# Canon — engine environment.
# Copy to engine/.env. Never committed, never read by the web layer.
#
# THERE ARE NO PER-INTEGRATION CREDENTIALS IN THIS FILE ANY MORE.
#
# SALESFORCE_USERNAME / _PASSWORD / _TOKEN, DATABRICKS_TOKEN,
# SNOWFLAKE_PASSWORD and the rest were removed when credentials became
# per-source. A static key per integration could not express two Salesforce
# orgs, could not be rotated without a deploy, and gave every run the same
# identity regardless of who started it.
#
# Credentials are now configured in the console, encrypted with AES-256-GCM by
# the web layer, and stored in `source_credentials`. The engine decrypts them
# per run — see engine/credentials.py. `sources.config` still holds non-secret
# connection shape only (object names, table names, filters), exactly as
# AGENTS.md § Security Rules requires.
#
# OAuth *app* registrations (client id and secret for Canon itself) live in
# web/.env, not here: the authorize flow is browser-driven and never touches
# the engine.

# Same Postgres the web layer uses. Drizzle owns the schema; the engine writes
# only its own tables — entities, matches, conflicts, resolutions, audit_log,
# plus runs status. Never sources, never rulesets, never source_credentials.
DATABASE_URL=postgresql://user:password@host:5432/postgres

# All model calls happen inside the engine. This key must never reach web/.
ANTHROPIC_API_KEY=

# The root of trust for stored credentials, and the only secret here that
# unlocks another secret.
#
# MUST BE BYTE-IDENTICAL to CANON_CREDENTIAL_KEY in web/.env — the web layer
# seals credentials with it and the engine opens them. If the two differ, every
# stored credential fails to decrypt with a message saying so.
#
#   openssl rand -base64 32
#
# In production this should come from a KMS or secret manager rather than a
# file; engine/credentials.py::_key_for is the single place that would change.
CANON_CREDENTIAL_KEY=

# Set to "production" to refuse a weak credential key outright instead of
# hashing it up to length.
CANON_ENV=development

# Where generated datasets live, for sources of kind `synthetic`.
#
# An engine setting rather than a field on `sources.config`, because the dataset
# is a file on this machine's disk: the console cannot see what is there and
# could not validate a path typed into a form. Which SIDE a synthetic source
# serves comes from its position in the run — source A is side "a" — so one
# directory serves both halves of a reconciliation with no per-source config.
#
#   uv run python -m eval.generate --seed 42 --accounts 500 --out ./data/run42
CANON_SYNTHETIC_DATA_DIR=./data/run42
