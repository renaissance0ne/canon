# Canon — engine environment.
# Copy to engine/.env. Never committed, never read by the web layer.
#
# AGENTS.md § Security Rules: source credentials are keyed by source `kind` and
# live HERE ONLY. `sources.config` in Postgres holds non-secret connection shape
# (object names, table names, filters). If you find yourself writing a password
# into a jsonb column, stop.

# Same Postgres the web layer uses. Drizzle owns the schema; the engine writes
# only its own tables — entities, matches, conflicts, resolutions, audit_log,
# plus runs status. Never sources, never rulesets.
DATABASE_URL=postgresql://user:password@host:5432/postgres

# All model calls happen inside the engine. This key must never reach web/.
ANTHROPIC_API_KEY=

# Salesforce (kind: "salesforce")
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_USERNAME=
SALESFORCE_PASSWORD=
SALESFORCE_TOKEN=

# Warehouse (kind: "databricks" | "snowflake")
DATABRICKS_TOKEN=
DATABRICKS_SERVER_HOSTNAME=
DATABRICKS_HTTP_PATH=
SNOWFLAKE_PASSWORD=
