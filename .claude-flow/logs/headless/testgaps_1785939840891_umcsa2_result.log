        "content": "```python\ndef test_select_rule_returns_none_when_no_rule_matches():\n    assert select_rule(_conflict(field=\"obscure_field\"), rules=[]) is None\n\ndef test_select_rule_picks_most_specific_over_wildcard():\n    specific = _rule(field=\"territory\", entity_type=\"account\")\n    wildcard = _rule(field=\"*\", entity_type=\"*\")\n    assert select_rule(_conflict(field=\"territory\"), rules=[wildcard, specific]) == specific\n\ndef test_select_rule_first_match_wins_on_a_specificity_tie():\n    r1, r2 = _rule(field=\"territory\"), _rule(field=\"territory\")  # same specificity\n    assert select_rule(_conflict(field=\"territory\"), rules=[r1, r2]) == r1\n\ndef test_validate_accepts_value_a_or_value_b_verbatim():\n    assert validate(\"APAC\", value_a=\"APAC\", value_b=\"EMEA\") is True\n    assert validate(\"EMEA\", value_a=\"APAC\", value_b=\"EMEA\") is True\n\ndef test_validate_accepts_a_legal_normalization_of_an_observed_value():\n    assert validate(\"acme\", value_a=\"Acme Inc.\", value_b=\"ACME INC\") is True\n\ndef test_validate_rejects_a_hallucinated_third_value():\n    # This is the single most important test in the whole system per AGENTS.md.\n    assert validate(\"EMEA-NORTH\", value_a=\"APAC\", value_b=\"EMEA\") is False\n\ndef test_validate_rejects_empty_string_when_neither_observed_value_is_empty():\n    assert validate(\"\", value_a=\"APAC\", value_b=\"EMEA\") is False\n\ndef test_resolve_escalates_when_select_rule_returns_none():\n    resolutions = resolve([_conflict(field=\"obscure\")], rules=[])\n    assert resolutions[0].status == \"escalated\"\n\ndef test_resolve_escalates_when_validate_rejects_the_proposed_value():\n    # even if a rule \"decided\", a failing validate must still escalate — not apply\n    ...\n\ndef test_resolve_never_auto_applies_above_severity_2_regardless_of_confidence():\n    # ties back to should_auto_apply's gate — resolve() must actually call it\n    ...\n\ndef test_resolve_empty_conflict_list_returns_empty_list():\n    assert resolve([], rules=[]) == []\n```\n\n",
        "level": 4
      },
