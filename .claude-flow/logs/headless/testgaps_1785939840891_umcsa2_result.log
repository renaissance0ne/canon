ion=\"d\", **kw)\n\ndef test_wildcard_both_is_least_specific():\n    assert rule_specificity(_rule(\"*\", \"*\")) == 0\n\ndef test_exact_field_wildcard_entity():\n    assert rule_specificity(_rule(\"territory\", \"*\")) == 2\n\ndef test_wildcard_field_exact_entity():\n    assert rule_specificity(_rule(\"*\", \"account\")) == 1\n\ndef test_exact_field_and_entity_is_most_specific():\n    assert rule_specificity(_rule(\"territory\", \"account\")) == 3\n\ndef test_ordering_matches_agents_md_priority():\n    rules = [_rule(\"*\", \"*\"), _rule(\"*\", \"account\"), _rule(\"territory\", \"*\"),\n              _rule(\"territory\", \"account\")]\n    assert sorted(rules, key=rule_specificity, reverse=True) == list(reversed(rules))\n```\n\n#### A2. `SurvivorshipRule` validator — `schema.py:101` (`prefer_source` needs a source)\n\n```python\ndef test_prefer_source_without_preferred_source_id_raises():\n    with pytest.raises(ValueError, match=\"preferred_source_id\"):\n        SurvivorshipRule(id=\"r1\", field=\"*\", entity_type=\"*\",\n                         strategy=\"prefer_source\", description=\"d\")\n\ndef test_prefer_source_with_preferred_source_id_is_valid():\n    r = SurvivorshipRule(id=\"r1\", field=\"*\", entity_type=\"*\", strategy=\"prefer_source\",\n                          preferred_source_id=\"src-1\", description=\"d\")\n    assert r.preferred_source_id == \"src-1\"\n\ndef test_non_prefer_source_strategies_dont_require_it():\n    for strategy in (\"most_recent\", \"most_complete\", \"escalate\"):\n        SurvivorshipRule(id=\"r1\", field=\"*\", entity_type=\"*\", strategy=strategy, description=\"d\")\n```\n\n**Missing edge case not covered by the current validator, worth flagging to you as a real gap (not just a test gap):** nothing rejects `preferred_source_id` being set when strategy is *not* `prefer_source`. Is a stray value there silently ignored downstream, or should it be a validation error? Test + decide:\n\n```python\ndef test_preferred_source_id_i