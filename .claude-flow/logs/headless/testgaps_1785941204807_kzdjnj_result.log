t (cls, sev) == (\"structural\", 4)\n\n    def test_territory_mismatch_is_attribute_severity_3(self):\n        assert classify(\"territory\", \"APAC\", \"EMEA\") == (\"attribute\", 3)\n\n    def test_other_field_mismatch_is_attribute_severity_2(self):\n        assert classify(\"industry\", \"Tech\", \"Finance\") == (\"attribute\", 2)\n\n    def test_values_folding_equal_is_cosmetic_severity_1(self):\n        assert classify(\"name\", \"Acme Inc.\", \"ACME INC\") == (\"cosmetic\", 1)\n\n    def test_identical_values_do_not_classify_as_conflict(self):\n        # EDGE CASE not covered by AGENTS.md text — should identical inputs raise,\n        # return None, or never be called? Needs an explicit contract.\n        ...\n\n@pytest.mark.xfail(reason=\"Phase 2 not implemented\", strict=True)\ndef test_detect_flags_unmatched_entities_as_orphan():\n    ...\n\n@pytest.mark.xfail(reason=\"Phase 2 not implemented\", strict=True)\ndef test_detect_flags_two_a_records_matching_one_b_as_duplicate_severity_4():\n    ...\n```\n\n```python\n# engine/tests/pipeline/test_blocking.py\n@pytest.mark.xfail(reason=\"Phase 2 not implemented\", strict=True)\ndef test_block_never_compares_all_pairs_on_large_input():\n    # Perf/complexity regression guard: AGENTS.md is explicit this must be O(n*k).\n    side_a = [entity_factory(external_id=f\"a{i}\") for i in range(5000)]\n    side_b = [entity_factory(external_id=f\"b{i}\") for i in range(5000)]\n    import time\n    start = time.perf_counter()\n    pairs = block(side_a, side_b, top_k=10)\n    assert time.perf_counter() - start < 5.0\n    assert len(pairs) <= 5000 * 10\n\n@pytest.mark.xfail(reason=\"Phase 2 not implemented\", strict=True)\ndef test_exact_key_match_takes_priority_over_embedding():\n    ...\n\n@pytest.mark.xfail(reason=\"Phase 2 not implemented\", strict=True)\ndef test_combine_confidence_is_bounded_0_to_1():\n    ...\n```\n\n```python\n# engine/tests/agent/test_graph_resolve.py\n@pytest.mark.xfail(reason=\"Phase 3 not implemented\", strict=True)\nclass TestValidate:\n    def test_rejects_hallucinated_value_not_in_observed_set(self):\n        # THE non-negotiable check per AGENTS.md — deserves the most test weight\n        # once implemented: fuzz many invented strings, all must be rejected.\n        assert validate(\"ACC-9999\", value_a=\"ACC-1\", value_b=\"ACC-2\") is False\n\n    def test_accepts_value_a_verbatim(self):\n        assert validate(\"ACC-1\", value_a=\"ACC-1\", value_b=\"ACC-2\") is True\n\n    def test_accepts_legal_normalization_of_value_b(self):\n        assert validate(\"acme\", value_a=\"Acme Inc.\", value_b=\"ACME INC\") is True\n\n@pytest.mark.xfail(reason=\"Phase 3 not implemented\", strict=True)\ndef test_select_rule_returns_none_when_no_rule_matches():\n    # \"Canon never guesses in the absence of policy\" — this is the escalation trigger.\n    assert select_rule(conflict, rules=[]) is None\n\n@pytest.mark.xfail(reason=\"Phase 3 not implemented\", strict=True)\ndef test_resolve_never_calls_model_when_deterministic_rule_decides(monkeypatch):\n    # Cost-control contract: rule-decided conflicts must not touch the Anthropic client.\n    ...\n```\n\n```python\n# engine/tests/eval/test_generate.py\n@pytest.mark.xfail(reason=\"Phase 1 not implemented\", strict=True)\ndef test_generate_is_deterministic_for_same_seed(tmp_path):\n    m1 = generate(seed=42, accounts=50, out_dir=tmp_path / \"a\")\n    m2 = generate(seed=42, accounts=50, out_dir=tmp_path / \"b\")\n    assert m1 == m2\n\n@pytest.mark.xfail(reason=\"Phase 1 not implemented\", strict=True)\ndef test_generate_injects_all_six_divergence_types(tmp_path):\n    manifest = generate(seed=1, accounts=500, out_dir=tmp_path)\n    classes = {e.conflict_class for e in manifest}\n    assert classes.issuperset({\"structural\", \"attribute\", \"cosmetic\", \"orphan\", \"duplicate\"})\n\n@pytest.mark.xfail(reason=\"Phase 1 not implemented\", strict=True)\ndef test_generate_produces_genuinely_ambiguous_cases():\n    # This is the row AGENTS.md says \"matters most\" — regression guard against\n    # someone quietly dropping it to make metrics look better.\n    manifest = generate(seed=1, accounts=500, out_dir=tmp_path)\n    assert any(e.expected_resolution == \"escalate\" for e in manifest)\n```\n\n---\n\n### 5. Missing error-handling tests\n\nNone of the following failure paths are tested anywhere (most can't be yet since the code doesn't exist, but they need to be specified now):\n\n| Missing case | Where it should live |\n|---|---|\n| `main.py::run_status` for a nonexistent `run_id` → currently unconditionally 501; once implemented, must 404 | `engine/tests/test_main.py` |\n| `execute_run` failure mid-pipeline → must write `status=\"failed\"` + `error` and not leave a run stuck in an intermediate status | `engine/tests/test_main.py` |\n| `db.py::update_run_status` called with an invalid `RunStatus` transition (e.g. `complete → matching`) | `engine/tests/test_db.py` |\n| `requireReviewer()` when Clerk session exists but `currentUser()` returns null (edge case between auth() and currentUser() consistency) | `web/lib/server/auth.test.ts` |\n| Zod schema failures on route handlers — **can't be tested yet, no route handlers exist** (Phase 4 item 12+) | flag as not-yet-buildable |\n| `SalesforceConnector`/`WarehouseConnector` — no test for auth failure, rate limiting, empty result set, or partial-page failures mid-stream | `engine/tests/connectors/` (Phase 5) |\n| `SyntheticConnector.extract` on a missing/corrupt `data_dir` | `engine/tests/connectors/test_synthetic.py` |\n\n```python\n# engine/tests/connectors/test_synthetic.py\n@pytest.mark.xfail(reason=\"Phase 1 not implemented\", strict=True)\ndef test_extract_raises_clear_error_on_missing_data_dir(tmp_path):\n    conn = SyntheticConnector(data_dir=tmp_path / \"does-not-exist\", side=\"a\")\n    with pytest.raises(FileNotFoundError):\n        list(conn.extract(\"account\"))\n```\n\n---\n\n### 6. Integration test gaps\n\nNone of these exist and can't be written meaningfully until the corresponding phase lands, but the seams are worth naming now so they aren't forgotten:\n\n1. **Web ↔ Engine HTTP contract** — `POST {ENGINE_URL}/runs` → `GET /runs/:id/status` round trip. No web-side typed client exists yet (`lib/server/engine.ts` is listed in the architecture but not yet created).\n2. **Table-ownership enforcement** — no automated check that the engine never writes `sources`/`rulesets`, or that web never writes `entities`/`matches`/`conflicts`. This is exactly the kind of invariant that should be a test (e.g., a DB-permission test using a Postgres role with `REVOKE` on those tables for each writer), not just a comment in AGENTS.md.\n3. **Zod ↔ Pydantic contract drift** — no test asserts the two schemas actually agree (e.g., generate example payloads from Pydantic, validate against Zod in a golden-file test, or vice versa). This is explicitly called out in AGENTS.md as something that must never drift.\n4. **Full pipeline run against `eval/generate.py` output** — `extract → normalize → match → detect → resolve` end-to-end, once each stage exists — currently impossible since every stage raises `NotImplementedError`.\n5. **Auth middleware (`proxy.ts`) route coverage** — no test confirms `/api/runs/*` and other non-public routes actually 401/redirect when unauthenticated, versus `/`, `/sign-in`, `/sign-up` staying public.\n\n```ts\n// web/proxy.test.ts (needs a Clerk test harness — @clerk/testing)\nit(\"blocks unauthenticated access to a console route\", async () => {\n  const res = await fetch(\"/runs\", { redirect: \"manual\" });\n  expect([302, 307, 401]).toContain(res.status);\n});\nit(\"allows unauthenticated access to the landing page\", async () => {\n  const res = await fetch(\"/\");\n  expect(res.status).toBe(200);\n});\n```\n\n---\n\n### Priority order\n\n1. Stand up test infra (`pytest` config in `engine/`, add `vitest` + `@testing-library/react` to `web/` — **ask before installing**, per AGENTS.md