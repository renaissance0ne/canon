        "content": "import pytest\nfrom unittest.mock import patch\nfrom eval.baselines import baseline_exact, baseline_rules\n\npytestmark = pytest.mark.xfail(raises=NotImplementedError, reason=\"Phase 2, not yet implemented\")\n\ndef test_baseline_exact_flags_cosmetic_differences_too(entity_pair_cosmetic_diff_only):\n    # Unlike the full pipeline, baseline_exact must NOT fold names — that's\n    # the point of it being the floor.\n    conflicts = baseline_exact(*entity_pair_cosmetic_diff_only)\n    assert len(conflicts) == 1\n\ndef test_baseline_rules_never_calls_the_model(sample_entities, sample_rules):\n    with patch(\"anthropic.Anthropic\") as mock_client:\n        baseline_rules(*sample_entities, sample_rules)\n        mock_client.assert_not_called()\n```\n\n---\n\n",
