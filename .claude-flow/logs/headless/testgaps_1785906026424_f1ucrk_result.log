  resp = client.get(\"/runs/not-a-uuid/status\")\n        assert resp.status_code == 422\n```\n\n### 4. `web/types/*.ts` — the Zod half of the tool contract, zero tests\n\nThis is the other half of the contract in #1. No test runner is configured for `web/` at all yet (no vitest/jest in `package.json`) — **that's the actual first gap**. I'd suggest adding **Vitest** (pairs cleanly with Next.js App Router, no config ceremony) — flagging this since `AGENTS.md` requires approval before adding a dependency.\n\n```typescript\n// web/types/rules.test.ts (once a test runner is approved/added)\nimport { describe, expect, it } from \"vitest\";\nimport { ruleSpecificity, survivorshipRuleSchema } from \"./rules\";\n\ndescribe(\"survivorshipRuleSchema\", () => {\n  it(\"rejects prefer_source without preferredSourceId\", () => {\n    const result = survivorshipRuleSchema.safeParse({\n      id: \"r1\", field: \"*\", entityType: \"*\",\n      strategy: \"prefer_source\", description: \"x\",\n    });\n    expect(result.success).toBe(false);\n    expect(result.error?.issues[0].path).toEqual([\"preferredSourceId\"]);\n  });\n\n  it(\"accepts prefer_source with preferredSourceId\", () => {\n    const result = survivorshipRuleSchema.safeParse({\n      id: \"r1\", field: \"*\", entityType: \"*\", strategy: \"prefer_source\",\n      preferredSourceId: \"src-1\", description: \"x\",\n    });\n    expect(result.success).toBe(true);\n  });\n});\n\ndescribe(\"ruleSpecificity\", () => {\n  it.each([\n    [\"*\", \"*\", 0],\n    [\"*\", \"account\", 1],\n    [\"territory\", \"*\", 2],\n    [\"territory\", \"account\", 3],\n  ])(\"field=%s entityType=%s -> %i\", (field, entityType, expected) => {\n    expect(\n      ruleSpecificity({ id: \"r\", field, entityType, strategy: \"most_recent\", description: \"x\" }),\n    ).toBe(expected);\n  });\n\n  // Cross-language parity: Python's rule_specificity must agree on every case\n  // here. Consider a shared JSON fixture consumed by both test suites.\n});\n```\n\n```typescript\n// web/types/run.test.ts\nimport { describe, expect, it } from \"vitest\";\nimport { EMPTY_RUN_STATS, isRunActive, runStatsSchema } from \"./run\";\n\ndescribe(\"isRunActive\", () => {\n  it.each([\"complete\", \"failed\"])(\"%s is not active\", (s) => {\n    expect(isRunActive(s as any)).toBe(false);\n  });\n  it.each([\"queued\", \"extracting\", \"matching\", \"detecting\", \"resolving\"])(\n    \"%s is active\", (s) => expect(isRunActive(s as any)).toBe(true),\n  );\n});\n\ndescribe(\"EMPTY_RUN_STATS\", () => {\n  it(\"satisfies runStatsSchema\", () => {\n    expect(() => runStatsSchema.parse(EMPTY_RUN_STATS)).not.toThrow();\n  });\n});\n```\n\n```typescript\n// web/types/resolution.test.ts\nimport { describe, expect, it } from \"vitest\";\nimport { reviewActionSchema } from \"./resolution\";\n\ndescribe(\"reviewActionSchema\", () => {\n  it(\"approve requires reviewedBy\", () => {\n    expect(reviewActionSchema.safeParse({ action: \"approve\", reviewedBy: \"\" }).success).toBe(false);\n  });\n  it(\"override requires overrideValue\", () => {\n    expect(\n      reviewActionSchema.safeParse({ action: \"override\", reviewedBy: \"alice\" }).success,\n    ).toBe(false);\n  });\n  it(\"unknown action is rejected\", () => {\n    expect(reviewActionSchema.safeParse({ action: \"delete\", reviewedBy: \"alice\" }).success).toBe(false);\n  });\n});\n```\n\n```typescript\n// web/types/source.test.ts — completeness guard: catches a new SourceKind\n// being added to the enum without its label/side mapping being updated.\nimport { describe, expect, it } from \"vitest\";\nimport { sourceKindSchema, SOURCE_KIND_LABEL, SOURCE_KIND_SIDE } from \"./source\";\n\ndescribe(\"SourceKind lookup tables stay complete\", () => {\n  it(\"every enum value has a label and a side\", () => {\n    for (const kind of sourceKindSchema.options) {\n      expect(SOURCE_KIND_LABEL[kind]).toBeDefined();\n      expect(SOURCE_KIND_SIDE[kind]).toBeDefined();\n    }\n  });\n});\n```\n\n### 5. `web/lib/server/sources.ts` — `listSources` / `countSourcesBySide`, untested\n\n```typescript\n// web/lib/server/sources.test.ts\nimport { describe, expect, it, vi } from \"vitest\";\n\nvi.mock(\"next/server\", () => ({ connection: vi.fn().mockResolvedValue(undefined) }));\nvi.mock(\"@/lib/db\", () => ({ getDb: vi.fn() }));\n\ndescribe(\"countSourcesBySide\", () => {\n  it(\"buckets salesforce/hubspot as crm, databricks/snowflake as warehouse\", async () => {\n    // Arrange getDb() mock to return a fixed row set via listSources' select chain,\n    // then assert counts: no source double-counted across buckets.\n  });\n\n  it(\"returns all zeros for an empty sources table\", async () => {\n    // Arrange empty result set; assert { crm: 0, warehouse: 0, synthetic: 0 }.\n  });\n});\n\ndescribe(\"listSources\", () => {\n  it(\"throws a clear error when a DB row fails sourceSchema.parse (e.g. null config)\", async () => {\n    // Arrange a malformed row; assert the ZodError surfaces rather than being swallowed.\n  });\n});\n```\n\n### 6. `web/components/severity-mark.tsx` — the accessibility-critical component\n\n`AGENTS.md` is explicit: *\"Never render the mark without the word.\"* That's a testable invariant, not just a style guideline.\n\n```typescript\n// web/components/severity-mark.test.tsx\nimport { render, screen } from \"@testing-library/react\";\nimport { describe, expect, it } from \"vitest\";\nimport { SeverityMark } from \"./severity-mark\";\n\ndescribe(\"SeverityMark\", () => {\n  it.each([4, 3, 2, 1] as const)(\"severity %i always renders its text label\", (severity) => {\n    render(<SeverityMark severity={severity} />);\n    const labels = { 4: \"Structural\", 3: \"Attribute\", 2: \"Attribute\", 1: \"Cosmetic\" };\n    expect(screen.getByText(labels[severity])).toBeInTheDocument();\n  });\n});\n```\n\n---\n\n## B. Stubbed logic — write TDD skeletons now, activate on implementation\n\nThese currently `raise NotImplementedError`. Rather than skip them, pin the documented contract now with `pytest.mark.xfail(raises=NotImplementedError)` so the suite is honest about what's built, and the tests flip green the moment each function lands — no separate \"add tests\" step later.\n\n### 7. `engine/pipeline/normalize.py::fold_name` — flag a real ambiguity\n\nThe docstring folds `\"Pvt Ltd\"` as a suffix, but `LEGAL_SUFFIXES` lists both `\"pvt\"` and `\"pvt ltd\"` as separate tuple entries. If folding strips one trailing token at a time, `\"pvt ltd\"` as a *phrase* can never match — worth resolving before implementing, not after.\n\n```python\n# engine/tests/pipeline/test_normalize.py\nimport pytest\nfrom pipeline.normalize import fold_name\n\npytestmark = pytest.mark.xfail(raises=NotImplementedError, reason=\"Phase 2, not yet implemented\")\n\n@pytest.mark.parametrize(\"raw,expected\", [\n    (\"Acme Inc.\", \"acme\"),\n    (\"ACME INC\", \"acme\"),\n    (\"Acme, Inc.\", \"acme\"),\n    (\"Acme   Corp\", \"acme\"),           # whitespace collapsing\n    (\"Acme Pvt Ltd\", \"acme\"),          # compound suffix — the ambiguity above\n    (\"Acme Pvt. Ltd.\", \"acme\"),\n    (\"LLC\", \"\"),                        # name that IS only a suffix\n    (\"Corp Solutions Inc\", \"corp solutions\"),  # suffix mid-name must NOT fold\n])\ndef test_fold_name(raw, expected):\n    assert fold_name(raw) == expected\n\ndef test_fold_name_is_idempotent():\n    assert fold_name(fold_name(\"Acme Inc.\")) == fold_name(\"Acme Inc.\")\n\ndef test_fold_name_empty_string():\n    assert fold_name(\"\") == \"\"\n```\n\n### 8. `engine/pipeline/detect.py::classify` and `detect`\n\n```python\n# engine/tests/pipeline/test_detect.py\nimport pytest\nfrom uuid import uuid4\nfrom pipeline.detect import classify, detect, severity_for_orphan\n\npytestmark = pytest.mark.xfail(raises=NotImplementedError, reason=\"Phase 2, not yet implemented\")\n\nclass TestClassify:\n    def test_parent_external_id_is_structural_severity_4(self):\n        assert classify(\"parentExternalId\", \"ACC-1\", \"ACC-2\") == (\"structural\", 4)\n\n    @pytest.mark.parametrize(\"field\", [\"territory\", \"roleName\", \"ownerId\"])\n    def test_ownership_fields_are_attribute_severity_3(self, field):\n        assert classify(field, \"a\", \"b\") == (\"attribute\", 3)\n\n    def test_other_field_is_attribute_severity_2(self):\n        assert classify(\"industry\", \"Tech\", \"Finance\") == (\"attribute\", 2)\n\n    def test_values_folding_to_same_form_are_cosmetic_severity_1(self):\n        assert classify(\"name\", \"Acme Inc.\", \"ACME INC\") == (\"cosmetic\", 1)\n\n    def test_field_name_is_case_sensitive_against_structural_set(self):\n        # Guards against a silent miscategorization if source data ever sends\n        # \"ParentExternalId\" — should NOT be treated as structural.\n        result = classify(\"ParentExternalId\", \"ACC-1\", \"ACC-2\")\n        assert result != (\"structural\", 4)\n\n\nclass TestSeverityForOrphan:\n    def test_with_children_is_4(self):\n        assert severity_for_orphan(has_children=True) == 4\n\n    def test_without_children_is_3(self):\n        assert severity_for_orphan(has_children=False) == 3\n\n\nclass TestDetect:\n    def test_identical_matched_entities_produce_no_conflicts(self, matching_entity_pair):\n        ...\n\n    def test_multiple_field_diffs_produce_one_conflict_per_field(self, ...):\n        ...\n\n    def test_unmatched_entity_without_children_is_orphan_severity_3(self, ...):\n        ...\n\n    def test_unmatched_entity_with_children_is_orphan_severity_4(self, ...):\n        ...\n\n    def test_two_side_a_records_matching_one_side_b_record_is_duplicate_severity_4(self, ...):\n        ...\n\n    def test_every_conflict_carries_the_run_id(self, ...):\n        ...\n```\n\n### 9. `engine/agent/graph.py::validate` — the non-negotiable hallucination guard\n\nThis is the highest-value test in the entire codebase per `AGENTS.md` (\"*A hallucinated parent id is worse than an escalation*