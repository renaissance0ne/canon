        "code": "# engine/tests/test_normalize.py — drives pipeline/normalize.py fold_name / normalize\nimport pytest\nfrom pipeline.normalize import fold_name, normalize\n\n@pytest.mark.parametrize(\"raw,expected\", [\n    (\"Acme Inc.\", \"acme\"),\n    (\"ACME INC\", \"acme\"),\n    (\"Trellis Labs Pvt Ltd\", \"trellis labs\"),   # two suffixes stripped\n    (\"Söhne GmbH\", \"sohne\"),                     # NFKD fold + suffix\n    (\"  Extra   Space  Co\", \"extra space\"),\n])\ndef test_fold_name_matches_web_lib_validate_value_LEGAL_SUFFIXES(raw, expected):\n    assert fold_name(raw) == expected\n\ndef test_fold_name_whole_value_equals_a_suffix_is_kept():\n    # mirrors web/lib/validate-value.ts foldValue: \"keep it, don't strip to empty\"\n    assert fold_name(\"Ltd\") == \"ltd\"\n\ndef test_fold_name_is_deterministic_and_total():\n    for value in [\"\", \"  \", \"Acme\", \"😀 Inc\"]:\n        assert fold_name(value) == fold_name(value)\n\ndef test_normalize_produces_canonical_entities_with_recorded_not_destructive_names():\n    records = [{\"Id\": \"001\", \"Name\": \"Acme Inc.\", \"ParentId\": None}]\n    entities = normalize(records, entity_type=\"account\", source_id=\"src-a\")\n    assert entities[0].name == \"Acme Inc.\"          # original preserved\n    assert entities[0].normalized_name == \"acme\"    # folded separately\n\ndef test_normalize_empty_input_returns_empty_list():\n    assert normalize([], entity_type=\"account\", source_id=\"src-a\") == []"
