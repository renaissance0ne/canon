        "code": "// web/lib/server/conflicts.integration.test.ts — requires a seeded test DB\nimport { describe, it, expect, beforeEach } from \"vitest\";\nimport { recordReview, getReviewTarget } from \"./conflicts\";\n// import { withTestDb, seedConflictAndResolution } from \"@/tests/db\"; // infra TODO\n\ndescribe(\"recordReview\", () => {\n  it(\"returns 404 for a conflict id that does not exist\", async () => {\n    const result = await recordReview({ conflictId: crypto.randomUUID(), action: { action: \"approve\" }, reviewer: r() });\n    expect(result).toEqual({ ok: false, code: 404, message: expect.any(String) });\n  });\n\n  it(\"returns 409 approving a conflict with no resolution yet (run still resolving)\", async () => {\n    // seed a conflict with resolutionId = null\n    const result = await recordReview({ conflictId: \"seeded-unresolved\", action: { action: \"approve\" }, reviewer: r() });\n    expect(result).toMatchObject({ ok: false, code: 409 });\n  });\n\n  it(\"returns 409 approving a conflict whose rule said escalate (empty proposedValue)\", async () => {\n    // seed resolution with proposedValue: \"\", status: \"escalated\"\n    const result = await recordReview({ conflictId: \"seeded-escalated-empty\", action: { action: \"approve\" }, reviewer: r() });\n    expect(result).toMatchObject({ ok: false, code: 409 });\n  });\n\n  it(\"returns 400 overriding with a value that is neither observed value nor a legal normalization\", () => {});\n\n  it(\"override stores the OBSERVED value the candidate folds onto, not the typed string\", () => {});\n\n  it(\"approve writes status='approved' and appends a human_approved audit row with previousStatus\", () => {});\n\n  it(\"reject writes status='rejected' and audit detail has chosenValue=null (nothing was applied)\", () => {});\n\n  it(\"does NOT modify proposedValue, rationale, confidence, or appliedRuleId on any action\", () => {});\n\n  it(\"moving from override back to approve clears overrideValue on the row\", () => {});\n\n  it(\"audit detail includes previousStatus equal to the status BEFORE this call\", () => {});\n\n  it(\"reviewedBy always comes from the passed reviewer, never from the action payload\", () => {});\n});"
