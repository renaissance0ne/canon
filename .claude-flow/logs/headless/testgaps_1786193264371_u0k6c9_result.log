        "code": "// web/lib/server/engine.test.ts — no DB needed, mock fetch\nimport { describe, it, expect, vi, beforeEach } from \"vitest\";\nimport { startRun, fetchEngineStatus, EngineUnreachableError } from \"./engine\";\n\ndescribe(\"startRun\", () => {\n  beforeEach(() => { process.env.ENGINE_URL = \"http://engine.test\"; vi.restoreAllMocks(); });\n\n  it(\"throws EngineUnreachableError when fetch rejects (network down)\", async () => {\n    vi.stubGlobal(\"fetch\", vi.fn().mockRejectedValue(new Error(\"ECONNREFUSED\")));\n    await expect(startRun(\"run-1\")).rejects.toBeInstanceOf(EngineUnreachableError);\n  });\n\n  it(\"throws with timeout-specific message when the request times out\", async () => {\n    const err = new Error(\"timeout\"); err.name = \"TimeoutError\";\n    vi.stubGlobal(\"fetch\", vi.fn().mockRejectedValue(err));\n    await expect(startRun(\"run-1\")).rejects.toThrow(/no response within/);\n  });\n\n  it(\"throws when engine responds non-2xx\", async () => {\n    vi.stubGlobal(\"fetch\", vi.fn().mockResolvedValue(new Response(\"bad\", { status: 500 })));\n    await expect(startRun(\"run-1\")).rejects.toBeInstanceOf(EngineUnreachableError);\n  });\n\n  it(\"throws when engine returns 200 with a body that fails the tool-contract schema\", async () => {\n    vi.stubGlobal(\"fetch\", vi.fn().mockResolvedValue(Response.json({ wrong: \"shape\" })));\n    await expect(startRun(\"run-1\")).rejects.toThrow(/unexpected body/);\n  });\n\n  it(\"throws EngineUnreachableError (not a generic Error) when ENGINE_URL is unset\", async () => {\n    delete process.env.ENGINE_URL;\n    await expect(startRun(\"run-1\")).rejects.toBeInstanceOf(EngineUnreachableError);\n  });\n\n  it(\"resolves silently on a valid 200 response\", async () => {\n    vi.stubGlobal(\"fetch\", vi.fn().mockResolvedValue(Response.json({ runId: \"run-1\", accepted: true })));\n    await expect(startRun(\"run-1\")).resolves.toBeUndefined();\n  });\n});\n\ndescribe(\"fetchEngineStatus\", () => {\n  it(\"returns null (never throws) when the engine is unreachable — polling must degrade gracefully\", async () => {\n    vi.stubGlobal(\"fetch\", vi.fn().mockRejectedValue(new Error(\"down\")));\n    await expect(fetchEngineStatus(\"run-1\")).resolves.toBeNull();\n  });\n  it(\"returns null on a non-2xx response\", async () => {\n    vi.stubGlobal(\"fetch\", vi.fn().mockResolvedValue(new Response(\"\", { status: 503 })));\n    expect(await fetchEngineStatus(\"run-1\")).toBeNull();\n  });\n  it(\"returns null when the body fails schema validation\", async () => {\n    vi.stubGlobal(\"fetch\", vi.fn().mockResolvedValue(Response.json({ garbage: true })));\n    expect(await fetchEngineStatus(\"run-1\")).toBeNull();\n  });\n});"
