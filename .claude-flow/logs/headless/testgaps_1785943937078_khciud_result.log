t_does_not_strip_suffix_substring_inside_a_word(self):\n        # \"co\" must not fold \"Coastal Ventures\" into \"astal Ventures\"\n        assert \"coastal\" in fold_name(\"Coastal Ventures\")\n\n    def test_empty_string_is_total(self):\n        assert fold_name(\"\") == \"\"\n\n    def test_deterministic_across_calls(self):\n        assert fold_name(\"Acme GmbH\") == fold_name(\"Acme GmbH\")\n\nclass TestNormalize:\n    def test_preserves_original_name_alongside_folded(self):\n        [entity] = normalize([{\"Id\": \"1\", \"Name\": \"Acme Inc.\"}], entity_type=\"account\", source_id=\"s1\")\n        assert entity.name == \"Acme Inc.\"\n        assert entity.normalized_name != entity.name\n\n    def test_empty_records_returns_empty_list(self):\n        assert normalize([], entity_type=\"account\", source_id=\"s1\") == []\n\n    def test_missing_optional_fields_default_to_none(self):\n        [entity] = normalize([{\"Id\": \"1\", \"Name\": \"X\"}], entity_type=\"account\", source_id=\"s1\")\n        assert entity.parent_external_id is None\n        assert entity.last_modified_at is None\n\n    def test_raises_on_missing_required_external_id(self):\n        with pytest.raises(KeyError):\n            normalize([{\"Name\": \"X\"}], entity_type=\"account\", source_id=\"s1\")\n```\n\n### `pipeline/blocking.py` — `block`, `score`, `combine`, `match`\nGaps: **O(n·k) guarantee itself is untested** — this is a named architectural constraint (\"never compare all pairs\"), so it deserves a test that asserts candidate-pair count stays bounded, not just correctness. Also: empty sides, exact-key match short-circuiting embeddings, `top_k` boundary, confidence exactly at `MIN_MATCH_CONFIDENCE`, duplicate exact keys.\n\n```python\n# engine/pipeline/test_blocking.py\nimport pytest\nfrom pipeline.blocking import block, score, combine, match, MIN_MATCH_CONFIDENCE, TOP_K\n\nclass TestBlock:\n    def test_exact_external_id_match_short_circuits_embedding_lookup(self):\n        ...\n\n    def test_candidate_pairs_bounded_by_top_k_not_full_cross_product(self):\n        # regression guard for the O(n*k) requirement in AGENTS.md\n        side_a = [make_entity(f\"a{i}\") for i in range(200)]\n        side_b = [make_entity(f\"b{i}\") for i in range(200)]\n        pairs = block(side_a, side_b, top_k=5)\n        assert len(pairs) <= 200 * 5\n\n    def test_empty_side_returns_no_pairs(self):\n        assert block([], [make_entity(\"b1\")]) == []\n\nclass TestCombine:\n    def test_exact_key_dominates_low_fuzzy_signal(self):\n        ...\n\n    def test_confidence_is_clamped_to_unit_interval(self):\n        ...\n\nclass TestMatch:\n    def test_below_min_confidence_pairs_are_dropped(self):\n        ...\n\n    def test_at_exactly_min_confidence_boundary_is_included(self):\n        # off-by-one on MIN_MATCH_CONFIDENCE threshold\n        ...\n```\n\n### `pipeline/detect.py` — `classify`, `severity_for_orphan`, `detect`\nThis is the highest-value target: severity is \"not a vibe,\" per `AGENTS.md`, and it's the input to the auto-apply gate. Every row of the severity table needs a direct test, plus the orphan/duplicate special cases.\n\n```python\n# engine/pipeline/test_detect.py\nimport pytest\nfrom pipeline.detect import classify, severity_for_orphan, detect\n\nclass TestClassify:\n    @pytest.mark.parametrize(\"field,expected_class,expected_severity\", [\n        (\"parentExternalId\", \"structural\", 4),\n        (\"territory\", \"attribute\", 3),\n        (\"roleName\", \"attribute\", 3),\n        (\"ownerId\", \"attribute\", 3),\n        (\"industry\", \"attribute\", 2),   # non-rollup, non-ownership field\n    ])\n    def test_field_severity_matrix(self, field, expected_class, expected_severity):\n        cls, sev = classify(field, \"A\", \"B\")\n        assert (cls, sev) == (expected_class, expected_severity)\n\n    def test_values_folding_to_same_form_are_cosmetic(self):\n        cls, sev = classify(\"name\", \"Acme Inc.\", \"ACME INC\")\n        assert