        "content": "```ts\n// web/lib/reviewer-label.test.ts\nimport { describe, it, expect } from \"vitest\";\nimport { reviewerLabel } from \"@/lib/reviewer-label\";\n\ndescribe(\"reviewerLabel\", () => {\n  it(\"prefers username over email\", () => {\n    expect(reviewerLabel(\n      { username: \"j.rao\", primaryEmailAddress: { emailAddress: \"j@x.com\" } },\n      \"fallback-id\",\n    )).toBe(\"j.rao\");\n  });\n\n  it(\"falls back to email when username is null\", () => {\n    expect(reviewerLabel(\n      { username: null, primaryEmailAddress: { emailAddress: \"j@x.com\" } },\n      \"fallback-id\",\n    )).toBe(\"j@x.com\");\n  });\n\n  it(\"falls back to the stable id when user is null\", () => {\n    expect(reviewerLabel(null, \"fallback-id\")).toBe(\"fallback-id\");\n  });\n\n  it(\"falls back to the stable id when both username and email are absent\", () => {\n    expect(reviewerLabel({ username: null, primaryEmailAddress: null }, \"fallback-id\"))\n      .toBe(\"fallback-id\");\n  });\n\n  it(\"treats empty-string username as absent, not as a valid label\", () => {\n    // current implementation uses ?? — an empty string WOULD pass through.\n    // this test documents/locks the intended behavior once decided.\n    expect(reviewerLabel({ username: \"\", primaryEmailAddress: null }, \"fallback-id\"))\n      .toBe(\"fallback-id\"); // currently FAILS — flags a real edge case gap\n  });\n});\n```\nNote: that last case is a genuine bug-shaped gap — `??` does not treat `\"\"` as nullish, so an empty-string Clerk username would render as a blank label in the audit trail rather than falling back. Worth deciding intentionally.\n\n",
