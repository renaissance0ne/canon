erity=AUTO_APPLY_MAX_SEVERITY + 1)\n\n    def test_high_confidence_alone_never_overrides_severity_gate(self):\n        # regression guard: the two conditions must both hold, never either\n        assert not should_auto_apply(confidence=0.99, severity=3)\n\nclass TestSelectRule:\n    def test_most_specific_rule_wins_over_wildcard_field(self):\n        ...\n\n    def test_most_specific_rule_wins_over_wildcard_entity_type(self):\n        ...\n\n    def test_first_match_wins_among_equally_specific_rules(self):\n        ...\n\n    def test_no_matching_rule_returns_none_which_escalates(self):\n        assert select_rule(conflict_with_field(\"obscureField\"), rules=[]) is None\n\nclass TestValidate:\n    def test_accepts_value_a_verbatim(self):\n        assert validate(\"APAC\", value_a=\"APAC\", value_b=\"EMEA\")\n\n    def test_accepts_legal_normalization_of_observed_value(self):\n        assert validate(\"Acme\", value_a=\"Acme Inc.\", value_b=\"Acme LLC\")\n\n    def test_rejects_a_third_hallucinated_value(self):\n        # THE core non-negotiable check per AGENTS.md\n        assert not validate(\"EMEA-NORTH\", value_a=\"APAC\", value_b=\"EMEA\")\n\n    def test_rejects_value_that_only_superficially_resembles_an_observed_one(self):\n        assert not validate(\"ACC-4418\", value_a=\"ACC-4417\", value_b=\"ACC-2201\")\n\nclass TestResolve:\n    def test_severity_4_conflict_never_auto_applies_regardless_of_confidence(self):\n        ...\n\n    def test_empty_conflict_list_returns_empty_resolutions(self):\n        assert resolve([], rules=[]) == []\n```\n\n### `pipeline/schema.py` — the one place with real, testable logic today\n`SurvivorshipRule`'s `prefer_source` validator and `rule_specificity` are fully implemented and completely untested.\n\n```python\n# engine/pipeline/test_schema.py\nimport pytest\nfrom pydantic import ValidationError\nfrom pipeline.schema import SurvivorshipRule, rule_specificity\n\nclass TestSurvivorshipRuleValidation:\n    def test_prefer_source