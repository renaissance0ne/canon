        "title": "2.1 `lib/format.ts` — 8 functions, 0 tests",
        "content": "\n```ts\n// web/lib/format.test.ts\nimport { describe, it, expect } from \"vitest\";\nimport {\n  shortRunId, formatElapsed, formatCount, formatStat,\n  formatClockTime, formatTimestamp, formatRelative, formatConfidence,\n} from \"@/lib/format\";\n\ndescribe(\"shortRunId\", () => {\n  it(\"strips hyphens and takes 4+2 chars joined by an interpunct\", () => {\n    expect(shortRunId(\"a41f0c9d-1234-5678-9abc-def012345678\")).toBe(\"a41f·0c\");\n  });\n  it(\"handles an id shorter than expected without throwing\", () => {\n    // Edge case: malformed/truncated id — should not crash a render.\n    expect(() => shortRunId(\"abc\")).not.toThrow();\n  });\n});\n\ndescribe(\"formatElapsed\", () => {\n  it.each([\n    [0, \"00:00\"],\n    [59_000, \"00:59\"],\n    [60_000, \"01:00\"],\n    [3_599_000, \"59:59\"],\n    [3_600_000, \"1:00:00\"],\n    [-500, \"00:00\"],       // negative ms clamped to 0\n    [999, \"00:00\"],        // sub-second floors to 0\n  ])(\"formats %dms as %s\", (ms, expected) => {\n    expect(formatElapsed(ms)).toBe(expected);\n  });\n});\n\ndescribe(\"formatCount / formatStat\", () => {\n  it(\"adds thousands separators\", () => {\n    expect(formatCount(12345)).toBe(\"12,345\");\n  });\n  it(\"formatStat renders an em dash for null and undefined, not 0\", () => {\n    expect(formatStat(null)).toBe(\"—\");\n    expect(formatStat(undefined)).toBe(\"—\");\n    expect(formatStat(0)).toBe(\"0\"); // the actual bug this function exists to prevent\n  });\n});\n\ndescribe(\"formatRelative\", () => {\n  const now = new Date(\"2026-08-08T12:00:00Z\");\n  it.each([\n    [30_000, \"just now\"],\n    [90_000, \"2m ago\"],\n    [3_700_000, \"1h ago\"],\n    [172_800_000, \"2d ago\"],\n  ])(\"%dms ago formats correctly\", (deltaMs, expected) => {\n    expect(formatRelative(new Date(now.getTime() - deltaMs), now)).toBe(expected);\n  });\n  it(\"does not go negative for a future date (clock skew)\", () => {\n    // Edge case: engine clock slightly ahead of web clock.\n    expect(() => formatRelative(new Date(now.getTime() + 5000), now)).not.toThrow();\n  });\n});\n\ndescribe(\"formatConfidence\", () => {\n  it(\"always shows two decimals, never a percentage\", () => {\n    expect(formatConfidence(0.9)).toBe(\"0.90\");\n    expect(formatConfidence(1)).toBe(\"1.00\");\n    expect(formatConfidence(0)).toBe(\"0.00\");\n  });\n});\n```\n\n",
        "level": 3
      },
      {
        "title": "2.2 `lib/diff-chars.ts::diffSegments` — the signature UI element's engine, 0 tests",
        "content": "\n```ts\n// web/lib/diff-chars.test.ts\nimport { describe, it, expect } from \"vitest\";\nimport { diffSegments } from \"@/lib/diff-chars\";\n\ndescribe(\"diffSegments\", () => {\n  it(\"equal values put everything in prefix, nothing to emphasize\", () => {\n    expect(diffSegments(\"APAC\", \"APAC\")).toEqual({ prefix: \"APAC\", middle: \"\", suffix: \"\" });\n  });\n  it(\"suffix differs — APAC vs APAC-SOUTH\", () => {\n    expect(diffSegments(\"APAC-SOUTH\", \"APAC\")).toEqual({\n      prefix: \"APAC\", middle: \"-SOUTH\", suffix: \"\",\n    });\n  });\n  it(\"case-only difference — Acme Inc. vs ACME INC still highlights something\", () => {\n    const result = diffSegments(\"Acme Inc.\", \"ACME INC\");\n    expect(result.middle.length).toBeGreaterThan(0); // cosmetic conflicts must still light up\n  });\n  it(\"middle differs — ACC-4417 vs ACC-2201\", () => {\n    expect(diffSegments(\"ACC-4417\", \"ACC-2201\")).toEqual({\n      prefix: \"ACC-\", middle: \"4417\", suffix: \"\",\n    });\n  });\n  it(\"empty string vs non-empty (orphan side)\", () => {\n    expect(diffSegments(\"\", \"ACC-4417\")).toEqual({ prefix: \"\", middle: \"\", suffix: \"\" });\n  });\n  it(\"both empty\", () => {\n    expect(diffSegments(\"\", \"\")).toEqual({ prefix: \"\", middle: \"\", suffix: \"\" });\n  });\n  it(\"completely disjoint values\", () => {\n    expect(diffSegments(\"xyz\", \"abc\")).toEqual({ prefix: \"\", middle: \"xyz\", suffix: \"\" });\n  });\n  it(\"prefix/suffix overlap when one string is fully contained (e.g. 'aa' vs 'aaa')\", () => {\n    // Regression guard: prefix-walk and suffix-walk both use `max`, but do they\n    // correctly avoid double-counting overlapping characters for pathological\n    // short/long pairs?\n    expect(diffSegments(\"aaa\", \"aa\")).toEqual({ prefix: \"aa\", middle: \"a\", suffix: \"\" });\n  });\n  it(\"single-character values\", () => {\n    expect(diffSegments(\"A\", \"B\")).toEqual({ prefix: \"\", middle: \"A\", suffix: \"\" });\n  });\n});\n```\n\n",
        "level": 3
      },
      {
        "title": "2.3 `lib/validate-value.ts` — the `validate` guard, web side. Most important pure-function gap.",
        "content": "\n```ts\n// web/lib/validate-value.test.ts\nimport { describe, it, expect } from \"vitest\";\nimport { foldValue, checkObservedValue, observedValues, LEGAL_SUFFIXES } from \"@/lib/validate-value\";\n\ndescribe(\"foldValue\", () => {\n  it.each([\n    [\"Acme Inc.\", \"acme\"],\n    [\"ACME INC\", \"acme\"],\n    [\"  Acme   Corp  \", \"acme\"],\n    [\"O'Brien & Sons, LLC\", \"o brien sons\"],\n    [\"Trellis Labs Pvt Ltd\", \"trellis labs\"],   // two suffixes stripped, longest-first\n    [\"Ltd\", \"ltd\"],                              // whole value IS the suffix — not emptied\n    [\"\", \"\"],\n    [\"日本語 GmbH\", \"日本語\"],                    // unicode letters preserved (NFKD + \\p{L})\n  ])(\"folds %s to %s\", (input, expected) => {\n    expect(foldValue(input)).toBe(expected);\n  });\n\n  it(\"suffix stripping is greedy but bounded — does not loop forever on adversarial input\", () => {\n    const pathological = LEGAL_SUFFIXES.join(\" \").repeat(3);\n    expect(() => foldValue(pathological)).not.toThrow();\n  });\n});\n\ndescribe(\"checkObservedValue\", () => {\n  it(\"rejects an empty candidate\", () => {\n    expect(checkObservedValue(\"  \", [\"ACC-1\", \"ACC-2\"])).toEqual({\n      ok: false, reason: \"A value is required.\",\n    });\n  });\n\n  it(\"rejects when neither side has a value (orphan with no observed values)\", () => {\n    const result = checkObservedValue(\"anything\", [\"\", \"  \"]);\n    expect(result.ok).toBe(false);\n  });\n\n  it(\"accepts an exact match\", () => {\n    expect(checkObservedValue(\"ACC-4417\", [\"ACC-4417\", \"ACC-2201\"])).toEqual({\n      ok: true, matches: \"ACC-4417\",\n    });\n  });\n\n  it(\"accepts a legal normalization and returns the ORIGINAL observed casing, not the typed one\", () => {\n    // This is the subtle contract: `matches` must be the observed value, so the\n    // resolved hierarchy never stores a hand-typed variant.\n    const result = checkObservedValue(\"acme\", [\"Acme Inc.\", \"ACME INC\"]);\n    expect(result).toEqual({ ok: true, matches: \"Acme Inc.\" }); // first match wins\n  });\n\n  it(\"rejects an invented value not observed on either side — THE core guarantee\", () => {\n    const result = checkObservedValue(\"ACC-9999\", [\"ACC-4417\", \"ACC-2201\"]);\n    expect(result.ok).toBe(false);\n    expect(result.reason).toContain(\"ACC-4417\");\n    expect(result.reason).toContain(\"ACC-2201\");\n  });\n\n  it(\"rejects a substring/superstring of an observed value\", () => {\n    // Guards against a naive .includes() implementation slipping in later.\n    expect(checkObservedValue(\"ACC-441\", [\"ACC-4417\"]).ok).toBe(false);\n    expect(checkObservedValue(\"ACC-44177\", [\"ACC-4417\"]).ok).toBe(false);\n  });\n\n  it(\"trims whitespace on the candidate before comparing\", () => {\n    expect(checkObservedValue(\"  ACC-4417  \", [\"ACC-4417\"])).toEqual({\n      ok: true, matches: \"ACC-4417\",\n    });\n  });\n});\n\ndescribe(\"observedValues\", () => {\n  it(\"flattens both sides and drops blank entries\", () => {\n    expect(observedValues({ a: { values: [\"ACC-1\", \"\"] }, b: { values: [\"  \", \"ACC-2\"] } }))\n      .toEqual([\"ACC-1\", \"ACC-2\"]);\n  });\n  it(\"both sides empty (orphan-of-orphan, should not happen but must not crash)\", () => {\n    expect(observedValues({ a: { values: [] }, b: { values: [] } })).toEqual([]);\n  });\n});\n```\n\n**Cross-layer parity gap**: `LEGAL_SUFFIXES` here must stay byte-identical to `engine/pipeline/normalize.py::LEGAL_SUFFIXES`. Add a test that imports/hardcodes both lists and asserts equality (or generate one from the other) — right now nothing prevents them drifting.\n\n",
        "level": 3
      },
      {
        "title": "2.4 `lib/rule-trace.ts::deriveRuleTrace` — 4-branch derivation logic, 0 tests",
        "content": "\n```ts\n// web/lib/rule-trace.test.ts\nimport { describe, it, expect } from \"vitest\";\nimport { deriveRuleTrace } from \"@/lib/rule-trace\";\n// build a minimal QueueRow fixture per case\n\nit(\"no resolution yet → single classify node, not-yet-resolved\", () => {\n  const trace = deriveRuleTrace(rowWith({ resolution: null }));\n  expect(trace).toEqual([\n    { node: \"classify\", detail: expect.stringContaining(\"not yet resolved\"), ran: false },\n  ]);\n});\n\nit(\"rule decided → classify + apply ran, propose + validate reflect that\", () => {\n  const trace = deriveRuleTrace(rowWith({\n    resolution: { appliedRuleId: \"r1\", appliedRuleStrategy: \"most_recent\", proposedValue: \"APAC-SOUTH\", confidence: 0.91 },\n  }));\n  expect(trace.find(s => s.node === \"apply\")!.ran).toBe(true);\n  expect(trace.find(s => s.node === \"propose\")!.ran).toBe(false);\n  expect(trace.find(s => s.node === \"validate\")!.ran).toBe(true);\n});\n\nit(\"no rule matched, model proposed → propose ran, apply did not\", () => {\n  const trace = deriveRuleTrace(rowWith({\n    resolution: { appliedRuleId: null, proposedValue: \"APAC-SOUTH\", confidence: 0.91 },\n  }));\n  expect(trace.find(s => s.node === \"classify\")!.detail).toContain(\"no rule matched\");\n  expect(trace.find(s => s.node === \"apply\")!.ran).toBe(false);\n  expect(trace.find(s => s.node === \"propose\")!.ran).toBe(true);\n});\n\nit(\"no rule matched AND nothing proposed → escalated with no value, validate did not run\", () => {\n  const trace = deriveRuleTrace(rowWith({\n    resolution: { appliedRuleId: null, proposedValue: \"\", confidence: 0 },\n  }));\n  expect(trace.find(s => s.node === \"validate\")!.ran).toBe(false);\n  expect(trace.find(s => s.node === \"propose\")!.ran).toBe(false);\n});\n\nit(\"rule decided but produced no value (edge case: escalate strategy fired by classify)\", () => {\n  const trace = deriveRuleTrace(rowWith({\n    resolution: { appliedRuleId: \"r-escalate\", proposedValue: \"\", confidence: 0 },\n  }));\n  expect(trace.find(s => s.node === \"apply\")!.ran).toBe(false);\n});\n```\n\n",
        "level": 3
      },
      {
        "title": "2.5 `lib/audit-detail.ts` — 12+ conditional branches, 0 tests",
        "content": "\nThis function has real \"which of 10 optional keys are present\" combinatorics — high bug surface for a silent formatting regression.\n\n```ts\n// web/lib/audit-detail.test.ts\ndescribe(\"auditDetailParts\", () => {\n  it(\"run_started: no matching keys → empty array\", () => {\n    expect(auditDetailParts(entryWith({ action: \"run_started\", detail: {} }))).toEqual([]);\n  });\n\n  it(\"proposedValue and chosenValue differ → shows arrow\", () => {\n    const parts = auditDetailParts(entryWith({\n      detail: { proposedValue: \"ACC-4417\", chosenValue: \"ACC-2201\" },\n    }));\n    expect(parts).toContain(\"ACC-4417 → ACC-2201\");\n  });\n\n  it(\"proposedValue and chosenValue are equal → shows just the value, no arrow\", () => {\n    const parts = auditDetailParts(entryWith({\n      detail: { proposedValue: \"ACC-4417\", chosenValue: \"ACC-4417\" },\n    }));\n    expect(parts).toContain(\"ACC-4417\");\n    expect(parts.join(\" \")).not.toContain(\"→\");\n  });\n\n  it(\"only chosenValue present (a reject with no prior proposal) → shows chosenValue only\", () => {\n    expect(auditDetailParts(entryWith({ detail: { chosenValue: \"ACC-2201\" } })))\n      .toContain(\"ACC-2201\");\n  });\n\n  it(\"count uses the action-specific noun via COUNT_NOUN, falls back to bare number otherwise\", () => {\n    expect(auditDetailParts(entryWith({ action: \"conflict_detected\", detail: { count: 41 } })))\n      .toContain(\"41 conflicts\");\n    expect(auditDetailParts(entryWith({ action: \"run_started\", detail: { count: 41 } })))\n      .toContain(\"41\"); // no noun mapping for run_started\n  });\n\n  it(\"num() rejects non-finite values (NaN/Infinity) from malformed jsonb\", () => {\n    expect(auditDetailParts(entryWith({ detail: { confidence: NaN } })))\n      .not.toContain(expect.stringContaining(\"NaN\"));\n  });\n\n  it(\"str() rejects empty string and non-string types\", () => {\n    expect(auditDetailParts(entryWith({ detail: { field: \"\" } }))).not.toContain(\"\");\n    expect(auditDetailParts(entryWith({ detail: { field: 123 } })))\n      .not.toEqual(expect.arrayContaining([123]));\n  });\n\n  it(\"previousStatus renders with underscore replaced by hyphen\", () => {\n    expect(auditDetailParts(entryWith({ detail: { previousStatus: \"auto_applied\" } })))\n      .toContain(\"was auto-applied\");\n  });\n\n  it(\"note presence renders a marker, not the note text itself\", () => {\n    const parts = auditDetailParts(entryWith({ detail: { note: \"long sentence here\" } }));\n    expect(parts).toContain(\"note attached\");\n    expect(parts.join(\" \")).not.toContain(\"long sentence here\");\n  });\n\n  it(\"unrecognized keys in detail are silently ignored, not dumped\", () => {\n    const parts = auditDetailParts(entryWith({ detail: { someFutureKey: \"x\" } }));\n    expect(parts).toEqual([]);\n  });\n});\n\ndescribe(\"auditDetailLine / auditNote\", () => {\n  it(\"auditDetailLine joins with · and returns null when parts is empty\", () => {\n    expect(auditDetailLine(entryWith({ detail: {} }))).toBeNull();\n  });\n  it(\"auditNote returns the raw note, unlike auditDetailParts\", () => {\n    expect(auditNote(entryWith({ detail: { note: \"hello\" } }))).toBe(\"hello\");\n  });\n});\n```\n\n",
        "level": 3
      },
      {
        "title": "2.6 `lib/uuid.ts::isUuid` — used as a security/404 gate, 0 tests",
        "content": "\n```ts\ndescribe(\"isUuid\", () => {\n  it.each([\n    \"a41f0c9d-1234-5678-9abc-def012345678\",\n    \"A41F0C9D-1234-5678-9ABC-DEF012345678\", // case-insensitive\n  ])(\"accepts %s\", (v) => expect(isUuid(v)).toBe(true));\n\n  it.each([\n    \"banana\", \"\", \"12345\", \"a41f0c9d-1234-5678-9abc-def01234567\",   // one char short\n    \"a41f0c9d-1234-5678-9abc-def0123456789\", // one char long\n    \"a41f0c9d123456789abcdef012345678\",       // no hyphens\n    \"'; DROP TABLE runs;--\",                  // injection-shaped input must just be false, not throw\n  ])(\"rejects %s\", (v) => expect(isUuid(v)).toBe(false));\n});\n```\n\n",
        "level": 3
