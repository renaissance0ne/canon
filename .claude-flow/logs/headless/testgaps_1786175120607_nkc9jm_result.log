        "code": "// web/lib/server/conflicts.test.ts (integration, against a seeded test DB)\ndescribe(\"recordReview\", () => {\n  it(\"404s when conflictId does not exist\", async () => {\n    const result = await recordReview({ conflictId: randomUuid(), action: { action: \"approve\" }, reviewer });\n    expect(result).toEqual({ ok: false, code: 404, message: expect.any(String) });\n  });\n\n  it(\"409s when the conflict has no resolution yet (run still resolving)\", async () => {\n    const conflict = await seedConflict({ withResolution: false });\n    const result = await recordReview({ conflictId: conflict.id, action: { action: \"approve\" }, reviewer });\n    expect(result).toEqual({ ok: false, code: 409, message: expect.stringContaining(\"still resolving\") });\n  });\n\n  it(\"approving an escalated conflict with NO proposed value is rejected (409) — approving nothing is not a decision\", async () => {\n    const conflict = await seedConflict({ resolution: { proposedValue: \"\", status: \"escalated\" } });\n    const result = await recordReview({ conflictId: conflict.id, action: { action: \"approve\" }, reviewer });\n    expect(result).toEqual({ ok: false, code: 409, message: expect.stringContaining(\"Choose one of the two observed values\") });\n  });\n\n  it(\"approve sets status=approved, reviewedBy from session, does not touch proposedValue/rationale\", async () => {\n    const conflict = await seedConflict({ resolution: { proposedValue: \"APAC-SOUTH\", status: \"escalated\" } });\n    const result = await recordReview({ conflictId: conflict.id, action: { action: \"approve\" }, reviewer });\n    expect(result).toEqual({ ok: true, status: \"approved\" });\n    const row = await getResolution(conflict.resolutionId);\n    expect(row.proposedValue).toBe(\"APAC-SOUTH\");   // unchanged\n    expect(row.reviewedBy).toBe(reviewer.label);      // NOT client-supplied\n  });\n\n  it(\"override with a value not in the observed set is rejected (400), row untouched\", async () => {\n    const conflict = await seedConflict({ valueA: \"APAC-SOUTH\", valueB: \"APAC\", resolution: {} });\n    const before = await getResolution(conflict.resolutionId);\n    const result = await recordReview({\n      conflictId: conflict.id, action: { action: \"override\", overrideValue: \"ACC-9999\" }, reviewer,\n    });\n    expect(result.ok).toBe(false);\n    expect((result as any).code).toBe(400);\n    expect(await getResolution(conflict.resolutionId)).toEqual(before); // no partial write\n  });\n\n  it(\"override with a legal normalization stores the OBSERVED casing, not what was typed\", async () => {\n    const conflict = await seedConflict({ valueA: \"Acme Inc.\", valueB: \"ACME INC\", resolution: {} });\n    await recordReview({ conflictId: conflict.id, action: { action: \"override\", overrideValue: \"acme\" }, reviewer });\n    const row = await getResolution(conflict.resolutionId);\n    expect(row.overrideValue).toBe(\"Acme Inc.\"); // matches the first observed value, not \"acme\"\n  });\n\n  it(\"reject clears any prior overrideValue (moving off an override must not leave a stale chosen value)\", async () => {\n    const conflict = await seedConflict({ resolution: { status: \"overridden\", overrideValue: \"APAC-SOUTH\" } });\n    await recordReview({ conflictId: conflict.id, action: { action: \"reject\" }, reviewer });\n    const row = await getResolution(conflict.resolutionId);\n    expect(row.overrideValue).toBeNull();\n  });\n\n  it(\"every successful review appends exactly one audit_log row with previousStatus recorded\", async () => {\n    const conflict = await seedConflict({ resolution: { status: \"auto_applied\", proposedValue: \"APAC-SOUTH\" } });\n    await recordReview({ conflictId: conflict.id, action: { action: \"approve\" }, reviewer });\n    const audit = await listAuditForConflict(conflict.id);\n    expect(audit).toHaveLength(1);\n    expect(audit[0].action).toBe(\"human_approved\");\n    expect(audit[0].detail.previousStatus).toBe(\"auto_applied\");\n  });\n\n  it(\"reject records chosenValue as null in the audit detail (rejecting chooses nothing)\", async () => {\n    const conflict = await seedConflict({ resolution: { proposedValue: \"APAC-SOUTH\" } });\n    await recordReview({ conflictId: conflict.id, action: { action: \"reject\" }, reviewer });\n    const [entry] = await listAuditForConflict(conflict.id);\n    expect(entry.detail.chosenValue).toBeNull();\n  });\n\n  it(\"re-reviewing an already-approved conflict is allowed and appends a second audit row (revisits are not blocked)\", async () => {\n    const conflict = await seedConflict({ resolution: { status: \"approved\" } });\n    const result = await recordReview({ conflictId: conflict.id, action: { action: \"reject\" }, reviewer });\n    expect(result.ok).toBe(true);\n    expect(await listAuditForConflict(conflict.id)).toHaveLength(1); // this call\n  });\n});"
