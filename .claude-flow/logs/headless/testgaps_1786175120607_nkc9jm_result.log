\n  expect(trace.find(s => s.node === \"validate\")!.ran).toBe(true);\n});\n\nit(\"no rule matched, model proposed → propose ran, apply did not\", () => {\n  const trace = deriveRuleTrace(rowWith({\n    resolution: { appliedRuleId: null, proposedValue: \"APAC-SOUTH\", confidence: 0.91 },\n  }));\n  expect(trace.find(s => s.node === \"classify\")!.detail).toContain(\"no rule matched\");\n  expect(trace.find(s => s.node === \"apply\")!.ran).toBe(false);\n  expect(trace.find(s => s.node === \"propose\")!.ran).toBe(true);\n});\n\nit(\"no rule matched AND nothing proposed → escalated with no value, validate did not run\", () => {\n  const trace = deriveRuleTrace(rowWith({\n    resolution: { appliedRuleId: null, proposedValue: \"\", confidence: 0 },\n  }));\n  expect(trace.find(s => s.node === \"validate\")!.ran).toBe(false);\n  expect(trace.find(s => s.node === \"propose\")!.ran).toBe(false);\n});\n\nit(\"rule decided but produced no value (edge case: escalate strategy fired by classify)\", () => {\n  const trace = deriveRuleTrace(rowWith({\n    resolution: { appliedRuleId: \"r-escalate\", proposedValue: \"\", confidence: 0 },\n  }));\n  expect(trace.find(s => s.node === \"apply\")!.ran).toBe(false);\n});\n```\n\n### 2.5 `lib/audit-detail.ts` — 12+ conditional branches, 0 tests\n\nThis function has real \"which of 10 optional keys are present\" combinatorics — high bug surface for a silent formatting regression.\n\n```ts\n// web/lib/audit-detail.test.ts\ndescribe(\"auditDetailParts\", () => {\n  it(\"run_started: no matching keys → empty array\", () => {\n    expect(auditDetailParts(entryWith({ action: \"run_started\", detail: {} }))).toEqual([]);\n  });\n\n  it(\"proposedValue and chosenValue differ → shows arrow\", () => {\n    const parts = auditDetailParts(entryWith({\n      detail: { proposedValue: \"ACC-4417\", chosenValue: \"ACC-2201\" },\n    }));\n    expect(parts).toContain(\"ACC-4417 → ACC-2201\");\n  });\n\n  it(\"proposedValue and chosenValue are equal → shows just the value, no arrow\", () => {\n    const parts = auditDetailParts(entryWith({\n      detail: { proposedValue: \"ACC-4417\", chosenValue: \"ACC-4417\" },\n    }));\n    expect(parts).toContain(\"ACC-4417\");\n    expect(parts.join(\" \")).not.toContain(\"→\");\n  });\n\n  it(\"only chosenValue present (a reject with no prior proposal) → shows chosenValue only\", () => {\n    expect(auditDetailParts(entryWith({ detail: { chosenValue: \"ACC-2201\" } })))\n      .toContain(\"ACC-2201\");\n  });\n\n  it(\"count uses the action-specific noun via COUNT_NOUN, falls back to bare number otherwise\", () => {\n    expect(auditDetailParts(entryWith({ action: \"conflict_detected\", detail: { count: 41 } })))\n      .toContain(\"41 conflicts\");\n    expect(auditDetailParts(entryWith({ action: \"run_started\", detail: { count: 41 } })))\n      .toContain(\"41\"); // no noun mapping for run_started\n  });\n\n  it(\"num() rejects non-finite values (NaN/Infinity) from malformed jsonb\", () => {\n    expect(auditDetailParts(entryWith({ detail: { confidence: NaN } })))\n      .not.toContain(expect.stringContaining(\"NaN\"));\n  });\n\n  it(\"str() rejects empty string and non-string types\", () => {\n    expect(auditDetailParts(entryWith({ detail: { field: \"\" } }))).not.toContain(\"\");\n    expect(auditDetailParts(entryWith({ detail: { field: 123 } })))\n      .not.toEqual(expect.arrayContaining([123]));\n  });\n\n  it(\"previousStatus renders with underscore replaced by hyphen\", () => {\n    expect(auditDetailParts(entryWith({ detail: { previousStatus: \"auto_applied\" } })))\n      .toContain(\"was auto-applied\");\n  });\n\n  it(\"note presence renders a marker, not the note text itself\", () => {\n    const parts = auditDetailParts(entryWith({ detail: { note: \"long sentence here\" } }));\n    expect(parts).toContain(\"note attached\");\n    expect(parts.join(\" \")).not.toContain(\"long sentence here\");\n  });\n\n  it(\"unrecognized keys in detail are silently ignored, not dumped\", () => {\n    const parts = auditDetailParts(entryWith({ detail: { someFutureKey: \"x\" } }));\n    expect(parts).toEqual([]);\n  });\n});\n\ndescribe(\"auditDetailLine / auditNote\", () => {\n  it(\"auditDetailLine joins with · and returns null when parts is empty\", () => {\n    expect(auditDetailLine(entryWith({ detail: {} }))).toBeNull();\n  });\n  it(\"auditNote returns the raw note, unlike auditDetailParts\", () => {\n    expect(auditNote(entryWith({ detail: { note: \"hello\" } }))).toBe(\"hello\");\n  });\n});\n```\n\n### 2.6 `lib/uuid.ts::isUuid` — used as a security/404 gate, 0 tests\n\n```ts\ndescribe(\"isUuid\", () => {\n  it.each([\n    \"a41f0c9d-1234-5678-9abc-def012345678\",\n    \"A41F0C9D-1234-5678-9ABC-DEF012345678\", // case-insensitive\n  ])(\"accepts %s\", (v) => expect(isUuid(v)).toBe(true));\n\n  it.each([\n    \"banana\", \"\", \"12345\", \"a41f0c9d-1234-5678-9abc-def01234567\",   // one char short\n    \"a41f0c9d-1234-5678-9abc-def0123456789\", // one char long\n    \"a41f0c9d123456789abcdef012345678\",       // no hyphens\n    \"'; DROP TABLE runs;--\",                  // injection-shaped input must just be false, not throw\n  ])(\"rejects %s\", (v) => expect(isUuid(v)).toBe(false));\n});\n```\n\n### 2.7 `lib/reviewer-label.ts` and `lib/api-client.ts` — 0 tests\n\n```ts\ndescribe(\"reviewerLabel\", () => {\n  it(\"prefers username over email\", () => {\n    expect(reviewerLabel({ username: \"j.rao\", primaryEmailAddress: { emailAddress: \"j@x.com\" } }, \"fallback\")).toBe(\"j.rao\");\n  });\n  it(\"falls back to email when username is null\", () => {\n    expect(reviewerLabel({ username: null, primaryEmailAddress: { emailAddress: \"j@x.com\" } }, \"fallback\")).toBe(\"j@x.com\");\n  });\n  it(\"falls back to the provided fallback when user is null\", () => {\n    expect(reviewerLabel(null, \"user_123\")).toBe(\"user_123\");\n  });\n  it(\"falls back when username is empty string (falsy but not null)\", () => {\n    // `??` doesn't catch \"\" — this could be a real bug if Clerk ever returns \"\".\n    expect(reviewerLabel({ username: \"\", primaryEmailAddress: null }, \"fallback\")).toBe(\"\");\n  });\n});\n\ndescribe(\"postJson / patchJson\", () => {\n  // mock global.fetch per case\n  it(\"returns ok:true with parsed data on 2xx\", async () => { /* ... */ });\n  it(\"returns ok:false with server-provided error message on 4xx\", async () => { /* ... */ });\n  it(\"falls back to 'Request failed (N)' when error body has no `error` field\", async () => { /* ... */ });\n  it(\"returns issues map when the 400 body includes field-level issues\", async () => { /* ... */ });\n  it(\"network failure (fetch throws) → friendly ok:false message, does not throw\", async () => {\n    global.fetch = vi.fn().mockRejectedValue(new TypeError(\"network error\"));\n    const result = await postJson(\"/api/runs\", {});\n    expect(result).toEqual({ ok: false, message: expect.stringContaining(\"reach the server\") });\n  });\n  it(\"non-JSON response body → payload becomes null, does not throw\", async () => {\n    global.fetch = vi.fn().mockResolvedValue({ ok: true, json: () => Promise.reject(\"not json\") } as any);\n    await expect(postJson(\"/api/runs\", {})).resolves.toEqual({ ok: true, data: null });\n  });\n});\n```\n\n### 2.8 `types/run.ts` — 5 derived-state functions, 0 tests\n\n```ts\n// web/types/run.test.ts\ndescribe(\"isTerminalRunStatus\", () => {\n  it.each([\"complete\", \"failed\"])(\"%s is terminal\", (s) => expect(isTerminalRunStatus(s as any)).toBe(true));\n  it.each([\"queued\", \"extracting\", \"matching\", \"detecting\", \"resolving\"])(\n    \"%s is not terminal\", (s) => expect(isTerminalRunStatus(s as any)).toBe(false));\n});\n\ndescribe(\"runStageIndex\", () => {\n  it(\"failed is not in RUN_STAGES and returns -1\", () => {\n    expect(runStageIndex(\"failed\")).toBe(-1);\n  });\n  it(\"stages are in ascending pipeline order\", () => {\n    expect(runStageIndex(\"queued\")).toBeLessThan(runStageIndex(\"resolving\"));\n  });\n});\n\ndescribe(\"isStatKnown\", () => {\n  it(\"stat from a later stage is unknown while an earlier stage is current\", () => {\n    expect(isStatKnown(\"conflicts\", \"matching\")).toBe(false); // conflicts comes from detecting\n  });\n  it(\"stat is known once its producing stage is behind current\", () => {\n    expect(isStatKnown(\"entitiesA\", \"matching\")).toBe(true); // entitiesA from extracting\n  });\n  it(\"stat is known exactly at boundary — its own producing stage does NOT yet count as known\", () => {\n    // runStageIndex(current) > runStageIndex(producer), strictly greater\n    expect(isStatKnown(\"matches\", \"matching\")).toBe(false);\n  });\n  it(\"complete run: every stat is known regardless of STAT_PRODUCED_BY\", () => {\n    expect(isStatKnown(\"tokensUsed\", \"complete\")).toBe(true);\n  });\n  it(\"failed run: every stat is known (shows partial progress rather than blanking)\", () => {\n    expect(isStatKnown(\"escalated\", \"failed\")).toBe(true);\n  });\n});\n\ndescribe(\"failedStage\", () => {\n  it(\"extracts stage from the engine's stage= convention\", () => {\n    expect(failedStage(\"source=Databricks GTM stage=extract\")).toBe(\"extracting\");\n  });\n  it(\"null error → null stage\", () => {\n    expect(failedStage(null)).toBeNull();\n  });\n  it(\"error string with no stage= marker → null, not a guess\", () => {\n    expect(failedStage(\"Connection refused\")).toBeNull();\n  });\n  it(\"unrecognized verb after stage= → null (byVerb has no fallback)\", () => {\n    expect(failedStage(\"stage=unknown_verb\")).toBeNull();\n  });\n  it(\"case-insensitive stage verb\", () => {\n    expect(failedStage(\"stage=EXTRACT\")).toBe(\"extracting\");\n  });\n  it(\"EngineDispatch convention (dispatch → queued)\", () => {\n    expect(failedStage(\"EngineDispatch: timeout\\nstage=dispatch\")).toBe(\"queued\");\n  });\n});\n```\n\n### 2.9 `types/queue.ts` — `conflictFieldLabel`, `severityReason`, `queueQuerySchema`\n\n```ts\ndescribe(\"conflictFieldLabel\", () => {\n  it(\"orphan → 'entity absent' regardless of field name\", () => {\n    expect(conflictFieldLabel({ field: \"territory\", conflictClass: \"orphan\", a: {values:[],present:false}, b: {values:[],present:true} }))\n      .toBe(\"entity absent\");\n  });\n  it(\"duplicate with 2→1 → '2 → 1'\", () => {\n    expect(conflictFieldLabel({ field: \"x\", conflictClass: \"duplicate\",\n      a: { values: [\"r1\", \"r2\"], present: true }, b: { values: [\"r3\"], present: true } }))\n      .toBe(\"2 → 1\");\n  });\n  it(\"duplicate where 'to' side is 0 → falls back to 'duplicate record'\", () => {\n    // from>to but to===0 — the guard `to > 0` matters here\n    expect(conflictFieldLabel({ field: \"x\", conflictClass: \"duplicate\",\n      a: { values: [\"r1\",\"r2\"], present: true }, b: { values: [], present: false } }))\n      .toBe(\"duplicate record\");\n  });\n  it(\"attribute/structural/cosmetic → the field name itself\", () => {\n    expect(conflictFieldLabel({ field: \"territory\", conflictClass: \"attribute\",\n      a: { values: [\"APAC\"], present: true }, b: { values: [\"EMEA\"], present: true } }))\n      .toBe(\"territory\");\n  });\n});\n\ndescribe(\"severityReason\", () => {\n  it(\"orphan with children pluralizes correctly at exactly 1\", () => {\n    expect(severityReason({ conflictClass: \"orphan\", severity: 3, childCount: 1 }))\n      .toContain(\"1 child\");\n    expect(severityReason({ conflictClass: \"orphan\", severity: 4, childCount: 2 }))\n      .toContain(\"2 children\");\n  });\n  it(\"attribute severity 3 vs 2 give different reasons (ownership vs non-rollup)\", () => {\n    expect(severityReason({ conflictClass: \"attribute\", severity: 3, childCount: 0 }))\n      .toContain(\"owns or is credited\");\n    expect(severityReason({ conflictClass: \"attribute\", severity: 2, childCount: 0 }))\n      .toContain(\"non-rollup\");\n  });\n});\n\ndescribe(\"queueQuerySchema\", () => {\n  it(\"severities '4,3' parses to [4,3]\", () => {\n    expect(queueQuerySchema.parse({ severities: \"4,3\" }).severities).toEqual([4, 3]);\n  });\n  it(\"severities with an out-of-range number silently drops it, doesn't throw\", () => {\n    expect(queueQuerySchema.parse({ severities: \"4,9,abc\" }).severities).toEqual([4]);\n  });\n  it(\"severities omitted → empty array, not undefined\", () => {\n    expect(queueQuerySchema.parse({}).severities).toEqual([]);\n  });\n  it(\"status defaults to 'escalated'\", () => {\n    expect(queueQuerySchema.parse({}).status).toBe(\"escalated\");\n  });\n  it(\"page coerces string '2' to number 2, rejects 0\", () => {\n    expect(queueQuerySchema.parse({ page: \"2\" }).page).toBe(2);\n    expect(queueQuerySchema.safeParse({ page: \"0\" }).success).toBe(false);\n  });\n  it(\"invalid runId (not a uuid) fails validation\", () => {\n    expect(queueQuerySchema.safeParse({ runId: \"not-a-uuid\" }).success).toBe(false);\n  });\n});\n```\n\n### 2.10 `types/resolution.ts::isHumanDecided` + `reviewActionSchema`\n\n```ts\nit.each([\"approved\", \"rejected\", \"overridden\"])(\"%s is human-decided\", (s) =>\n  expect(isHumanDecided(s as any)).toBe(true));\nit.each([\"proposed\", \"auto_applied\", \"escalated\"])(\"%s is not human-decided\", (s) =>\n  expect(isHumanDecided(s as any)).toBe(false));\n\ndescribe(\"reviewActionSchema\", () => {\n  it(\"override requires overrideValue min length 1\", () => {\n    expect(reviewActionSchema.safeParse({ action: \"override\", overrideValue: \"\" }).success).toBe(false);\n  });\n  it(\"approve/reject do not require or accept overrideValue as a schema field\", () => {\n    expect(reviewActionSchema.parse({ action: \"approve\" })).toEqual({ action: \"approve\" });\n  });\n  it(\"note over 500 chars is rejected\", () => {\n    expect(reviewActionSchema.safeParse({ action: \"approve\", note: \"x\".repeat(501) }).success).toBe(false);\n  });\n  it(\"rejects an unknown action literal\", () => {\n    expect(reviewActionSchema.safeParse({ action: \"delete\" }).success).toBe(false);\n  });\n  it(\"reviewedBy in the body is silently stripped/ignored, never trusted\", () => {\n    // Zod strict-ish behavior check — confirms client can't inject an actor.\n    const parsed = reviewActionSchema.safeParse({ action: \"approve\", reviewedBy: \"attacker\" });\n    expect(parsed.success && \"reviewedBy\" in parsed.data).toBe(false);\n  });\n});\n```\n\n---\n\n## 3. `web/lib/server/` — DB-touching business logic (integration tests, need a DB)\n\nThese are the highest-risk untested code in the repo: real state transitions, audit-trail invariants, money-shot business rules. They need either a real Postgres test database (Testcontainers / a Supabase branch) or a mocked Drizzle client. Given `.env`/Supabase are already in play, recommend a disposable test schema over mocking Drizzle's query builder (mocking it tends to just re-test the mock).\n\n### 3.1 `lib/server/conflicts.ts::recordReview` — **the most important untested function in the codebase**\n\nThis is the human-review write path — the one place a wrong test gap becomes a wrong audit-trail entry.\n\n```ts\n// web/lib/server/conflicts.test.ts (integration, against a seeded test DB)\ndescribe(\"recordReview\", () => {\n  it(\"404s when conflictId does not exist\", async () => {\n    const result = await recordReview({ conflictId: randomUuid(), action: { action: \"approve\" }, reviewer });\n    expect(result).toEqual({ ok: false, code: 404, message: expect.any(String) });\n  });\n\n  it(\"409s when the conflict has no resolution yet (run still resolving)\", async () => {\n    const conflict = await seedConflict({ withResolution: false });\n    const result = await recordReview({ conflictId: conflict.id, action: { action: \"approve\" }, reviewer });\n    expect(result).toEqual({ ok: false, code: 409, message: expect.stringContaining(\"still resolving\") });\n  });\n\n  it(\"approving an escalated conflict with NO proposed value is rejected (409) — approving nothing is not a decision\", async () => {\n    const conflict = await seedConflict({ resolution: { proposedValue: \"\", status: \"escalated\" } });\n    const result = await recordReview({ conflictId: conflict.id, action: { action: \"approve\" }, reviewer });\n    expect(result).toEqual({ ok: false, code: 409, message: expect.stringContaining(\"Choose one of the two observed values\") });\n  });\n\n  it(\"approve sets status=approved, reviewedBy from session, does not touch proposedValue/rationale\", async () => {\n    const conflict = await seedConflict({ resolution: { proposedValue: \"APAC-SOUTH\", status: \"escalated\" } });\n    const result = await recordReview({ conflictId: conflict.id, action: { action: \"approve\" }, reviewer });\n    expect(result).toEqual({ ok: true, status: \"approved\" });\n    const row = await getResolution(conflict.resolutionId);\n    expect(row.proposedValue).toBe(\"APAC-SOUTH\");   // unchanged\n    expect(row.reviewedBy).toBe(reviewer.label);      // NOT client-supplied\n  });\n\n  it(\"override with a value not in the observed set is rejected (400), row untouched\", async () => {\n    const conflict = await seedConflict({ valueA: \"APAC-SOUTH\", valueB: \"APAC\", resolution: {} });\n    const before = await getResolution(conflict.resolutionId);\n    const result = await recordReview({\n      conflictId: conflict.id, action: { action: \"override\", overrideValue: \"ACC-9999\" }, reviewer,\n    });\n    expect(result.ok).toBe(false);\n    expect((result as any).code).toBe(400);\n    expect(await getResolution(conflict.resolutionId)).toEqual(before); // no partial write\n  });\n\n  it(\"override with a legal normalization stores the OBSERVED casing, not what was typed\", async () => {\n    const conflict = await seedConflict({ valueA: \"Acme Inc.\", valueB: \"ACME INC\", resolution: {} });\n    await recordReview({ conflictId: conflict.id, action: { action: \"override\", overrideValue: \"acme\" }, reviewer });\n    const row = await getResolution(conflict.resolutionId);\n    expect(row.overrideValue).toBe(\"Acme Inc.\"); // matches the first observed value, not \"acme\"\n  });\n\n  it(\"reject clears any prior overrideValue (moving off an override must not leave a stale chosen value)\", async () => {\n    const conflict = await seedConflict({ resolution: { status: \"overridden\", overrideValue: \"APAC-SOUTH\" } });\n    await recordReview({ conflictId: conflict.id, action: { action: \"reject\" }, reviewer });\n    const row = await getResolution(conflict.resolutionId);\n    expect(row.overrideValue).toBeNull();\n  });\n\n  it(\"every successful review appends exactly one audit_log row with previousStatus recorded\", async () => {\n    const conflict = await seedConflict({ resolution: { status: \"auto_applied\", proposedValue: \"APAC-SOUTH\" } });\n    await recordReview({ conflictId: conflict.id, action: { action: \"approve\" }, reviewer });\n    const audit = await listAuditForConflict(conflict.id);\n    expect(audit).toHaveLength(1);\n    expect(audit[0].action).toBe(\"human_approved\");\n    expect(audit[0].detail.previousStatus).toBe(\"auto_applied\");\n  });\n\n  it(\"reject records chosenValue as null in the audit detail (rejecting chooses nothing)\", async () => {\n    const conflict = await seedConflict({ resolution: { proposedValue: \"APAC-SOUTH\" } });\n    await recordReview({ conflictId: conflict.id, action: { action: \"reject\" }, reviewer });\n    const [entry] = await listAuditForConflict(conflict.id);\n    expect(entry.detail.chosenValue).toBeNull();\n  });\n\n  it(\"re-reviewing an already-approved conflict is allowed and appends a second audit row (revisits are not blocked)\", async () => {\n    const conflict = await seedConflict({ resolution: { status: \"approved\" } });\n    const result = await recordReview({ conflictId: conflict.id, action: { action: \"reject\" }, reviewer });\n    expect(result.ok).toBe(true);\n    expect(await listAuditForConflict(conflict.id)).toHaveLength(1); // this call\n  });\n});\n```\n\n### 3.2 `lib/server/conflicts.ts::toQueueRow` (private, test via `getQueuePage`) — orphan/duplicate presence logic\n\n```ts\nit(\"orphan present only on side B: side A reads present:false, identity comes from B\", async () => {\n  const run = await seedRunWithOrphan({ presentOn: \"b\" });\n  const page = await getQueuePage(defaultQuery(run.id), run, []);\n  const row = page.rows[0];\n  expect(row.a.present).toBe(false);\n  expect(row.externalId).toBe(row.b.externalId); // identity follows the present side\n});\n\nit(\"valueA with multiple newline-separated values (duplicate) splits into an array, trims blank lines\", async () => {\n  // conflicts.valueA = \"REC-1\\n REC-2 \\n\\n\"\n  const row = /* seeded duplicate conflict */;\n  expect(row.a.values).toEqual([\"REC-1\", \"REC-2\"]);\n});\n\nit(\"a conflict whose entity belongs to neither run source renders 'unknown source' rather than mislabeling\", async () => {\n  // Simulates an engine bug (cross-run contamination) — must not silently mislabel.\n});\n```\n\n### 3.3 `lib/server/export.ts::decisionsToCsv` / `csvCell` — CSV injection & escaping, 0 tests\n\n```ts\ndescribe(\"csvCell / decisionsToCsv\", () => {\n  it(\"null becomes empty string\", () => {\n    expect(decisionsToCsv([decisionWith({ rationale: null })])).toContain(\",,\"); // adjacent empty cells\n  });\n  it(\"a value containing a comma is quoted\", () => {\n    const csv = decisionsToCsv([decisionWith({ entityName: \"Acme, Inc.\" })]);\n    expect(csv).toContain('\"Acme, Inc.\"');\n  });\n  it(\"a value containing a double quote is escaped by doubling\", () => {\n    const csv = decisionsToCsv([decisionWith({ rationale: 'Applied \"most_recent\" strategy' })]);\n    expect(csv).toContain('\"\"most_recent\"\"');\n  });\n  it(\"a value containing CRLF is quoted so it doesn't create a phantom row\", () => {\n    const csv = decisionsToCsv([decisionWith({ rationale: \"line one\\r\\nline two\" })]);\n    const rows = csv.trim().split(\"\\r\\n\");\n    expect(rows).toHaveLength(2); // header + 1 data row, not 3\n  });\n  it(\"a rationale beginning with = / + / - / @ is NOT neutralized — CSV/formula-injection risk\", () => {\n    // Opening a decisions export in Excel with a rationale like `=cmd|'/c calc'!A1`\n    // is a known CSV-injection vector. Current csvCell only escapes quotes/commas/\n    // newlines, not leading formula characters. Flagging as a real gap, not just\n    // a missing test — recommend prefixing a leading `'` or a space when the cell\n    // starts with =, +, -, or @, since `rationale` and `entityName` both\n    // originate from source-system data or model output, not from a trusted operator.\n    const csv = decisionsToCsv([decisionWith({ rationale: \"=SUM(A1:A10)\" })]);\n    expect(csv).not.toMatch(/,=SUM/); // documents current (risky) behavior; should fail once fixed\n  });\n  it(\"trailing CRLF present on the whole file, even with zero rows\", () => {\n    expect(decisionsToCsv([])).toBe(\"conflictId,externalId,...\\r\\n\");\n  });\n});\n```\n\n**Flagging the formula-injection case as a real (low-severity, since it's an internal export not shared broadly) finding**, not just a test gap — worth a one-line fix in `csvCell` when convenient.\n\n### 3.4 `lib/server/export.ts::applyDecisions` — hierarchy reconstruction\n\n```ts\nit(\"account with a resolved parentExternalId conflict gets reparented\", () => {\n  const accounts = [{ externalId: \"ACC-1\", fields: { name: \"X\" }, parentExternalId: \"OLD\" }];\n  const decisions = [decisionWith({ externalId: \"ACC-1\", field: \"parentExternalId\", appliedValue: \"NEW\" })];\n  expect(applyDecisions(accounts, decisions)).toEqual([\n    { externalId: \"ACC-1\", name: \"X\", parentExternalId: \"NEW\", reparented: true },\n  ]);\n});\n\nit(\"resolved value equal to the original parent → reparented:false (no-op override)\", () => {\n  const accounts = [{ externalId: \"ACC-1\", fields: { name: \"X\" }, parentExternalId: \"SAME\" }];\n  const decisions = [decisionWith({ externalId: \"ACC-1\", field: \"parentExternalId\", appliedValue: \"SAME\" })];\n  expect(applyDecisions(accounts, decisions)[0].reparented).toBe(false);\n});\n\nit(\"decision on a non-parentExternalId field does not affect hierarchy\", () => {\n  const accounts = [{ externalId: \"ACC-1\", fields: { name: \"X\" }, parentExternalId: \"OLD\" }];\n  const decisions = [decisionWith({ externalId: \"ACC-1\", field: \"territory\", appliedValue: \"APAC\" })];\n  expect(applyDecisions(accounts, decisions)[0].parentExternalId).toBe(\"OLD\");\n});\n\nit(\"decision with appliedValue null (escalated, never applied) leaves original parent standing\", () => {\n  const accounts = [{ externalId: \"ACC-1\", fields: { name: \"X\" }, parentExternalId: \"OLD\" }];\n  const decisions = [decisionWith({ externalId: \"ACC-1\", field: \"parentExternalId\", appliedValue: null })];\n  expect(applyDecisions(accounts, decisions)[0]).toEqual(\n    expect.objectContaining({ parentExternalId: \"OLD\", reparented: false }),\n  );\n});\n```\n\n### 3.5 `lib/server/rulesets.ts::createRulesetVersion` — concurrency-critical, integration only\n\n```ts\nit(\"first save of a new name starts at version 1 and is active\", async () => {\n  const rs = await createRulesetVersion({ name: \"Default\", rules: [] });\n  expect(rs.version).toBe(1);\n  expect(rs.isActive).toBe(true);\n});\n\nit(\"second save of the same name increments version and deactivates the previous one\", async () => {\n  await createRulesetVersion({ name: \"Default\", rules: [] });\n  const v2 = await createRulesetVersion({ name: \"Default\", rules: [] });\n  expect(v2.version).toBe(2);\n  const v1 = await getRulesetByNameVersion(\"Default\", 1);\n  expect(v1!.isActive).toBe(false);\n});\n\nit(\"only one ruleset is active system-wide, even across different names\", async () => {\n  await createRulesetVersion({ name: \"Policy A\", rules: [] });\n  await createRulesetVersion({ name: \"Policy B\", rules: [] });\n  const active = await listActiveRulesets();\n  expect(active).toHaveLength(1);\n});\n\nit(\"concurrent saves of the same name never produce two rows with the same version — THE reason for the advisory lock\", async () => {\n  const [a, b] = await Promise.all([\n    createRulesetVersion({ name: \"Default\", rules: [] }),\n    createRulesetVersion({ name: \"Default\", rules: [] }),\n  ]);\n  expect(new Set([a.version, b.version]).size).toBe(2); // not both version 1\n});\n\nit(\"a run citing an older ruleset version still reads that version's rules after a newer save\", async () => {\n  const v1 = await createRulesetVersion({ name: \"Default\", rules: [{ id: \"r1\", field: \"*\", entityType: \"*\", strategy: \"escalate\", description: \"d\" }] });\n  await createRulesetVersion({ name: \"Default\", rules: [] }); // v2, different rules\n  expect(await getRuleset(v1.id)).toEqual(expect.objectContaining({ version: 1, rules: expect.arrayContaining([expect.objectContaining({ id: \"r1\" })]) }));\n});\n```\n\n### 3.6 `lib/server/engine.ts::startRun` / `fetchEngineStatus` — network edge cases, 0 tests\n\n```ts\ndescribe(\"startRun\", () => {\n  it(\"throws EngineUnreachableError when ENGINE_URL is unset\", async () => {\n    delete process.env.ENGINE_URL;\n    await expect(startRun(runId)).rejects.toThrow(EngineUnreachableError);\n  });\n  it(\"throws with a timeout-specific message when the engine hangs past DISPATCH_TIMEOUT_MS\", async () => {\n    mockFetchToHang();\n    await expect(startRun(runId)).rejects.toThrow(/no response within 8s/);\n  });\n  it(\"throws when the engine returns non-2xx, including the response body (truncated)\", async () => {\n    mockFetch({ ok: false, status: 500, text: () => Promise.resolve(\"x\".repeat(1000)) });\n    await expect(startRun(runId)).rejects.toThrow(/500/);\n  });\n  it(\"throws a contract-break error when the engine returns 200 with an unexpected shape\", async () => {\n    mockFetch({ ok: true, json: () => Promise.resolve({ wrong: \"shape\" }) });\n    await expect(startRun(runId)).rejects.toThrow(/tool contract/);\n  });\n  it(\"succeeds silently (no return value) on a well-formed 200\", async () => {\n    mockFetch({ ok: true, json: () => Promise.resolve({ runId, accepted: true }) });\n    await expect(startRun(runId)).resolves.toBeUndefined();\n  });\n});\n\ndescribe(\"fetchEngineStatus\", () => {\n  it(\"returns null (not a throw) on any network failure — polling must degrade gracefully\", async () => {\n    mockFetchToThrow(new TypeError(\"fetch failed\"));\n    expect(await fetchEngineStatus(runId)).toBeNull();\n  });\n  it(\"returns null on non-2xx\", async () => { /* ... */ });\n  it(\"returns null on a malformed body rather than throwing on .parse()\", async () => {\n    mockFetch({ ok: true, json: () => Promise.resolve({ garbage: true }) });\n    expect(await fetchEngineStatus(runId)).toBeNull();\n  });\n  it(\"returns the parsed status on success\", async () => { /* ... */ });\n});\n```\n\n---\n\n## 4. Integration test gaps — API route handlers\n\nNone of the seven route handlers have request-level tests (Next.js route handlers can be unit-tested directly by calling `GET`/`POST` with a constructed `Request`, no server needed).\n\n```ts\n// web/app/api/runs/route.test.ts\ndescribe(\"POST /api/runs\", () => {\n  it(\"400s when sourceAId === sourceBId — self-reconciliation is meaningless\", async () => {\n    const req = jsonRequest({ sourceAId: sameId, sourceBId: sameId, rulesetId: validRulesetId });\n    const res = await POST(req);\n    expect(res.status).toBe(400);\n    expect((await res.json()).error).toContain(\"different systems\");\n  });\n\n  it(\"400s with a specific message when sourceAId has been deleted since page load\", async () => {\n    const req = jsonRequest({ sourceAId: deletedId, sourceBId: validId, rulesetId: validRulesetId });\n    expect((await (await POST(req)).json()).error).toBe(\"Source A no longer exists.\");\n  });\n\n  it(\"400s on malformed JSON body\", async () => {\n    const req = new Request(\"http://x/api/runs\", { method: \"POST\", body: \"not json\" });\n    expect((await POST(req)).status).toBe(400);\n  });\n\n  it(\"Zod validation failure returns field-addressable issues\", async () => {\n    const req = jsonRequest({ sourceAId: \"not-a-uuid\" });\n    const body = await (await POST(req)).json();\n    expect(body.issues).toHaveProperty(\"sourceAId\");\n  });\n\n  it(\"engine unreachable: run row is still created (201), marked failed with stage=dispatch, audit row appended\", async () => {\n    mockEngineUnreachable();\n    const req = jsonRequest(validBody);\n    const res = await POST(req);\n    expect(res.status).toBe(201); // run exists even though dispatch failed\n    const { runId } = await res.json();\n    expect((await getRun(runId))!.status).toBe(\"failed\");\n    expect((await getRun(runId))!.error).toContain(\"stage=dispatch\");\n  });\n\n  it(\"happy path: 201, run row created, engine dispatched, run_started audit row with ruleset name+version\", async () => { /* ... */ });\n});\n\n// web/app/api/conflicts/[conflictId]/resolution/route.test.ts\ndescribe(\"PATCH /api/conflicts/:conflictId/resolution\", () => {\n  it(\"malformed conflictId (not a UUID) → 404 before touching the DB\", async () => {\n    const res = await PATCH(jsonRequest({ action: \"approve\" }), ctxWith(\"not-a-uuid\"));\n    expect(res.status).toBe(404);\n  });\n  it(\"propagates recordReview's 409/400/404 codes and messages verbatim\", async () => { /* ... */ });\n  it(\"response includes reviewedBy from the session, not from the request\", async () => { /* ... */ });\n});\n\n// web/app/api/runs/[runId]/export/route.test.ts\ndescribe(\"GET /api/runs/:runId/export\", () => {\n  it(\"format=xml (unsupported) → 400\", async () => { /* ... */ });\n  it(\"sections=hierarchy,bogus → 400, does not partially export\", async () => { /* ... */ });\n  it(\"sections repeated/out of order still produces canonical-order output (byte-identical for same set)\", async () => {\n    const a = await GET(reqWith(\"?sections=decisions,hierarchy\"), ctx);\n    const b = await GET(reqWith(\"?sections=hierarchy,decisions\"), ctx);\n    expect(await a.text()).toBe(await b.text());\n  });\n  it(\"format=csv ignores sections other than decisions and sets content-disposition filename\", async () => { /* ... */ });\n  it(\"runId not found → 404\", async () => { /* ... */ });\n  it(\"json export sets cache-control:no-store (exports must never be cached)\", async () => { /* ... */ });\n});\n```\n\n---\n\n## Summary — priority order\n\n| Priority | Item | Why |\n|---|---|---|\n| 1 | Stand up Vitest (`web/`) and `pytest` config (`engine/`) | Nothing else runs without this |\n| 2 | `web/lib/validate-value.ts` (`checkObservedValue`, `foldValue`) | The \"never invent a value\" guarantee, web side |\n| 3 | `web/lib/server/conflicts.ts::recordReview` | The human-review write path; wrong test coverage here = wrong audit trail |\n| 4 | `engine/agent/graph.py::should_auto_apply` | Directly gates the paper's headline metric |\n| 5 | `web/lib/server/export.ts` (CSV escaping + `applyDecisions`) | Data-integrity + the noted formula-injection gap |\n| 6 | `web/lib/server/rulesets.ts::createRulesetVersion` | Concurrency correctness, silent-corruption risk if wrong |\n| 7 | Route handler integration tests | Cheapest high-value integration coverage, no browser needed |\n| 8 | Remaining pure `lib/`/`types/` functions | High test-per-effort ratio, no DB needed |\n| 9 | `engine/pipeline/*`, `agent/*` TDD skeletons | Not implemented yet — write now as spec, will start passing as Phase 2/3 lands |\n| 10 | Cross-language parity (`foldValue` ↔ `fold_name`, `LEGAL_SUFFIXES`) | Currently nothing enforces the two stay in lockstep, which AGENTS.md calls out as a reproducibility requirement |\n\nLet me know if you want me to actually scaffold the test infra (Vitest config + `pytest.ini`) and 