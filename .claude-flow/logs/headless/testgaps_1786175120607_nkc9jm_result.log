rict=True)` so they flip to a hard failure — not a silent pass — the day someone implements the function without matching the spec.\n\n```python\n# engine/tests/pipeline/test_normalize.py\nimport pytest\nfrom pipeline.normalize import fold_name\n\npytestmark = pytest.mark.xfail(reason=\"Phase 2 — not yet implemented\", strict=True)\n\n@pytest.mark.parametrize(\"raw,expected\", [\n    (\"Acme Inc.\", \"acme\"),\n    (\"ACME INC\", \"acme\"),\n    (\"Trellis Labs Pvt Ltd\", \"trellis labs\"),   # two suffixes, stripped repeatedly\n    (\"  Acme   Corp  \", \"acme\"),\n    (\"O'Brien & Sons, LLC\", \"o brien sons\"),     # punctuation dropped not replaced... verify against web's foldValue\n    (\"Ltd\", \"ltd\"),                              # whole value IS a suffix — kept, not emptied\n])\ndef test_fold_name_matches_web_foldValue_contract(raw, expected):\n    assert fold_name(raw) == expected\n\ndef test_fold_name_is_deterministic():\n    assert fold_name(\"Acme Inc.\") == fold_name(\"Acme Inc.\")\n```\n\n> **Note the parity requirement**: `engine/pipeline/normalize.py::fold_name` must produce byte-identical output to `web/lib/validate-value.ts::foldValue` for the same input — AGENTS.md is explicit that a value one layer accepts and the other rejects breaks reproducibility. Once both are implemented, add a **cross-language parity test**: generate a shared fixture file (`fixtures/fold-cases.json`) and assert both `fold_name` and `foldValue` agree on every case. This is a real integration gap — nothing currently proves the two implementations will match.\n\n```python\n# engine/tests/pipeline/test_detect.py (continued)\npytestmark = pytest.mark.xfail(reason=\"Phase 2 — not yet implemented\", strict=True)\n\ndef test_classify_parent_mismatch_is_structural_4():\n    cls, sev = classify(\"parentExternalId\", \"ACC-1\", \"ACC-2\")\n    assert (cls, sev) == (\"structural\", 4)\n\ndef test_classify_territory_mismatch_is_attribute_3():\n    cls, sev = classify(\"territory\", \"APAC\", \"EMEA\")\n    assert (cls, sev) == (\"attribute\", 3)\n\ndef test_classify_arbitrary_field_mismatch_is_attribute_2():\n    cls, sev = classify(\"industry\", \"SaaS\", \"Software\")\n    assert (cls, sev) == (\"attribute\", 2)\n\ndef test_classify_same_folded_value_is_cosmetic_1():\n    cls, sev = classify(\"name\", \"Acme Inc.\", \"ACME INC\")\n    assert (cls, sev) == (\"cosmetic\", 1)\n\ndef test_classify_identical_values_should_not_be_called_or_is_not_a_conflict():\n    # Edge case worth deciding explicitly: does classify() get called at all\n    # for value_a == value_b, or does it need to handle it gracefully?\n    ...\n```\n\n```python\n# engine/tests/agent/test_graph.py (continued)\npytestmark = pytest.mark.xfail(reason=\"Phase 3 — not yet implemented\", strict=True)\n\ndef test_select_rule_most_specific_wins():\n    ...  # exact field+entity beats wildcard-on-either, per rule_specificity\n\ndef test_select_rule_ties_keep_author_order():\n    # Two rules with equal specificity — first in the input list must win.\n    ...\n\ndef test_select_rule_no_match_returns_none():\n    ...\n\ndef test_validate_accepts_observed_value_a():\n    assert validate(\"ACC-4417\", value_a=\"ACC-4417\", value_b=\"ACC-2201\") is True\n\ndef test_validate_rejects_invented_value():\n    # THE non-negotiable check — a hallucinated value must fail even if it\n    # \"looks\" plausible (e.g. a valid-looking id that's neither observed value).\n    assert validate(\"ACC-9999\", value_a=\"ACC-4417\", value_b=\"ACC-2201\") is False\n\ndef test_validate_accepts_legal_normalization_of_observed_value():\n    assert validate(\"acme\", value_a=\"Acme Inc.\", value_b=\"ACME INC\") is True\n\ndef test_validate_rejects_partial_match():\n    # \"ACC-441\" is a substring of \"ACC-4417\" but not equal or a normalization —\n    # must still fail. Catches an accidental `.startswith()` implementation.\n    assert validate(\"ACC-441\", value_a=\"ACC-4417\", value_b=\"ACC-2201\") is False\n```\n\nApply the same `xfail`-skeleton pattern to `blocking.py` (`fold_name`-adjacent: `combine()` weight boundary tests, `block()` never returning O(n²) pairs — test with a synthetic 200×200 set and assert candidate count ≪ 40,000), `connectors/synthetic.py::extract` (round-trips generated fixtures), `db.py` (needs a test Postgres — see §4), and `eval/generate.py::generate` (the most important one to get right early: assert the manifest's injection-rate columns land within tolerance of `InjectionRates` defaults across a large seed, and assert the **ambiguous** rows are actually present — AGENTS.md flags this as the row a naive generator skips).\n\n---\n\n## 2. `web/` — pure `lib/` functions (no DB, no I/O — cheapest tests, write these first)\n\n### 2.1 `lib/format.ts` — 8 functions, 0 tests\n\n```ts\n// web/lib/format.test.ts\nimport { describe, it, expect } from \"vitest\";\nimport {\n  shortRunId, formatElapsed, formatCount, formatStat,\n  formatClockTime, formatTimestamp, formatRelative, formatConfidence,\n} from \"@/lib/format\";\n\ndescribe(\"shortRunId\", () => {\n  it(\"strips hyphens and takes 4+2 chars joined by an interpunct\", () => {\n    expect(shortRunId(\"a41f0c9d-1234-5678-9abc-def012345678\")).toBe(\"a41f·0c\");\n  });\n  it(\"handles an id shorter than expected without throwing\", () => {\n    // Edge case: malformed/truncated id — should not crash a render.\n    expect(() => shortRunId(\"abc\")).not.toThrow();\n  });\n});\n\ndescribe(\"formatElapsed\", () => {\n  it.each([\n    [0, \"00:00\"],\n    [59_000, \"00:59\"],\n    [60_000, \"01:00\"],\n    [3_599_000, \"59:59\"],\n    [3_600_000, \"1:00:00\"],\n    [-500, \"00:00\"],       // negative ms clamped to 0\n    [999, \"00:00\"],        // sub-second floors to 0\n  ])(\"formats %dms as %s\", (ms, expected) => {\n    expect(formatElapsed(ms)).toBe(expected);\n  });\n});\n\ndescribe(\"formatCount / formatStat\", () => {\n  it(\"adds thousands separators\", () => {\n    expect(formatCount(12345)).toBe(