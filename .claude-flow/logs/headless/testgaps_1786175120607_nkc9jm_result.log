        "code": "// web/lib/format.test.ts\nimport { describe, it, expect } from \"vitest\";\nimport {\n  shortRunId, formatElapsed, formatCount, formatStat,\n  formatClockTime, formatTimestamp, formatRelative, formatConfidence,\n} from \"@/lib/format\";\n\ndescribe(\"shortRunId\", () => {\n  it(\"strips hyphens and takes 4+2 chars joined by an interpunct\", () => {\n    expect(shortRunId(\"a41f0c9d-1234-5678-9abc-def012345678\")).toBe(\"a41f·0c\");\n  });\n  it(\"handles an id shorter than expected without throwing\", () => {\n    // Edge case: malformed/truncated id — should not crash a render.\n    expect(() => shortRunId(\"abc\")).not.toThrow();\n  });\n});\n\ndescribe(\"formatElapsed\", () => {\n  it.each([\n    [0, \"00:00\"],\n    [59_000, \"00:59\"],\n    [60_000, \"01:00\"],\n    [3_599_000, \"59:59\"],\n    [3_600_000, \"1:00:00\"],\n    [-500, \"00:00\"],       // negative ms clamped to 0\n    [999, \"00:00\"],        // sub-second floors to 0\n  ])(\"formats %dms as %s\", (ms, expected) => {\n    expect(formatElapsed(ms)).toBe(expected);\n  });\n});\n\ndescribe(\"formatCount / formatStat\", () => {\n  it(\"adds thousands separators\", () => {\n    expect(formatCount(12345)).toBe(\"12,345\");\n  });\n  it(\"formatStat renders an em dash for null and undefined, not 0\", () => {\n    expect(formatStat(null)).toBe(\"—\");\n    expect(formatStat(undefined)).toBe(\"—\");\n    expect(formatStat(0)).toBe(\"0\"); // the actual bug this function exists to prevent\n  });\n});\n\ndescribe(\"formatRelative\", () => {\n  const now = new Date(\"2026-08-08T12:00:00Z\");\n  it.each([\n    [30_000, \"just now\"],\n    [90_000, \"2m ago\"],\n    [3_700_000, \"1h ago\"],\n    [172_800_000, \"2d ago\"],\n  ])(\"%dms ago formats correctly\", (deltaMs, expected) => {\n    expect(formatRelative(new Date(now.getTime() - deltaMs), now)).toBe(expected);\n  });\n  it(\"does not go negative for a future date (clock skew)\", () => {\n    // Edge case: engine clock slightly ahead of web clock.\n    expect(() => formatRelative(new Date(now.getTime() + 5000), now)).not.toThrow();\n  });\n});\n\ndescribe(\"formatConfidence\", () => {\n  it(\"always shows two decimals, never a percentage\", () => {\n    expect(formatConfidence(0.9)).toBe(\"0.90\");\n    expect(formatConfidence(1)).toBe(\"1.00\");\n    expect(formatConfidence(0)).toBe(\"0.00\");\n  });\n});"
