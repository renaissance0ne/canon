dle.length).toBeGreaterThan(0); // cosmetic conflicts must still light up\n  });\n  it(\"middle differs — ACC-4417 vs ACC-2201\", () => {\n    expect(diffSegments(\"ACC-4417\", \"ACC-2201\")).toEqual({\n      prefix: \"ACC-\", middle: \"4417\", suffix: \"\",\n    });\n  });\n  it(\"empty string vs non-empty (orphan side)\", () => {\n    expect(diffSegments(\"\", \"ACC-4417\")).toEqual({ prefix: \"\", middle: \"\", suffix: \"\" });\n  });\n  it(\"both empty\", () => {\n    expect(diffSegments(\"\", \"\")).toEqual({ prefix: \"\", middle: \"\", suffix: \"\" });\n  });\n  it(\"completely disjoint values\", () => {\n    expect(diffSegments(\"xyz\", \"abc\")).toEqual({ prefix: \"\", middle: \"xyz\", suffix: \"\" });\n  });\n  it(\"prefix/suffix overlap when one string is fully contained (e.g. 'aa' vs 'aaa')\", () => {\n    // Regression guard: prefix-walk and suffix-walk both use `max`, but do they\n    // correctly avoid double-counting overlapping characters for pathological\n    // short/long pairs?\n    expect(diffSegments(\"aaa\", \"aa\")).toEqual({ prefix: \"aa\", middle: \"a\", suffix: \"\" });\n  });\n  it(\"single-character values\", () => {\n    expect(diffSegments(\"A\", \"B\")).toEqual({ prefix: \"\", middle: \"A\", suffix: \"\" });\n  });\n});\n```\n\n### 2.3 `lib/validate-value.ts` — the `validate` guard, web side. Most important pure-function gap.\n\n```ts\n// web/lib/validate-value.test.ts\nimport { describe, it, expect } from \"vitest\";\nimport { foldValue, checkObservedValue, observedValues, LEGAL_SUFFIXES } from \"@/lib/validate-value\";\n\ndescribe(\"foldValue\", () => {\n  it.each([\n    [\"Acme Inc.\", \"acme\"],\n    [\"ACME INC\", \"acme\"],\n    [\"  Acme   Corp  \", \"acme\"],\n    [\"O'Brien & Sons, LLC\", \"o brien sons\"],\n    [\"Trellis Labs Pvt Ltd\", \"trellis labs\"],   // two suffixes stripped, longest-first\n    [\"Ltd\", \"ltd\"],                              // whole value IS the suffix — not emptied\n    [\"\", \"\"],\n    [\"日本語 GmbH\", \"日本語\"],                    // unicode letters preserved (NFKD + \\p{L})\n  ])(\"folds %s to %s\", (input, expected) => {\n    expect(foldValue(input)).toBe(expected);\n  });\n\n  it(\"suffix stripping is greedy but bounded — does not loop forever on adversarial input\", () => {\n    const pathological = LEGAL_SUFFIXES.join(\" \").repeat(3);\n    expect(() => foldValue(pathological)).not.toThrow();\n  });\n});\n\ndescribe(\"checkObservedValue\", () => {\n  it(\"rejects an empty candidate\", () => {\n    expect(checkObservedValue(\"  \", [\"ACC-1\", \"ACC-2\"])).toEqual({\n      ok: false, reason: \"A value is required.\",\n    });\n  });\n\n  it(\"rejects when neither side has a value (orphan with no observed values)\", () => {\n    const result = checkObservedValue(\"anything\", [\"\", \"  \"]);\n    expect(result.ok).toBe(false);\n  });\n\n  it(\"accepts an exact match\", () => {\n    expect(checkObservedValue(\"ACC-4417\", [\"ACC-4417\", \"ACC-2201\"])).toEqual({\n      ok: true, matches: \"ACC-4417\",\n    });\n  });\n\n  it(\"accepts a legal normalization and returns the ORIGINAL observed casing, not the typed one\", () => {\n    // This is the subtle contract: `matches` must be the observed value, so the\n    // resolved hierarchy never stores a hand-typed variant.\n    const result = checkObservedValue(\"acme\", [\"Acme Inc.\", \"ACME INC\"]);\n    expect(result).toEqual({ ok: true, matches: \"Acme Inc.\" }); // first match wins\n  });\n\n  it(\"rejects an invented value not observed on either side — THE core guarantee\", () => {\n    const result = checkObservedValue(\"ACC-9999\", [\"ACC-4417\", \"ACC-2201\"]);\n    expect(result.ok).toBe(false);\n    expect(result.reason).toContain(\"ACC-4417\");\n    expect(result.reason).toContain(\"ACC-2201\");\n  });\n\n  it(\"rejects a substring/superstring of an observed value\", () => {\n    // Guards against a naive .includes() implementation slipping in later.\n    expect(checkObservedValue(\"ACC-441\", [\"A