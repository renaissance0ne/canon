        "content": "from eval.generate import generate, InjectionRates\n\nclass TestGenerate:\n    def test_same_seed_produces_identical_manifest(self, tmp_path):\n        m1 = generate(seed=42, accounts=50, out_dir=tmp_path / \"a\")\n        m2 = generate(seed=42, accounts=50, out_dir=tmp_path / \"b\")\n        assert m1 == m2\n\n    def test_different_seeds_produce_different_manifests(self, tmp_path): ...\n\n    def test_every_manifest_entry_has_a_known_conflict_class(self): ...\n\n    def test_ambiguous_rate_produces_at_least_one_escalate_entry(self, tmp_path):\n        # AGENTS.md: \"deliberately inject cases where the correct answer is\n        # escalate\" — a generator that produces zero of these defeats the point\n        rates = InjectionRates(ambiguous=0.5)\n        manifest = generate(seed=1, accounts=200, out_dir=tmp_path, rates=rates)\n        assert any(e.expected_resolution == \"escalate\" for e in manifest)\n\n    def test_zero_accounts_does_not_crash(self, tmp_path):\n        assert generate(seed=1, accounts=0, out_dir=tmp_path) == []\n```\n\n```python\n",
