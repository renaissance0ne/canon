t produce negative output\", () => {\n    const future = new Date(\"2026-08-07T12:05:00Z\");\n    expect(formatRelative(future, now)).not.toMatch(/^-/);\n  });\n});\n\ndescribe(\"formatConfidence\", () => {\n  it(\"always shows two decimals\", () => expect(formatConfidence(0.9)).toBe(\"0.90\"));\n  it(\"handles exact 1.0 and 0.0\", () => {\n    expect(formatConfidence(1)).toBe(\"1.00\");\n    expect(formatConfidence(0)).toBe(\"0.00\");\n  });\n});"
