        "title": "3. Web (TypeScript) — pure functions with zero tests",
        "content": "\nHighest ROI: these are small, deterministic, and already have real edge-case bugs waiting (see boundary notes inline).\n\n**`lib/format.ts`**\n```ts\n// web/lib/format.test.ts\nimport { describe, it, expect } from \"vitest\";\nimport { shortRunId, formatElapsed, formatCount, formatStat, formatRelative, formatConfidence } from \"./format\";\n\ndescribe(\"shortRunId\", () => {\n  it(\"formats a standard uuid\", () => {\n    expect(shortRunId(\"a41f1234-c9ab-...\")).toMatch(/^[0-9a-f]{4}·[0-9a-f]{2}$/);\n  });\n  it(\"is stable for the same id\", () => {\n    const id = \"11111111-2222-3333-4444-555555555555\";\n    expect(shortRunId(id)).toBe(shortRunId(id));\n  });\n});\n\ndescribe(\"formatElapsed\", () => {\n  it(\"formats under a minute as mm:ss\", () => expect(formatElapsed(5_000)).toBe(\"00:05\"));\n  it(\"formats exactly one hour as h:mm:ss\", () => expect(formatElapsed(3_600_000)).toBe(\"1:00:00\"));\n  it(\"formats one second under an hour as mm:ss not h:mm:ss\", () =>\n    expect(formatElapsed(3_599_000)).toBe(\"59:59\"));\n  it(\"clamps negative durations to zero instead of throwing\", () =>\n    expect(formatElapsed(-500)).toBe(\"00:00\"));\n  it(\"handles zero\", () => expect(formatElapsed(0)).toBe(\"00:00\"));\n});\n\ndescribe(\"formatStat\", () => {\n  it(\"renders null as em dash\", () => expect(formatStat(null)).toBe(\"—\"));\n  it(\"renders undefined as em dash\", () => expect(formatStat(undefined)).toBe(\"—\"));\n  it(\"renders zero as '0', not em dash — 0 and unknown are different facts\", () =>\n    expect(formatStat(0)).toBe(\"0\"));\n});\n\ndescribe(\"formatRelative\", () => {\n  const now = new Date(\"2026-08-07T12:00:00Z\");\n  it(\"under a minute reads 'just now'\", () =>\n    expect(formatRelative(new Date(\"2026-08-07T11:59:31Z\"), now)).toBe(\"just now\"));\n  it(\"boundary at exactly 60s\", () =>\n    expect(formatRelative(new Date(\"2026-08-07T11:59:00Z\"), now)).toBe(\"1m ago\"));\n  it(\"boundary at exactly 24h reads days not hours\", () =>\n    expect(formatRelative(new Date(\"2026-08-06T12:00:00Z\"), now)).toBe(\"1d ago\"));\n  it(\"future date (clock skew) does not produce negative output\", () => {\n    const future = new Date(\"2026-08-07T12:05:00Z\");\n    expect(formatRelative(future, now)).not.toMatch(/^-/);\n  });\n});\n\ndescribe(\"formatConfidence\", () => {\n  it(\"always shows two decimals\", () => expect(formatConfidence(0.9)).toBe(\"0.90\"));\n  it(\"handles exact 1.0 and 0.0\", () => {\n    expect(formatConfidence(1)).toBe(\"1.00\");\n    expect(formatConfidence(0)).toBe(\"0.00\");\n  });\n});\n```\n\n**`lib/reviewer-label.ts`** — priority-chain logic, currently untested including the fallback path:\n```ts\n// web/lib/reviewer-label.test.ts\nimport { reviewerLabel } from \"./reviewer-label\";\n\ndescribe(\"reviewerLabel\", () => {\n  it(\"prefers username over email\", () =>\n    expect(reviewerLabel({ username: \"j.rao\", primaryEmailAddress: { emailAddress: \"j@x.com\" } }, \"fallback\")).toBe(\"j.rao\"));\n  it(\"falls back to email when username is null\", () =>\n    expect(reviewerLabel({ username: null, primaryEmailAddress: { emailAddress: \"j@x.com\" } }, \"fallback\")).toBe(\"j@x.com\"));\n  it(\"falls back to the provided fallback when user is null\", () =>\n    expect(reviewerLabel(null, \"user_123\")).toBe(\"user_123\"));\n  it(\"falls back when username is empty string\", () =>\n    // empty string is falsy-ish but not null — confirm ?? doesn't treat \"\" as present\n    expect(reviewerLabel({ username: \"\", primaryEmailAddress: null }, \"fallback\")).toBe(\"fallback\"));\n});\n```\n\n**`lib/uuid.ts::isUuid`** — regex has real edge cases untested:\n```ts\n// web/lib/uuid.test.ts\nimport { isUuid } from \"./uuid\";\n\ndescribe(\"isUuid\", () => {\n  it(\"accepts a valid v4 uuid\", () => expect(isUuid(\"11111111-2222-3333-4444-555555555555\")).toBe(true));\n  it(\"accepts uppercase (case-insensitive)\", () => expect(isUuid(\"A1B2C3D4-E5F6-7890-ABCD-EF1234567890\")).toBe(true));\n  it(\"rejects wrong segment lengths\", () => expect(isUuid(\"1234-5678\")).toBe(false));\n  it(\"rejects missing hyphens\", () => expect(isUuid(\"11111111222233334444555555555555\")).toBe(false));\n  it(\"rejects non-hex characters\", () => expect(isUuid(\"gggggggg-2222-3333-4444-555555555555\")).toBe(false));\n  it(\"rejects empty string\", () => expect(isUuid(\"\")).toBe(false));\n  it(\"rejects a value with trailing/leading whitespace\", () =>\n    expect(isUuid(\" 11111111-2222-3333-4444-555555555555\")).toBe(false));\n});\n```\n\n**`lib/api-client.ts::postJson`** — three untested failure paths that matter to every form in the console:\n```ts\n// web/lib/api-client.test.ts\nimport { postJson } from \"./api-client\";\nimport { vi, beforeEach } from \"vitest\";\n\ndescribe(\"postJson\", () => {\n  beforeEach(() => { global.fetch = vi.fn(); });\n\n  it(\"returns ok:true with parsed data on 2xx\", async () => {\n    (fetch as any).mockResolvedValue({ ok: true, json: async () => ({ id: \"1\" }) });\n    const result = await postJson<{ id: string }>(\"/api/x\", {});\n    expect(result).toEqual({ ok: true, data: { id: \"1\" } });\n  });\n\n  it(\"returns a network-failure message when fetch rejects (offline)\", async () => {\n    (fetch as any).mockRejectedValue(new TypeError(\"Failed to fetch\"));\n    const result = await postJson(\"/api/x\", {});\n    expect(result.ok).toBe(false);\n  });\n\n  it(\"surfaces the server error message on 4xx\", async () => {\n    (fetch as any).mockResolvedValue({ ok: false, status: 400, json: async () => ({ error: \"bad\" }) });\n    const result = await postJson(\"/api/x\", {});\n    expect(result).toMatchObject({ ok: false, message: \"bad\" });\n  });\n\n  it(\"falls back to a status-based message when the error body has no 'error' field\", async () => {\n    (fetch as any).mockResolvedValue({ ok: false, status: 500, json: async () => null });\n    const result = await postJson(\"/api/x\", {});\n    expect((result as any).message).toContain(\"500\");\n  });\n\n  it(\"passes through field-level issues for form rendering\", async () => {\n    (fetch as any).mockResolvedValue({\n      ok: false, status: 400,\n      json: async () => ({ error: \"Invalid\", issues: { name: \"Required\" } }),\n    });\n    const result = await postJson(\"/api/x\", {});\n    expect((result as any).issues).toEqual({ name: \"Required\" });\n  });\n});\n```\n\n---\n\n",
        "level": 3
      },
      {
        "title": "4. Web — server-side logic (`lib/server/`), zero tests",
        "content": "\nThese need either a test DB (Supabase branch / local Postgres via Drizzle) or a mocked `getDb()` — see §5 for the integration-test setup this requires.\n\n**`lib/server/audit.ts`**\n```ts\n// web/lib/server/audit.test.ts — requires a test DB (append-only invariant matters most)\ndescribe(\"appendAudit / listRunAudit\", () => {\n  it(\"listRunAudit returns entries oldest-first\", async () => { ... });\n  it(\"listRecentAudit returns entries newest-first across all runs\", async () => { ... });\n  it(\"listRecentAudit respects the limit parameter\", async () => { ... });\n  it(\"there is no update or delete path — appendAudit is additive only\", () => {\n    // static assertion: audit.ts exports only append + list functions\n    ...\n  });\n});\n```\n\n**`lib/server/auth.ts::requireReviewer`**\n```ts\n// web/lib/server/auth.test.ts\nimport { vi } from \"vitest\";\nvi.mock(\"@clerk/nextjs/server\", () => ({ auth: vi.fn(), currentUser: vi.fn() }));\n\ndescribe(\"requireReviewer\", () => {\n  it(\"throws when there is no authenticated session\", async () => {\n    (auth as any).mockResolvedValue({ isAuthenticated: false, userId: null });\n    await expect(requireReviewer()).rejects.toThrow(/No authenticated reviewer/);\n  });\n  it(\"returns userId and derived label when authenticated\", async () => {\n    (auth as any).mockResolvedValue({ isAuthenticated: true, userId: \"u1\" });\n    (currentUser as any).mockResolvedValue({ username: \"j.rao\" });\n    await expect(requireReviewer()).resolves.toEqual({ userId: \"u1\", label: \"j.rao\" });\n  });\n});\n\ndescribe(\"getReviewer\", () => {\n  it(\"returns null instead of throwing when signed out\", async () => {\n    (auth as any).mockResolvedValue({ isAuthenticated: false });\n    await expect(getReviewer()).resolves.toBeNull();\n  });\n});\n```\n\n**`lib/server/engine.ts`** — this is the most error-handling-critical file in the whole web layer (it's the entire boundary to a process that AGENTS.md says \"being down is a normal Tuesday\") and it has **zero tests today**:\n```ts\n// web/lib/server/engine.test.ts\ndescribe(\"startRun\", () => {\n  it(\"throws EngineUnreachableError when ENGINE_URL is unset\", async () => {\n    delete process.env.ENGINE_URL;\n    await expect(startRun(\"run-1\")).rejects.toThrow(EngineUnreachableError);\n  });\n  it(\"throws EngineUnreachableError on network failure\", async () => {\n    global.fetch = vi.fn().mockRejectedValue(new Error(\"ECONNREFUSED\"));\n    await expect(startRun(\"run-1\")).rejects.toThrow(EngineUnreachableError);\n  });\n  it(\"throws EngineUnreachableError on timeout with a distinct message\", async () => {\n    global.fetch = vi.fn().mockRejectedValue(Object.assign(new Error(), { name: \"TimeoutError\" }));\n    await expect(startRun(\"run-1\")).rejects.toThrow(/no response within 8s/);\n  });\n  it(\"throws EngineUnreachableError on non-2xx status, including response body in message\", async () => {\n    global.fetch = vi.fn().mockResolvedValue({ ok: false, status: 503, text: async () => \"down\" });\n    await expect(startRun(\"run-1\")).rejects.toThrow(/503/);\n  });\n  it(\"throws when the engine returns 200 with a body that fails the contract schema\", async () => {\n    global.fetch = vi.fn().mockResolvedValue({ ok: true, json: async () => ({ wrong: \"shape\" }) });\n    await expect(startRun(\"run-1\")).rejects.toThrow(EngineUnreachableError);\n  });\n  it(\"succeeds silently on a valid accepted response\", async () => {\n    global.fetch = vi.fn().mockResolvedValue({ ok: true, json: async () => ({ runId: \"run-1\", accepted: true }) });\n    await expect(startRun(\"run-1\")).resolves.toBeUndefined();\n  });\n});\n\ndescribe(\"fetchEngineStatus\", () => {\n  it(\"returns null (not throw) on network failure — polling degrades, never errors\", async () => {\n    global.fetch = vi.fn().mockRejectedValue(new Error(\"down\"));\n    await expect(fetchEngineStatus(\"run-1\")).resolves.toBeNull();\n  });\n  it(\"returns null on non-2xx\", async () => {\n    global.fetch = vi.fn().mockResolvedValue({ ok: false, status: 500 });\n    await expect(fetchEngineStatus(\"run-1\")).resolves.toBeNull();\n  });\n  it(\"returns null when the body fails schema validation\", async () => {\n    global.fetch = vi.fn().mockResolvedValue({ ok: true, json: async () => ({ bogus: true }) });\n    await expect(fetchEngineStatus(\"run-1\")).resolves.toBeNull();\n  });\n  it(\"returns the parsed status on success\", async () => { ... });\n});\n```\n\n**`lib/server/export.ts`** — the CSV writer has classic untested injection/escaping edge cases:\n```ts\n// web/lib/server/export.test.ts\ndescribe(\"decisionsToCsv\", () => {\n  it(\"escapes a value containing a comma\", () => {\n    const csv = decisionsToCsv([{ ...base, valueA: \"Acme, Inc.\" }]);\n    expect(csv).toContain('\"Acme, Inc.\"');\n  });\n  it(\"escapes a value containing a double quote by doubling it\", () => {\n    const csv = decisionsToCsv([{ ...base, rationale: 'He said \"hi\"' }]);\n    expect(csv).toContain('\"He said \"\"hi\"\"\"');\n  });\n  it(\"escapes a value containing an embedded newline\", () => {\n    const csv = decisionsToCsv([{ ...base, rationale: \"line1\\nline2\" }]);\n    expect(csv).toContain('\"line1\\nline2\"');\n  });\n  it(\"renders null fields as empty cells, not the string 'null'\", () => {\n    const csv = decisionsToCsv([{ ...base, appliedRuleId: null }]);\n    expect(csv).not.toContain(\"null\");\n  });\n  it(\"uses CRLF line endings\", () => {\n    expect(decisionsToCsv([base])).toMatch(/\\r\\n/);\n  });\n  it(\"empty decisions list still emits the header row\", () => {\n    expect(decisionsToCsv([])).toBe(DECISION_COLUMNS.join(\",\") + \"\\r\\n\");\n  });\n});\n\ndescribe(\"appliedValue (in export.ts)\", () => {\n  it(\"overridden status returns the override value, not the proposed value\", () =>\n    expect(appliedValue(\"overridden\", \"proposed-x\", \"override-y\")).toBe(\"override-y\"));\n  it(\"escalated status returns null even though a proposed value exists\", () =>\n    expect(appliedValue(\"escalated\", \"proposed-x\", null)).toBeNull());\n  it(\"null status (no resolution yet) returns null\", () =>\n    expect(appliedValue(null, null, null)).toBeNull());\n});\n\ndescribe(\"applyDecisions\", () => {\n  it(\"marks reparented true only when the resolved parent differs from side A's original\", () => { ... });\n  it(\"account with no parentExternalId decision keeps its original side-A parent\", () => { ... });\n  it(\"two decisions on the same field for the same entity — last one in the sorted list wins (verify actual precedence, this is currently implicit)\", () => {\n    // NOTE: current implementation just Map.set()s in iteration order — if two\n    // conflicts ever target the same entity+field this silently picks one.\n    // Pin down and assert the actual behavior; flag if unintended.\n  });\n});\n\ndescribe(\"buildRunExport\", () => {\n  it(\"hierarchy and decisions load concurrently and both land in the result\", async () => { ... });\n  it(\"a conflict detected but not yet resolved still appears in decisions with null status (left join)\", async () => { ... });\n});\n```\n\n**`lib/server/rulesets.ts::createRulesetVersion`** — the concurrency-critical path (advisory lock + version bump + single-active-invariant) has no test at all, including no test that the invariant actually holds:\n```ts\n// web/lib/server/rulesets.test.ts — integration, real/test DB required\ndescribe(\"createRulesetVersion\", () => {\n  it(\"first version of a new name is version 1\", async () => { ... });\n  it(\"second save of the same name increments to the next version\", async () => { ... });\n  it(\"saving deactivates the previously active version of the SAME name\", async () => { ... });\n  it(\"saving a different-named ruleset does not deactivate an unrelated active ruleset — VERIFY this against the actual query\", async () => {\n    // rulesets.ts comment says \"exactly one ruleset is active across the whole\n    // install\" but the UPDATE clause only filters on isActive=true, not on\n    // name. Confirm intended behavior and lock it down with a test either way —\n    // this is a correctness-relevant ambiguity, not a stylistic one.\n  });\n  it(\"two concurrent createRulesetVersion calls for the same name never produce the same version number\", async () => {\n    // exercises the pg_advisory_xact_lock — run two calls via Promise.all\n    const [a, b] = await Promise.all([\n      createRulesetVersion({ name: \"policy-x\", rules: [rule] }),\n      createRulesetVersion({ name: \"policy-x\", rules: [rule] }),\n    ]);\n    expect(a.version).not.toBe(b.version);\n  });\n});\n\ndescribe(\"getActiveRuleset\", () => {\n  it(\"returns null when no ruleset has ever been created\", async () => { ... });\n  it(\"returns the highest version among active=true rows\", async () => { ... });\n});\n```\n\n**`lib/server/runs.ts::failUndispatchedRun`** — the guard condition is the whole point of the function and is untested:\n```ts\n// web/lib/server/runs.test.ts\ndescribe(\"failUndispatchedRun\", () => {\n  it(\"marks a queued run as failed with the given error\", async () => { ... });\n  it(\"does NOT overwrite a run the engine has already advanced past queued\", async () => {\n    // create a run, move it to \"matching\" (simulating the engine), then call\n    // failUndispatchedRun — status must remain \"matching\"\n  });\n});\n\ndescribe(\"getSeverityBreakdown\", () => {\n  it(\"returns all-zero breakdown when the run has no conflicts\", async () => { ... });\n  it(\"silently drops a row with severity outside 1..4 instead of throwing\", async () => {\n    // per the comment: \"an engine bug, not something to render\" — insert a\n    // conflict with severity=99 directly and confirm it's excluded, not crashed on\n  });\n});\n```\n\n**`lib/server/sources.ts::findSourceIds`**\n```ts\ndescribe(\"findSourceIds\", () => {\n  it(\"returns an empty set without a DB round trip when given an empty array\", async () => { ... });\n  it(\"returns only the ids that exist, silently dropping nonexistent ones\", async () => { ... });\n});\n```\n\n---\n\n",
        "level": 3
      },
      {
        "title": "5. Web — route handlers (`app/api/**/route.ts`), zero tests",
        "content": "\nThese are the highest-value integration tests in the repo: `POST /api/runs` alone encodes five business rules (same-source rejection, missing-source 400, missing-ruleset 400, actor-from-session-not-body, and the degrade-to-failed-on-engine-unreachable path) with no test covering any of them.\n\n```ts\n// web/app/api/runs/route.test.ts\ndescribe(\"POST /api/runs\", () => {\n  it(\"rejects when sourceAId === sourceBId with 400\", async () => { ... });\n  it(\"400s when sourceAId does not exist\", async () => { ... });\n  it(\"400s when sourceBId does not exist\", async () => { ... });\n  it(\"400s when rulesetId does not exist\", async () => { ... });\n  it(\"400s on malformed JSON body\", async () => { ... });\n  it(\"400s with field-level issues when a uuid field is not a uuid\", async () => { ... });\n\n  it(\"creates the run, dispatches to the engine, and returns 201 with runId on success\", async () => { ... });\n\n  it(\"appends a run_started audit entry with actor = session reviewer, never from the body\", async () => {\n    // POST a body that includes an attacker-controlled \"actor\" field (if one\n    // were accepted) and assert the persisted audit row's actor is the\n    // session's reviewer label regardless\n  });\n\n  it(\"when the engine is unreachable: run row still ends up failed, audit gets run_failed, response is STILL 201\", async () => {\n    // this is the wireframe-1h path — the response contract (201, not 500) is\n    // easy to regress and has no test today\n    vi.mocked(startRun).mockRejectedValue(new EngineUnreachableError(\"down\"));\n    const res = await POST(request);\n    expect(res.status).toBe(201);\n    // and separately, fetch the run row and confirm status === \"failed\"\n  });\n\n  it(\"a non-EngineUnreachableError from startRun propagates rather than being swallowed\", async () => {\n    vi.mocked(startRun).mockRejectedValue(new TypeError(\"unexpected\"));\n    await expect(POST(request)).rejects.toThrow(TypeError);\n  });\n});\n\ndescribe(\"GET /api/runs\", () => {\n  it(\"returns runs sorted newest-first (delegates to listRuns, worth a smoke test)\", async () => { ... });\n});\n```\n\n```ts\n// web/app/api/runs/[runId]/route.test.ts\ndescribe(\"GET /api/runs/:runId\", () => {\n  it(\"404s on a syntactically invalid uuid (e.g. '/runs/banana') without hitting the DB\", async () => { ... });\n  it(\"404s when the uuid is well-formed but no run exists\", async () => { ... });\n  it(\"200s with the joined run detail (source names, ruleset name+version) on success\", async () => { ... });\n});\n```\n\n```ts\n// web/app/api/runs/[runId]/status/route.test.ts\ndescribe(\"GET /api/runs/:runId/status\", () => {\n  it(\"404s for an unknown run\", async () => { ... });\n  it(\"terminal run (complete/failed) never calls fetchEngineStatus\", async () => {\n    const spy = vi.spyOn(engineModule, \"fetchEngineStatus\");\n    // seed a run with status \"complete\"\n    await GET(request, ctx);\n    expect(spy).not.toHaveBeenCalled();\n  });\n  it(\"in-flight run prefers the live engine status when available\", async () => { ... });\n  it(\"in-flight run falls back to the DB row when the engine is unreachable (fetchEngineStatus resolves null)\", async () => { ... });\n  it(\"response has cache-control: no-store\", async () => { ... });\n});\n```\n\n```ts\n// web/app/api/runs/[runId]/export/route.test.ts\ndescribe(\"GET /api/runs/:runId/export\", () => {\n  it(\"defaults to json when format is omitted\", async () => { ... });\n  it(\"400s on an unrecognized format value\", async () => { ... });\n  it(\"404s for an unknown run\", async () => { ... });\n  it(\"csv response has content-type text/csv and a content-disposition filename\", async () => { ... });\n  it(\"json response has content-disposition filename ending in .json\", async () => { ... });\n  it(\"exportedBy is the session reviewer's label, not client-supplied\", async () => { ... });\n});\n```\n\n```ts\n// web/app/api/sources/route.test.ts, rulesets/route.test.ts\ndescribe(\"POST /api/sources\", () => {\n  it(\"400s when config.objects is empty (min(1) on the array)\", async () => { ... });\n  it(\"400s when kind is not one of the enum values\", async () => { ... });\n  it(\"rejects a body that includes a credential-shaped field — confirm the schema truly has no place for one\", async () => {\n    // defense-in-depth test for the \"never a password in sources.config\" rule\n    const res = await POST(makeRequest({ name: \"x\", kind: \"salesforce\", config: { objects: [\"Account\"], password: \"hunter2\" } }));\n    // schema is `.strict()`-equivalent? confirm — if extra keys are silently\n    // stripped rather than rejected, that's worth knowing explicitly\n  });\n});\n\ndescribe(\"POST /api/rulesets\", () => {\n  it(\"400s when rules array is empty (min(1))\", async () => { ... });\n  it(\"400s when a rule has strategy=prefer_source with no preferredSourceId (schema .refine)\", async () => { ... });\n  it(\"201s and the response reflects the server-assigned version, not anything from the request\", async () => { ... });\n});\n```\n\n**`app/api/_lib/respond.ts`** — shared plumbing every route depends on, untested in isolation:\n```ts\n// web/app/api/_lib/respond.test.ts\ndescribe(\"parseJson\", () => {\n  it(\"returns ok:false 400 when the body is not valid JSON\", async () => { ... });\n  it(\"returns ok:false 400 with per-field issues when schema validation fails\", async () => {\n    const result = await parseJson(makeRequest({ name: 123 }), z.object({ name: z.string() }));\n    expect(result.ok).toBe(false);\n    if (!result.ok) {\n      const body = await result.response.json();\n      expect(body.issues).toHaveProperty(\"name\");\n    }\n  });\n  it(\"joins nested paths with dots (e.g. 'config.objects')\", async () => { ... });\n  it(\"uses '_' as the key for a root-level issue with no path\", async () => { ... });\n  it(\"returns ok:true with typed data on success\", async () => { ... });\n});\n```\n\n---\n\n",
        "level": 3
      },
      {
        "title": "6. Error handling gaps (cross-cutting)",
        "content": "\n| Surface | Untested failure mode |\n|---|---|\n| `lib/server/engine.ts` | Engine returns 200 with valid JSON but wrong shape (contract drift) — covered above, currently the single largest blind spot |\n| `app/api/runs/route.ts` | DB insert (`createRun`) itself throwing (e.g. connection loss) between audit-append and engine-dispatch — no test for partial-failure ordering |\n| `lib/server/rulesets.ts` | Transaction failure mid-`createRulesetVersion` — does the advisory lock release correctly, does `isActive` get left in a bad state? Needs a forced-rollback test |\n| `lib/server/auth.ts` | `requireReviewer` is documented to \"fail loudly\" if reached without a session — no test proves proxy.ts + this function actually compose that way end-to-end |\n| `engine/main.py` | `execute_run` mid-pipeline failure — AGENTS.md promises \"a run that fails halfway leaves a readable trail,\" but there's no test (and no implementation yet) proving a failure in `detect` doesn't lose the `entities`/`matches` already written |\n| `engine/agent/graph.py::validate` | Once implemented: no test yet for a *legal* normalization that's easy to get subtly wrong — e.g. does `\"Acme Inc.\"` validate against observed value `\"acme inc\"` (case+punctuation) but not against a same-looking string that folds differently? |\n| Zod schemas (`types/rules.ts`) | `survivorshipRuleSchema`'s `.refine` only fires on `strategy === \"prefer_source\"` — no test that `preferredSourceId` is silently *ignored* (not required, not rejected) for the other three strategies |\n\n---\n\n",
        "level": 3
      },
      {
        "title": "7. Integration test gaps",
        "content": "\n1. **The conflict review loop doesn't exist yet** — `GET /api/conflicts`, `PATCH /api/conflicts/:conflictId/resolution`. This is feature #13/#14 in AGENTS.md's build order and the core reviewer workflow. When built, it needs (at minimum): approve/reject/override each appending the correct `audit_log.action` (`REVIEW_AUDIT_ACTION` mapping already exists in `types/resolution.ts` — good, that mapping itself has no test yet either), override value validated server-side against the two observed values (mirrors `validate` in the engine — same non-negotiable rule, same test shape as `TestValidate` above), and `reviewedBy` never accepted from the request body (same pattern as the `POST /api/runs` actor test).\n\n2. **Web → Engine → Postgres round trip.** Nothing exercises `createRun` → `startRun` → (engine writes `entities`/`matches`/`conflicts`) → `GET /status` reflecting engine progress. Once `engine/main.py::execute_run` is implemented, this needs at least one end-to-end test against a real (containerized/test) Postgres and a running engine instance — table-ownership violations (engine writing to `sources`/`rulesets`, web writing to `entities`/`matches`/`conflicts`) are exactly the kind of bug that only shows up in an integration test, never a unit test.\n\n3. **Table-ownership as an enforced invariant, not just a comment.** AGENTS.md states the ownership split is enforced by convention, not by DB permissions. Worth a lightweight static/integration check: grep `web/lib/server/**` for any `.insert(entities` / `.insert(matches` / `.insert(conflicts` (should never appear), and equivalently confirm `engine/db.py` never touches `sources`/`rulesets` tables. Cheap to write, catches the exact class of bug AGENTS.md is most worried about.\n\n4. **Zod ↔ Pydantic contract drift.** `web/types/*.ts` and `engine/pipeline/schema.py` are hand-duplicated per AGENTS.md (\"do not change one without changing the other\"). Nothing currently verifies they agree — e.g. `AuditAction` literals, `Severity` bounds, `RuleStrategy` enum values. A contract test that decodes a JSON fixture through both the Pydantic model and the Zod schema and diffs the accepted value sets would catch drift immediately instead of at demo time.\n\n5. **`proxy.ts` auth boundary.** No test confirms `/api/*` is actually protected (only `/`, `/sign-in`, `/sign-up` are public) or that the matcher's static-asset exclusion regex doesn't accidentally also exclude something like `/api/runs/export.csv`-shaped paths. Clerk provides testing utilities for exactly this (`clerk-testing` skill is available if you want help wiring it up).\n\n---\n\n",
        "level": 3
      },
      {
        "title": "Priority order if implementing incrementally",
        "content": "1. `lib/server/engine.ts` tests — highest blast radius, zero coverage, pure error-handling logic, no DB needed (just `fetch` mocking).\n2. `lib/format.ts` + `lib/uuid.ts` + `lib/reviewer-label.ts` — pure, fast, no setup needed, unblocks nothing else so can run first.\n3. `app/api/_lib/respond.ts` + `POST /api/runs` — the route logic every other route pattern-matches.\n4. Engine: `should_auto_apply`, `severity_for_orphan`, `rule_specificity` — small, and pin the numbers the eventual paper depends on before more code is built on top of them.\n5. TDD skeletons for `normalize.py`/`blocking.py`/`detect.py`/`graph.py` as you implement each — write the test class from §2 immediately before the function body, not after.\n\nWant me to scaffold the actual test files (Vitest config + `engine/tests/__init__.py` structure) so these are ready to fill in, or hold off until you confirm Vitest as the web test runner?",
        "level": 3
      }
    ],
    "codeBlocks": [
      {
        "language": "toml",
        "code": "# engine/pyproject.toml — add\n[tool.pytest.ini_options]\ntestpaths = [\"tests\"]"
      },
      {
        "language": "text",
        "code": "engine/tests/\n  pipeline/test_schema.py\n  pipeline/test_normalize.py\n  pipeline/test_blocking.py\n  pipeline/test_detect.py\n  agent/test_graph.py\n  agent/test_prompts.py\n  eval/test_generate.py\n  eval/test_baselines.py\n  eval/test_harness.py\n  test_main.py          # FastAPI TestClient\n  test_db.py            # needs a test Postgres or mocking — see §5"
      },
      {
        "language": "python",
        "code": "# engine/tests/pipeline/test_schema.py\nimport pytest\nfrom pydantic import ValidationError\nfrom pipeline.schema import SurvivorshipRule, rule_specificity\n\ndef make_rule(**overrides):\n    base = dict(id=\"r1\", field=\"territory\", entity_type=\"account\",\n                strategy=\"most_recent\", description=\"d\")\n    return SurvivorshipRule(**{**base, **overrides})\n\nclass TestRuleSpecificity:\n    def test_exact_field_and_type_scores_highest(self):\n        assert rule_specificity(make_rule(field=\"territory\", entity_type=\"account\")) == 3\n\n    def test_wildcard_field_only(self):\n        assert rule_specificity(make_rule(field=\"*\", entity_type=\"account\")) == 1\n\n    def test_wildcard_type_only(self):\n        assert rule_specificity(make_rule(field=\"territory\", entity_type=\"*\")) == 2\n\n    def test_full_wildcard_scores_zero(self):\n        assert rule_specificity(make_rule(field=\"*\", entity_type=\"*\")) == 0\n\nclass TestSurvivorshipRuleValidation:\n    def test_prefer_source_without_preferred_source_id_rejected(self):\n        with pytest.raises(ValidationError):\n            make_rule(strategy=\"prefer_source\", preferred_source_id=None)\n\n    def test_prefer_source_with_preferred_source_id_accepted(self):\n        rule = make_rule(strategy=\"prefer_source\", preferred_source_id=\"src-1\")\n        assert rule.preferred_source_id == \"src-1\"\n\n    def test_non_prefer_source_strategy_does_not_require_preferred_source_id(self):\n        assert make_rule(strategy=\"escalate\").preferred_source_id is None\n\nclass TestCanonModelWireFormat:\n    def test_round_trips_camelcase_alias(self):\n        rule = make_rule()\n        wire = rule.model_dump(by_alias=True)\n        assert \"entityType\" in wire and \"entity_type\" not in wire\n        assert SurvivorshipRule.model_validate(wire).entity_type == rule.entity_type\n\n    def test_rejects_unknown_field_extra_forbid(self):\n        with pytest.raises(ValidationError):\n            SurvivorshipRule.model_validate({**make_rule().model_dump(by_alias=True), \"bogus\": 1})\n\nclass TestMatchConfidenceBounds:\n    def test_confidence_out_of_range_rejected(self):\n        from uuid import uuid4\n        from pipeline.schema import Match, MatchSignals\n        with pytest.raises(ValidationError):\n            Match(run_id=uuid4(), entity_a_id=uuid4(), entity_b_id=uuid4(),\n                  confidence=1.5, method=\"fuzzy\",\n                  signals=MatchSignals(exact_key=False, cosine=0.5, fuzzy_ratio=0.5))"
      },
      {
        "language": "python",
        "code": "# engine/tests/pipeline/test_detect.py\nfrom pipeline.detect import severity_for_orphan\n\ndef test_orphan_with_children_is_severity_4():\n    assert severity_for_orphan(has_children=True) == 4\n\ndef test_orphan_without_children_is_severity_3():\n    assert severity_for_orphan(has_children=False) == 3"
      },
      {
        "language": "python",
        "code": "# engine/tests/agent/test_graph.py\nimport pytest\nfrom agent.graph import should_auto_apply, AUTO_APPLY_CONFIDENCE_THRESHOLD, AUTO_APPLY_MAX_SEVERITY\n\n@pytest.mark.parametrize(\"confidence,severity,expected\", [\n    (0.95, 1, True),\n    (0.95, 2, True),\n    (0.95, 3, False),          # severity gate, high confidence still blocks\n    (0.50, 1, False),          # confidence gate, low severity still blocks\n    (AUTO_APPLY_CONFIDENCE_THRESHOLD, AUTO_APPLY_MAX_SEVERITY, True),   # inclusive boundary\n    (AUTO_APPLY_CONFIDENCE_THRESHOLD - 0.001, AUTO_APPLY_MAX_SEVERITY, False),\n    (1.0, AUTO_APPLY_MAX_SEVERITY + 1, False),\n])\ndef test_should_auto_apply_gate(confidence, severity, expected):\n    assert should_auto_apply(confidence=confidence, severity=severity) is expected"
      },
