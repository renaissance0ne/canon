      {
        "title": "engine/tests/pipeline/test_normalize.py",
        "content": "from pipeline.normalize import fold_name, normalize\n\nclass TestFoldName:\n    def test_case_folds(self):\n        assert fold_name(\"Acme\") == fold_name(\"ACME\")\n\n    def test_strips_legal_suffix_inc(self):\n        assert fold_name(\"Acme Inc.\") == fold_name(\"Acme\")\n\n    def test_strips_legal_suffix_gmbh(self):\n        assert fold_name(\"Muster GmbH\") == fold_name(\"Muster\")\n\n    def test_collapses_whitespace_and_punctuation(self):\n        assert fold_name(\"Acme,  Inc.\") == fold_name(\"Acme Inc\")\n\n    def test_deterministic_same_input_same_output(self):\n        assert fold_name(\"Acme Inc.\") == fold_name(\"Acme Inc.\")\n\n    def test_empty_string(self):\n        assert fold_name(\"\") == \"\"\n\n    def test_name_that_is_only_a_legal_suffix(self):\n        # edge case: folding \"LLC\" alone must not raise or return empty silently\n        assert fold_name(\"LLC\") is not None\n\nclass TestNormalize:\n    def test_name_is_preserved_verbatim_normalized_name_is_folded(self):\n        # AGENTS.md: folding is RECORDED, NOT DESTRUCTIVE\n        [entity] = normalize([{\"name\": \"Acme Inc.\", \"id\": \"1\"}],\n                              entity_type=\"account\", source_id=\"src-a\")\n        assert entity.name == \"Acme Inc.\"\n        assert entity.normalized_name == fold_name(\"Acme Inc.\")\n\n    def test_empty_input_returns_empty_list(self):\n        assert normalize([], entity_type=\"account\", source_id=\"src-a\") == []\n\n    def test_missing_optional_fields_default_correctly(self):\n        # no parentExternalId, no lastModifiedAt in the raw record\n        [entity] = normalize([{\"id\": \"1\", \"name\": \"Acme\"}],\n                              entity_type=\"account\", source_id=\"src-a\")\n        assert entity.parent_external_id is None\n        assert entity.last_modified_at is None\n```\n\n```python\n",
        "level": 1
