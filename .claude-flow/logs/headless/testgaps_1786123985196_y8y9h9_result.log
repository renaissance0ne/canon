d=None)\n\n    def test_prefer_source_with_preferred_source_id_accepted(self):\n        rule = make_rule(strategy=\"prefer_source\", preferred_source_id=\"src-1\")\n        assert rule.preferred_source_id == \"src-1\"\n\n    def test_non_prefer_source_strategy_does_not_require_preferred_source_id(self):\n        assert make_rule(strategy=\"escalate\").preferred_source_id is None\n\nclass TestCanonModelWireFormat:\n    def test_round_trips_camelcase_alias(self):\n        rule = make_rule()\n        wire = rule.model_dump(by_alias=True)\n        assert \"entityType\" in wire and \"entity_type\" not in wire\n        assert SurvivorshipRule.model_validate(wire).entity_type == rule.entity_type\n\n    def test_rejects_unknown_field_extra_forbid(self):\n        with pytest.raises(ValidationError):\n            SurvivorshipRule.model_validate({**make_rule().model_dump(by_alias=True), \"bogus\": 1})\n\nclass TestMatchConfidenceBounds:\n    def test_confidence_out_of_range_rejected(self):\n        from uuid import uuid4\n        from pipeline.schema import Match, MatchSignals\n        with pytest.raises(ValidationError):\n            Match(run_id=uuid4(), entity_a_id=uuid4(), entity_b_id=uuid4(),\n                  confidence=1.5, method=\"fuzzy\",\n                  signals=MatchSignals(exact_key=False, cosine=0.5, fuzzy_ratio=0.5))\n```\n\n**`engine/pipeline/detect.py::severity_for_orphan`** — trivial but it's a headline metric input, and it has an untested boundary (no explicit test for children=True/False, no test that it's total for the two boolean states):\n```python\n# engine/tests/pipeline/test_detect.py\nfrom pipeline.detect import severity_for_orphan\n\ndef test_orphan_with_children_is_severity_4():\n    assert severity_for_orphan(has_children=True) == 4\n\ndef test_orphan_without_children_is_severity_3():\n    assert severity_for_orphan(has_children=False) == 3\n```\n\n**`engine/agent/graph.py::should_auto_apply`** — the auto-apply gate. This is the single most consequential boolean in the system (it's what \"false auto-apply rate\" measures) and it has zero tests, including no boundary tests at the exact threshold values:\n```python\n# engine/tests/agent/test_graph.py\nimport pytest\nfrom agent.graph import should_auto_apply, AUTO_APPLY_CONFIDENCE_THRESHOLD, AUTO_APPLY_MAX_SEVERITY\n\n@pytest.mark.parametrize(\"confidence,severity,expected\", [\n    (0.95, 1, True),\n    (0.95, 2, True),\n    (0.95, 3, False),          # severity gate, high confidence still blocks\n    (0.50, 1, False),          # confidence gate, low severity still blocks\n    (AUTO_APPLY_CONFIDENCE_THRESHOLD, AUTO_APPLY_MAX_SEVERITY, True),   # inclusive boundary\n    (AUTO_APPLY_CONFIDENCE_THRESHOLD - 0.001, AUTO_APPLY_MAX_SEVERITY, False),\n    (1.0, AUTO_APPLY_MAX_SEVERITY + 1, False),\n])\ndef test_should_auto_apply_gate(confidence, severity, expected):\n    assert should_auto_apply(confidence=confidence, severity=severity) is expected\n```\n\n**`engine/main.py::start_run`** — the one live FastAPI route. Untested: that it actually schedules the background task rather than running inline, and that it echoes `run_id` correctly.\n```python\n# engine/tests/test_main.py\nfrom fastapi.testclient import TestClient\nfrom unittest.mock import patch\nfrom main import app\n\ndef test_start_run_returns_accepted_immediately(monkeypatch):\n    monkeypatch.setattr(\"main.execute_run\", lambda run_id: None)\n    with TestClient(app) as client:\n        run_id = \"11111111-1111-1111-1111-111111111111\"\n        resp = client.post(\"/runs\", json={\"runId\": run_id})\n    assert resp.status_code == 200\n    assert resp.json() == {\"runId\": run_id, \"accepted\": True}\n\ndef test_start_run_schedules_background_task_not_inline(monkeypatch):\n    calls = []\n    monkeypatch.setattr(\"main.execute_run\", lambda run_id: calls.append(run_id))\n    with TestClient(app) as client:\n        client.post(\"/runs\", json={\"runId\": \"11111111-1111-1111-1111-111111111111\"})\n    