        "code": "// web/lib/reviewer-label.test.ts\nimport { describe, it, expect } from \"vitest\";\nimport { reviewerLabel } from \"./reviewer-label\";\n\ndescribe(\"reviewerLabel\", () => {\n  it(\"prefers username over email\", () => {\n    expect(reviewerLabel({ username: \"j.rao\", primaryEmailAddress: { emailAddress: \"j@x.com\" } }, \"uid\")).toBe(\"j.rao\");\n  });\n  it(\"falls back to email when username is null\", () => {\n    expect(reviewerLabel({ username: null, primaryEmailAddress: { emailAddress: \"j@x.com\" } }, \"uid\")).toBe(\"j@x.com\");\n  });\n  it(\"falls back to the stable id when user is null (signed-out edge case)\", () => {\n    expect(reviewerLabel(null, \"uid\")).toBe(\"uid\");\n  });\n  it(\"falls back to the id when username and email are both absent\", () => {\n    expect(reviewerLabel({ username: \"\", primaryEmailAddress: null }, \"uid\")).toBe(\"uid\");\n  });\n});"
