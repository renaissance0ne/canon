        "title": "A1. Pure functions — highest ROI, no mocking",
        "content": "\n**`lib/format.ts`** (8 exported functions, all untested)\n\nGaps: `shortRunId` on a non-UUID/short string; `formatElapsed` at exact minute/hour boundaries and negative input; `formatRelative` at the `59s→1m`, `59m→1h`, `23h→1d` boundaries and future dates; `formatStat(null)` vs `formatStat(0)` (these must render differently — that's the entire point of the function).\n\n```ts\n// web/lib/format.test.ts\nimport { describe, it, expect } from \"vitest\";\nimport { shortRunId, formatElapsed, formatStat, formatRelative, formatConfidence } from \"./format\";\n\ndescribe(\"shortRunId\", () => {\n  it(\"interpunct-joins the first 4 and next 2 hex chars, hyphens stripped\", () => {\n    expect(shortRunId(\"a41f1234-c9ab-...\")).toBe(\"a41f·c9\");\n  });\n});\n\ndescribe(\"formatElapsed\", () => {\n  it.each([\n    [0, \"00:00\"],\n    [59_000, \"00:59\"],\n    [60_000, \"01:00\"],\n    [3_599_000, \"59:59\"],\n    [3_600_000, \"1:00:00\"],\n    [-5_000, \"00:00\"], // clamps, doesn't go negative\n  ])(\"%ims -> %s\", (ms, expected) => expect(formatElapsed(ms)).toBe(expected));\n});\n\ndescribe(\"formatStat\", () => {\n  it(\"renders null/undefined as an em dash, not 0\", () => {\n    expect(formatStat(null)).toBe(\"—\");\n    expect(formatStat(undefined)).toBe(\"—\");\n    expect(formatStat(0)).toBe(\"0\"); // must NOT collapse to the same output as null\n  });\n});\n\ndescribe(\"formatRelative\", () => {\n  it.each([\n    [30_000, \"just now\"],\n    [59_000, \"just now\"],\n    [60_000, \"1m ago\"],\n    [3_599_000, \"59m ago\"],\n    [3_600_000, \"1h ago\"],\n    [86_400_000, \"1d ago\"],\n  ])(\"%ims ago -> %s\", (deltaMs, expected) => {\n    const now = new Date(2026, 0, 2, 0, 0, 0);\n    expect(formatRelative(new Date(now.getTime() - deltaMs), now)).toBe(expected);\n  });\n\n  it(\"does not throw on a future date\", () => {\n    const now = new Date(2026, 0, 1);\n    expect(() => formatRelative(new Date(2026, 0, 2), now)).not.toThrow();\n  });\n});\n\ndescribe(\"formatConfidence\", () => {\n  it(\"always shows two decimals, never a percentage\", () => {\n    expect(formatConfidence(0.9)).toBe(\"0.90\");\n    expect(formatConfidence(1)).toBe(\"1.00\");\n  });\n});\n```\n\n**`lib/reviewer-label.ts`** — untested precedence chain (username → email → fallback). This directly backs the audit trail identity claim in `AGENTS.md`.\n\n```ts\n// web/lib/reviewer-label.test.ts\nimport { describe, it, expect } from \"vitest\";\nimport { reviewerLabel } from \"./reviewer-label\";\n\ndescribe(\"reviewerLabel\", () => {\n  it(\"prefers username over email\", () => {\n    expect(reviewerLabel({ username: \"j.rao\", primaryEmailAddress: { emailAddress: \"j@x.com\" } }, \"uid\")).toBe(\"j.rao\");\n  });\n  it(\"falls back to email when username is null\", () => {\n    expect(reviewerLabel({ username: null, primaryEmailAddress: { emailAddress: \"j@x.com\" } }, \"uid\")).toBe(\"j@x.com\");\n  });\n  it(\"falls back to the stable id when user is null (signed-out edge case)\", () => {\n    expect(reviewerLabel(null, \"uid\")).toBe(\"uid\");\n  });\n  it(\"falls back to the id when username and email are both absent\", () => {\n    expect(reviewerLabel({ username: \"\", primaryEmailAddress: null }, \"uid\")).toBe(\"uid\");\n  });\n});\n```\n\n**`types/rules.ts`** — `ruleSpecificity` and `orderRulesByEvaluation` are the actual survivorship-rule ordering algorithm (`AGENTS.md` § Tool Contract: \"most specific first ... first match wins\"). This is business-critical and completely untested; a bug here silently changes which rule fires on every conflict.\n\n```ts\n// web/types/rules.test.ts\nimport { describe, it, expect } from \"vitest\";\nimport { ruleSpecificity, orderRulesByEvaluation, type SurvivorshipRule } from \"./rules\";\n\nconst rule = (id: string, field: string, entityType: string): SurvivorshipRule => ({\n  id, field, entityType, strategy: \"escalate\", description: \"\",\n});\n\ndescribe(\"ruleSpecificity\", () => {\n  it.each([\n    [rule(\"a\", \"*\", \"*\"), 0],\n    [rule(\"b\", \"*\", \"account\"), 1],\n    [rule(\"c\", \"territory\", \"*\"), 2],\n    [rule(\"d\", \"territory\", \"account\"), 3],\n  ])(\"scores %s -> %i\", (r, score) => expect(ruleSpecificity(r)).toBe(score));\n});\n\ndescribe(\"orderRulesByEvaluation\", () => {\n  it(\"puts exact field+entityType before either wildcard\", () => {\n    const wildcard = rule(\"wild\", \"*\", \"*\");\n    const specific = rule(\"spec\", \"territory\", \"account\");\n    expect(orderRulesByEvaluation([wildcard, specific])).toEqual([specific, wildcard]);\n  });\n\n  it(\"preserves author order for ties (deterministic first-match)\", () => {\n    const first = rule(\"first\", \"territory\", \"*\");\n    const second = rule(\"second\", \"territory\", \"*\");\n    expect(orderRulesByEvaluation([second, first])).toEqual([second, first]);\n  });\n\n  it(\"is a no-op on an empty ruleset\", () => {\n    expect(orderRulesByEvaluation([])).toEqual([]);\n  });\n});\n```\n\nAlso untested: the `survivorshipRuleSchema.refine` — `strategy: \"prefer_source\"` without `preferredSourceId` must fail; with it, must pass. And `RULE_WILDCARD`/`RULE_STRATEGY_HINT` are just constants (skip).\n\n**`types/run.ts`** — `isTerminalRunStatus`, `runStageIndex` (edge case: `runStageIndex(\"failed\")` must return `-1`, per the doc comment — untested, and a regression here would break the run progress bar silently).\n\n```ts\n// web/types/run.test.ts\nimport { describe, it, expect } from \"vitest\";\nimport { isTerminalRunStatus, runStageIndex, RUN_STAGES } from \"./run\";\n\ndescribe(\"isTerminalRunStatus\", () => {\n  it(\"complete and failed are terminal; everything else is not\", () => {\n    expect(isTerminalRunStatus(\"complete\")).toBe(true);\n    expect(isTerminalRunStatus(\"failed\")).toBe(true);\n    for (const s of RUN_STAGES.filter((s) => s !== \"complete\")) {\n      expect(isTerminalRunStatus(s)).toBe(false);\n    }\n  });\n});\n\ndescribe(\"runStageIndex\", () => {\n  it(\"failed carries no position and returns -1\", () => {\n    expect(runStageIndex(\"failed\")).toBe(-1);\n  });\n  it(\"queued is stage 0\", () => {\n    expect(runStageIndex(\"queued\")).toBe(0);\n  });\n});\n```\n\n**Zod contract edge cases** (`types/source.ts`, `types/resolution.ts`) — untested:\n\n```ts\n// web/types/source.test.ts\nimport { describe, it, expect } from \"vitest\";\nimport { createSourceSchema } from \"./source\";\n\ndescribe(\"createSourceSchema\", () => {\n  it(\"rejects an empty objects array in config\", () => {\n    expect(createSourceSchema.safeParse({ name: \"x\", kind: \"synthetic\", config: { objects: [] } }).success).toBe(false);\n  });\n  it(\"rejects a name over 80 chars\", () => {\n    expect(createSourceSchema.safeParse({ name: \"a\".repeat(81), kind: \"synthetic\", config: { objects: [\"Account\"] } }).success).toBe(false);\n  });\n  it(\"rejects an unknown kind\", () => {\n    expect(createSourceSchema.safeParse({ name: \"x\", kind: \"mysql\", config: { objects: [\"a\"] } }).success).toBe(false);\n  });\n});\n```\n\n```ts\n// web/types/resolution.test.ts — reviewActionSchema discriminated union\nimport { describe, it, expect } from \"vitest\";\nimport { reviewActionSchema } from \"./resolution\";\n\ndescribe(\"reviewActionSchema\", () => {\n  it(\"override requires a non-empty overrideValue\", () => {\n    expect(reviewActionSchema.safeParse({ action: \"override\", overrideValue: \"\" }).success).toBe(false);\n    expect(reviewActionSchema.safeParse({ action: \"override\" }).success).toBe(false);\n  });\n  it(\"approve/reject ignore an extraneous overrideValue field silently or reject it — pin the actual behavior\", () => {\n    const result = reviewActionSchema.safeParse({ action: \"approve\", overrideValue: \"x\" });\n    expect(result.success).toBe(true); // discriminated union on other branch: verify this is truly intended\n  });\n  it(\"rejects reviewedBy in the body — must never be client-suppliable (see doc comment)\", () => {\n    const result = reviewActionSchema.safeParse({ action: \"approve\", reviewedBy: \"attacker\" });\n    // reviewedBy isn't in the schema shape at all — confirm it's stripped, not merely ignored by types\n  });\n});\n```\n\n**`app/api/_lib/respond.ts`** — `isUuid` and `parseJson` are pure/near-pure and untested:\n\n```ts\n// web/app/api/_lib/respond.test.ts\nimport { describe, it, expect } from \"vitest\";\nimport { isUuid, parseJson, badRequest } from \"./respond\";\nimport { z } from \"zod\";\n\ndescribe(\"isUuid\", () => {\n  it.each([\n    [\"not-a-uuid\", false],\n    [\"a41f1234-c9ab-4a12-8b34-1234567890ab\", true],\n    [\"A41F1234-C9AB-4A12-8B34-1234567890AB\", true], // case-insensitive\n    [\"\", false],\n  ])(\"%s -> %s\", (v, expected) => expect(isUuid(v)).toBe(expected));\n});\n\ndescribe(\"parseJson\", () => {\n  const schema = z.object({ name: z.string() });\n\n  it(\"returns a 400 response when the body is not valid JSON\", async () => {\n    const req = new Request(\"http://x\", { method: \"POST\", body: \"{not json\" });\n    const result = await parseJson(req, schema);\n    expect(result.ok).toBe(false);\n    if (!result.ok) expect(result.response.status).toBe(400);\n  });\n\n  it(\"returns field-addressable issues on schema failure\", async () => {\n    const req = new Request(\"http://x\", { method: \"POST\", body: JSON.stringify({ name: 5 }) });\n    const result = await parseJson(req, schema);\n    expect(result.ok).toBe(false);\n    if (!result.ok) {\n      const body = await result.response.json();\n      expect(body.issues).toHaveProperty(\"name\");\n    }\n  });\n\n  it(\"passes through parsed data on success\", async () => {\n    const req = new Request(\"http://x\", { method: \"POST\", body: JSON.stringify({ name: \"ok\" }) });\n    const result = await parseJson(req, schema);\n    expect(result).toEqual({ ok: true, data: { name: \"ok\" } });\n  });\n});\n```\n\n**`components/severity-mark.tsx`** — `AGENTS.md` states the mark must *never* render without its text label; that's a testable accessibility invariant, currently unverified.\n\n```tsx\n// web/components/severity-mark.test.tsx\nimport { render, screen } from \"@testing-library/react\";\nimport { describe, it, expect } from \"vitest\";\nimport { SeverityMark } from \"./severity-mark\";\n\ndescribe(\"SeverityMark\", () => {\n  it.each([4, 3, 2, 1] as const)(\"severity %i always renders its text label alongside the mark\", (sev) => {\n    render(<SeverityMark severity={sev} />);\n    expect(screen.getByText(/Structural|Attribute|Cosmetic/)).toBeInTheDocument();\n  });\n});\n```\n\n",
