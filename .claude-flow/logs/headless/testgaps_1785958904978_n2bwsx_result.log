n the engine is unreachable — polling must degrade gracefully\", async () => {\n    vi.stubGlobal(\"fetch\", vi.fn().mockRejectedValue(new Error(\"down\")));\n    expect(await fetchEngineStatus(\"id\")).toBeNull();\n  });\n  it(\"returns null on a non-2xx status\", async () => {\n    vi.stubGlobal(\"fetch\", vi.fn().mockResolvedValue(new Response(null, { status: 500 })));\n    expect(await fetchEngineStatus(\"id\")).toBeNull();\n  });\n  it(\"returns null when the 200 body fails schema validation\", async () => {\n    vi.stubGlobal(\"fetch\", vi.fn().mockResolvedValue(Response.json({ garbage: true })));\n    expect(await fetchEngineStatus(\"id\")).toBeNull();\n  });\n});"
