neStatus(\"id\")).toBeNull();\n  });\n  it(\"returns null when the 200 body fails schema validation\", async () => {\n    vi.stubGlobal(\"fetch\", vi.fn().mockResolvedValue(Response.json({ garbage: true })));\n    expect(await fetchEngineStatus(\"id\")).toBeNull();\n  });\n});\n```\n\n**`lib/server/auth.ts`** — mock `@clerk/nextjs/server`:\n\n```ts\ndescribe(\"requireReviewer\", () => {\n  it(\"throws when there is no authenticated session (proxy.ts/handler disagreement case)\", async () => {\n    // mock auth() -> { isAuthenticated: false }\n    await expect(requireReviewer()).rejects.toThrow(/No authenticated reviewer/);\n  });\n  it(\"resolves username/email/id via reviewerLabel precedence\", async () => { /* mock currentUser() variants */ });\n});\ndescribe(\"getReviewer\", () => {\n  it(\"returns null (not a throw) when signed out\", async () => {});\n});\n```\n\n### A4. Route handlers — request/response contract\n\n```ts\n// web/app/api/sources/route.test.ts\ndescribe(\"POST /api/sources\", () => {\n  it(\"returns 400 with field issues for an invalid body, and never calls createSource\", async () => {});\n  it(\"returns 201 and the created row for a valid body\", async () => {});\n  it(\"rejects a body containing a credential-shaped field (password/token/secret) — defense in depth for the 'never store secrets' rule\", async () => {\n    // createSourceSchema has no such field, so this should already 400 — assert it, don't assume it\n  });\n});\n```\n\n### A5. Middleware\n\n```ts\n// web/proxy.test.ts — exercise the matcher/isPublicRoute logic directly\ndescribe(\"isPublicRoute\", () => {\n  it.each([\"/\", \"/sign-in\", \"/sign-in/factor-one\", \"/sign-up\"])(\"%s is public\", (p) => {});\n  it.each([\"/runs\", \"/api/sources\", \"/conflicts/123\"])(\"%s requires auth\", (p) => {});\n});\n```\n\n---\n\n## Part B — Engine layer (`engine/`), mostly unimplemented\n\n### B1. Already-implemented, untested today\n\n```python\n# engine/pipeline/test_schema.py\nimport pytest\nfrom pydantic import ValidationError\nfrom pipeline.schema import SurvivorshipRule, CanonModel\n\ndef test_prefer_source_requires_preferred_source_id():\n    with pytest.raises(ValidationError):\n        SurvivorshipRule(id=\"r1\", field=\"territory\", entityType=\"account\",\n                          strategy=\"prefer_source\", description=\"x\")\n\ndef test_prefer_source_with_id_is_valid():\n    SurvivorshipRule(id=\"r1\", field=\"territory\", entityType=\"account\",\n                      strategy=\"prefer_source\", preferredSourceId=\"src-1\", description=\"x\")\n\ndef test_camel_case_alias_round_trip():\n    # confirms the web<->engine wire contract: engine models accept/emit camelCase\n    rule = SurvivorshipRule.model_validate({\"id\": \"r1\", \"field\": \"*\", \"entityType\": \"*\",\n                                             \"strategy\": \"escalate\", \"description\": \"x\"})\n    assert rule.model_dump(by_alias=True)[\"entityType\"] == \"*\"\n\ndef test_extra_field_is_rejected():\n    # extra=\"forbid\" — a field either side doesn't expect must fail loudly, not be silently dropped\n    with pytest.raises(ValidationError):\n        SurvivorshipRule.model_validate({\"id\": \"r1\", \"field\": \"*\", \"entityType\": \"*\",\n                                          \"strategy\": \"escalate\", \"description\": \"x\", \"bogus\": 1})\n```\n\n```python\n# engine/pipeline/test_detect.py\nfrom pipeline.detect import severity_for_orphan\n\ndef test_orphan_with_children_is_severity_4():\n    assert severity_for_orphan(has_children=True) == 4\n\ndef test_orphan_without_children_is_severity_3():\n    assert severity_for_orphan(has_children=False) == 3\n```\n\n```python\n# engine/agent/test_graph.py\nfrom agent.graph import should_auto_apply, AUTO_APPLY_CONFIDENCE_THRESHOLD, AUTO_APPLY_MAX_SEVERITY\n\ndef test_gate_requires_both_conditions():\n    assert should_auto_apply(confidence=0.9, severity=1) is True\n    assert should_auto_apply(confidence=0.5, severity=1) is False   # confidence too low\n    assert should_auto_apply(confidence=0.9, severity=3) is False   # severity too high\n\ndef test_gate_is_inclusive_at_the_boundary():\n    assert should_auto_apply(confidence=AUTO_APPLY_CONFIDENCE_THRESHOLD, severity=AUTO_APPLY_MAX_SEVERITY) is True\n\ndef test_gate_never_fires_above_max_severity_regardless_of_confidence():\n    assert should_auto_apply(confidence=1.0, severity=AUTO_APPLY_MAX_SEVERITY + 1) is False\n```\n\n```python\n# engine/main_test.py — needs `httpx` (not currently a dependency — flag for approval)\nfrom fastapi.testclient import TestClient\nfrom main import app\n\nclient = TestClient(app)\n\ndef test_post_runs_accepts_and_returns_immediately():\n    resp = client.post(\"/runs\", json={\"runId\": \"a41f1234-c9ab-4a12-8b34-1234567890ab\"})\n    assert resp.status_code == 200\n    assert resp.json()[\"accepted\"] is True\n\ndef test_post_runs_rejects_a_non_uuid_run_id():\n    resp = client.post(\"/runs\", json={\"runId\": \"not-a-uuid\"})\n    assert resp.status_code == 422\n```\n\n### B2. Stubs — write the test now, from spec, so implementation is TDD\n\n`AGENTS.md` is specific enough about behavior (fold rules, severity table, gate thresholds, validate semantics) to write meaningful tests before the function bodies exist. This is the highest-leverage use of time on the engine side right now, since it turns the Phase 2/3 build into red→green rather than untested-by-default.\n\n```python\n# engine/pipeline/test_normalize.py\nfrom pipeline.normalize import fold_name, normalize\n\nclass TestFoldName:\n    def test_folds_case_and_whitespace(self):\n        assert fold_name(\"  Acme  Corp  \") == fold_name(\"ACME CORP\")\n\n    def test_folds_known_legal_suffixes(self):\n        assert fold_name(\"Acme Inc.\") == fold_name(\"Acme\")\n        assert fold_name(\"Acme GmbH\") == fold_name(\"Acme\")\n        assert fold_name(\"Acme Pvt Ltd\") == fold_name(\"Acme\")\n\n    def test_is_deterministic(self):\n        assert fold_name(\"Acme Inc.\") == fold_name(\"Acme Inc.\")\n\n    def test_does_not_fold_a_suffix_that_is_part_of_the_real_name(self):\n        # \"Corp\" the standalone word, not a substring match inside \"Corpus\"\n        assert fold_name(\"Corpus Christi\") != fold_name(\"Corpus\")\n\nclass TestNormalize:\n    def test_preserves_original_name_alongside_normalized_name(self):\n        # folding is RECORDED, NOT DESTRUCTIVE — both must survive\n        [entity] = normalize([{\"Name\": \"Acme Inc.\", \"Id\": \"1\"}], entity_type=\"account\", source_id=\"s1\")\n        assert entity.name == \"Acme Inc.\"\n        assert entity.normalized_name != entity.name\n\n    def test_empty_input_returns_empty_list(self):\n        assert normalize([], entity_type=\"account\", source_id=\"s1\") == []\n\n    def test_missing_optional_fields_default_to_none(self):\n        [entity] = normalize([{\"Name\": \"Acme\", \"Id\": \"1\"}], entity_type=\"account\", source_id=\"s1\")\n        assert entity.parent_external_id is None\n        assert entity.last_modified_at is None\n```\n\n```python\n# engine/pipeline/test_detect.py (extending)\nfrom pipeline.detect import classify\n\nclass TestClassify:\n    def test_parent_external_id_disagreement_is_structural_severity_4(self):\n        assert classify(\"parentExternalId\", \"ACC-1\", \"ACC-2\") == (\"structural\", 4)\n\n    def test_territory_disagreement_is_attribute_severity_3(self):\n        assert classify(\"territory\", \"APAC\", \"EMEA\") == (\"attribute\", 3)\n\n    def test_arbitrary_field_disagreement_is_attribute_severity_2(self):\n        assert classify(\"industry\", \"SaaS\", \"Fintech\") == (\"attribute\", 2)\n\n    def test_values_that_fold_to_the_same_form_are_cosmetic_severity_1(self):\n        assert classify(\"name\", \"Acme Inc.\", \"ACME INC\") == (\"cosmetic\", 1)\n\n    def test_identical_values_do_not_reach_classify_at_all(self):\n        # detect() should filter equal values upstream — document/assert the contract\n        pass\n```\n\n```python\n# engine/agent/test_graph_resolve.py\nfrom pipeline.schema import Conflict, SurvivorshipRule\nfrom agent.graph import select_rule, validate, resolve\n\nclass TestSelectRule:\n    def test_most_specific_rule_wins_over_a_wildcard(self):\n        wildcard = SurvivorshipRule(id=\"w\", field=\"*\", entityType=\"*\", strategy=\"escalate\", description=\"\")\n        specific = SurvivorshipRule(id=\"s\", field=\"territory\", entityType=\"account\",\n                                     strategy=\"most_recent\", description=\"\")\n        conflict = Conflict(runId=..., matchId=..., field=\"territory\",\n                             valueA=\"APAC\", valueB=\"EMEA\", conflictClass=\"attribute\",\n                             severity=3, detectedBy=\"rule\")\n        assert select_rule(conflict, [wildcard, specific]).id == \"s\"\n\n    def test_returns_none_when_no_rule_matches_the_field_or_entity_type(self):\n        rule = SurvivorshipRule(id=\"r\", field=\"territory\", entityType=\"account\",\n                                 strategy=\"most_recent\", description=\"\")\n        conflict = Conflict(runId=..., matchId=..., field=\"roleName\",\n                             valueA=\"AE\", valueB=\"SDR\", conflictClass=\"attribute\",\n                             severity=3, detectedBy=\"rule\")\n        assert select_rule(conflict, [rule]) is None\n\nclass TestValidate:\n    def test_accepts_one_of_the_two_observed_values(self):\n        assert validate(\"APAC\", value_a=\"APAC\", value_b=\"EMEA\") is True\n\n    def test_accepts_a_legal_normalization_of_an_observed_value(self):\n        assert validate(\"Acme\", value_a=\"Acme Inc.\", value_b=\"ACME\") is True\n\n    def test_rejects_an_invented_value_NON_NEGOTIABLE(self):\n        # this is the single most important test in the agent layer per AGENTS.md\n        assert validate(\"EMEA-NORTH\", value_a=\"APAC\", value_b=\"EMEA\") is False\n\nclass TestResolve:\n    def test_conflict_with_a_matching_rule_never_calls_the_model(self, mocker):\n        spy = mocker.patch(\"agent.graph._call_model\")  # once implemented\n        resolve([conflict_with_rule], [matching_rule])\n        spy.assert_not_called()\n\n    def test_low_confidence_proposal_escalates_rather_than_auto_applying(self):\n        pass\n\n    def test_a_proposal_that_fails_validate_escalates_rather_than_erroring(self):\n        pass\n```\n\n### B3. Connectors, db.py, generate.py, baselines.py, harness.py — stubs\n\nFor each, once implemented the minimum required tests per `AGENTS.md`'s own acceptance criteria:\n\n- **`db.py`**: `write_entities`/`write_matches`/`write_conflicts` never touch `sources`/`rulesets` (table-ownership enforcement — this deserves a static/lint-style test, e.g. grep the module for `sources.` / `rulesets.` write calls, in addition to a functional test against a test DB); `update_run_status` never overwrites `sourceAId`/`sourceBId`/`rulesetId`.\n- **`eval/generate.py::generate`**: same `seed` produces byte-identical output twice; manifest entry count matches injection rates within tolerance for a large N; the `ambiguous` category is actually present (not accidentally resolvable) — this is the row `AGENTS.md` says \"matters most.\"\n- **`eval/baselines.py::baseline_exact`**: flags every field inequality, including cosmetic ones it can't distinguish (that's the point of the floor).\n- **`eval/harness.py::run_system`**: `canon_full`'s escalation rate and false-auto-apply-rate are computable and non-negative; `sweep_auto_apply_threshold` is monotonic (raising the threshold never increases false-auto-apply-rate).\n- **connectors** (`salesforce.py`, `warehouse.py`, `synthetic.py`): conform to the `Connector` protocol (`isinstance(conn, Connector)` given `runtime_checkable`); `extract()` never yields a `CanonicalEntity` directly (only `RawRecord`) — connectors must not smuggle pipeline logic in.\n\n---\n\n## Part C — Integration test gaps (cross-layer / cross-language)\n\n1. **Tool-contract parity** — nothing currently verifies `web/types/*.ts` and `engine/pipeline/schema.py` actually agree. A fixture-based parity test would catch drift the moment one side changes without the other (`AGENTS.md`'s single hardest rule to enforce by hand):\n   ```\n   # engine/pipeline/test_contract_parity.py\n   # Load a shared fixtures/*.json (one per shape: SurvivorshipRule, RunStats, Conflict...),\n   # assert Pydantic .model_validate() accepts it, and separately assert the\n   # equivalent Zod schema (via a small Node fixture-check script) also accepts it.\n   ```\n2. **Source → ruleset → run creation, end to end**, against a real (test) Postgres: `POST /api/sources` → `POST /api/rulesets` → `createRun` → row exists with `status=queued`, `stats=EMPTY_RUN_STATS`, and `rulesetVersion` frozen even if a new ruleset version is saved afterward.\n3. **Engine-unreachable path, end to end**: `createRun` succeeds, `startRun` throws `EngineUnreachableError`, caller invokes `failUndispatchedRun` → run shows `status=failed` with the error, and `appendAudit` recorded `run_failed`. Nothing currently exercises this full chain.\n4. **Ruleset version race** (Part A2) is really an integration test — it requires two concurrent connections against a real advisory lock, not a mock.\n5. **`proxy.ts` route protection**, exercised via a real Next.js request (not just the matcher function): an unauthenticated request to `/api/sources` gets redirected/401'd; `/` and `/sign-in` do not.\n6. **Full pipeline vs. the synthetic manifest** — this is literally what `eval/harness.py` is for, and it doesn't exist yet either. Once Phase 2/3 land, `canon_full` run against `eval/generate.py` output, scored against `manifest.json`, is the integration test that matters most for this project — per `AGENTS.md`, re-run it and record before/after numbers on every detection/resolution change.\n\n---\n\n## Recommendation on tooling\n\n- **`web/`**: no test runner is installed. I'd suggest **Vitest** (fast, native ESM/TS, works well with Next.js Server Components via mocking) plus `@testing-library/react` for the few components with real logic. This needs your sign-off per `AGENTS.md`'s dependency policy — say the word and I'll add it and wire `npm run test`.\n- **`engine/`**: `pytest` is already a dev dependency but unused; `httpx` is needed for `fastapi.testclient.TestClient` and isn't currently listed — same approval needed before adding.\n\nWant me to (a) get your go-ahead on Vitest/httpx and scaffold the test config, or (b) start filling in one of these skeletons for real against the current code?\n",
