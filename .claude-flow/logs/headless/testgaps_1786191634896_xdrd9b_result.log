        "content": "import pytest\nfrom pydantic import ValidationError\nfrom uuid import uuid4\nfrom pipeline.schema import (\n    SurvivorshipRule, rule_specificity, CanonicalEntity, Match, MatchSignals, Conflict,\n)\n\nclass TestSurvivorshipRuleValidator:\n    def test_prefer_source_without_preferred_source_id_raises(self):\n        with pytest.raises(ValidationError):\n            SurvivorshipRule(\n                id=\"r1\", field=\"territory\", entity_type=\"account\",\n                strategy=\"prefer_source\", description=\"x\",\n            )\n\n    def test_prefer_source_with_empty_string_preferred_source_id_raises(self):\n        # \"\" is falsy — confirm the `not preferred_source_id` check catches it too, not just None\n        with pytest.raises(ValidationError):\n            SurvivorshipRule(\n                id=\"r1\", field=\"territory\", entity_type=\"account\",\n                strategy=\"prefer_source\", preferred_source_id=\"\", description=\"x\",\n            )\n\n    def test_prefer_source_with_preferred_source_id_passes(self):\n        rule = SurvivorshipRule(\n            id=\"r1\", field=\"territory\", entity_type=\"account\",\n            strategy=\"prefer_source\", preferred_source_id=\"src-a\", description=\"x\",\n        )\n        assert rule.preferred_source_id == \"src-a\"\n\n    @pytest.mark.parametrize(\"strategy\", [\"most_recent\", \"most_complete\", \"escalate\"])\n    def test_non_prefer_source_strategies_dont_require_preferred_source_id(self, strategy):\n        rule = SurvivorshipRule(\n            id=\"r1\", field=\"*\", entity_type=\"*\", strategy=strategy, description=\"x\",\n        )\n        assert rule.preferred_source_id is None\n\n\nclass TestRuleSpecificity:\n    @pytest.mark.parametrize(\"field,entity_type,expected\", [\n        (\"*\", \"*\", 0),\n        (\"*\", \"account\", 1),\n        (\"territory\", \"*\", 2),\n        (\"territory\", \"account\", 3),\n    ])\n    def test_specificity_score(self, field, entity_type, expected):\n        rule = SurvivorshipRule(\n            id=\"r\", field=field, entity_type=entity_type,\n            strategy=\"most_recent\", description=\"x\",\n        )\n        assert rule_specificity(rule) == expected\n\n\nclass TestCanonModelAliasing:\n    def test_accepts_camelcase_alias_and_snake_case_field_name(self):\n        via_alias = CanonicalEntity.model_validate({\n            \"externalId\": \"e1\", \"entityType\": \"account\", \"name\": \"Acme\",\n            \"normalizedName\": \"acme\", \"sourceId\": \"s1\",\n        })\n        via_field = CanonicalEntity(\n            external_id=\"e1\", entity_type=\"account\", name=\"Acme\",\n            normalized_name=\"acme\", source_id=\"s1\",\n        )\n        assert via_alias == via_field\n\n    def test_extra_fields_forbidden(self):\n        with pytest.raises(ValidationError):\n            CanonicalEntity.model_validate({\n                \"externalId\": \"e1\", \"entityType\": \"account\", \"name\": \"Acme\",\n                \"normalizedName\": \"acme\", \"sourceId\": \"s1\", \"bogusField\": 1,\n            })\n\n\nclass TestBoundedFields:\n    @pytest.mark.parametrize(\"confidence\", [-0.01, 1.01])\n    def test_match_confidence_out_of_range_rejected(self, confidence):\n        with pytest.raises(ValidationError):\n            Match(\n                run_id=uuid4(), entity_a_id=uuid4(), entity_b_id=uuid4(),\n                confidence=confidence, method=\"fuzzy\",\n                signals=MatchSignals(exact_key=False, cosine=0.5, fuzzy_ratio=0.5),\n            )\n\n    @pytest.mark.parametrize(\"severity\", [0, 5])\n    def test_conflict_severity_outside_1_4_rejected(self, severity):\n        with pytest.raises(ValidationError):\n            Conflict(\n                run_id=uuid4(), match_id=uuid4(), field=\"territory\",\n                value_a=\"a\", value_b=\"b\", conflict_class=\"attribute\",\n                severity=severity, detected_by=\"rule\",\n            )\n\n    def test_