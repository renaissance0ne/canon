        "title": "engine/tests/pipeline/test_normalize.py",
        "content": "from pipeline.normalize import fold_name, normalize\n\nclass TestFoldName:\n    def test_case_and_whitespace_folded(self):\n        assert fold_name(\"  Acme   Inc.  \") == fold_name(\"ACME INC\")\n\n    @pytest.mark.parametrize(\"suffix\", [\"Inc.\", \"LLC\", \"Pvt Ltd\", \"GmbH\", \"Corp\"])\n    def test_legal_suffixes_folded(self, suffix):\n        assert fold_name(f\"Trellis Labs {suffix}\") == fold_name(\"Trellis Labs\")\n\n    def test_determinism(self):\n        # \"the same input always folds the same way, in every layer\" — AGENTS.md\n        assert fold_name(\"Acme Inc.\") == fold_name(\"Acme Inc.\")\n\n    def test_empty_string(self):\n        assert fold_name(\"\") == \"\"\n\n    def test_name_that_is_only_a_suffix_is_not_destroyed(self):\n        # mirrors web/lib/validate-value.ts::foldValue's \"whole value IS the suffix\" guard\n        assert fold_name(\"Ltd\") != \"\"\n\nclass TestNormalize:\n    def test_preserves_original_name_alongside_folded(self):\n        # \"folding is RECORDED, NOT DESTRUCTIVE\" — name must survive verbatim\n        [entity] = normalize([{\"Name\": \"ACME INC\", \"Id\": \"001\"}],\n                              entity_type=\"account\", source_id=\"src-a\")\n        assert entity.name == \"ACME INC\"\n        assert entity.normalized_name == fold_name(\"ACME INC\")\n\n    def test_missing_optional_fields_default_safely(self):\n        [entity] = normalize([{\"Id\": \"001\", \"Name\": \"X\"}], entity_type=\"account\", source_id=\"src-a\")\n        assert entity.parent_external_id is None\n        assert entity.last_modified_at is None\n\n    def test_empty_iterable_returns_empty_list(self):\n        assert normalize([], entity_type=\"account\", source_id=\"src-a\") == []\n\n    def test_source_id_stamped_on_every_entity(self):\n        entities = normalize([{\"Id\": \"1\"}, {\"Id\": \"2\"}], entity_type=\"account\", source_id=\"src-a\")\n        assert all(e.source_id == \"src-a\" for e in entities)\n```\n