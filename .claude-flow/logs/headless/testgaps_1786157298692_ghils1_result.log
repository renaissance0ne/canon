        "title": "engine/tests/eval/test_harness.py",
        "content": "from eval.harness import run_system, ablate_without_validate, sweep_auto_apply_threshold\n\ndef test_run_system_reports_all_metric_fields(manifest, data_dir):\n    metrics = run_system(\"baseline_exact\", manifest, data_dir)\n    assert 0.0 <= metrics.precision <= 1.0\n    assert 0.0 <= metrics.escalation_rate <= 1.0\n\ndef test_ablate_without_validate_detects_invented_values(manifest, data_dir):\n    # the empirical case for validate being non-optional\n    metrics = ablate_without_validate(manifest, data_dir)\n    assert metrics.false_auto_apply_rate > 0  # proves removing validate lets bad values through\n\ndef test_sweep_covers_full_requested_range(manifest, data_dir):\n    sweep = sweep_auto_apply_threshold(manifest, data_dir, start=0.5, stop=0.95, step=0.05)\n    assert set(sweep.keys()) == {round(0.5 + 0.05 * i, 2) for i in range(10)}\n\ndef test_sweep_higher_threshold_never_increases_false_auto_apply_rate(manifest, data_dir):\n    # monotonicity is the property the tradeoff curve depends on\n    sweep = sweep_auto_apply_threshold(manifest, data_dir)\n    rates = [sweep[t].false_auto_apply_rate for t in sorted(sweep)]\n    assert all(a >= b for a, b in zip(rates, rates[1:]))\n```\n\n```python\n",
