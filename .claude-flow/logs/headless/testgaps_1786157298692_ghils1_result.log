        "code": "// web/types/run.test.ts\nimport { describe, it, expect } from \"vitest\";\nimport {\n  isTerminalRunStatus, runStageIndex, isStatKnown, failedStage, RUN_STAGES,\n} from \"@/types/run\";\n\ndescribe(\"isTerminalRunStatus\", () => {\n  it.each([\"complete\", \"failed\"])(\"%s is terminal\", (s) => expect(isTerminalRunStatus(s as never)).toBe(true));\n  it.each([\"queued\", \"extracting\", \"matching\", \"detecting\", \"resolving\"])(\n    \"%s is not terminal\", (s) => expect(isTerminalRunStatus(s as never)).toBe(false),\n  );\n});\n\ndescribe(\"isStatKnown\", () => {\n  it(\"a stat is unknown before its producing stage completes\", () => {\n    expect(isStatKnown(\"matches\", \"extracting\")).toBe(false);\n  });\n  it(\"a stat is known once its producing stage is behind us\", () => {\n    expect(isStatKnown(\"matches\", \"detecting\")).toBe(true);\n  });\n  it(\"all stats are known on complete\", () => {\n    expect(isStatKnown(\"tokensUsed\", \"complete\")).toBe(true);\n  });\n  it(\"all stats are known on failed — show what was measured before it died\", () => {\n    expect(isStatKnown(\"escalated\", \"failed\")).toBe(true);\n  });\n});\n\ndescribe(\"failedStage\", () => {\n  it(\"parses stage= from the engine error convention\", () => {\n    expect(failedStage(\"source=Databricks GTM stage=extract\")).toBe(\"extracting\");\n  });\n  it(\"returns null when error is null\", () => {\n    expect(failedStage(null)).toBeNull();\n  });\n  it(\"returns null when error has no stage= marker\", () => {\n    expect(failedStage(\"connection refused\")).toBeNull();\n  });\n  it(\"returns null for an unrecognized stage verb rather than guessing\", () => {\n    expect(failedStage(\"stage=bogus\")).toBeNull();\n  });\n  it(\"is case-insensitive on the verb\", () => {\n    expect(failedStage(\"stage=EXTRACT\")).toBe(\"extracting\");\n  });\n});\n\ndescribe(\"runStageIndex\", () => {\n  it(\"failed is not a stage and returns -1\", () => {\n    expect(runStageIndex(\"failed\")).toBe(-1);\n  });\n  it(\"indexes match RUN_STAGES order\", () => {\n    RUN_STAGES.forEach((stage, i) => expect(runStageIndex(stage)).toBe(i));\n  });\n});"
