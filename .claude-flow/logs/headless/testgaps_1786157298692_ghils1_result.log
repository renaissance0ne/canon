        "title": "4. API route handlers — integration tests (Next.js route handler + Zod boundary)",
        "content": "\n```ts\n// web/app/api/runs/route.test.ts\ndescribe(\"POST /api/runs\", () => {\n  it(\"rejects sourceAId === sourceBId with 400 before touching the DB\", async () => {\n    const res = await POST(mockRequest({ sourceAId: sameId, sourceBId: sameId, rulesetId }));\n    expect(res.status).toBe(400);\n  });\n\n  it(\"400 when sourceAId does not exist, even though FK would also catch it\", async () => {\n    const res = await POST(mockRequest({ sourceAId: randomUuid(), sourceBId: validId, rulesetId }));\n    expect(res.status).toBe(400);\n    expect(await res.json()).toMatchObject({ error: expect.stringContaining(\"Source A\") });\n  });\n\n  it(\"400 when rulesetId does not exist\", async () => {\n    const res = await POST(mockRequest({ sourceAId: validId, sourceBId: validId2, rulesetId: randomUuid() }));\n    expect(res.status).toBe(400);\n  });\n\n  it(\"still returns 201 with the run id when the engine is unreachable — run is recorded as failed, not lost\", async () => {\n    mockEngineUnreachable();\n    const res = await POST(mockRequest(validBody));\n    expect(res.status).toBe(201);\n    const { runId } = await res.json();\n    const run = await getRun(runId);\n    expect(run!.status).toBe(\"failed\");\n  });\n\n  it(\"appends a run_failed audit entry when dispatch fails, distinct from run_started\", async () => {\n    mockEngineUnreachable();\n    const res = await POST(mockRequest(validBody));\n    const { runId } = await res.json();\n    const audit = await listRunAudit(runId);\n    expect(audit.map((e) => e.action)).toEqual([\"run_started\", \"run_failed\"]);\n  });\n\n  it(\"re-throws non-EngineUnreachableError errors rather than silently marking the run failed\", async () => {\n    mockEngineThrows(new TypeError(\"unexpected\"));\n    await expect(POST(mockRequest(validBody))).rejects.toThrow(TypeError);\n  });\n\n  it(\"malformed JSON body returns 400, not a 500 from a thrown parse error\", async () => {\n    const res = await POST(new Request(\"http://x/api/runs\", { method: \"POST\", body: \"{not json\" }));\n    expect(res.status).toBe(400);\n  });\n});\n```\n\n```ts\n// web/app/api/runs/[runId]/status/route.test.ts\ndescribe(\"GET /api/runs/:runId/status\", () => {\n  it(\"404 for a non-UUID runId, before any DB query\", async () => {\n    const res = await GET(mockRequest(), { params: Promise.resolve({ runId: \"not-a-uuid\" }) });\n    expect(res.status).toBe(404);\n  });\n\n  it(\"terminal run (complete/failed) never calls the engine, reads Postgres only\", async () => {\n    const engineSpy = vi.spyOn(engineModule, \"fetchEngineStatus\");\n    await seedCompleteRun(runId);\n    await GET(mockRequest(), { params: Promise.resolve({ runId }) });\n    expect(engineSpy).not.toHaveBeenCalled();\n  });\n\n  it(\"in-flight run falls back to the Postgres row when the engine is unreachable\", async () => {\n    await seedRunWithStatus(runId, \"matching\");\n    vi.spyOn(engineModule, \"fetchEngineStatus\").mockResolvedValue(null);\n    const res = await GET(mockRequest(), { params: Promise.resolve({ runId }) });\n    expect((await res.json()).status).toBe(\"matching\");\n  });\n\n  it(\"response always sets cache-control: no-store\", async () => {\n    const res = await GET(mockRequest(), { params: Promise.resolve({ runId }) });\n    expect(res.headers.get(\"cache-control\")).toBe(\"no-store\");\n  });\n});\n```\n\n```ts\n// web/app/api/runs/[runId]/export/route.test.ts\ndescribe(\"GET /api/runs/:runId/export\", () => {\n  it(\"rejects an unknown format value with 400\", async () => {\n    const res = await GET(mockRequest(\"?format=xml\"), ctx);\n    expect(res.status).toBe(400);\n  });\n  it(\"rejects an unknown section name with 400\", async () => {\n    const res = await GET(mockRequest(\"?sections=hierarchy,bogus\"), ctx);\n    expect(res.status).toBe(400);\n  });\n  it(\"no sections param defaults to hierarchy+decisions\", async () => {\n    const res = await GET(mockRequest(\"\"), ctx);\n    const body = JSON.parse(await res.text());\n    expect(body.sections).toEqual([\"hierarchy\", \"decisions\"]);\n  });\n  it(\"csv format ignores non-decisions sections entirely\", async () => {\n    const res = await GET(mockRequest(\"?format=csv&sections=hierarchy,orphans\"), ctx);\n    expect(res.headers.get(\"content-type\")).toContain(\"text/csv\");\n  });\n  it(\"section order in the URL does not affect output order (canonicalized)\", async () => {\n    const res1 = await GET(mockRequest(\"?sections=decisions,hierarchy\"), ctx);\n    const res2 = await GET(mockRequest(\"?sections=hierarchy,decisions\"), ctx);\n    expect(await res1.text()).toBe(await res2.text());\n  });\n  it(\"duplicate section names are de-duplicated\", async () => {\n    const res = await GET(mockRequest(\"?sections=hierarchy,hierarchy\"), ctx);\n    const body = JSON.parse(await res.text());\n    expect(body.sections).toEqual([\"hierarchy\"]);\n  });\n});\n```\n\n```ts\n// web/app/api/conflicts/[conflictId]/resolution/route.test.ts\ndescribe(\"PATCH /api/conflicts/:conflictId/resolution\", () => {\n  it(\"404 for non-UUID conflictId\", async () => {\n    const res = await PATCH(mockRequest({}), { params: Promise.resolve({ conflictId: \"bad\" }) });\n    expect(res.status).toBe(404);\n  });\n  it(\"400 for a body that fails reviewActionSchema (unknown action)\", async () => {\n    const res = await PATCH(mockRequest({ action: \"delete\" }), ctx);\n    expect(res.status).toBe(400);\n  });\n  it(\"override without overrideValue is a 400 schema error, not a 500\", async () => {\n    const res = await PATCH(mockRequest({ action: \"override\" }), ctx);\n    expect(res.status).toBe(400);\n  });\n  it(\"propagates recordReview's error code (404/409/400) verbatim\", async () => {\n    mockRecordReviewReturns({ ok: false, code: 409, message: \"still resolving\" });\n    const res = await PATCH(mockRequest({ action: \"approve\" }), ctx);\n    expect(res.status).toBe(409);\n  });\n  it(\"success response includes reviewedBy from the session, never from the body\", async () => {\n    const res = await PATCH(mockRequest({ action: \"approve\" }), ctx);\n    expect((await res.json()).reviewedBy).toBe(mockReviewer.label);\n  });\n});\n```\n\n```ts\n// web/app/api/_lib/respond.test.ts\ndescribe(\"parseJson\", () => {\n  it(\"non-JSON body returns 400 'Body must be JSON.'\", async () => {\n    const result = await parseJson(new Request(\"http://x\", { method: \"POST\", body: \"{\" }), schema);\n    expect(result.ok).toBe(false);\n  });\n  it(\"valid JSON that fails schema returns field-addressable issues\", async () => {\n    const result = await parseJson(mockRequest({ name: \"\" }), createSourceSchema);\n    expect(result.ok).toBe(false);\n    if (!result.ok) expect(await result.response.json()).toMatchObject({ issues: expect.any(Object) });\n  });\n  it(\"nested path issues join with dots ('config.objects')\", async () => {\n    const result = await parseJson(mockRequest({ name: \"x\", kind: \"salesforce\", config: {} }), createSourceSchema);\n    if (!result.ok) {\n      const body = await result.response.json();\n      expect(Object.keys(body.issues)).toContain(\"config.objects\");\n    }\n  });\n});\n```\n\n---\n\n",
