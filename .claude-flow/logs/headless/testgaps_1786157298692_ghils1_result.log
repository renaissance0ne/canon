        "title": "2. Web layer — pure logic (highest ROI, zero DB mocking needed)",
        "content": "\n```ts\n// web/lib/validate-value.test.ts\nimport { describe, it, expect } from \"vitest\";\nimport { foldValue, checkObservedValue, observedValues } from \"@/lib/validate-value\";\n\ndescribe(\"foldValue\", () => {\n  it(\"folds case, whitespace and punctuation identically\", () => {\n    expect(foldValue(\"ACME-INC\")).toBe(foldValue(\"Acme Inc.\"));\n  });\n\n  it(\"strips a single legal suffix\", () => {\n    expect(foldValue(\"Trellis Labs Inc.\")).toBe(\"trellis labs\");\n  });\n\n  it(\"strips a compound suffix like 'Pvt Ltd' as one unit, longest-match-first\", () => {\n    // regression guard: must not strip \"ltd\" and leave a dangling \"pvt\"\n    expect(foldValue(\"Trellis Labs Pvt Ltd\")).toBe(\"trellis labs\");\n  });\n\n  it(\"does not destroy a value that IS entirely a suffix\", () => {\n    expect(foldValue(\"Ltd\")).toBe(\"ltd\");\n  });\n\n  it(\"handles empty string\", () => {\n    expect(foldValue(\"\")).toBe(\"\");\n  });\n\n  it(\"handles unicode/diacritics via NFKD normalization\", () => {\n    expect(foldValue(\"Café Inc.\")).toBe(foldValue(\"CAFE\"));\n  });\n});\n\ndescribe(\"checkObservedValue\", () => {\n  const observed = [\"APAC-SOUTH\", \"APAC\"];\n\n  it(\"accepts an exact observed value\", () => {\n    expect(checkObservedValue(\"APAC\", observed)).toEqual({ ok: true, matches: \"APAC\" });\n  });\n\n  it(\"accepts a legal normalization and returns the ORIGINAL observed value, not the typed one\", () => {\n    const result = checkObservedValue(\"acme inc\", [\"Acme Inc.\", \"ACME LLC\"]);\n    expect(result).toEqual({ ok: true, matches: \"Acme Inc.\" });\n  });\n\n  it(\"rejects an invented value — the non-negotiable rule\", () => {\n    const result = checkObservedValue(\"ACC-9999\", [\"ACC-1\", \"ACC-2\"]);\n    expect(result.ok).toBe(false);\n  });\n\n  it(\"rejects whitespace-only input\", () => {\n    expect(checkObservedValue(\"   \", observed).ok).toBe(false);\n  });\n\n  it(\"rejects when neither side holds a value (both orphan/absent)\", () => {\n    const result = checkObservedValue(\"anything\", []);\n    expect(result).toEqual({ ok: false, reason: expect.stringContaining(\"Neither side\") });\n  });\n\n  it(\"ignores blank entries within the observed array (orphan side contributes nothing)\", () => {\n    const result = checkObservedValue(\"APAC\", [\"APAC\", \"\"]);\n    expect(result.ok).toBe(true);\n  });\n});\n\ndescribe(\"observedValues\", () => {\n  it(\"flattens both sides and drops blanks\", () => {\n    const row = { a: { values: [\"APAC\", \"\"] }, b: { values: [\"  \"] } };\n    expect(observedValues(row)).toEqual([\"APAC\"]);\n  });\n});\n```\n\n```ts\n// web/lib/diff-chars.test.ts\nimport { describe, it, expect } from \"vitest\";\nimport { diffSegments } from \"@/lib/diff-chars\";\n\ndescribe(\"diffSegments\", () => {\n  it(\"equal values put everything in prefix, nothing to emphasize\", () => {\n    expect(diffSegments(\"APAC\", \"APAC\")).toEqual({ prefix: \"APAC\", middle: \"\", suffix: \"\" });\n  });\n\n  it(\"suffix difference — APAC vs APAC-SOUTH\", () => {\n    expect(diffSegments(\"APAC-SOUTH\", \"APAC\")).toEqual({\n      prefix: \"APAC\", middle: \"-SOUTH\", suffix: \"\",\n    });\n  });\n\n  it(\"head difference with shared suffix — ACC-4417 vs ACC-2201\", () => {\n    const result = diffSegments(\"ACC-4417\", \"ACC-2201\");\n    expect(result.prefix + result.middle + result.suffix).toBe(\"ACC-4417\");\n    expect(result.prefix).toBe(\"ACC-\");\n  });\n\n  it(\"completely different strings — empty prefix and suffix\", () => {\n    const result = diffSegments(\"XYZ\", \"ABC\");\n    expect(result.prefix).toBe(\"\");\n  });\n\n  it(\"empty vs non-empty string\", () => {\n    expect(diffSegments(\"\", \"APAC\")).toEqual({ prefix: \"\", middle: \"\", suffix: \"\" });\n  });\n\n  it(\"one string fully contains the other as a prefix AND suffix overlap — no double count\", () => {\n    // regression guard for the `suffix < max - prefix` bound\n    const result = diffSegments(\"aa\", \"aaa\");\n    expect(result.prefix.length + result.suffix.length).toBeLessThanOrEqual(2);\n  });\n});\n```\n\n```ts\n// web/lib/format.test.ts\nimport { describe, it, expect } from \"vitest\";\nimport {\n  shortRunId, formatElapsed, formatCount, formatStat,\n  formatRelative, formatConfidence,\n} from \"@/lib/format\";\n\ndescribe(\"shortRunId\", () => {\n  it(\"formats as 4·2 with interpunct, not hyphen\", () => {\n    expect(shortRunId(\"a41f1234-c9ab-...\")).toMatch(/^[0-9a-f]{4}·[0-9a-f]{2}$/);\n  });\n});\n\ndescribe(\"formatElapsed\", () => {\n  it.each([\n    [0, \"00:00\"], [59_000, \"00:59\"], [60_000, \"01:00\"],\n    [3_600_000, \"1:00:00\"], [3_661_000, \"1:01:01\"],\n  ])(\"%i ms -> %s\", (ms, expected) => expect(formatElapsed(ms)).toBe(expected));\n\n  it(\"clamps negative elapsed to zero rather than showing a negative time\", () => {\n    expect(formatElapsed(-500)).toBe(\"00:00\");\n  });\n});\n\ndescribe(\"formatStat\", () => {\n  it(\"renders em dash for null/undefined, not '0'\", () => {\n    expect(formatStat(null)).toBe(\"—\");\n    expect(formatStat(undefined)).toBe(\"—\");\n  });\n  it(\"renders an actual zero as '0', distinct from unknown\", () => {\n    expect(formatStat(0)).toBe(\"0\");\n  });\n});\n\ndescribe(\"formatRelative\", () => {\n  const now = new Date(\"2026-08-08T12:00:00Z\");\n  it.each([\n    [30, \"just now\"], [90, \"2m ago\"], [3661, \"1h ago\"], [90000, \"1d ago\"],\n  ])(\"%i seconds ago -> %s\", (secondsAgo, expected) => {\n    expect(formatRelative(new Date(now.getTime() - secondsAgo * 1000), now)).toBe(expected);\n  });\n});\n\ndescribe(\"formatConfidence\", () => {\n  it(\"always shows two decimals, never a percentage\", () => {\n    expect(formatConfidence(0.9)).toBe(\"0.90\");\n    expect(formatConfidence(1)).toBe(\"1.00\");\n  });\n});\n```\n\n```ts\n// web/types/run.test.ts\nimport { describe, it, expect } from \"vitest\";\nimport {\n  isTerminalRunStatus, runStageIndex, isStatKnown, failedStage, RUN_STAGES,\n} from \"@/types/run\";\n\ndescribe(\"isTerminalRunStatus\", () => {\n  it.each([\"complete\", \"failed\"])(\"%s is terminal\", (s) => expect(isTerminalRunStatus(s as never)).toBe(true));\n  it.each([\"queued\", \"extracting\", \"matching\", \"detecting\", \"resolving\"])(\n    \"%s is not terminal\", (s) => expect(isTerminalRunStatus(s as never)).toBe(false),\n  );\n});\n\ndescribe(\"isStatKnown\", () => {\n  it(\"a stat is unknown before its producing stage completes\", () => {\n    expect(isStatKnown(\"matches\", \"extracting\")).toBe(false);\n  });\n  it(\"a stat is known once its producing stage is behind us\", () => {\n    expect(isStatKnown(\"matches\", \"detecting\")).toBe(true);\n  });\n  it(\"all stats are known on complete\", () => {\n    expect(isStatKnown(\"tokensUsed\", \"complete\")).toBe(true);\n  });\n  it(\"all stats are known on failed — show what was measured before it died\", () => {\n    expect(isStatKnown(\"escalated\", \"failed\")).toBe(true);\n  });\n});\n\ndescribe(\"failedStage\", () => {\n  it(\"parses stage= from the engine error convention\", () => {\n    expect(failedStage(\"source=Databricks GTM stage=extract\")).toBe(\"extracting\");\n  });\n  it(\"returns null when error is null\", () => {\n    expect(failedStage(null)).toBeNull();\n  });\n  it(\"returns null when error has no stage= marker\", () => {\n    expect(failedStage(\"connection refused\")).toBeNull();\n  });\n  it(\"returns null for an unrecognized stage verb rather than guessing\", () => {\n    expect(failedStage(\"stage=bogus\")).toBeNull();\n  });\n  it(\"is case-insensitive on the verb\", () => {\n    expect(failedStage(\"stage=EXTRACT\")).toBe(\"extracting\");\n  });\n});\n\ndescribe(\"runStageIndex\", () => {\n  it(\"failed is not a stage and returns -1\", () => {\n    expect(runStageIndex(\"failed\")).toBe(-1);\n  });\n  it(\"indexes match RUN_STAGES order\", () => {\n    RUN_STAGES.forEach((stage, i) => expect(runStageIndex(stage)).toBe(i));\n  });\n});\n```\n\n```ts\n// web/types/rules.test.ts\nimport { describe, it, expect } from \"vitest\";\nimport { ruleSpecificity, orderRulesByEvaluation } from \"@/types/rules\";\n\ndescribe(\"orderRulesByEvaluation\", () => {\n  it(\"most specific rule sorts first\", () => {\n    const wildcard = { id: \"w\", field: \"*\", entityType: \"*\", strategy: \"escalate\", description: \"\" };\n    const specific = { id: \"s\", field: \"territory\", entityType: \"account\", strategy: \"escalate\", description: \"\" };\n    const [first] = orderRulesByEvaluation([wildcard, specific] as never);\n    expect(first.id).toBe(\"s\");\n  });\n\n  it(\"ties keep author order — first match wins deterministically\", () => {\n    const a = { id: \"a\", field: \"*\", entityType: \"*\", strategy: \"escalate\", description: \"\" };\n    const b = { id: \"b\", field: \"*\", entityType: \"*\", strategy: \"escalate\", description: \"\" };\n    const result = orderRulesByEvaluation([a, b] as never);\n    expect(result.map((r) => r.id)).toEqual([\"a\", \"b\"]);\n  });\n\n  it(\"empty ruleset returns empty array\", () => {\n    expect(orderRulesByEvaluation([])).toEqual([]);\n  });\n});\n```\n\n```ts\n// web/types/queue.test.ts\nimport { describe, it, expect } from \"vitest\";\nimport { conflictFieldLabel, severityReason } from \"@/types/queue\";\n\ndescribe(\"conflictFieldLabel\", () => {\n  it(\"orphan renders as 'entity absent', ignoring the field name\", () => {\n    const row = { field: \"territory\", conflictClass: \"orphan\", a: { values: [], present: false }, b: { values: [\"x\"], present: true } };\n    expect(conflictFieldLabel(row as never)).toBe(\"entity absent\");\n  });\n\n  it(\"duplicate with real count collapse renders 'N → M'\", () => {\n    const row = { field: \"x\", conflictClass: \"duplicate\", a: { values: [\"1\", \"2\"], present: true }, b: { values: [\"1\"], present: true } };\n    expect(conflictFieldLabel(row as never)).toBe(\"2 → 1\");\n  });\n\n  it(\"duplicate where to-count is zero falls back to generic label\", () => {\n    const row = { field: \"x\", conflictClass: \"duplicate\", a: { values: [\"1\", \"2\"], present: true }, b: { values: [], present: false } };\n    expect(conflictFieldLabel(row as never)).toBe(\"duplicate record\");\n  });\n\n  it(\"plain attribute/structural/cosmetic conflicts show the field name\", () => {\n    const row = { field: \"territory\", conflictClass: \"attribute\", a: { values: [\"x\"], present: true }, b: { values: [\"y\"], present: true } };\n    expect(conflictFieldLabel(row as never)).toBe(\"territory\");\n  });\n});\n\ndescribe(\"severityReason\", () => {\n  it(\"orphan with children mentions the count\", () => {\n    expect(severityReason({ conflictClass: \"orphan\", severity: 4, childCount: 3 })).toContain(\"3 children\");\n  });\n  it(\"orphan with exactly one child uses singular 'child'\", () => {\n    expect(severityReason({ conflictClass: \"orphan\", severity: 3, childCount: 1 })).toContain(\"1 child\");\n    expect(severityReason({ conflictClass: \"orphan\", severity: 3, childCount: 1 })).not.toContain(\"children\");\n  });\n  it(\"attribute severity 3 vs 2 give different explanations\", () => {\n    const s3 = severityReason({ conflictClass: \"attribute\", severity: 3, childCount: 0 });\n    const s2 = severityReason({ conflictClass: \"attribute\", severity: 2, childCount: 0 });\n    expect(s3).not.toBe(s2);\n  });\n});\n```\n\n```ts\n// web/lib/rule-trace.test.ts\nimport { describe, it, expect } from \"vitest\";\nimport { deriveRuleTrace } from \"@/lib/rule-trace\";\n\ndescribe(\"deriveRuleTrace\", () => {\n  it(\"no resolution yet -> single not-yet-resolved step\", () => {\n    const trace = deriveRuleTrace({ field: \"territory\", entityType: \"account\", resolution: null } as never);\n    expect(trace).toHaveLength(1);\n    expect(trace[0].ran).toBe(false);\n  });\n\n  it(\"rule decided -> apply ran, propose/validate reflect that path\", () => {\n    const row = {\n      field: \"territory\", entityType: \"account\",\n      resolution: { appliedRuleId: \"r1\", appliedRuleStrategy: \"most_recent\", proposedValue: \"APAC\", confidence: 0.9 },\n    };\n    const trace = deriveRuleTrace(row as never);\n    expect(trace.find((s) => s.node === \"apply\")!.ran).toBe(true);\n    expect(trace.find((s) => s.node === \"propose\")!.ran).toBe(false);\n  });\n\n  it(\"no rule matched, model proposed -> propose ran, apply did not\", () => {\n    const row = {\n      field: \"territory\", entityType: \"account\",\n      resolution: { appliedRuleId: null, appliedRuleStrategy: null, proposedValue: \"APAC\", confidence: 0.7 },\n    };\n    const trace = deriveRuleTrace(row as never);\n    expect(trace.find((s) => s.node === \"propose\")!.ran).toBe(true);\n    expect(trace.find((s) => s.node === \"apply\")!.ran).toBe(false);\n  });\n\n  it(\"escalated with no proposed value -> validate did not run (nothing to check)\", () => {\n    const row = {\n      field: \"territory\", entityType: \"account\",\n      resolution: { appliedRuleId: null, appliedRuleStrategy: null, proposedValue: \"\", confidence: 0 },\n    };\n    const trace = deriveRuleTrace(row as never);\n    expect(trace.find((s) => s.node === \"validate\")!.ran).toBe(false);\n  });\n});\n```\n\n```ts\n// web/lib/audit-detail.test.ts, web/lib/uuid.test.ts, web/lib/reviewer-label.test.ts\n// (compact — same pattern as above)\nimport { describe, it, expect } from \"vitest\";\nimport { auditDetailParts, auditDetailLine } from \"@/lib/audit-detail\";\nimport { isUuid } from \"@/lib/uuid\";\nimport { reviewerLabel } from \"@/lib/reviewer-label\";\n\ndescribe(\"auditDetailParts\", () => {\n  it(\"empty detail object returns empty array, not a stray dot\", () => {\n    expect(auditDetailParts({ detail: {}, action: \"run_started\" } as never)).toEqual([]);\n  });\n  it(\"shows both proposed and chosen value when they differ (override)\", () => {\n    const entry = { detail: { proposedValue: \"A\", chosenValue: \"B\" }, action: \"human_overridden\" };\n    expect(auditDetailLine(entry as never)).toContain(\"A → B\");\n  });\n  it(\"shows only the value when proposed === chosen (approve)\", () => {\n    const entry = { detail: { proposedValue: \"A\", chosenValue: \"A\" }, action: \"human_approved\" };\n    expect(auditDetailLine(entry as never)).not.toContain(\"→\");\n  });\n  it(\"rejected shows the proposed value with no chosen value, not '→ null'\", () => {\n    const entry = { detail: { proposedValue: \"A\" }, action: \"human_rejected\" };\n    expect(auditDetailLine(entry as never)).toContain(\"A\");\n    expect(auditDetailLine(entry as never)).not.toContain(\"→\");\n  });\n  it(\"ignores keys it does not recognize rather than dumping them\", () => {\n    const entry = { detail: { someUnknownKey: \"should not appear\" }, action: \"run_started\" };\n    expect(auditDetailLine(entry as never)).toBeNull();\n  });\n  it(\"singular vs plural noun for count is not tested — count noun always attaches regardless of n\", () => {\n    // n=1 still says \"1 conflicts\" today (COUNT_NOUN has no singular form) — flag as\n    // a real bug candidate, not just a gap: write the test, see it fail, decide.\n    const entry = { detail: { count: 1 }, action: \"conflict_detected\" };\n    expect(auditDetailLine(entry as never)).toBe(\"1 conflicts\"); // documents current (possibly wrong) behavior\n  });\n});\n\ndescribe(\"isUuid\", () => {\n  it.each([\n    [\"11111111-1111-1111-1111-111111111111\", true],\n    [\"banana\", false],\n    [\"\", false],\n    [\"11111111-1111-1111-1111-11111111111\", false],   // one char short\n    [\"11111111-1111-1111-1111-1111111111111\", false], // one char long\n    [\"G1111111-1111-1111-1111-111111111111\", false],  // invalid hex char\n  ])(\"%s -> %s\", (input, expected) => expect(isUuid(input)).toBe(expected));\n});\n\ndescribe(\"reviewerLabel\", () => {\n  it(\"prefers username over email\", () => {\n    expect(reviewerLabel({ username: \"j.rao\", primaryEmailAddress: { emailAddress: \"j@x.com\" } }, \"fallback\")).toBe(\"j.rao\");\n  });\n  it(\"falls back to email when no username\", () => {\n    expect(reviewerLabel({ username: null, primaryEmailAddress: { emailAddress: \"j@x.com\" } }, \"fallback\")).toBe(\"j@x.com\");\n  });\n  it(\"falls back to the passed-in id when user is null\", () => {\n    expect(reviewerLabel(null, \"user_abc123\")).toBe(\"user_abc123\");\n  });\n});\n```\n\n---\n\n",
        "level": 2
      },
      {
        "title": "3. Web layer — server logic (needs a DB test double / integration DB)",
        "content": "\nThese currently have **no seam for mocking** `getDb()` — it's imported directly, module-level, with no injection point. That itself is a coverage gap: recommend either (a) a test Postgres via `testcontainers`/`pglite`, or (b) refactoring `getDb()` to accept an override for unit tests. Flagging as a design decision, not doing it silently.\n\n```ts\n// web/lib/server/rulesets.test.ts (needs a real/test Postgres — integration test)\ndescribe(\"createRulesetVersion\", () => {\n  it(\"increments version per name, not globally\", async () => {\n    await createRulesetVersion({ name: \"policy-a\", rules: [rule] });\n    await createRulesetVersion({ name: \"policy-b\", rules: [rule] });\n    const v2 = await createRulesetVersion({ name: \"policy-a\", rules: [rule] });\n    expect(v2.version).toBe(2); // not 3 — policy-b's version doesn't bleed in\n  });\n\n  it(\"deactivates the previously active ruleset across ALL names, not just this one\", async () => {\n    // \"Exactly one ruleset is active across the whole install\" — this is the\n    // single most important invariant in this file and has no test today\n    const first = await createRulesetVersion({ name: \"policy-a\", rules: [rule] });\n    const second = await createRulesetVersion({ name: \"policy-b\", rules: [rule] });\n    const refetchedFirst = await getRuleset(first.id);\n    expect(refetchedFirst!.isActive).toBe(false);\n    expect(second.isActive).toBe(true);\n  });\n\n  it(\"concurrent saves of the same policy name never produce two v4s\", async () => {\n    // the advisory-lock's entire reason for existing — a race condition test\n    const [a, b] = await Promise.all([\n      createRulesetVersion({ name: \"policy-a\", rules: [rule] }),\n      createRulesetVersion({ name: \"policy-a\", rules: [rule] }),\n    ]);\n    expect(new Set([a.version, b.version]).size).toBe(2); // must differ, not collide\n  });\n\n  it(\"first version of a brand-new policy name starts at 1\", async () => {\n    const first = await createRulesetVersion({ name: \"brand-new\", rules: [rule] });\n    expect(first.version).toBe(1);\n  });\n});\n```\n\n```ts\n// web/lib/server/runs.test.ts\ndescribe(\"failUndispatchedRun\", () => {\n  it(\"does nothing if the run has already moved past 'queued'\", async () => {\n    // guard test: the engine has already advanced this run to 'matching';\n    // a late dispatch-timeout error must NOT overwrite real progress\n    const run = await createRun(input);\n    await updateRunStatusDirectly(run.id, \"matching\"); // simulate engine progress\n    await failUndispatchedRun(run.id, \"timeout\");\n    const reread = await getRun(run.id);\n    expect(reread!.status).toBe(\"matching\"); // unchanged\n  });\n\n  it(\"marks a genuinely stuck queued run as failed with the error and finishedAt set\", async () => {\n    const run = await createRun(input);\n    await failUndispatchedRun(run.id, \"EngineDispatch: no response within 8s\");\n    const reread = await getRun(run.id);\n    expect(reread!.status).toBe(\"failed\");\n    expect(reread!.finishedAt).not.toBeNull();\n  });\n});\n\ndescribe(\"getLatestRunWithConflicts\", () => {\n  it(\"skips a more-recent run that has zero conflicts\", async () => {\n    const older = await seedRunWithConflicts();\n    await seedRunWithNoConflicts(); // started after `older`\n    const latest = await getLatestRunWithConflicts();\n    expect(latest!.id).toBe(older.id);\n  });\n\n  it(\"returns null when there are no runs with conflicts at all\", async () => {\n    expect(await getLatestRunWithConflicts()).toBeNull();\n  });\n});\n```\n\n```ts\n// web/lib/server/conflicts.test.ts — recordReview is the highest-risk file in the whole web layer\ndescribe(\"recordReview\", () => {\n  it(\"returns 404 for a conflict id that does not exist\", async () => {\n    const result = await recordReview({ conflictId: randomUuid(), action: { action: \"approve\" }, reviewer });\n    expect(result).toEqual({ ok: false, code: 404, message: expect.any(String) });\n  });\n\n  it(\"returns 409 when the conflict has no resolution yet (run still resolving)\", async () => {\n    const conflict = await seedConflictWithoutResolution();\n    const result = await recordReview({ conflictId: conflict.id, action: { action: \"approve\" }, reviewer });\n    expect(result).toMatchObject({ ok: false, code: 409 });\n  });\n\n  it(\"approving an escalated conflict with no proposedValue is rejected — approving nothing is not a decision\", async () => {\n    const conflict = await seedEscalatedConflictWithEmptyProposal();\n    const result = await recordReview({ conflictId: conflict.id, action: { action: \"approve\" }, reviewer });\n    expect(result).toMatchObject({ ok: false, code: 409 });\n  });\n\n  it(\"override with a value neither source held is rejected — same rule as engine validate\", async () => {\n    const conflict = await seedConflictWithObservedValues([\"APAC\", \"APAC-SOUTH\"]);\n    const result = await recordReview({\n      conflictId: conflict.id, reviewer,\n      action: { action: \"override\", overrideValue: \"INVENTED-VALUE\" },\n    });\n    expect(result).toMatchObject({ ok: false, code: 400 });\n  });\n\n  it(\"override stores the OBSERVED value it folds onto, not the hand-typed string\", async () => {\n    const conflict = await seedConflictWithObservedValues([\"Acme Inc.\"]);\n    await recordReview({ conflictId: conflict.id, reviewer, action: { action: \"override\", overrideValue: \"acme inc\" } });\n    const stored = await getReviewTarget(conflict.id);\n    expect(stored!.resolution!.status).toBe(\"overridden\");\n    // fetch the resolution row directly and assert overrideValue === \"Acme Inc.\", not \"acme inc\"\n  });\n\n  it(\"does not mutate proposedValue, rationale, confidence, or appliedRuleId on any action\", async () => {\n    const conflict = await seedResolvedConflict({ proposedValue: \"APAC\", rationale: \"...\", confidence: 0.91 });\n    await recordReview({ conflictId: conflict.id, reviewer, action: { action: \"reject\" } });\n    const target = await getReviewTarget(conflict.id);\n    expect(target!.resolution!.proposedValue).toBe(\"APAC\"); // untouched\n  });\n\n  it(\"clears overrideValue when a reviewer moves off a prior override (e.g. reject after override)\", async () => {\n    const conflict = await seedResolvedConflict({});\n    await recordReview({ conflictId: conflict.id, reviewer, action: { action: \"override\", overrideValue: \"X\" } });\n    await recordReview({ conflictId: conflict.id, reviewer, action: { action: \"reject\" } });\n    const target = await getReviewTarget(conflict.id);\n    // the schema comment says overrideValue is \"cleared when a reviewer moves off an override\"\n    expect(target).toBeDefined(); // assert overrideValue is null after the second call\n  });\n\n  it(\"appends exactly one audit_log row per review action, with the correct action mapping\", async () => {\n    const conflict = await seedResolvedConflict({});\n    await recordReview({ conflictId: conflict.id, reviewer, action: { action: \"override\", overrideValue: \"X\" } });\n    const audit = await listRunAudit(conflict.runId);\n    expect(audit.filter((e) => e.action === \"human_overridden\")).toHaveLength(1);\n  });\n\n  it(\"reviewedBy always comes from the session reviewer, never from the request body\", async () => {\n    // there is no reviewedBy param on the function signature at all — this test\n    // is a signature-shape guard as much as a behavior test\n  });\n});\n\ndescribe(\"getQueuePage / toQueueRow — orphan and duplicate edge cases\", () => {\n  it(\"orphan present only on side B: side A is marked not-present, identity comes from B\", async () => {\n    // exercises the `a.present ? a : b` fallback in toQueueRow\n  });\n\n  it(\"duplicate conflict's valueA with multiple newline-separated values splits correctly\", async () => {\n    // splitValues() trims blank lines and filters empties — needs a case with\n    // trailing/leading blank lines in the raw column\n  });\n\n  it(\"a conflict whose entity belongs to neither of the run's sources renders 'unknown source' rather than throwing\", async () => {\n    // sourceName()'s defensive branch — currently only reachable via an engine bug,\n    // so this is the only test that will ever exercise it\n  });\n\n  it(\"severity/confidence sort is stable across pages — no row repeats between page 1 and page 2\", async () => {\n    // the tiebreak on conflicts.id exists specifically to prevent this\n  });\n\n  it(\"chip counts ignore their own filter (severity count ignores the severity filter, status count ignores the status filter)\", async () => {\n    // this is the trickiest invariant in getQueueCounts and has no test\n  });\n});\n```\n\n```ts\n// web/lib/server/export.test.ts\ndescribe(\"applyDecisions\", () => {\n  it(\"account with no matching decision keeps its original parentExternalId\", () => {\n    const result = applyDecisions([{ externalId: \"A\", fields: { name: \"A\" }, parentExternalId: \"P1\" }], []);\n    expect(result[0]).toMatchObject({ parentExternalId: \"P1\", reparented: false });\n  });\n\n  it(\"account with an applied parentExternalId decision is reparented=true\", () => {\n    const decisions = [{ externalId: \"A\", field: \"parentExternalId\", appliedValue: \"P2\" } as never];\n    const result = applyDecisions([{ externalId: \"A\", fields: { name: \"A\" }, parentExternalId: \"P1\" }], decisions);\n    expect(result[0]).toMatchObject({ parentExternalId: \"P2\", reparented: true });\n  });\n\n  it(\"decision with appliedValue === existing parent is NOT flagged reparented (no-op resolution)\", () => {\n    const decisions = [{ externalId: \"A\", field: \"parentExternalId\", appliedValue: \"P1\" } as never];\n    const result = applyDecisions([{ externalId: \"A\", fields: { name: \"A\" }, parentExternalId: \"P1\" }], decisions);\n    expect(result[0].reparented).toBe(false);\n  });\n\n  it(\"escalated/proposed/rejected decisions (appliedValue null) do not affect the hierarchy\", () => {\n    const decisions = [{ externalId: \"A\", field: \"parentExternalId\", appliedValue: null } as never];\n    const result = applyDecisions([{ externalId: \"A\", fields: { name: \"A\" }, parentExternalId: \"P1\" }], decisions);\n    expect(result[0].parentExternalId).toBe(\"P1\");\n  });\n\n  it(\"non-parentExternalId decisions never touch the hierarchy\", () => {\n    const decisions = [{ externalId: \"A\", field: \"territory\", appliedValue: \"APAC\" } as never];\n    const result = applyDecisions([{ externalId: \"A\", fields: { name: \"A\" }, parentExternalId: \"P1\" }], decisions);\n    expect(result[0].parentExternalId).toBe(\"P1\");\n  });\n});\n\ndescribe(\"appliedValue\", () => {\n  it.each([\n    [\"auto_applied\", \"proposed\", null, \"proposed\"],\n    [\"approved\", \"proposed\", null, \"proposed\"],\n    [\"overridden\", \"proposed\", \"typed\", \"typed\"],\n    [\"escalated\", \"proposed\", null, null],\n    [\"rejected\", \"proposed\", null, null],\n    [\"proposed\", \"proposed\", null, null],\n    [null, \"proposed\", null, null],\n  ])(\"status=%s proposed=%s override=%s -> %s\", (status, proposed, override, expected) => {\n    expect(appliedValue(status, proposed, override)).toBe(expected);\n  });\n});\n\ndescribe(\"decisionsToCsv / csvCell\", () => {\n  it(\"quotes and escapes commas, quotes, and newlines\", () => {\n    const csv = decisionsToCsv([{ rationale: 'Contains, a \"quote\"\\nand newline' } as never]);\n    expect(csv).toContain('\"Contains, a \"\"quote\"\"');\n  });\n  it(\"null cells render as empty string, not the literal 'null'\", () => {\n    const csv = decisionsToCsv([{ status: null, proposedValue: null } as never]);\n    expect(csv).not.toContain(\"null\");\n  });\n  it(\"ends with a trailing CRLF\", () => {\n    expect(decisionsToCsv([])).toMatch(/\\r\\n$/);\n  });\n  it(\"uses CRLF line endings throughout, not bare \\\\n\", () => {\n    const csv = decisionsToCsv([row1, row2] as never);\n    expect(csv.split(\"\\r\\n\").length).toBeGreaterThan(2);\n  });\n});\n\ndescribe(\"estimateExportBytes\", () => {\n  it(\"sums only the requested sections, not all four\", () => {\n    const sizing = { hierarchy: 10, decisions: 20, orphans: 30, stats: 1 };\n    const bytes = estimateExportBytes(sizing, [\"hierarchy\"]);\n    expect(bytes).toBe(10 * 120); // BYTES_PER_ROW.hierarchy\n  });\n  it(\"empty section list returns 0\", () => {\n    expect(estimateExportBytes({ hierarchy: 10, decisions: 20, orphans: 30, stats: 1 }, [])).toBe(0);\n  });\n});\n```\n\n```ts\n// web/lib/server/engine.test.ts — error-handling-heavy, mock global fetch\ndescribe(\"startRun\", () => {\n  it(\"throws EngineUnreachableError when fetch itself rejects (network down)\", async () => {\n    vi.stubGlobal(\"fetch\", vi.fn().mockRejectedValue(new Error(\"ECONNREFUSED\")));\n    await expect(startRun(\"run-1\")).rejects.toThrow(EngineUnreachableError);\n  });\n\n  it(\"throws EngineUnreachableError with the timeout message on AbortSignal.timeout\", async () => {\n    const timeoutError = Object.assign(new Error(\"timed out\"), { name: \"TimeoutError\" });\n    vi.stubGlobal(\"fetch\", vi.fn().mockRejectedValue(timeoutError));\n    await expect(startRun(\"run-1\")).rejects.toThrow(/no response within 8s/);\n  });\n\n  it(\"throws when the engine responds non-2xx\", async () => {\n    vi.stubGlobal(\"fetch\", vi.fn().mockResolvedValue(new Response(\"bad\", { status: 500 })));\n    await expect(startRun(\"run-1\")).rejects.toThrow(EngineUnreachableError);\n  });\n\n  it(\"throws when the engine returns 200 with a body that fails the tool-contract schema\", async () => {\n    vi.stubGlobal(\"fetch\", vi.fn().mockResolvedValue(Response.json({ wrong: \"shape\" })));\n    await expect(startRun(\"run-1\")).rejects.toThrow(/tool contract/);\n  });\n\n  it(\"succeeds silently on a valid 200 response\", async () => {\n    vi.stubGlobal(\"fetch\", vi.fn().mockResolvedValue(Response.json({ runId: \"run-1\", accepted: true })));\n    await expect(startRun(\"run-1\")).resolves.toBeUndefined();\n  });\n\n  it(\"throws EngineUnreachableError when ENGINE_URL is unset, before ever calling fetch\", async () => {\n    vi.stubEnv(\"ENGINE_URL\", \"\");\n    const fetchSpy = vi.fn();\n    vi.stubGlobal(\"fetch\", fetchSpy);\n    await expect(startRun(\"run-1\")).rejects.toThrow(EngineUnreachableError);\n    expect(fetchSpy).not.toHaveBeenCalled();\n  });\n});\n\ndescribe(\"fetchEngineStatus\", () => {\n  it(\"returns null (never throws) when fetch rejects\", async () => {\n    vi.stubGlobal(\"fetch\", vi.fn().mockRejectedValue(new Error(\"down\")));\n    await expect(fetchEngineStatus(\"run-1\")).resolves.toBeNull();\n  });\n  it(\"returns null on non-2xx\", async () => {\n    vi.stubGlobal(\"fetch\", vi.fn().mockResolvedValue(new Response(\"\", { status: 503 })));\n    await expect(fetchEngineStatus(\"run-1\")).resolves.toBeNull();\n  });\n  it(\"returns null when the body fails schema validation\", async () => {\n    vi.stubGlobal(\"fetch\", vi.fn().mockResolvedValue(Response.json({ bogus: true })));\n    await expect(fetchEngineStatus(\"run-1\")).resolves.toBeNull();\n  });\n  it(\"returns the parsed status on a valid response\", async () => {\n    const status = { runId: \"run-1\", status: \"matching\", stats: EMPTY_RUN_STATS, error: null };\n    vi.stubGlobal(\"fetch\", vi.fn().mockResolvedValue(Response.json(status)));\n    await expect(fetchEngineStatus(\"run-1\")).resolves.toEqual(status);\n  });\n});\n```\n\n---\n\n",
