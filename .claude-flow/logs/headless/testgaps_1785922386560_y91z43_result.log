`getReviewer` — `web/lib/server/auth.ts`** (auth boundary — no session should never silently produce an audit-log row)\n```ts\n// web/lib/server/auth.test.ts — mock @clerk/nextjs/server\nimport { describe, it, expect, vi } from \"vitest\";\n\nvi.mock(\"@clerk/nextjs/server\", () => ({\n  auth: vi.fn(),\n  currentUser: vi.fn(),\n}));\n\ndescribe(\"requireReviewer\", () => {\n  it(\"throws when there is no session\", async () => {\n    const { auth } = await import(\"@clerk/nextjs/server\");\n    (auth as any).mockResolvedValue({ isAuthenticated: false, userId: null });\n    const { requireReviewer } = await import(\"./auth\");\n    await expect(requireReviewer()).rejects.toThrow(/No authenticated reviewer/);\n  });\n\n  it(\"returns userId + resolved label when authenticated\", async () => {\n    const { auth, currentUser } = await import(\"@clerk/nextjs/server\");\n    (auth as any).mockResolvedValue({ isAuthenticated: true, userId: \"uid_1\" });\n    (currentUser as any).mockResolvedValue({ username: \"j.rao\", primaryEmailAddress: null });\n    const { requireReviewer } = await import(\"./auth\");\n    await expect(requireReviewer()).resolves.toEqual({ userId: \"uid_1\", label: \"j.rao\" });\n  });\n});\n\ndescribe(\"getReviewer\", () => {\n  it(\"returns null instead of throwing when signed out\", async () => {\n    const { auth } = await import(\"@clerk/nextjs/server\");\n    (auth as any).mockResolvedValue({ isAuthenticated: false, userId: null });\n    const { getReviewer } = await import(\"./auth\");\n    await expect(getReviewer()).resolves.toBeNull();\n  });\n});\n```\n\n**8. `listSources` / `countSourcesBySide` — `web/lib/server/sources.ts`** (needs a DB — this is the one integration-test gap that already exists, not a future one)\n```ts\n// web/lib/server/sources.integration.test.ts — against a real test Postgres (Drizzle), not a mock\ndescribe(\"countSourcesBySide\", () => {\n  it(\"classifies salesforce/hubspot as crm, databricks/snowflake as warehouse, synthetic separately\", async () => {\n    // seed sources of each kind, then:\n    const counts = await countSourcesBySide();\n    expect(counts).toEqual({ crm: 2, warehouse: 2, synthetic: 1 });\n  });\n\n  it(\"returns zeros when no sources are configured\", async () => { /* ... */ });\n\n  it(\"parses every row through sourceSchema — a row that fails Zod validation should throw, not silently drop\", async () => {\n    // insert a row with a malformed `config` shape directly via the db client,\n    // bypassing sourceSchema, and assert listSources() rejects rather than returning it\n  });\n});\n```\n\n",
