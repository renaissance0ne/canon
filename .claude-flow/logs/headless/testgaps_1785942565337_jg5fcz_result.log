        "code": "# engine/tests/pipeline/test_schema.py\nimport pytest\nfrom pydantic import ValidationError\nfrom pipeline.schema import SurvivorshipRule, rule_specificity\n\ndef _rule(**overrides):\n    base = dict(id=\"r1\", field=\"*\", entity_type=\"*\", strategy=\"most_recent\", description=\"d\")\n    base.update(overrides)\n    return SurvivorshipRule(**base)\n\n@pytest.mark.parametrize(\"field,entity_type,expected\", [\n    (\"*\", \"*\", 0),\n    (\"*\", \"account\", 1),\n    (\"territory\", \"*\", 2),\n    (\"territory\", \"account\", 3),\n])\ndef test_specificity_ranking(field, entity_type, expected):\n    assert rule_specificity(_rule(field=field, entity_type=entity_type)) == expected\n\ndef test_prefer_source_without_preferred_source_id_raises():\n    with pytest.raises(ValidationError):\n        _rule(strategy=\"prefer_source\", preferred_source_id=None)\n\ndef test_prefer_source_with_preferred_source_id_is_valid():\n    rule = _rule(strategy=\"prefer_source\", preferred_source_id=\"src-a\")\n    assert rule.preferred_source_id == \"src-a\"\n\ndef test_camel_case_wire_format_round_trips():\n    rule = _rule(preferred_source_id=None)\n    dumped = rule.model_dump(by_alias=True)\n    assert \"preferredSourceId\" in dumped\n    assert SurvivorshipRule.model_validate(dumped) == rule\n\ndef test_extra_field_rejected():\n    with pytest.raises(ValidationError):\n        SurvivorshipRule(**_rule().model_dump(), unexpectedField=\"x\")"
