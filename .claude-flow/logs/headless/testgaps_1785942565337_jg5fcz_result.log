      {
        "title": "engine/tests/pipeline/test_schema.py",
        "content": "import pytest\nfrom pydantic import ValidationError\nfrom pipeline.schema import SurvivorshipRule, rule_specificity\n\ndef _rule(**overrides):\n    base = dict(id=\"r1\", field=\"*\", entity_type=\"*\", strategy=\"most_recent\", description=\"d\")\n    base.update(overrides)\n    return SurvivorshipRule(**base)\n\n@pytest.mark.parametrize(\"field,entity_type,expected\", [\n    (\"*\", \"*\", 0),\n    (\"*\", \"account\", 1),\n    (\"territory\", \"*\", 2),\n    (\"territory\", \"account\", 3),\n])\ndef test_specificity_ranking(field, entity_type, expected):\n    assert rule_specificity(_rule(field=field, entity_type=entity_type)) == expected\n\ndef test_prefer_source_without_preferred_source_id_raises():\n    with pytest.raises(ValidationError):\n        _rule(strategy=\"prefer_source\", preferred_source_id=None)\n\ndef test_prefer_source_with_preferred_source_id_is_valid():\n    rule = _rule(strategy=\"prefer_source\", preferred_source_id=\"src-a\")\n    assert rule.preferred_source_id == \"src-a\"\n\ndef test_camel_case_wire_format_round_trips():\n    rule = _rule(preferred_source_id=None)\n    dumped = rule.model_dump(by_alias=True)\n    assert \"preferredSourceId\" in dumped\n    assert SurvivorshipRule.model_validate(dumped) == rule\n\ndef test_extra_field_rejected():\n    with pytest.raises(ValidationError):\n        SurvivorshipRule(**_rule().model_dump(), unexpectedField=\"x\")\n```\n\n**1d. `reviewerLabel` — `web/lib/reviewer-label.ts`**\n\n```ts\n// web/lib/__tests__/reviewer-label.test.ts\nimport { describe, it, expect } from \"vitest\";\nimport { reviewerLabel } from \"@/lib/reviewer-label\";\n\ndescribe(\"reviewerLabel\", () => {\n  it(\"prefers username over email\", () => {\n    expect(reviewerLabel({ username: \"j.rao\", primaryEmailAddress: { emailAddress: \"j@x.com\" } }, \"uid_1\"))\n      .toBe(\"j.rao\");\n  });\n\n  it(\"falls back to email when username is null\", () => {\n    expect(reviewerLabel({ username: null, primaryEmailAddress: { emailAddress: \"j@x.com\" } }, \"uid_1\"))\n      .toBe(\"j@x.com\");\n  });\n\n  it(\"falls back to the stable id when user is null\", () => {\n    expect(reviewerLabel(null, \"uid_1\")).toBe(\"uid_1\");\n  });\n\n  it(\"falls back to the stable id when username and email are both absent\", () => {\n    expect(reviewerLabel({ username: undefined, primaryEmailAddress: null }, \"uid_1\")).toBe(\"uid_1\");\n  });\n\n  it(\"treats empty-string username as absent (falsy), not as a valid label\", () => {\n    // NOTE: current impl uses ?? which does NOT fall through on \"\" — this\n    // documents actual behavior; flag if empty-string usernames are possible.\n    expect(reviewerLabel({ username: \"\", primaryEmailAddress: { emailAddress: \"j@x.com\" } }, \"uid_1\")).toBe(\"\");\n  });\n});\n```\n\nThat last case is a real edge case worth flagging: `??` only falls through on `null`/`undefined`, not `\"\"`. If Clerk can ever return an empty-string username, the audit trail would show a blank actor. Worth a one-line `||` vs `??` decision.\n\n**1e. `cn` — `web/lib/cn.ts`**\n\n```ts\n// web/lib/__tests__/cn.test.ts\nimport { describe, it, expect } from \"vitest\";\nimport { cn } from \"@/lib/cn\";\n\ndescribe(\"cn\", () => {\n  it(\"merges conflicting Tailwind classes, last wins\", () => {\n    expect(cn(\"p-2\", \"p-4\")).toBe(\"p-4\");\n  });\n  it(\"drops falsy values\", () => {\n    expect(cn(\"a\", false && \"b\", undefined, null, \"c\")).toBe(\"a c\");\n  });\n});\n```\n\n**1f. `listSources` / `countSourcesBySide` — `web/lib/server/sources.ts`** — needs a DB mock (mock `getDb()` or run against a test schema).\n\n```ts\n// web/lib/server/__tests__/sources.test.ts\nimport { describe, it, expect, vi, beforeEach } from \"vitest\";\n\nvi.mock(\"@/lib/db\", () => ({ getDb: vi.fn() }));\nvi.mock(\"next/server\", () => ({ connection: vi.fn() }));\n\nimport { listSources, countSourcesBySide } from \"@/lib/server/sources\";\nimport { getDb } from \"@/lib/db\";\n\ndescribe(\"listSources\", () => {\n  it(\"returns sources ordered by createdAt, parsed through sourceSchema\", async () => {\n    // arrange getDb() mock to return fixture rows; assert shape/order\n  });\n\n  it(\"throws if a row fails Zod validation (e.g. credentials leaked into config)\", async () => {\n    // arrange a row with a `password` key inside `config` — sourceSchema should\n    // reject or at minimum this test should assert it does NOT silently pass through\n  });\n});\n\ndescribe(\"countSourcesBySide\", () => {\n  it(\"buckets salesforce/hubspot as crm, databricks/snowflake as warehouse\", async () => {});\n  it(\"returns zeros for all buckets when there are no sources\", async () => {});\n  it(\"counts a synthetic source separately, not under crm or warehouse\", async () => {});\n});\n```\n\n**1g. `requireReviewer` / `getReviewer` — `web/lib/server/auth.ts`**\n\n```ts\n// web/lib/server/__tests__/auth.test.ts\nimport { describe, it, expect, vi } from \"vitest\";\n\nvi.mock(\"@clerk/nextjs/server\", () => ({ auth: vi.fn(), currentUser: vi.fn() }));\n\nimport { requireReviewer, getReviewer } from \"@/lib/server/auth\";\nimport { auth, currentUser } from \"@clerk/nextjs/server\";\n\ndescribe(\"requireReviewer\", () => {\n  it(\"throws when there is no session (proxy.ts/handler disagreement)\", async () => {\n    vi.mocked(auth).mockResolvedValue({ isAuthenticated: false, userId: null } as any);\n    await expect(requireReviewer()).rejects.toThrow(/No authenticated reviewer/);\n  });\n\n  it(\"returns userId + label when authenticated\", async () => {\n    vi.mocked(auth).mockResolvedValue({ isAuthenticated: true, userId: \"uid_1\" } as any);\n    vi.mocked(currentUser).mockResolvedValue({ username: \"j.rao\" } as any);\n    await expect(requireReviewer()).resolves.toEqual({ userId: \"uid_1\", label: \"j.rao\" });\n  });\n});\n\ndescribe(\"getReviewer\", () => {\n  it(\"returns null instead of throwing when signed out\", async () => {\n    vi.mocked(auth).mockResolvedValue({ isAuthenticated: false } as any);\n    await expect(getReviewer()).resolves.toBeNull();\n  });\n});\n```\n\n---\n\n",
