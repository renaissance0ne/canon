        "code": "# engine/tests/agent/test_graph_resolution.py\nfrom agent.graph import select_rule, validate, resolve\n\nclass TestSelectRule:\n    def test_no_matching_rule_returns_none_and_escalates(self, conflict, unrelated_rules):\n        assert select_rule(conflict, unrelated_rules) is None\n\n    def test_most_specific_rule_wins_over_wildcard(self, conflict, specific_and_wildcard_rules):\n        chosen = select_rule(conflict, specific_and_wildcard_rules)\n        assert chosen.field != \"*\" and chosen.entity_type != \"*\"\n\n    def test_first_match_wins_among_equally_specific_rules(self, conflict, two_equally_specific_rules):\n        assert select_rule(conflict, two_equally_specific_rules) is two_equally_specific_rules[0]\n\n\nclass TestValidate:\n    def test_accepts_value_a_verbatim(self):\n        assert validate(\"APAC\", value_a=\"APAC\", value_b=\"EMEA\") is True\n\n    def test_accepts_legal_normalization_of_observed_value(self):\n        assert validate(\"Acme\", value_a=\"Acme Inc.\", value_b=\"Other Co\") is True\n\n    def test_rejects_hallucinated_value_not_derived_from_either_side(self):\n        # THE non-negotiable check — this is the test that matters most in the paper\n        assert validate(\"ACC-9999-MADE-UP\", value_a=\"ACC-1\", value_b=\"ACC-2\") is False\n\n    def test_rejects_empty_proposed_value(self):\n        assert validate(\"\", value_a=\"APAC\", value_b=\"EMEA\") is False\n\n\nclass TestResolve:\n    def test_ambiguous_conflict_with_no_rule_and_low_confidence_escalates(self, ambiguous_conflict):\n        resolutions = resolve([ambiguous_conflict], rules=[])\n        assert resolutions[0].status == \"escalated\"\n\n    def test_rule_decided_high_confidence_low_severity_auto_applies(self, easy_conflict, matching_rule):\n        resolutions = resolve([easy_conflict], rules=[matching_rule])\n        assert resolutions[0].status == \"auto_applied\"\n\n    def test_validate_rejection_forces_escalation_even_if_rule_fired(\n        self, conflict_where_rule_produces_invented_value, bad_rule\n    ):\n        # ablation case: what the \"without validate\" ablation in eval/ is measuring\n        resolutions = resolve([conflict_where_rule_produces_invented_value], rules=[bad_rule])\n        assert resolutions[0].status == \"escalated\""
