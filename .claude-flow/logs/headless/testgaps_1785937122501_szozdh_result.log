e\", \"escalate\"])\n    def test_non_prefer_source_strategies_do_not_require_preferred_source_id(self, strategy):\n        rule = SurvivorshipRule(\n            id=\"r1\", field=\"*\", entity_type=\"*\", strategy=strategy, description=\"x\",\n        )\n        assert rule.preferred_source_id is None\n\n\nclass TestRuleSpecificity:\n    def test_exact_field_and_type_beats_double_wildcard(self):\n        exact = SurvivorshipRule(id=\"a\", field=\"territory\", entity_type=\"account\",\n                                  strategy=\"escalate\", description=\"\")\n        wild = SurvivorshipRule(id=\"b\", field=\"*\", entity_type=\"*\",\n                                 strategy=\"escalate\", description=\"\")\n        assert rule_specificity(exact) > rule_specificity(wild)\n\n    def test_exact_field_wildcard_type_beats_wildcard_field_exact_type(self):\n        # both are \"one exact, one wild\" — spec implies field weighs more (2) than type (1)\n        field_exact = SurvivorshipRule(id=\"a\", field=\"territory\", entity_type=\"*\",\n                                        strategy=\"escalate\", description=\"\")\n        type_exact = SurvivorshipRule(id=\"b\", field=\"*\", entity_type=\"account\",\n                                       strategy=\"escalate\", description=\"\")\n        assert rule_specificity(field_exact) > rule_specificity(type_exact)\n```\n\n```python\n# engine/tests/pipeline/test_schema_contract.py\n\"\"\"Byte-for-byte parity with web/types/*.ts is the actual bug surface here.\"\"\"\nfrom pipeline.schema import Conflict\nfrom uuid import uuid4\n\ndef test_conflict_wire_format_uses_camel_case():\n    c = Conflict(\n        run_id=uuid4(), match_id=uuid4(), field=\"territory\",\n        value_a=\"APAC\", value_b=\"APAC-SOUTH\",\n        conflict_class=\"attribute\", severity=3, detected_by=\"rule\",\n    )\n    wire = c.model_dump(by_alias=True, mode=\"json\")\n    assert set(wire.keys()) == {\n        \"id\", \"runId\", \"matchId\", \"field\", \"valueA\", \"valueB\",\n        \"conflictClass\", \"severity\", \"detectedBy\",\n    }\n\ndef test_conflict_rejects_unknown_field():\n    import pytest\n    from pydantic import ValidationError\n    with pytest.raises(ValidationError):\n        Conflict.model_validate({\n            \"runId\": str(uuid4()), \"matchId\": str(uuid4()), \"field\": \"x\",\n            \"valueA\": \"a\", \"valueB\": \"b\", \"conflictClass\": \"attribute\",\n            \"severity\": 2, \"detectedBy\": \"rule\", \"unexpectedField\": \"boom\",\n        })\n```\n\n---\n\n### 2. Engine — stubbed functions (write tests now, against the documented contract)\n\nSince these bodies don't exist yet, these skeletons double as the spec the implementation must satisfy — write them, watch them fail on `NotImplementedError`, then implement.\n\n```python\n# engine/tests/pipeline/test_normalize.py\nimport pytest\nfrom pipeline.normalize import fold_name, normalize\n\nclass TestFoldName:\n    def test_folds_case(self):\n        assert fold_name(\"Acme\") == fold_name(\"ACME\")\n\n    def test_folds_legal_suffix_inc(self):\n        assert fold_name(\"Acme Inc.\") == fold_name(\"Acme\")\n\n    def test_folds_legal_suffix_pvt_ltd(self):\n        assert fold_name(\"Acme Pvt Ltd\") == fold_name(\"Acme\")\n\n    def test_folds_whitespace_and_punctuation(self):\n        assert fold_name(\"Acme,  Inc.\") == fold_name(\"acme inc\")\n\n    def test_is_deterministic(self):\n        assert fold_name(\"Acme Corp\") == fold_name(\"Acme Corp\")\n\n    def test_empty_string_does_not_raise(self):\n        assert fold_name(\"\") == \"\"\n\n    def test_name_with_only_a_suffix_word_is_not_folded_to_empty(self):\n        # edge case: a company literally named \"Corp\" shouldn't fold to \"\"\n        assert fold_name(\"Corp\") != \"\"\n\n    def test_unicode_and_accented_characters_survive(self):\n        result = fold_name(\"Café Müller GmbH\")\n        assert result  # doesn't crash; folding is total per the docstring\n\n\ncla