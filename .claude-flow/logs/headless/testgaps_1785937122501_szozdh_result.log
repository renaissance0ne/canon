        "code": "# engine/tests/pipeline/test_normalize.py\nimport pytest\nfrom pipeline.normalize import fold_name, normalize\n\nclass TestFoldName:\n    def test_folds_case(self):\n        assert fold_name(\"Acme\") == fold_name(\"ACME\")\n\n    def test_folds_legal_suffix_inc(self):\n        assert fold_name(\"Acme Inc.\") == fold_name(\"Acme\")\n\n    def test_folds_legal_suffix_pvt_ltd(self):\n        assert fold_name(\"Acme Pvt Ltd\") == fold_name(\"Acme\")\n\n    def test_folds_whitespace_and_punctuation(self):\n        assert fold_name(\"Acme,  Inc.\") == fold_name(\"acme inc\")\n\n    def test_is_deterministic(self):\n        assert fold_name(\"Acme Corp\") == fold_name(\"Acme Corp\")\n\n    def test_empty_string_does_not_raise(self):\n        assert fold_name(\"\") == \"\"\n\n    def test_name_with_only_a_suffix_word_is_not_folded_to_empty(self):\n        # edge case: a company literally named \"Corp\" shouldn't fold to \"\"\n        assert fold_name(\"Corp\") != \"\"\n\n    def test_unicode_and_accented_characters_survive(self):\n        result = fold_name(\"Café Müller GmbH\")\n        assert result  # doesn't crash; folding is total per the docstring\n\n\nclass TestNormalize:\n    def test_preserves_original_name_alongside_folded(self, raw_account_record):\n        entities = normalize([raw_account_record], entity_type=\"account\", source_id=\"src-a\")\n        assert entities[0].name != entities[0].normalized_name  # folding is recorded, not destructive\n        assert entities[0].name == raw_account_record[\"name\"]\n\n    def test_empty_input_returns_empty_list(self):\n        assert normalize([], entity_type=\"account\", source_id=\"src-a\") == []\n\n    def test_record_missing_optional_parent_id_yields_none(self, raw_account_record_no_parent):\n        entities = normalize([raw_account_record_no_parent], entity_type=\"account\", source_id=\"src-a\")\n        assert entities[0].parent_external_id is None\n\n    def test_malformed_record_missing_required_field_raises(self, raw_record_missing_external_id):\n        with pytest.raises((KeyError, ValueError)):\n            normalize([raw_record_missing_external_id], entity_type=\"account\", source_id=\"src-a\")"
