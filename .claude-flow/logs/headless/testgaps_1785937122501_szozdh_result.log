        "content": "\"\"\"db.py talks to Postgres directly — test with a real test DB or a\npsycopg connection fixture pointed at a disposable schema, not mocks,\nper the project's stance that mocked persistence hides prod drift.\"\"\"\nimport pytest\nfrom db import write_entities, write_matches, write_conflicts, load_ruleset, update_run_status\n\nclass TestTableOwnership:\n    def test_write_entities_never_touches_sources_or_rulesets_tables(self, db_conn, run_id, sample_entities):\n        write_entities(run_id, sample_entities)\n        assert _table_row_count(db_conn, \"sources\") == 0  # untouched by this call\n        assert _table_row_count(db_conn, \"rulesets\") == 0\n\n    def test_update_run_status_only_writes_status_stats_error_columns(self, db_conn, seeded_run):\n        update_run_status(seeded_run.id, \"matching\", stats=None, error=None)\n        row = _fetch_run(db_conn, seeded_run.id)\n        assert row.source_a_id == seeded_run.source_a_id  # unchanged\n        assert row.ruleset_id == seeded_run.ruleset_id     # unchanged\n\n    def test_append_audit_is_insert_only_never_update(self, db_conn, run_id):\n        append_audit(run_id, \"run_started\", actor=\"engine\", detail={})\n        count_before = _table_row_count(db_conn, \"audit_log\")\n        append_audit(run_id, \"run_failed\", actor=\"engine\", detail={\"error\": \"x\"})\n        assert _table_row_count(db_conn, \"audit_log\") == count_before + 1  # never overwrote row 1\n\n\nclass TestLoadRuleset:\n    def test_missing_ruleset_id_raises_not_found(self, db_conn):\n        with pytest.raises(Exception):\n            load_ruleset(uuid4())\n\n    def test_returns_only_active_version_when_multiple_versions_exist(self, db_conn, versioned_ruleset):\n        rules = load_ruleset(versioned_ruleset.latest_id)\n        assert rules == versioned_ruleset.latest_rules  # not an older version\n```\n\n```python\n",
        "level": 1
      },
      {
        "title": "engine/tests/test_main.py",
        "content": "\"\"\"FastAPI route + orchestration — use TestClient, not a live server.\"\"\"\nimport pytest\nfrom fastapi.testclient import TestClient\nfrom main import app\n\nclient = TestClient(app)\n\nclass TestStartRun:\n    def test_returns_202_shape_immediately_without_blocking_on_pipeline(self, run_id):\n        resp = client.post(\"/runs\", json={\"runId\": str(run_id)})\n        assert resp.status_code == 200\n        assert resp.json() == {\"runId\": str(run_id), \"accepted\": True}\n\n    def test_rejects_malformed_run_id(self):\n        resp = client.post(\"/runs\", json={\"runId\": \"not-a-uuid\"})\n        assert resp.status_code == 422\n\n\nclass TestRunStatus:\n    def test_unknown_run_id_returns_404_not_501_once_implemented(self, unseeded_run_id):\n        resp = client.get(f\"/runs/{unseeded_run_id}/status\")\n        assert resp.status_code == 404  # currently 501 — this test locks in the real contract\n\n\nclass TestExecuteRun:\n    def test_failure_midway_leaves_run_status_failed_with_error_detail(\n        self, run_id, broken_source_config\n    ):\n        # \"a run that fails halfway leaves a readable trail\" — AGENTS.md guarantee\n        from main import execute_run\n        with pytest.raises(Exception):\n            execute_run(run_id)\n        # then assert runs.status == \"failed\" and runs.error is not None via db fixture\n\n    def test_engine_never_writes_sources_or_rulesets_tables_during_a_run(self, run_id, seeded_run):\n        from main import execute_run\n        execute_run(run_id)\n        assert _sources_table_unmodified_since(seeded_run.snapshot)\n```\n\n---\n\n",
        "level": 1
      },
