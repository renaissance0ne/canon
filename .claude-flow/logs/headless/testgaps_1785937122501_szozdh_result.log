        "title": "3. Web layer — implemented logic, currently untested",
        "content": "\n```typescript\n// web/lib/reviewer-label.test.ts\nimport { describe, it, expect } from \"vitest\";\nimport { reviewerLabel } from \"@/lib/reviewer-label\";\n\ndescribe(\"reviewerLabel\", () => {\n  it(\"prefers username over email\", () => {\n    expect(reviewerLabel({ username: \"j.rao\", primaryEmailAddress: { emailAddress: \"j@x.com\" } }, \"fallback\"))\n      .toBe(\"j.rao\");\n  });\n\n  it(\"falls back to email when username is null\", () => {\n    expect(reviewerLabel({ username: null, primaryEmailAddress: { emailAddress: \"j@x.com\" } }, \"fallback\"))\n      .toBe(\"j@x.com\");\n  });\n\n  it(\"falls back to the stable id when user is null\", () => {\n    expect(reviewerLabel(null, \"user_123\")).toBe(\"user_123\");\n  });\n\n  it(\"falls back to the stable id when username and email are both null\", () => {\n    expect(reviewerLabel({ username: null, primaryEmailAddress: null }, \"user_123\")).toBe(\"user_123\");\n  });\n\n  it(\"falls back when primaryEmailAddress exists but emailAddress is null\", () => {\n    expect(reviewerLabel({ username: null, primaryEmailAddress: { emailAddress: null } }, \"user_123\"))\n      .toBe(\"user_123\");\n  });\n});\n```\n\n```typescript\n// web/lib/server/auth.test.ts\nimport { describe, it, expect, vi } from \"vitest\";\nimport { requireReviewer, getReviewer } from \"@/lib/server/auth\";\n\nvi.mock(\"@clerk/nextjs/server\", () => ({\n  auth: vi.fn(),\n  currentUser: vi.fn(),\n}));\n\ndescribe(\"requireReviewer\", () => {\n  it(\"throws when there is no authenticated session\", async () => {\n    const { auth } = await import(\"@clerk/nextjs/server\");\n    vi.mocked(auth).mockResolvedValue({ isAuthenticated: false, userId: null } as any);\n    await expect(requireReviewer()).rejects.toThrow(/No authenticated reviewer/);\n  });\n\n  it(\"returns userId and derived label when authenticated\", async () => {\n    const { auth, currentUser } = await import(\"@clerk/nextjs/server\");\n    vi.mocked(auth).mockResolvedValue({ isAuthenticated: true, userId: \"user_1\" } as any);\n    vi.mocked(currentUser).mockResolvedValue({ username: \"j.rao\" } as any);\n    const reviewer = await requireReviewer();\n    expect(reviewer).toEqual({ userId: \"user_1\", label: \"j.rao\" });\n  });\n});\n\ndescribe(\"getReviewer\", () => {\n  it(\"returns null instead of throwing when signed out\", async () => {\n    const { auth } = await import(\"@clerk/nextjs/server\");\n    vi.mocked(auth).mockResolvedValue({ isAuthenticated: false } as any);\n    expect(await getReviewer()).toBeNull();\n  });\n});\n```\n\n```typescript\n// web/lib/server/sources.test.ts\nimport { describe, it, expect, vi } from \"vitest\";\nimport { countSourcesBySide } from \"@/lib/server/sources\";\n\ndescribe(\"countSourcesBySide\", () => {\n  it(\"buckets salesforce and hubspot as crm\", async () => {\n    // mock listSources() to return one of each kind, then assert counts\n  });\n\n  it(\"buckets synthetic sources separately from crm/warehouse\", async () => {});\n\n  it(\"returns all zeros when there are no configured sources\", async () => {});\n});\n```\n\n```typescript\n// web/types/source.test.ts\nimport { describe, it, expect } from \"vitest\";\nimport { createSourceSchema, sourceConfigSchema } from \"@/types/source\";\n\ndescribe(\"sourceConfigSchema\", () => {\n  it(\"rejects an empty objects array\", () => {\n    expect(sourceConfigSchema.safeParse({ objects: [] }).success).toBe(false);\n  });\n\n  it(\"accepts config without a filter\", () => {\n    expect(sourceConfigSchema.safeParse({ objects: [\"Account\"] }).success).toBe(true);\n  });\n});\n\ndescribe(\"createSourceSchema\", () => {\n  it(\"rejects a name over 80 characters\", () => {\n    const longName = \"a\".repeat(81);\n    expect(createSourceSchema.safeParse({ name: longName, kind: \"salesforce\", config: { objects: [\"Account\"] } }).success)\n      .toBe(false);\n  });\n\n  it(\"rejects an unknown kind\", () => {\n    expect(createSourceSchema.safeParse({ name: \"x\", kind: \"oracle\", config: { objects: [\"a\"] } }).success)\n      .toBe(false);\n  });\n\n  it(\"rejects a credential-shaped key smuggled into config (extra field)\", () => {\n    // config schema has no .strict() today — this test documents whether that's intentional;\n    // if it passes, config silently accepts e.g. { objects: [...], password: \"...\" }\n    const result = sourceConfigSchema.safeParse({ objects: [\"Account\"], password: \"leak\" });\n    expect(result.success && \"password\" in (result.data as object)).toBe(false);\n  });\n});\n```\n\n```tsx\n// web/components/severity-mark.test.tsx\nimport { describe, it, expect } from \"vitest\";\nimport { render, screen } from \"@testing-library/react\";\nimport { SeverityMark } from \"@/components/severity-mark\";\n\ndescribe(\"SeverityMark\", () => {\n  it.each([1, 2, 3, 4] as const)(\"always renders the text label alongside severity %i\", (severity) => {\n    render(<SeverityMark severity={severity} />);\n    // AGENTS.md hard rule: \"the mark alone is never the only signal\"\n    expect(screen.getByText(/Structural|Attribute|Cosmetic/)).toBeInTheDocument();\n  });\n\n  it(\"severities 3 and 2 share the label 'Attribute' but render different treatments\", () => {\n    const { container: c3 } = render(<SeverityMark severity={3} />);\n    const { container: c2 } = render(<SeverityMark severity={2} />);\n    expect(c3.innerHTML).not.toBe(c2.innerHTML);\n  });\n});\n```\n\n```tsx\n// web/components/sources/source-table.test.tsx\nimport { describe, it, expect } from \"vitest\";\nimport { render, screen } from \"@testing-library/react\";\nimport { SourceTable } from \"@/components/sources/source-table\";\n\ndescribe(\"SourceTable\", () => {\n  it(\"renders one row per source\", () => { /* pass 3 sources, assert 3 <tr> in tbody */ });\n\n  it(\"joins multiple config.objects with a comma\", () => {\n    // source.config.objects = [\"Account\", \"User\"] → cell text \"Account, User\"\n  });\n\n  it(\"renders an empty tbody without throwing when sources is []\", () => {\n    render(<SourceTable sources={[]} />);\n    expect(screen.queryAllByRole(\"row\")).toHaveLength(1); // header row only\n  });\n});\n```\n\n---\n\n",
        "level": 3
