        "code": "# engine/tests/pipeline/test_detect.py\nimport pytest\nfrom pipeline.detect import classify, detect\n\nclass TestClassify:\n    def test_parent_external_id_difference_is_structural_severity_4(self):\n        cls, sev = classify(\"parentExternalId\", \"ACC-1\", \"ACC-2\")\n        assert cls == \"structural\" and sev == 4\n\n    @pytest.mark.parametrize(\"field\", [\"territory\", \"roleName\", \"ownerId\"])\n    def test_ownership_fields_are_attribute_severity_3(self, field):\n        cls, sev = classify(field, \"a\", \"b\")\n        assert cls == \"attribute\" and sev == 3\n\n    def test_other_field_difference_is_attribute_severity_2(self):\n        cls, sev = classify(\"industry\", \"Tech\", \"Finance\")\n        assert cls == \"attribute\" and sev == 2\n\n    def test_values_folding_to_same_name_are_cosmetic_severity_1(self):\n        cls, sev = classify(\"name\", \"Acme Inc.\", \"ACME INC\")\n        assert cls == \"cosmetic\" and sev == 1\n\n    def test_identical_values_do_not_reach_classify_as_a_conflict(self):\n        # boundary: detect() should never call classify on equal values —\n        # this documents the invariant classify() itself doesn't enforce\n        pass\n\n\nclass TestDetect:\n    def test_unmatched_entity_on_side_a_becomes_orphan_conflict(self, run_id, one_sided_match_set):\n        conflicts = detect(one_sided_match_set.matches, one_sided_match_set.entities, run_id=run_id)\n        assert any(c.conflict_class == \"orphan\" for c in conflicts)\n\n    def test_two_side_a_records_matching_one_side_b_record_is_duplicate_severity_4(\n        self, run_id, duplicate_match_set\n    ):\n        conflicts = detect(duplicate_match_set.matches, duplicate_match_set.entities, run_id=run_id)\n        dupes = [c for c in conflicts if c.conflict_class == \"duplicate\"]\n        assert dupes and all(c.severity == 4 for c in dupes)\n\n    def test_orphan_with_children_is_severity_4_without_children_severity_3(\n        self, run_id, orphan_with_children, orphan_without_children\n    ):\n        ...  # wire has_children through the fixture and assert both branches\n\n    def test_no_conflicts_when_all_fields_agree(self, run_id, fully_matching_pair):\n        assert detect(fully_matching_pair.matches, fully_matching_pair.entities, run_id=run_id) == []\n\n    def test_empty_matches_list_returns_empty_conflicts(self, run_id):\n        assert detect([], {}, run_id=run_id) == []"
