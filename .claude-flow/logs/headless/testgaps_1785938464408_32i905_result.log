t import TestClient\nfrom uuid import uuid4\nfrom main import app\n\nclient = TestClient(app)\n\nclass TestStartRun:\n    def test_accepts_valid_run_id_returns_202_shape(self):\n        run_id = str(uuid4())\n        resp = client.post(\"/runs\", json={\"runId\": run_id})\n        assert resp.status_code == 200\n        assert resp.json() == {\"runId\": run_id, \"accepted\": True}\n\n    def test_missing_run_id_returns_422(self):\n        resp = client.post(\"/runs\", json={})\n        assert resp.status_code == 422\n\n    def test_malformed_uuid_returns_422(self):\n        resp = client.post(\"/runs\", json={\"runId\": \"not-a-uuid\"})\n        assert resp.status_code == 422\n\n    def test_background_task_is_dispatched(self, mocker):\n        mock_execute = mocker.patch(\"main.execute_run\")\n        run_id = str(uuid4())\n        client.post(\"/runs\", json={\"runId\": run_id})\n        mock_execute.assert_called_once()\n\n\nclass TestRunStatus:\n    def test_unknown_run_id_returns_404_not_501(self):\n        # currently unconditionally 501 — once implemented, must distinguish\n        # \"not implemented\" from \"no such run\"\n        resp = client.get(f\"/runs/{uuid4()}/status\")\n        assert resp.status_code in (404, 200)  # not the placeholder 501\n\n\nclass TestExecuteRun:\n    def test_failure_midway_leaves_readable_status_not_silent(self, mocker):\n        # a stage failure must still call update_run_status(..., status=\"failed\", error=...)\n        mocker.patch(\"main.normalize\", side_effect=RuntimeError(\"boom\"))\n        mock_update = mocker.patch(\"db.update_run_status\")\n        execute_run(uuid4())\n        mock_update.assert_any_call(mocker.ANY, \"failed\", error=mocker.ANY)\n\n    def test_engine_never_writes_sources_or_rulesets(self, mocker):\n        # table-ownership regression guard — assert no code path calls a\n        # hypothetical db.write_sources/write_rulesets\n        ...\n```\n\n### 8. `engine/db.py` — no tests, and the table-o