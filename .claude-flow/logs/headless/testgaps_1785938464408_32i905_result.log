    classes = {m.conflict_class for m in manifest}\n        assert {\"structural\", \"attribute\", \"cosmetic\", \"orphan\", \"duplicate\"} <= classes\n\n    def test_ambiguous_entries_have_expected_resolution_escalate(self, tmp_path):\n        manifest = generate(seed=42, accounts=500, out_dir=tmp_path)\n        ambiguous = [m for m in manifest if m.expected_resolution == \"escalate\"]\n        assert len(ambiguous) > 0\n\n    def test_zero_accounts_edge_case(self, tmp_path):\n        manifest = generate(seed=42, accounts=0, out_dir=tmp_path)\n        assert manifest == []\n\n    def test_custom_rates_change_injection_counts(self, tmp_path):\n        low = generate(seed=42, accounts=500, out_dir=tmp_path / \"low\",\n                        rates=InjectionRates(reparent=0.0))\n        assert not any(m.field == \"parentExternalId\" for m in low)\n\n\n# tests/eval/test_baselines.py — baseline_rules is \"the real comparison\"; a bug\n# here silently invalidates every reported number.\nclass TestBaselineExact:\n    def test_flags_every_string_inequality(self, entity_factory):\n        ...\n    def test_no_conflicts_when_sides_identical(self, entity_factory):\n        ...\n\nclass TestBaselineRules:\n    def test_uses_no_model_calls(self, mocker):\n        mock_anthropic = mocker.patch(\"anthropic.Anthropic\")\n        baseline_rules([], [], [])\n        mock_anthropic.assert_not_called()\n\n\n# tests/eval/test_harness.py\nclass TestSweepAutoApplyThreshold:\n    def test_returns_entry_for_every_step_in_range(self, tmp_path, manifest_factory):\n        sweep = sweep_auto_apply_threshold(manifest_factory(), tmp_path, start=0.5, stop=0.6, step=0.05)\n        assert set(sweep.keys()) == {0.50, 0.55, 0.60}\n\n    def test_higher_threshold_never_increases_false_auto_apply_rate(self, ...):\n        # monotonicity property of the tradeoff curve\n        ...\n\nclass TestAblateWithoutValidate:\n    def test_quantifies_invented_values_as_nonzero_when_validate_removed(self, ...):\n        ...\n```\n\n### 10. Web — `lib/server/*` and `lib/reviewer-label.ts` (the only real logic)\n\n```ts\n// web/lib/reviewer-label.test.ts\nimport { describe, it, expect } from \"vitest\";\nimport { reviewerLabel } from \"@/lib/reviewer-label\";\n\ndescribe(\"reviewerLabel\", () => {\n  it(\"prefers username over email\", () => {\n    expect(reviewerLabel({ username: \"j.rao\", primaryEmailAddress: { emailAddress: \"j@x.com\" } }, \"fallback\"))\n      .toBe(\"j.rao\");\n  });\n\n  it(\"falls back to email when username is null\", () => {\n    expect(reviewerLabel({ username: null, primaryEmailAddress: { emailAddress: \"j@x.com\" } }, \"fallback\"))\n      .toBe(\"j@x.com\");\n  });\n\n  it(\"falls back to the stable id when user is null\", () => {\n    expect(reviewerLabel(null, \"user_123\")).toBe(\"user_123\");\n  });\n\n  it(\"falls back to the stable id when both username and email are null\", () => {\n    expect(reviewerLabel({ username: null, primaryEmailAddress: null }, \"user_123\")).toBe(\"user_123\");\n  });\n\n  it(\"falls back when primaryEmailAddress exists but emailAddress is null\", () => {\n    expect(reviewerLabel({ username: null, primaryEmailAddress: { emailAddress: null } }, \"user_123\"))\n      .toBe(\"user_123\");\n  });\n\n  it(\"empty-string username is not treated as absent\", () => {\n    // ?? only catches null/undefined — \"\" would currently win over email.\n    // Decide if that's intended; test documents current behavior either way.\n    expect(reviewerLabel({ username: \"\", primaryEmailAddress: { emailAddress: \"j@x.com\" } }, \"fallback\"))\n      .toBe(\"\");\n  });\n});\n```\n\n```ts\n// web/lib/server/auth.test.ts — needs @clerk/nextjs/server mocked\nimport { describe, it, expect, vi } from \"vitest\";\n\nvi.mock(\"@clerk/nextjs/server\", () => ({\n  auth: vi.fn(),\n  currentUser: vi.fn(),\n}));\n\ndescribe(\"requireReviewer\", () => {\n  it(\"throws when there is no session (proxy.ts/handler disagreement)\", async () => {\