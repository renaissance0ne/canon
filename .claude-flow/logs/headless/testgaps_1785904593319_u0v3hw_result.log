      {
        "title": "engine/tests/pipeline/test_schema_contract.py",
        "content": "import pytest\nfrom pydantic import ValidationError\nfrom pipeline.schema import SurvivorshipRule, Match, Resolution, CanonicalEntity\n\ndef test_wire_format_is_camelcase():\n    entity = CanonicalEntity(external_id=\"1\", entity_type=\"account\", name=\"Acme\",\n                              normalized_name=\"acme\", source_id=\"s1\")\n    dumped = entity.model_dump(by_alias=True)\n    assert \"externalId\" in dumped and \"external_id\" not in dumped\n\ndef test_snake_case_construction_still_works():\n    # populate_by_name=True must allow python-side construction too.\n    CanonicalEntity(external_id=\"1\", entity_type=\"account\", name=\"Acme\",\n                     normalized_name=\"acme\", source_id=\"s1\")\n\ndef test_prefer_source_strategy_requires_preferred_source_id():\n    with pytest.raises(ValidationError):\n        SurvivorshipRule(id=\"r1\", field=\"*\", entity_type=\"*\",\n                          strategy=\"prefer_source\", description=\"d\")\n\ndef test_prefer_source_with_id_is_valid():\n    SurvivorshipRule(id=\"r1\", field=\"*\", entity_type=\"*\", strategy=\"prefer_source\",\n                      preferred_source_id=\"src-a\", description=\"d\")\n\n@pytest.mark.parametrize(\"confidence\", [-0.01, 1.01])\ndef test_match_confidence_out_of_range_rejected(confidence):\n    with pytest.raises(ValidationError):\n        Match(run_id=\"00000000-0000-0000-0000-000000000000\",\n              entity_a_id=\"00000000-0000-0000-0000-000000000001\",\n              entity_b_id=\"00000000-0000-0000-0000-000000000002\",\n              confidence=confidence, method=\"fuzzy\",\n              signals={\"exact_key\": False, \"cosine\": 0.5, \"fuzzy_ratio\": 0.5})\n\ndef test_unknown_field_on_wire_is_rejected():\n    with pytest.raises(ValidationError):\n        CanonicalEntity(external_id=\"1\", entity_type=\"account\", name=\"Acme\",\n                         normalized_name=\"acme\", source_id=\"s1\", extra_field=\"nope\")\n```\n\n---\n\n",
        "level": 1
