        "title": "engine/tests/pipeline/test_schema.py",
        "content": "import pytest\nfrom pydantic import ValidationError\nfrom pipeline.schema import SurvivorshipRule, rule_specificity\n\ndef make_rule(field=\"*\", entity_type=\"*\", strategy=\"escalate\", **kw):\n    return SurvivorshipRule(id=\"r1\", field=field, entity_type=entity_type,\n                             strategy=strategy, description=\"d\", **kw)\n\n@pytest.mark.parametrize(\"field,entity_type,expected\", [\n    (\"*\", \"*\", 0),\n    (\"*\", \"account\", 1),\n    (\"territory\", \"*\", 2),\n    (\"territory\", \"account\", 3),\n])\ndef test_specificity_ordering(field, entity_type, expected):\n    assert rule_specificity(make_rule(field=field, entity_type=entity_type)) == expected\n\ndef test_more_specific_always_outranks_wildcard():\n    wildcard = make_rule(field=\"*\", entity_type=\"*\")\n    specific = make_rule(field=\"territory\", entity_type=\"account\")\n    assert rule_specificity(specific) > rule_specificity(wildcard)\n```\n\n",
