        "language": "ts",
        "code": "// web/types/rules.test.ts\nimport { describe, it, expect } from \"vitest\";\nimport { ruleSpecificity, survivorshipRuleSchema, createRulesetSchema } from \"@/types/rules\";\n\ndescribe(\"ruleSpecificity\", () => {\n  it(\"scores a fully wildcard rule as 0\", () => {\n    expect(ruleSpecificity({ id: \"r1\", field: \"*\", entityType: \"*\", strategy: \"escalate\", description: \"\" })).toBe(0);\n  });\n\n  it(\"scores field-specific + entityType-wildcard as 2\", () => {\n    expect(ruleSpecificity({ id: \"r2\", field: \"territory\", entityType: \"*\", strategy: \"most_recent\", description: \"\" })).toBe(2);\n  });\n\n  it(\"scores entityType-specific + field-wildcard as 1\", () => {\n    expect(ruleSpecificity({ id: \"r3\", field: \"*\", entityType: \"account\", strategy: \"most_recent\", description: \"\" })).toBe(1);\n  });\n\n  it(\"scores a fully specific rule as 3 — highest priority\", () => {\n    expect(ruleSpecificity({ id: \"r4\", field: \"territory\", entityType: \"account\", strategy: \"most_recent\", description: \"\" })).toBe(3);\n  });\n});\n\ndescribe(\"survivorshipRuleSchema\", () => {\n  it(\"rejects prefer_source without preferredSourceId\", () => {\n    const result = survivorshipRuleSchema.safeParse({\n      id: \"r5\", field: \"territory\", entityType: \"account\", strategy: \"prefer_source\", description: \"\",\n    });\n    expect(result.success).toBe(false);\n  });\n\n  it(\"accepts prefer_source with preferredSourceId\", () => {\n    const result = survivorshipRuleSchema.safeParse({\n      id: \"r6\", field: \"territory\", entityType: \"account\", strategy: \"prefer_source\",\n      preferredSourceId: \"src-1\", description: \"\",\n    });\n    expect(result.success).toBe(true);\n  });\n\n  it(\"accepts escalate/most_recent/most_complete without preferredSourceId\", () => {\n    for (const strategy of [\"escalate\", \"most_recent\", \"most_complete\"] as const) {\n      const result = survivorshipRuleSchema.safeParse({\n        id: \"r7\", field: \"*\", entityType: \"*\", strategy, description: \"\",\n      });\n      expect(result.success).toBe(true);\n    }\n  });\n\n  it(\"createRulesetSchema rejects an empty rules array\", () => {\n    expect(createRulesetSchema.safeParse({ name: \"v1\", rules: [] }).success).toBe(false);\n  });\n});"
