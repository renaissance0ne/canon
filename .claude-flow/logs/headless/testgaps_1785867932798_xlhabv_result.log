        "code": "// web/types/run.test.ts\nimport { describe, it, expect } from \"vitest\";\nimport { isRunActive, runStatusSchema, EMPTY_RUN_STATS, runStatsSchema } from \"@/types/run\";\n\ndescribe(\"isRunActive\", () => {\n  it.each([\"queued\", \"extracting\", \"matching\", \"detecting\", \"resolving\"] as const)(\n    \"%s is active\",\n    (status) => expect(isRunActive(status)).toBe(true),\n  );\n\n  it.each([\"complete\", \"failed\"] as const)(\n    \"%s is terminal, not active\",\n    (status) => expect(isRunActive(status)).toBe(false),\n  );\n});\n\ndescribe(\"runStatsSchema\", () => {\n  it(\"EMPTY_RUN_STATS is itself valid against the schema\", () => {\n    expect(runStatsSchema.safeParse(EMPTY_RUN_STATS).success).toBe(true);\n  });\n\n  it(\"rejects negative counts\", () => {\n    expect(runStatsSchema.safeParse({ ...EMPTY_RUN_STATS, conflicts: -1 }).success).toBe(false);\n  });\n\n  it(\"rejects non-integer counts\", () => {\n    expect(runStatsSchema.safeParse({ ...EMPTY_RUN_STATS, matches: 1.5 }).success).toBe(false);\n  });\n});"
