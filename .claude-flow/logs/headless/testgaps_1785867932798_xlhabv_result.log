;\nimport { NavRail } from \"@/components/console/nav-rail\";\n\nvi.mock(\"next/navigation\", () => ({ usePathname: () => \"/conflicts\" }));\n\ndescribe(\"NavRail\", () => {\n  it(\"marks the exact matching route as current\", () => {\n    render(<NavRail />);\n    expect(screen.getByRole(\"link\", { name: \"Conflicts\" })).toHaveAttribute(\"aria-current\", \"page\");\n  });\n\n  it(\"does not mark a sibling route as current\", () => {\n    render(<NavRail />);\n    expect(screen.getByRole(\"link\", { name: \"Sources\" })).not.toHaveAttribute(\"aria-current\");\n  });\n\n  it.todo(\n    \"does not treat a route sharing only a prefix (e.g. /runs-archive) as active for /runs — \" +\n    \"startsWith is too permissive; needs a documented case before it regresses\",\n  );\n});\n```\n\n---\n\n### 6. `web/components/severity-mark.tsx` — `SeverityMark`\n\nAGENTS.md is explicit and non-negotiable here: *\"Never render the mark without the word.\"* That's a testable invariant, not just a style guideline — worth locking in before someone adds a compact/icon-only variant later.\n\n```tsx\n// web/components/severity-mark.test.tsx\nimport { describe, it, expect } from \"vitest\";\nimport { render, screen } from \"@testing-library/react\";\nimport { SeverityMark } from \"@/components/severity-mark\";\n\ndescribe(\"SeverityMark\", () => {\n  it.each([\n    [4, \"Structural\"],\n    [3, \"Attribute\"],\n    [2, \"Attribute\"],\n    [1, \"Cosmetic\"],\n  ] as const)(\"severity %i always renders its label %s alongside the mark\", (severity, label) => {\n    render(<SeverityMark severity={severity} />);\n    expect(screen.getByText(label)).toBeInTheDocument();\n  });\n\n  it(\"severity 3 and 2 share the label 'Attribute' but must remain visually distinct\", () => {\n    // regression guard: severity 2 vs 3 differ only in border/weight treatment,\n    // not in label — assert distinct className/treatment, not distinct text\n  });\n});\n```\n\n---\n\n### 7. `web/components/sources/source-table.tsx` — `SourceTable`\n\n**Edge cases:** empty `sources` array (renders header with zero `<tr>` body rows — no empty-state messaging inside the table itself, which may be intentional since `SourcesEmptyState` owns that, but worth asserting the boundary), and a source whose `config.objects` is a single-item array vs. multi-item (join formatting).\n\n```tsx\n// web/components/sources/source-table.test.tsx\nimport { describe, it, expect } from \"vitest\";\nimport { render, screen } from \"@testing-library/react\";\nimport { SourceTable } from \"@/components/sources/source-table\";\nimport type { Source } from \"@/types/source\";\n\nconst source = (overrides: Partial<Source>): Source => ({\n  id: \"s1\", name: \"Salesforce (prod)\", kind: \"salesforce\",\n  config: { objects: [\"Account\", \"User\"] }, createdAt: new Date(), ...overrides,\n});\n\ndescribe(\"SourceTable\", () => {\n  it(\"renders one row per source with kind label and side derived correctly\", () => {\n    render(<SourceTable sources={[source({ kind: \"databricks\", config: { objects: [\"gtm.accounts\"] } })]} />);\n    expect(screen.getByText(\"Databricks\")).toBeInTheDocument();\n    expect(screen.getByText(\"warehouse\")).toBeInTheDocument();\n  });\n\n  it(\"renders a header-only table with no rows when sources is empty\", () => {\n    render(<SourceTable sources={[]} />);\n    expect(screen.queryAllByRole(\"row\")).toHaveLength(1); // header row only\n  });\n\n  it(\"joins multiple config.objects with a comma\", () => {\n    render(<SourceTable sources={[source({ config: { objects: [\"Account\", \"UserRole\", \"Territory\"] } })]} />);\n    expect(screen.getByText(\"Account, UserRole, Territory\")).toBeInTheDocument();\n  });\n\n  it(\"labels a synthetic source as 'either' side, not crm or warehouse\", () => {\n    render(<SourceTable sources={[source({ kind: \"synthetic\" })]} />);\n    expect(screen.getByText(\"either\")).toBeInTheDocument();\n  });\n});\n```\n\n---\n\n### Structural gaps 