alidation; every other strategy must succeed without it.\n\n```ts\n// web/types/rules.test.ts\nimport { describe, it, expect } from \"vitest\";\nimport { ruleSpecificity, survivorshipRuleSchema, createRulesetSchema } from \"@/types/rules\";\n\ndescribe(\"ruleSpecificity\", () => {\n  it(\"scores a fully wildcard rule as 0\", () => {\n    expect(ruleSpecificity({ id: \"r1\", field: \"*\", entityType: \"*\", strategy: \"escalate\", description: \"\" })).toBe(0);\n  });\n\n  it(\"scores field-specific + entityType-wildcard as 2\", () => {\n    expect(ruleSpecificity({ id: \"r2\", field: \"territory\", entityType: \"*\", strategy: \"most_recent\", description: \"\" })).toBe(2);\n  });\n\n  it(\"scores entityType-specific + field-wildcard as 1\", () => {\n    expect(ruleSpecificity({ id: \"r3\", field: \"*\", entityType: \"account\", strategy: \"most_recent\", description: \"\" })).toBe(1);\n  });\n\n  it(\"scores a fully specific rule as 3 — highest priority\", () => {\n    expect(ruleSpecificity({ id: \"r4\", field: \"territory\", entityType: \"account\", strategy: \"most_recent\", description: \"\" })).toBe(3);\n  });\n});\n\ndescribe(\"survivorshipRuleSchema\", () => {\n  it(\"rejects prefer_source without preferredSourceId\", () => {\n    const result = survivorshipRuleSchema.safeParse({\n      id: \"r5\", field: \"territory\", entityType: \"account\", strategy: \"prefer_source\", description: \"\",\n    });\n    expect(result.success).toBe(false);\n  });\n\n  it(\"accepts prefer_source with preferredSourceId\", () => {\n    const result = survivorshipRuleSchema.safeParse({\n      id: \"r6\", field: \"territory\", entityType: \"account\", strategy: \"prefer_source\",\n      preferredSourceId: \"src-1\", description: \"\",\n    });\n    expect(result.success).toBe(true);\n  });\n\n  it(\"accepts escalate/most_recent/most_complete without preferredSourceId\", () => {\n    for (const strategy of [\"escalate\", \"most_recent\", \"most_complete\"] as const) {\n      const result = survivorshipRuleSchema.safeParse({\n        id: \"r7\", field: \"*\", entityType: \"*\", strategy, description: \"\",\n      });\n      expect(result.success).toBe(true);\n    }\n  });\n\n  it(\"createRulesetSchema rejects an empty rules array\", () => {\n    expect(createRulesetSchema.safeParse({ name: \"v1\", rules: [] }).success).toBe(false);\n  });\n});\n```\n\n---\n\n### 2. `web/types/run.ts` — `isRunActive()`\n\n**Edge cases:** every value in `runStatusSchema` needs a row, not just \"queued\" and \"complete\" — `extracting`/`matching`/`detecting`/`resolving` are the ones most likely to silently regress if someone reorders `TERMINAL_RUN_STATUSES`.\n\n```ts\n// web/types/run.test.ts\nimport { describe, it, expect } from \"vitest\";\nimport { isRunActive, runStatusSchema, EMPTY_RUN_STATS, runStatsSchema } from \"@/types/run\";\n\ndescribe(\"isRunActive\", () => {\n  it.each([\"queued\", \"extracting\", \"matching\", \"detecting\", \"resolving\"] as const)(\n    \"%s is active\",\n    (status) => expect(isRunActive(status)).toBe(true),\n  );\n\n  it.each([\"complete\", \"failed\"] as const)(\n    \"%s is terminal, not active\",\n    (status) => expect(isRunActive(status)).toBe(false),\n  );\n});\n\ndescribe(\"runStatsSchema\", () => {\n  it(\"EMPTY_RUN_STATS is itself valid against the schema\", () => {\n    expect(runStatsSchema.safeParse(EMPTY_RUN_STATS).success).toBe(true);\n  });\n\n  it(\"rejects negative counts\", () => {\n    expect(runStatsSchema.safeParse({ ...EMPTY_RUN_STATS, conflicts: -1 }).success).toBe(false);\n  });\n\n  it(\"rejects non-integer counts\", () => {\n    expect(runStatsSchema.safeParse({ ...EMPTY_RUN_STATS, matches: 1.5 }).success).toBe(false);\n  });\n});\n```\n\n---\n\n### 3. `web/types/resolution.ts` — `reviewActionSchema`\n\nThis discriminated union is the entire input contract for the human-review PATCH route (not yet built). Getting its edge cases pinned now is cheap; debugging a wrong-shaped payload after the route exists is not.\n\n**Missing error-handling tests:** `override` without `overrideValue`, empty-string `reviewedBy`/`overrideValue` (schema uses `.min(1)`, so blank strings must fail, not just `undefined`), and an unrecognized `action` value.\n\n```ts\n// web/types/resolution.test.ts\nimport { describe, it, expect } from \"vitest\";\nimport { reviewActionSchema } from \"@/types/resolution\";\n\ndescribe(\"reviewActionSchema\", () => {\n  it(\"accepts approve with reviewedBy\", () => {\n    expect(reviewActionSchema.safeParse({ action: \"approve\", reviewedBy: \"vzd1919\" }).success).toBe(true);\n  });\n\n  it(\"rejects approve with empty reviewedBy\", () => {\n    expect(reviewActionSchema.safeParse({ action: \"approve\", reviewedBy: \"\" }).success).toBe(false);\n  });\n\n  it(\"rejects override missing overrideValue\", () => {\n    expect(reviewActionSchema.safeParse({ action: \"override\", reviewedBy: \"vzd1919\" }).success).toBe(false);\n  });\n\n  it(\"rejects override with empty overrideValue\", () => {\n    const result = reviewActionSchema.safeParse({ action: \"override\", reviewedBy: \"vzd1919\", overrideValue: \"\" });\n    expect(result.success).toBe(false);\n  });\n\n  it(\"accepts a fully-formed override\", () => {\n    const result = reviewActionSchema.safeParse({\n      action: \"override\", reviewedBy: \"vzd1919\", overrideValue: \"ACC-4417\",\n    });\n    expect(result.success).toBe(true);\n  });\n\n  it(\"rejects an unknown action\", () => {\n    expect(reviewActionSchema.safeParse({ action: \"snooze\", reviewedBy: \"x\" }).success).toBe(false);\n  });\n});\n```\n\n---\n\n### 4. `web/lib/server/sources.ts` — `listSources()`, `countSourcesBySide()`\n\n**Blocked today** by the missing `@/lib/db/client` / `@/lib/db/schema` modules — flagging that as the real gap. Once those exist, `countSourcesBySide` needs coverage on its bucketing logic, which is where a bug would actually hide.\n\n**Edge cases:** empty source list, a source of kind `synthetic` (falls 