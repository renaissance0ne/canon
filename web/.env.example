# Canon — web environment.
# Copy to web/.env. Server-side only. NOTHING here is ever NEXT_PUBLIC_.
#
# AGENTS.md § Security Rules: there is no legitimate reason for this project to
# expose anything to the browser beyond the app's own API routes.

# Postgres. Drizzle owns the schema and migrates it from here.
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Migrations need a SESSION-mode connection — drizzle-kit issues DDL with
# prepared statements, which Supavisor transaction mode (port 6543) cannot
# serve. Falls back to DATABASE_URL if unset.
MIGRATION_DATABASE_URL=

# The reconciliation engine. Deliberately not NEXT_PUBLIC_: the engine has no
# auth of its own and starting a run is a write, so the only path to it runs
# through this app's session-protected route handlers.
ENGINE_URL=http://localhost:8000

# Clerk — reviewer identity. The publishable key is public by design; the
# secret key is not.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ── Credential storage ───────────────────────────────────────────────────────

# The root of trust for stored source credentials.
#
# MUST BE BYTE-IDENTICAL to CANON_CREDENTIAL_KEY in engine/.env. The web layer
# seals credentials with it and the engine opens them; if the two differ, every
# stored credential fails to decrypt with a message saying so.
#
#   openssl rand -base64 32
#
# Rotation: add CANON_CREDENTIAL_KEY_V2 in BOTH files, bump CURRENT_KEY_VERSION
# in lib/server/crypto.ts, and re-encrypt rows whose key_version is behind. Old
# rows keep opening under their own version throughout, so there is no window
# where credentials are unreadable.
CANON_CREDENTIAL_KEY=

# ── OAuth app registrations ──────────────────────────────────────────────────
#
# These are Canon's own registration with each provider — per-deployment, not
# per-user, and NOT the same thing as a source's credentials. Those are supplied
# by whoever connects the source and stored encrypted in `source_credentials`.
#
# They live here rather than in engine/.env because the authorize flow is
# entirely browser-driven and never touches the engine.
#
# Each provider needs this exact redirect URI registered:
#   {CANON_APP_URL}/api/oauth/{kind}/callback
#
# Leave a pair blank and that platform's OAuth option renders as unavailable
# with the reason, rather than failing at the redirect.

# Canon's own origin. Used to build the OAuth redirect URI, which must match
# what is registered at the provider character for character.
#
# Read from here rather than from the request's Host header on purpose: Host is
# attacker-controllable, and a redirect URI derived from it is the classic way
# an authorization code ends up delivered somewhere else. Falls back to the
# request origin for local development only.
CANON_APP_URL=http://localhost:3000

# Salesforce Connected App (scopes: api, refresh_token, offline_access)
SALESFORCE_OAUTH_CLIENT_ID=
SALESFORCE_OAUTH_CLIENT_SECRET=

# HubSpot app. The one provider here without PKCE — its token endpoint
# authenticates with the client secret and rejects a code_verifier.
HUBSPOT_OAUTH_CLIENT_ID=
HUBSPOT_OAUTH_CLIENT_SECRET=

# Databricks user-to-machine. A public client: PKCE is the proof, so there is
# deliberately no secret to set.
DATABRICKS_OAUTH_CLIENT_ID=

# Snowflake. Requires an EXTERNAL OAUTH or CUSTOM security integration on the
# account before this will work.
SNOWFLAKE_OAUTH_CLIENT_ID=
SNOWFLAKE_OAUTH_CLIENT_SECRET=
