# Canon — web layer environment.
# Copy to web/.env. Server-side only unless a var is explicitly marked public.
#
# AGENTS.md § Security Rules: no secret is ever prefixed NEXT_PUBLIC_.

# Runtime — Supavisor TRANSACTION mode, port 6543. Prepared statements are not
# supported in this mode, which is why lib/db passes `prepare: false`.
# Read by Server Components and route handlers only.
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Migrations — Supavisor SESSION mode, port 5432. Same host and credential as
# above, different port. drizzle-kit needs prepared statements; transaction mode
# cannot serve them. (A direct connection, db.[ref].supabase.co:5432, also works
# but is IPv6-only without the IPv4 add-on.)
MIGRATION_DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# Where the reconciliation engine listens. Not public: the browser never calls
# the engine directly, only this app's own /api routes do.
ENGINE_URL=http://localhost:8000

# Clerk. The console is protected-first (see proxy.ts): only /, /sign-in and
# /sign-up are public. The publishable key is designed to ship to the browser
# and only identifies the instance; the secret key must never be NEXT_PUBLIC_.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Routes, not secrets. proxy.ts sends unauthenticated traffic here.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/get-started
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/get-started

# NOTE — Canon does NOT use a Supabase API key. It talks to Postgres directly
# over the connection strings above, which bypasses PostgREST and the API-key
# system entirely, so database credentials are the only auth involved. Add a
# secret key (Dashboard → Settings → API Keys) only if something starts using
# supabase-js, Storage or Realtime. The legacy `service_role` JWT is being
# retired at the end of 2026 in favour of `sb_secret_...` keys.

# NOTE — ANTHROPIC_API_KEY, SALESFORCE_*, DATABRICKS_TOKEN and SNOWFLAKE_PASSWORD
# belong in engine/.env and must never appear here. All model calls happen
# inside the engine.
