        "code": "// lib/reviewer-label.test.ts\nimport { describe, it, expect } from \"vitest\";\nimport { reviewerLabel } from \"./reviewer-label\";\n\ndescribe(\"reviewerLabel\", () => {\n  it(\"prefers username when present\", () => {\n    expect(reviewerLabel({ username: \"j.rao\", primaryEmailAddress: { emailAddress: \"j@x.com\" } }, \"uid_1\")).toBe(\"j.rao\");\n  });\n\n  it(\"falls back to email when username is null\", () => {\n    expect(reviewerLabel({ username: null, primaryEmailAddress: { emailAddress: \"j@x.com\" } }, \"uid_1\")).toBe(\"j@x.com\");\n  });\n\n  it(\"falls back to userId when user is null\", () => {\n    expect(reviewerLabel(null, \"uid_1\")).toBe(\"uid_1\");\n  });\n\n  it(\"falls back to userId when username and email are both null\", () => {\n    expect(reviewerLabel({ username: null, primaryEmailAddress: null }, \"uid_1\")).toBe(\"uid_1\");\n  });\n\n  it(\"falls back to userId when emailAddress field itself is null\", () => {\n    expect(reviewerLabel({ username: null, primaryEmailAddress: { emailAddress: null } }, \"uid_1\")).toBe(\"uid_1\");\n  });\n\n  it(\"treats empty-string username as falsy and falls through to email\", () => {\n    // Edge case: Clerk *can* return \"\" for username. Confirms ?? doesn't\n    // treat \"\" as absent — if this test fails, the precedence logic needs `||`.\n    expect(reviewerLabel({ username: \"\", primaryEmailAddress: { emailAddress: \"j@x.com\" } }, \"uid_1\")).toBe(\"\");\n  });\n});"
