any);\n    vi.mocked(currentUser).mockResolvedValue({ username: \"j.rao\" } as any);\n    const { requireReviewer } = await import(\"./auth\");\n    await expect(requireReviewer()).resolves.toEqual({ userId: \"uid_1\", label: \"j.rao\" });\n  });\n});\n\ndescribe(\"getReviewer\", () => {\n  it(\"returns null when unauthenticated, without calling currentUser\", async () => {\n    const { auth, currentUser } = await import(\"@clerk/nextjs/server\");\n    vi.mocked(auth).mockResolvedValue({ isAuthenticated: false } as any);\n    const { getReviewer } = await import(\"./auth\");\n    await expect(getReviewer()).resolves.toBeNull();\n    expect(currentUser).not.toHaveBeenCalled();\n  });\n});\n```\n\n---\n\n## 3. Route protection — `proxy.ts` (critical, zero coverage)\n\nThis is the sole access-control gate for an internal tool handling org charts and audit mutations. No test verifies the matcher logic.\n\n**Gaps — integration-level, needs Playwright or a Next.js middleware test harness:**\n- `/` is public (no redirect to sign-in)\n- `/sign-in` and `/sign-in/anything` are public\n- `/sign-up` and nested routes are public\n- Any other route (e.g. `/sources`, `/api/anything`) redirects unauthenticated requests\n- Static assets matched by the negative-lookahead regex are *not* intercepted (e.g. `/logo.svg`, `/foo.css`)\n- `/api/*` and `/trpc/*` are protected even though they'd otherwise be excluded by the first matcher pattern\n\n```ts\n// e2e/proxy.spec.ts (Playwright)\nimport { test, expect } from \"@playwright/test\";\n\ntest(\"unauthenticated user is redirected off a protected console route\", async ({ page }) => {\n  await page.goto(\"/sources\");\n  await expect(page).toHaveURL(/sign-in/);\n});\n\ntest(\"landing page is reachable without auth\", async ({ page }) => {\n  await page.goto(\"/\");\n  await expect(page).not.toHaveURL(/sign-in/);\n});\n\ntest(\"sign-in route itself does not redirect\", async ({ page }) => {\n  await page.goto(\"/sign-in\");\n  await expect(