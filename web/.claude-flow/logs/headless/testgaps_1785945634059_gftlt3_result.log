en username and email are both null\", () => {\n    expect(reviewerLabel({ username: null, primaryEmailAddress: null }, \"uid_1\")).toBe(\"uid_1\");\n  });\n\n  it(\"falls back to userId when emailAddress field itself is null\", () => {\n    expect(reviewerLabel({ username: null, primaryEmailAddress: { emailAddress: null } }, \"uid_1\")).toBe(\"uid_1\");\n  });\n\n  it(\"treats empty-string username as falsy and falls through to email\", () => {\n    // Edge case: Clerk *can* return \"\" for username. Confirms ?? doesn't\n    // treat \"\" as absent — if this test fails, the precedence logic needs `||`.\n    expect(reviewerLabel({ username: \"\", primaryEmailAddress: { emailAddress: \"j@x.com\" } }, \"uid_1\")).toBe(\"\");\n  });\n});\n```\n\n### `lib/cn.ts` — `cn()`\n```ts\n// lib/cn.test.ts\nimport { describe, it, expect } from \"vitest\";\nimport { cn } from \"./cn\";\n\ndescribe(\"cn\", () => {\n  it(\"merges class strings\", () => {\n    expect(cn(\"px-2\", \"py-4\")).toBe(\"px-2 py-4\");\n  });\n  it(\"dedupes conflicting tailwind classes, last wins\", () => {\n    expect(cn(\"px-2\", \"px-4\")).toBe(\"px-4\");\n  });\n  it(\"drops falsy values\", () => {\n    expect(cn(\"a\", false && \"b\", undefined, null, \"c\")).toBe(\"a c\");\n  });\n  it(\"handles empty input\", () => {\n    expect(cn()).toBe(\"\");\n  });\n});\n```\n\n### `types/source.ts` — Zod schemas (untested validation boundary)\nThese gate every source create/read. No test confirms invalid input is actually rejected.\n\n```ts\n// types/source.test.ts\nimport { describe, it, expect } from \"vitest\";\nimport { createSourceSchema, sourceSchema, sourceConfigSchema } from \"./source\";\n\ndescribe(\"createSourceSchema\", () => {\n  it(\"accepts a valid source\", () => {\n    expect(() => createSourceSchema.parse({\n      name: \"SFDC Prod\", kind: \"salesforce\", config: { objects: [\"Account\"] },\n    })).not.toThrow();\n  });\n\n  it.each([\"\", \"x\".repeat(81)])(\"rejects name length %s out of bounds\", (name) => {\n    expect(() => createSourceSchema.parse({ name, kind: \"salesforce\", config: { objects: [\"Account\"] } })).toThrow();\n  });\n\n  it(\"rejects an unknown kind\", () => {\n    expect(() => createSourceSchema.parse({ name: \"x\", kind: \"oracle\", config: { objects: [\"a\"] } })).toThrow();\n  });\n\n  it(\"rejects config with zero objects\", () => {\n    expect(() => sourceConfigSchema.parse({ objects: [] })).toThrow();\n  });\n\n  it(\"accepts config without optional filter\", () => {\n    expect(() => sourceConfigSchema.parse({ objects: [\"Account\"] })).not.toThrow();\n  });\n});\n\ndescribe(\"sourceSchema\", () => {\n  it(\"coerces createdAt string to Date\", () => {\n    const parsed = sourceSchema.parse({\n      id: \"123e4567-e89b-12d3-a456-426614174000\",\n      name: \"x\", kind: \"synthetic\", config: { objects: [\"a\"] },\n      createdAt: \"2026-01-01T00:00:00Z\",\n    });\n    expect(parsed.createdAt).toBeInstanceOf(Date);\n  });\n\n  it(\"rejects a non-uuid id\", () => {\n    expect(() => sourceSchema.parse({ id: \"not-a-uuid\", name: \"x\", kind: \"synthetic\", config: { objects: [\"a\"] }, createdAt: new Date() })).toThrow();\n  });\n});\n```\n\n---\n\n## 2. Server-only logic — `lib/server/*.ts`\n\nThese need DB/Clerk mocked; currently completely opaque.\n\n### `lib/server/sources.ts` — `countSourcesBySide()`\nPure aggregation logic hidden behind `listSources()`. Extract-and-test or mock `getDb`.\n\n**Gaps:** kind→side mapping correctness, empty list, source kind not in any bucket (impossible today but silently drops if schema grows), duplicate kinds.\n\n```ts\n// lib/server/sources.test.ts\nimport { describe, it, expect, vi } from \"vitest\";\n\nvi.mock(\"@/lib/db\", () => ({ getDb: vi.fn() }));\nvi.mock(\"next/server\", () => ({ connection: vi.fn().mockResolvedValue(undefined) }));\n\n// After mocking, drive listSources()'s DB call and assert on countSourcesBySide().\ndescribe(\"countSourcesBySide\", () => {\n  it(\"buckets