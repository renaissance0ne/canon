        "title": "B. Pure logic — `types/*.ts`",
        "content": "\nThese files bury real business rules inside what looks like a types module — easy to miss in a coverage sweep.\n\n| File | Untested exports | Edge cases |\n|---|---|---|\n| `types/resolution.ts` | `isHumanDecided` | each of the 6 `ResolutionStatus` values |\n| `types/queue.ts` | `conflictFieldLabel`, `severityReason` | duplicate with `from > to > 0` vs `to === 0`; orphan `childCount` 0/1/plural; every `conflictClass` branch of `severityReason`, incl. default's `severity === 3` split |\n| `types/run.ts` | `isTerminalRunStatus`, `runStageIndex`, `isStatKnown`, `failedStage` | `failedStage` regex: no `stage=`, mixed case, unknown verb (returns null vs mapped); `isStatKnown` for `failed` (always true) vs mid-pipeline statuses |\n| `types/rules.ts` | `orderRulesByEvaluation`, `ruleSpecificity` | tie-break preserves author order; all four specificity combinations (`*/*`, `field/*`, `*/type`, `field/type`); zod `.refine` on `prefer_source` missing `preferredSourceId` |\n\n**Skeleton — `types/run.test.ts`**:\n\n```ts\nimport { describe, it, expect } from \"vitest\";\nimport { failedStage, isStatKnown, isTerminalRunStatus, runStageIndex } from \"@/types/run\";\n\ndescribe(\"failedStage\", () => {\n  it.each([\n    [\"source=Databricks GTM stage=extract\", \"extracting\"],\n    [\"stage=matching\", \"matching\"],\n    [\"STAGE=Resolve\", \"resolving\"],\n    [\"no stage marker here\", null],\n    [null, null],\n  ])(\"parses %s -> %s\", (error, expected) => {\n    expect(failedStage(error)).toBe(expected);\n  });\n});\n\ndescribe(\"isStatKnown\", () => {\n  it(\"is true for every stat once a run is complete\", () => {\n    expect(isStatKnown(\"tokensUsed\", \"complete\")).toBe(true);\n  });\n  it(\"is true for every stat on a failed run (partial progress kept)\", () => {\n    expect(isStatKnown(\"conflicts\", \"failed\")).toBe(true);\n  });\n  it(\"is false for a stat whose stage hasn't run yet\", () => {\n    expect(isStatKnown(\"conflicts\", \"matching\")).toBe(false);\n  });\n  it(\"is true once the producing stage is behind current\", () => {\n    expect(isStatKnown(\"candidatePairs\", \"detecting\")).toBe(true);\n  });\n});\n\ndescribe(\"isTerminalRunStatus / runStageIndex\", () => {\n  it(\"failed has no stage position\", () => {\n    expect(runStageIndex(\"failed\")).toBe(-1);\n  });\n  it(\"complete and failed are both terminal\", () => {\n    expect(isTerminalRunStatus(\"complete\")).toBe(true);\n    expect(isTerminalRunStatus(\"failed\")).toBe(true);\n    expect(isTerminalRunStatus(\"resolving\")).toBe(false);\n  });\n});\n```\n\n**Skeleton — `types/rules.test.ts`**:\n\n```ts\nimport { describe, it, expect } from \"vitest\";\nimport { orderRulesByEvaluation, ruleSpecificity, survivorshipRuleSchema } from \"@/types/rules\";\n\ndescribe(\"ruleSpecificity\", () => {\n  it(\"ranks field+entityType above field-only above entityType-only above wildcard\", () => {\n    const wildcard = ruleSpecificity({ id: \"1\", field: \"*\", entityType: \"*\", strategy: \"escalate\", description: \"\" });\n    const fieldOnly = ruleSpecificity({ id: \"2\", field: \"x\", entityType: \"*\", strategy: \"escalate\", description: \"\" });\n    const both = ruleSpecificity({ id: \"3\", field: \"x\", entityType: \"account\", strategy: \"escalate\", description: \"\" });\n    expect(both).toBeGreaterThan(fieldOnly);\n    expect(fieldOnly).toBeGreaterThan(wildcard);\n  });\n});\n\ndescribe(\"orderRulesByEvaluation\", () => {\n  it(\"keeps author order among equally-specific rules\", () => {\n    const a = { id: \"a\", field: \"*\", entityType: \"*\", strategy: \"escalate\" as const, description: \"\" };\n    const b = { id: \"b\", field: \"*\", entityType: \"*\", strategy: \"most_recent\" as const, description: \"\" };\n    expect(orderRulesByEvaluation([a, b]).map((r) => r.id)).toEqual([\"a\", \"b\"]);\n  });\n});\n\ndescribe(\"survivorshipRuleSchema\", () => {\n  it(\"rejects prefer_source without preferredSourceId\", () => {\n    const result = survivorshipRuleSchema.safeParse({\n      id: \"1\", field: \"*\", entityType: \"*\", strategy: \"prefer_source\", description: \"\",\n    });\n    expect(result.success).toBe(false);\n  });\n});\n```\n\n---\n\n",
