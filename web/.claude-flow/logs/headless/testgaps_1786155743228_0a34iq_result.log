ait postJson(\"/api/x\", {});\n    expect(result).toEqual({ ok: false, message: \"Bad thing\", issues: { field: \"x\" } });\n  });\n\n  it(\"falls back to a status-based message when body has no error field\", async () => {\n    vi.stubGlobal(\"fetch\", vi.fn().mockResolvedValue(new Response(\"\", { status: 500 })));\n    const result = await patchJson(\"/api/x\", {});\n    expect(result).toMatchObject({ ok: false, message: expect.stringContaining(\"500\") });\n  });\n\n  it(\"handles a network failure (fetch throws)\", async () => {\n    vi.stubGlobal(\"fetch\", vi.fn().mockRejectedValue(new TypeError(\"network down\")));\n    const result = await postJson(\"/api/x\", {});\n    expect(result.ok).toBe(false);\n  });\n\n  it(\"handles a non-JSON response body\", async () => {\n    vi.stubGlobal(\"fetch\", vi.fn().mockResolvedValue(new Response(\"<html>\", { status: 200 })));\n    const result = await postJson(\"/api/x\", {});\n    // payload becomes null via .catch — confirm this doesn't throw\n    expect(result.ok).toBe(true);\n  });\n});\n```\n\n---\n\n### B. Pure logic — `types/*.ts`\n\nThese files bury real business rules inside what looks like a types module — easy to miss in a coverage sweep.\n\n| File | Untested exports | Edge cases |\n|---|---|---|\n| `types/resolution.ts` | `isHumanDecided` | each of the 6 `ResolutionStatus` values |\n| `types/queue.ts` | `conflictFieldLabel`, `severityReason` | duplicate with `from > to > 0` vs `to === 0`; orphan `childCount` 0/1/plural; every `conflictClass` branch of `severityReason`, incl. default's `severity === 3` split |\n| `types/run.ts` | `isTerminalRunStatus`, `runStageIndex`, `isStatKnown`, `failedStage` | `failedStage` regex: no `stage=`, mixed case, unknown verb (returns null vs mapped); `isStatKnown` for `failed` (always true) vs mid-pipeline statuses |\n| `types/rules.ts` | `orderRulesByEvaluation`, `ruleSpecificity` | tie-break preserves author order; all four specificity combinations (`*/*`, `field/*`, `*/ty