      {
        "title": "C. Server business logic — `lib/server/*.ts` (needs DB mocking, currently 0 tests, highest risk)",
        "content": "\nThis is where the actual product rules live — auto-apply gating, review recording, export assembly, the reproducibility guarantees the codebase's own comments call out as load-bearing. All of it is currently unverified by anything except manual testing.\n\n| File | Untested functions | Notable gaps |\n|---|---|---|\n| `lib/server/auth.ts` | `requireReviewer`, `getReviewer` | throws with no session (must not silently write \"anonymous\" to audit_log); `getReviewer` returns `null` cleanly |\n| `lib/server/conflicts.ts` | `recordReview`, `toQueueRow` (via `getQueuePage`), `splitValues`, `sourceName` | **every branch of `recordReview`**: no conflict (404), no resolution yet (409), `approve` with empty `proposedValue` (409 — \"approving nothing is not a decision\"), invalid override value (400), valid override folds to observed value; orphan `present` flag when one side has zero values; `sourceName` fallback to `\"unknown source\"` for an engine bug |\n| `lib/server/engine.ts` | `startRun`, `fetchEngineStatus`, `engineUrl` | `ENGINE_URL` unset throws; dispatch timeout → `EngineUnreachableError`; non-OK response; malformed response body fails schema check; `fetchEngineStatus` returns `null` (not throw) on any failure — timeout, non-OK, bad schema |\n| `lib/server/entities.ts` | `countChildrenByParent`, `countAccounts` | empty `externalIds` short-circuits to empty Map without querying; duplicate ids deduped |\n| `lib/server/export.ts` | `buildRunExport`, `applyDecisions`, `decisionsToCsv`, `estimateExportBytes`, `isExportSection` | `appliedValue` per status (`escalated`/`proposed`/`rejected` → null; `overridden` → override value; `auto_applied`/`approved` → proposed value); `applyDecisions` sets `reparented` only when resolved parent differs; CSV cell quoting for embedded commas/quotes/newlines; sections requested vs sections attached (asking for `orphans` alone must not also compute decisions/hierarchy) |\n| `lib/server/rulesets.ts` | `createRulesetVersion`, `getActiveRuleset` | first version for a new name is `1`; only one ruleset is active after a save (old one flipped off); `getActiveRuleset` returns `null` when none active |\n| `lib/server/runs.ts` | `failUndispatchedRun`, `getSeverityBreakdown` | guarded update only affects rows still `queued` (a race with the engine must not clobber real progress); severity outside 1–4 dropped rather than crashing |\n| `lib/server/sources.ts` | `countSourcesBySide`, `findSourceIds` | kind→side classification for every `SourceKind`; `findSourceIds([])` short-circuits |\n\n**Skeleton — `lib/server/conflicts.test.ts`** (the file with the most business rules):\n\n```ts\nimport { describe, it, expect, vi, beforeEach } from \"vitest\";\n\nconst mockDb = {\n  select: vi.fn().mockReturnThis(),\n  from: vi.fn().mockReturnThis(),\n  innerJoin: vi.fn().mockReturnThis(),\n  leftJoin: vi.fn().mockReturnThis(),\n  where: vi.fn().mockReturnThis(),\n  limit: vi.fn(),\n  update: vi.fn().mockReturnThis(),\n  set: vi.fn().mockReturnThis(),\n};\nvi.mock(\"@/lib/db\", () => ({ getDb: () => mockDb }));\nvi.mock(\"@/lib/server/audit\", () => ({ appendAudit: vi.fn() }));\n\nimport { recordReview } from \"@/lib/server/conflicts\";\nimport { appendAudit } from \"@/lib/server/audit\";\n\nconst reviewer = { userId: \"u1\", label: \"j.rao\" };\n\ndescribe(\"recordReview\", () => {\n  beforeEach(() => vi.clearAllMocks());\n\n  it(\"returns 404 when the conflict does not exist\", async () => {\n    mockDb.limit.mockResolvedValueOnce([]); // getReviewTarget's baseQuery\n    const result = await recordReview({ conflictId: \"c1\", action: { action: \"approve\" }, reviewer });\n    expect(result).toEqual({ ok: false, code: 404, message: expect.any(String) });\n  });\n\n  it(\"returns 409 when the conflict has no resolution yet\", async () => {\n    mockDb.limit.mockResolvedValueOnce([{ conflictId: \"c1\", resolutionId: null, valueA: \"X\", valueB: \"\" }]);\n    const result = await recordReview({ conflictId: \"c1\", action: { action: \"approve\" }, reviewer });\n    expect(result).toMatchObject({ ok: false, code: 409 });\n  });\n\n  it(\"returns 409 approving an escalated conflict with no proposed value\", async () => {\n    mockDb.limit.mockResolvedValueOnce([{\n      conflictId: \"c1\", resolutionId: \"r1\", proposedValue: \"\", status: \"escalated\",\n      appliedRuleId: null, confidence: 0, valueA: \"A\", valueB: \"B\",\n    }]);\n    const result = await recordReview({ conflictId: \"c1\", action: { action: \"approve\" }, reviewer });\n    expect(result).toMatchObject({ ok: false, code: 409 });\n  });\n\n  it(\"returns 400 when an override value is not one of the observed values\", async () => {\n    mockDb.limit.mockResolvedValueOnce([{\n      conflictId: \"c1\", resolutionId: \"r1\", proposedValue: \"ACC-1\", status: \"escalated\",\n      appliedRuleId: null, confidence: 0, valueA: \"ACC-1\", valueB: \"ACC-2\",\n    }]);\n    const result = await recordReview({\n      conflictId: \"c1\", action: { action: \"override\", overrideValue: \"ACC-9999\" }, reviewer,\n    });\n    expect(result).toMatchObject({ ok: false, code: 400 });\n    expect(appendAudit).not.toHaveBeenCalled();\n  });\n\n  it(\"writes an approved resolution and appends human_approved to the audit log\", async () => {\n    mockDb.limit.mockResolvedValueOnce([{\n      conflictId: \"c1\", runId: \"run1\", resolutionId: \"r1\", proposedValue: \"ACC-1\",\n      status: \"escalated\", appliedRuleId: null, confidence: 0.9, valueA: \"ACC-1\", valueB: \"ACC-2\",\n      field: \"parentExternalId\", severity: 3, aExternalId: \"e1\",\n    }]);\n    const result = await recordReview({ conflictId: \"c1\", action: { action: \"approve\" }, reviewer });\n    expect(result).toEqual({ ok: true, status: \"approved\" });\n    expect(appendAudit).toHaveBeenCalledWith(expect.objectContaining({ action: \"human_approved\" }));\n  });\n});\n```\n\n**Skeleton — `lib/server/engine.test.ts`** (error-handling focus — this is the file whose whole job is degrading gracefully):\n\n```ts\nimport { describe, it, expect, vi, beforeEach, afterEach } from \"vitest\";\nimport { startRun, fetchEngineStatus, EngineUnreachableError } from \"@/lib/server/engine\";\n\nbeforeEach(() => { process.env.ENGINE_URL = \"http://engine.test\"; });\nafterEach(() => { vi.unstubAllGlobals(); delete process.env.ENGINE_URL; });\n\ndescribe(\"startRun\", () => {\n  it(\"throws EngineUnreachableError when ENGINE_URL is unset\", async () => {\n    delete process.env.ENGINE_URL;\n    await expect(startRun(\"run-1\")).rejects.toThrow(EngineUnreachableError);\n  });\n\n  it(\"throws when fetch rejects (network down)\", async () => {\n    vi.stubGlobal(\"fetch\", vi.fn().mockRejectedValue(new Error(\"ECONNREFUSED\")));\n    await expect(startRun(\"run-1\")).rejects.toThrow(EngineUnreachableError);\n  });\n\n  it(\"throws when the engine responds non-OK\", async () => {\n    vi.stubGlobal(\"fetch\", vi.fn().mockResolvedValue(new Response(\"boom\", { status: 500 })));\n    await expect(startRun(\"run-1\")).rejects.toThrow(EngineUnreachableError);\n  });\n\n  it(\"throws when the 200 body doesn't match the tool contract\", async () => {\n    vi.stubGlobal(\"fetch\", vi.fn().mockResolvedValue(\n      new Response(JSON.stringify({ unexpected: true }), { status: 200 }),\n    ));\n    await expect(startRun(\"run-1\")).rejects.toThrow(EngineUnreachableError);\n  });\n\n  it(\"resolves on a valid accepted response\", async () => {\n    vi.stubGlobal(\"fetch\", vi.fn().mockResolvedValue(\n      new Response(JSON.stringify({ runId: \"run-1\", accepted: true }), { status: 200 }),\n    ));\n    await expect(startRun(\"run-1\")).resolves.toBeUndefined();\n  });\n});\n\ndescribe(\"fetchEngineStatus\", () => {\n  it(\"returns null (never throws) when fetch rejects\", async () => {\n    vi.stubGlobal(\"fetch\", vi.fn().mockRejectedValue(new Error(\"timeout\")));\n    expect(await fetchEngineStatus(\"run-1\")).toBeNull();\n  });\n\n  it(\"returns null on a non-OK response\", async () => {\n    vi.stubGlobal(\"fetch\", vi.fn().mockResolvedValue(new Response(\"\", { status: 503 })));\n    expect(await fetchEngineStatus(\"run-1\")).toBeNull();\n  });\n\n  it(\"returns null when the body fails schema validation\", async () => {\n    vi.stubGlobal(\"fetch\", vi.fn().mockResolvedValue(\n      new Response(JSON.stringify({ garbage: true }), { status: 200 }),\n    ));\n    expect(await fetchEngineStatus(\"run-1\")).toBeNull();\n  });\n});\n```\n\n---\n\n",
        "level": 3
      },
      {
        "title": "D. API routes — `app/api/**/route.ts` (integration layer, zero tests)",
        "content": "\nNext.js Route Handlers export plain `GET`/`POST` functions and can be called directly with a constructed `Request` — no server needed.\n\n| Route | Untested behavior |\n|---|---|\n| `POST /api/conflicts/[conflictId]/resolution` | invalid UUID param → 404 before touching DB; Zod rejection → 400 with `issues`; propagates 400/404/409 from `recordReview` |\n| `POST /api/runs` | `sourceAId === sourceBId` → 400; nonexistent source/ruleset id → 400 (not a raw FK 500); **engine-unreachable path**: run row created, `failUndispatchedRun` called, `run_failed` audit written, still returns **201** (not 500) |\n| `GET /api/runs/[runId]/status` | terminal run skips the engine call entirely; non-terminal run prefers live engine status over the DB row; falls back to DB row when engine returns null; `cache-control: no-store` header present |\n| `GET /api/runs/[runId]/export` | invalid `format` → 400; invalid `sections` → 400; unknown section name → 400; sections de-duplicated and reordered to canonical order regardless of input order; CSV path ignores `hierarchy`/`orphans`/`stats` |\n| `GET /api/audit/export` | invalid `runId` → 404; invalid `action` → 400; CSV column order and quoting |\n| `GET /api/conflicts` | invalid query (bad `page`, bad `severities`) → 400; `no-runs` state returns the documented empty shape rather than erroring |\n\n**Skeleton — `app/api/runs/route.test.ts`** (the richest error-handling route):\n\n```ts\nimport { describe, it, expect, vi, beforeEach } from \"vitest\";\n\nvi.mock(\"@/lib/server/auth\", () => ({ requireReviewer: vi.fn().mockResolvedValue({ userId: \"u1\", label: \"j.rao\" }) }));\nvi.mock(\"@/lib/server/audit\", () => ({ appendAudit: vi.fn() }));\nvi.mock(\"@/lib/server/sources\", () => ({ findSourceIds: vi.fn() }));\nvi.mock(\"@/lib/server/rulesets\", () => ({ getRuleset: vi.fn() }));\nvi.mock(\"@/lib/server/runs\", () => ({ createRun: vi.fn(), failUndispatchedRun: vi.fn(), listRuns: vi.fn() }));\nvi.mock(\"@/lib/server/engine\", async (importOriginal) => {\n  const actual = await importOriginal<typeof import(\"@/lib/server/engine\")>();\n  return { ...actual, startRun: vi.fn() };\n});\n\nimport { POST } from \"@/app/api/runs/route\";\nimport { findSourceIds } from \"@/lib/server/sources\";\nimport { getRuleset } from \"@/lib/server/rulesets\";\nimport { createRun, failUndispatchedRun } from \"@/lib/server/runs\";\nimport { startRun, EngineUnreachableError } from \"@/lib/server/engine\";\n\nfunction req(body: unknown) {\n  return new Request(\"http://test/api/runs\", { method: \"POST\", body: JSON.stringify(body) });\n}\n\nconst validBody = { sourceAId: \"11111111-1111-1111-1111-111111111111\",\n  sourceBId: \"22222222-2222-2222-2222-222222222222\",\n  rulesetId: \"33333333-3333-3333-3333-333333333333\" };\n\ndescribe(\"POST /api/runs\", () => {\n  beforeEach(() => vi.clearAllMocks());\n\n  it(\"400s when source A equals source B\", async () => {\n    const res = await POST(req({ ...validBody, sourceBId: validBody.sourceAId }));\n    expect(res.status).toBe(400);\n  });\n\n  it(\"400s when a source id doesn't exist (not a raw FK error)\", async () => {\n    vi.mocked(findSourceIds).mockResolvedValue(new Set([validBody.sourceAId]));\n    vi.mocked(getRuleset).mockResolvedValue({ id: validBody.rulesetId, name: \"x\", version: 1 } as any);\n    const res = await POST(req(validBody));\n    expect(res.status).toBe(400);\n  });\n\n  it(\"still returns 201 and records the failure when the engine is unreachable\", async () => {\n    vi.mocked(findSourceIds).mockResolvedValue(new Set([validBody.sourceAId, validBody.sourceBId]));\n    vi.mocked(getRuleset).mockResolvedValue({ id: validBody.rulesetId, name: \"x\", version: 1 } as any);\n    vi.mocked(createRun).mockResolvedValue({ id: \"run-1\" } as any);\n    vi.mocked(startRun).mockRejectedValue(new EngineUnreachableError(\"down\"));\n\n    const res = await POST(req(validBody));\n    expect(res.status).toBe(201);\n    expect(failUndispatchedRun).toHaveBeenCalledWith(\"run-1\", expect.stringContaining(\"stage=dispatch\"));\n  });\n});\n```\n\n---\n\n",
        "level": 3
      },
      {
        "title": "E. Client components & the one hook",
        "content": "\nMost components are presentational, but a handful carry real logic worth isolating.\n\n| File | Gap |\n|---|---|\n| `components/conflicts/use-review.ts` | success path updates `decided[conflictId]` from the **server's** response (not an optimistic guess) and calls `router.refresh()`; failure path leaves `decided` untouched and returns the message; `pendingId` set then cleared regardless of outcome |\n| `components/conflicts/override-panel.tsx` | Save disabled until `check.ok`; error only shows after `touched`; clicking an observed value fills the input and marks touched; submitted value is the **folded match**, not the raw typed text |\n| `components/rules/ruleset-editor.tsx` | `dirty` detection via `sameRules` (field-by-field, not JSON.stringify) — reordering rules, or a strategy change with same JSON shape, must flip dirty correctly; `save()` blocks with a message when `prefer_source` has no `preferredSourceId`; `preferredSourceId` stripped when strategy isn't `prefer_source` |\n\n**Skeleton — `components/conflicts/use-review.test.ts`**:\n\n```ts\nimport { describe, it, expect, vi, beforeEach } from \"vitest\";\nimport { renderHook, act, waitFor } from \"@testing-library/react\";\n\nconst refresh = vi.fn();\nvi.mock(\"next/navigation\", () => ({ useRouter: () => ({ refresh }) }));\nvi.mock(\"@/lib/api-client\", () => ({ patchJson: vi.fn() }));\n\nimport { useReview } from \"@/components/conflicts/use-review\";\nimport { patchJson } from \"@/lib/api-client\";\n\ndescribe(\"useReview\", () => {\n  beforeEach(() => vi.clearAllMocks());\n\n  it(\"records the server's status on success and triggers a refresh\", async () => {\n    vi.mocked(patchJson).mockResolvedValue({\n      ok: true, data: { conflictId: \"c1\", status: \"approved\", reviewedBy: \"j.rao\" },\n    });\n    const { result } = renderHook(() => useReview());\n\n    await act(async () => {\n      const outcome = await result.current.submit(\"c1\", { action: \"approve\" });\n      expect(outcome).toEqual({ ok: true });\n    });\n\n    expect(result.current.decided.c1).toEqual({ status: \"approved\", reviewedBy: \"j.rao\" });\n    await waitFor(() => expect(refresh).toHaveBeenCalled());\n  });\n\n  it(\"leaves decided untouched and returns the message on failure\", async () => {\n    vi.mocked(patchJson).mockResolvedValue({ ok: false, message: \"Nothing proposed yet.\" });\n    const { result } = renderHook(() => useReview());\n\n    let outcome;\n    await act(async () => { outcome = await result.current.submit(\"c1\", { action: \"approve\" }); });\n\n    expect(outcome).toEqual({ ok: false, message: \"Nothing proposed yet.\" });\n    expect(result.current.decided.c1).toBeUndefined();\n    expect(refresh).not.toHaveBeenCalled();\n  });\n\n  it(\"clears pendingId after the request settles, on both paths\", async () => {\n    vi.mocked(patchJson).mockResolvedValue({ ok: false, message: \"x\" });\n    const { result } = renderHook(() => useReview());\n    await act(async () => { await result.current.submit(\"c1\", { action: \"reject\" }); });\n    expect(result.current.pendingId).toBeNull();\n  });\n});\n```\n\n---\n\n",
        "level": 3
      },
      {
        "title": "F. Middleware / auth boundary — `proxy.ts`",
        "content": "\nZero coverage, and it's the thing standing between an unauthenticated request and the org chart. Unit-testing Clerk middleware directly is awkward; the practical gap is an **integration test** hitting the app (or at minimum asserting the matcher config):\n\n```ts\n// proxy.test.ts — verify the route matcher, since that's the part that's pure data\nimport { describe, it, expect } from \"vitest\";\nimport { createRouteMatcher } from \"@clerk/nextjs/server\";\n\n// Re-derive the same matcher the middleware uses, or export isPublicRoute from proxy.ts for testing.\nconst isPublicRoute = createRouteMatcher([\"/\", \"/sign-in(.*)\", \"/sign-up(.*)\"]);\n\nit(\"treats landing and auth pages as public\", () => {\n  expect(isPublicRoute(new Request(\"http://t/\"))).toBe(true);\n  expect(isPublicRoute(new Request(\"http://t/sign-in/factor-one\"))).toBe(true);\n});\n\nit(\"treats the console and API as protected\", () => {\n  expect(isPublicRoute(new Request(\"http://t/conflicts\"))).toBe(false);\n  expect(isPublicRoute(new Request(\"http://t/api/runs\"))).toBe(false);\n});\n```\n*(Requires exporting `isPublicRoute` from `proxy.ts`, or duplicating the matcher — flag this as a minor refactor-for-testability.)*\n\n---\n\n",
        "level": 3
      },
      {
        "title": "G. Integration test gaps (no unit test can catch these)",
        "content": "\n1. **End-to-end review flow**: create a run → seed a conflict + resolution against a real (test) Postgres → PATCH approve/reject/override through the actual route → assert both `resolutions` and `audit_log` rows, not just the HTTP response. Every current \"unit\" test above mocks the DB; nothing verifies the Drizzle queries themselves compile/execute correctly against real schema (join correctness in `toQueueRow`, the `NULLS LAST` ordering, the advisory lock in `createRulesetVersion`).\n2. **Engine dispatch failure → UI**: `POST /api/runs` with the engine down should produce a run a reviewer can actually see fail in the console (wireframe 1h), not just a 201 in isolation.\n3. **Export round-trip**: download JSON with each section combination and CSV, and diff against `buildRunExport`'s actual DB-backed output — the current gap only tests `applyDecisions`/`decisionsToCsv` against hand-built fixtures, never the join queries feeding them.\n4. **Ruleset version race**: two concurrent `createRulesetVersion` calls for the same name must not both become v4 — this is exactly what the `pg_advisory_xact_lock` exists to prevent, and it's untestable without a real Postgres connection and concurrent requests.\n5. **Auth boundary**: an unauthenticated request to any `/api/*` or console route actually gets redirected/blocked — currently zero coverage above the pure-function level in F.\n6. **Queue filter chip counts vs list**: `getQueueCounts`'s \"counted with every filter except its own\" contract is described in a comment but never asserted — a regression here would silently mislead reviewers about queue size.\n\n---\n\n",
        "level": 3
      },
      {
        "title": "Priority if starting from zero",
        "content": "1. `lib/*.ts` and `types/*.ts` — pure, cheap, catches the most subtle logic bugs (folding, formatting, severity reasoning).\n2. `lib/server/conflicts.ts::recordReview` and `lib/server/engine.ts` — highest-risk business logic and the two files whose entire purpose is correct error handling.\n3. Route handlers for `/api/runs` and `/api/conflicts/[id]/resolution` — thin but load-bearing; catches wiring bugs the unit tests below them can't.\n4. `use-review.ts` and `override-panel.tsx` — the only two client-side files with real branching logic.\n5. Integration tests (section G) — once a test database is wired up in CI.",
        "level": 3
      }
    ],
    "codeBlocks": [
      {
        "language": "bash",
        "code": "npm i -D vitest @vitejs/plugin-react jsdom @testing-library/react @testing-library/jest-dom @testing-library/user-event"
      },
      {
        "language": "ts",
        "code": "import { describe, it, expect } from \"vitest\";\nimport { foldValue, checkObservedValue, observedValues, LEGAL_SUFFIXES } from \"@/lib/validate-value\";\n\ndescribe(\"foldValue\", () => {\n  it(\"lowercases, strips punctuation, collapses whitespace\", () => {\n    expect(foldValue(\"ACME-INC\")).toBe(\"acme\");\n    expect(foldValue(\"ACME INC\")).toBe(\"acme\");\n  });\n\n  it(\"strips a legal suffix\", () => {\n    expect(foldValue(\"Trellis Labs Inc\")).toBe(\"trellis labs\");\n  });\n\n  it(\"strips stacked suffixes longest-first (pvt ltd, not ltd alone)\", () => {\n    expect(foldValue(\"Trellis Labs Pvt Ltd\")).toBe(\"trellis labs\");\n  });\n\n  it(\"does not strip when the whole value IS the suffix\", () => {\n    expect(foldValue(\"Ltd\")).toBe(\"ltd\");\n  });\n\n  it(\"handles empty and whitespace-only input\", () => {\n    expect(foldValue(\"   \")).toBe(\"\");\n  });\n});\n\ndescribe(\"checkObservedValue\", () => {\n  it(\"rejects an empty candidate\", () => {\n    expect(checkObservedValue(\"\", [\"ACME\"])).toEqual({ ok: false, reason: expect.any(String) });\n  });\n\n  it(\"rejects when neither side holds a value (orphan-orphan)\", () => {\n    expect(checkObservedValue(\"ACME\", [\"\", \" \"])).toMatchObject({ ok: false });\n  });\n\n  it(\"accepts an exact match\", () => {\n    expect(checkObservedValue(\"ACME\", [\"ACME\", \"Acme Inc.\"])).toEqual({ ok: true, matches: \"ACME\" });\n  });\n\n  it(\"accepts a folded/normalized match\", () => {\n    expect(checkObservedValue(\"acme\", [\"Acme Inc.\"])).toEqual({ ok: true, matches: \"Acme Inc.\" });\n  });\n\n  it(\"rejects an invented value not present on either side\", () => {\n    const result = checkObservedValue(\"Nobody Corp\", [\"ACME\", \"Acme Inc.\"]);\n    expect(result.ok).toBe(false);\n  });\n});\n\ndescribe(\"observedValues\", () => {\n  it(\"flattens both sides and drops blanks\", () => {\n    expect(observedValues({ a: { values: [\"X\", \"\"] }, b: { values: [\" \"] } })).toEqual([\"X\"]);\n  });\n});"
      },
      {
        "language": "ts",
        "code": "import { describe, it, expect, vi, afterEach } from \"vitest\";\nimport { postJson, patchJson } from \"@/lib/api-client\";\n\nafterEach(() => vi.unstubAllGlobals());\n\ndescribe(\"postJson / patchJson\", () => {\n  it(\"returns ok:true with parsed data on 200\", async () => {\n    vi.stubGlobal(\"fetch\", vi.fn().mockResolvedValue(\n      new Response(JSON.stringify({ id: \"1\" }), { status: 200 }),\n    ));\n    const result = await postJson(\"/api/x\", { a: 1 });\n    expect(result).toEqual({ ok: true, data: { id: \"1\" } });\n  });\n\n  it(\"surfaces the server error field on non-OK\", async () => {\n    vi.stubGlobal(\"fetch\", vi.fn().mockResolvedValue(\n      new Response(JSON.stringify({ error: \"Bad thing\", issues: { field: \"x\" } }), { status: 400 }),\n    ));\n    const result = await postJson(\"/api/x\", {});\n    expect(result).toEqual({ ok: false, message: \"Bad thing\", issues: { field: \"x\" } });\n  });\n\n  it(\"falls back to a status-based message when body has no error field\", async () => {\n    vi.stubGlobal(\"fetch\", vi.fn().mockResolvedValue(new Response(\"\", { status: 500 })));\n    const result = await patchJson(\"/api/x\", {});\n    expect(result).toMatchObject({ ok: false, message: expect.stringContaining(\"500\") });\n  });\n\n  it(\"handles a network failure (fetch throws)\", async () => {\n    vi.stubGlobal(\"fetch\", vi.fn().mockRejectedValue(new TypeError(\"network down\")));\n    const result = await postJson(\"/api/x\", {});\n    expect(result.ok).toBe(false);\n  });\n\n  it(\"handles a non-JSON response body\", async () => {\n    vi.stubGlobal(\"fetch\", vi.fn().mockResolvedValue(new Response(\"<html>\", { status: 200 })));\n    const result = await postJson(\"/api/x\", {});\n    // payload becomes null via .catch — confirm this doesn't throw\n    expect(result.ok).toBe(true);\n  });\n});"
