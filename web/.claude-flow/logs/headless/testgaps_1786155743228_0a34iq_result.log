        "code": "import { describe, it, expect, vi, beforeEach } from \"vitest\";\n\nconst mockDb = {\n  select: vi.fn().mockReturnThis(),\n  from: vi.fn().mockReturnThis(),\n  innerJoin: vi.fn().mockReturnThis(),\n  leftJoin: vi.fn().mockReturnThis(),\n  where: vi.fn().mockReturnThis(),\n  limit: vi.fn(),\n  update: vi.fn().mockReturnThis(),\n  set: vi.fn().mockReturnThis(),\n};\nvi.mock(\"@/lib/db\", () => ({ getDb: () => mockDb }));\nvi.mock(\"@/lib/server/audit\", () => ({ appendAudit: vi.fn() }));\n\nimport { recordReview } from \"@/lib/server/conflicts\";\nimport { appendAudit } from \"@/lib/server/audit\";\n\nconst reviewer = { userId: \"u1\", label: \"j.rao\" };\n\ndescribe(\"recordReview\", () => {\n  beforeEach(() => vi.clearAllMocks());\n\n  it(\"returns 404 when the conflict does not exist\", async () => {\n    mockDb.limit.mockResolvedValueOnce([]); // getReviewTarget's baseQuery\n    const result = await recordReview({ conflictId: \"c1\", action: { action: \"approve\" }, reviewer });\n    expect(result).toEqual({ ok: false, code: 404, message: expect.any(String) });\n  });\n\n  it(\"returns 409 when the conflict has no resolution yet\", async () => {\n    mockDb.limit.mockResolvedValueOnce([{ conflictId: \"c1\", resolutionId: null, valueA: \"X\", valueB: \"\" }]);\n    const result = await recordReview({ conflictId: \"c1\", action: { action: \"approve\" }, reviewer });\n    expect(result).toMatchObject({ ok: false, code: 409 });\n  });\n\n  it(\"returns 409 approving an escalated conflict with no proposed value\", async () => {\n    mockDb.limit.mockResolvedValueOnce([{\n      conflictId: \"c1\", resolutionId: \"r1\", proposedValue: \"\", status: \"escalated\",\n      appliedRuleId: null, confidence: 0, valueA: \"A\", valueB: \"B\",\n    }]);\n    const result = await recordReview({ conflictId: \"c1\", action: { action: \"approve\" }, reviewer });\n    expect(result).toMatchObject({ ok: false, code: 409 });\n  });\n\n  it(\"returns 400 when an override value is not one of the observed values\", async () => {\n    mockDb.limit.mockResolvedValueOnce([{\n      conflictId: \"c1\", resolutionId: \"r1\", proposedValue: \"ACC-1\", status: \"escalated\",\n      appliedRuleId: null, confidence: 0, valueA: \"ACC-1\", valueB: \"ACC-2\",\n    }]);\n    const result = await recordReview({\n      conflictId: \"c1\", action: { action: \"override\", overrideValue: \"ACC-9999\" }, reviewer,\n    });\n    expect(result).toMatchObject({ ok: false, code: 400 });\n    expect(appendAudit).not.toHaveBeenCalled();\n  });\n\n  it(\"writes an approved resolution and appends human_approved to the audit log\", async () => {\n    mockDb.limit.mockResolvedValueOnce([{\n      conflictId: \"c1\", runId: \"run1\", resolutionId: \"r1\", proposedValue: \"ACC-1\",\n      status: \"escalated\", appliedRuleId: null, confidence: 0.9, valueA: \"ACC-1\", valueB: \"ACC-2\",\n      field: \"parentExternalId\", severity: 3, aExternalId: \"e1\",\n    }]);\n    const result = await recordReview({ conflictId: \"c1\", action: { action: \"approve\" }, reviewer });\n    expect(result).toEqual({ ok: true, status: \"approved\" });\n    expect(appendAudit).toHaveBeenCalledWith(expect.objectContaining({ action: \"human_approved\" }));\n  });\n});"
