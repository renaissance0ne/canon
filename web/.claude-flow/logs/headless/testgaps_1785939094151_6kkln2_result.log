        "language": "ts",
        "code": "import { describe, it, expect, vi } from \"vitest\";\n\nconst authMock = vi.fn();\nconst currentUserMock = vi.fn();\nvi.mock(\"@clerk/nextjs/server\", () => ({ auth: () => authMock(), currentUser: () => currentUserMock() }));\n\nimport { requireReviewer, getReviewer } from \"@/lib/server/auth\";\n\ndescribe(\"requireReviewer\", () => {\n  it(\"throws when there is no session (matcher/handler disagreement)\", async () => {\n    authMock.mockResolvedValue({ isAuthenticated: false, userId: null });\n    await expect(requireReviewer()).rejects.toThrow(/No authenticated reviewer/);\n  });\n\n  it(\"throws when isAuthenticated is true but userId is somehow falsy\", async () => {\n    authMock.mockResolvedValue({ isAuthenticated: true, userId: \"\" });\n    await expect(requireReviewer()).rejects.toThrow();\n  });\n\n  it(\"resolves label from currentUser when session exists\", async () => {\n    authMock.mockResolvedValue({ isAuthenticated: true, userId: \"uid_1\" });\n    currentUserMock.mockResolvedValue({ username: \"j.rao\", primaryEmailAddress: null });\n    await expect(requireReviewer()).resolves.toEqual({ userId: \"uid_1\", label: \"j.rao\" });\n  });\n});\n\ndescribe(\"getReviewer\", () => {\n  it(\"returns null when signed out, without calling currentUser\", async () => {\n    authMock.mockResolvedValue({ isAuthenticated: false, userId: null });\n    expect(await getReviewer()).toBeNull();\n    expect(currentUserMock).not.toHaveBeenCalled();\n  });\n\n  it(\"returns a Reviewer when signed in\", async () => {\n    authMock.mockResolvedValue({ isAuthenticated: true, userId: \"uid_1\" });\n    currentUserMock.mockResolvedValue({ username: null, primaryEmailAddress: { emailAddress: \"j@x.com\" } });\n    expect(await getReviewer()).toEqual({ userId: \"uid_1\", label: \"j@x.com\" });\n  });\n});"
