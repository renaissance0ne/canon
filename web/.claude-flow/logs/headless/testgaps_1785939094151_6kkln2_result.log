        "code": "import { describe, it, expect } from \"vitest\";\nimport { reviewerLabel } from \"@/lib/reviewer-label\";\n\ndescribe(\"reviewerLabel\", () => {\n  it(\"prefers username over email\", () => {\n    expect(reviewerLabel({ username: \"j.rao\", primaryEmailAddress: { emailAddress: \"j@x.com\" } }, \"uid_1\")).toBe(\"j.rao\");\n  });\n  it(\"falls back to email when no username\", () => {\n    expect(reviewerLabel({ username: null, primaryEmailAddress: { emailAddress: \"j@x.com\" } }, \"uid_1\")).toBe(\"j@x.com\");\n  });\n  it(\"falls back to userId when user is null\", () => {\n    expect(reviewerLabel(null, \"uid_1\")).toBe(\"uid_1\");\n  });\n  it(\"falls back to userId when both username and email are null\", () => {\n    expect(reviewerLabel({ username: null, primaryEmailAddress: null }, \"uid_1\")).toBe(\"uid_1\");\n  });\n  it(\"treats an empty-string username as present (documents current ?? behavior)\", () => {\n    expect(reviewerLabel({ username: \"\", primaryEmailAddress: { emailAddress: \"j@x.com\" } }, \"uid_1\")).toBe(\"\");\n  });\n});"
