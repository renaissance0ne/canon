        "code": "import { describe, it, expect, vi, beforeEach } from \"vitest\";\n\nconst rows: any[] = [];\nvi.mock(\"@/lib/db\", () => ({\n  getDb: () => ({\n    select: () => ({ from: () => ({ orderBy: () => Promise.resolve(rows) }) }),\n  }),\n}));\nvi.mock(\"next/server\", () => ({ connection: vi.fn().mockResolvedValue(undefined) }));\n\nimport { listSources, countSourcesBySide } from \"@/lib/server/sources\";\n\ndescribe(\"listSources / countSourcesBySide\", () => {\n  beforeEach(() => { rows.length = 0; });\n\n  it(\"returns [] and zero counts when no sources are configured\", async () => {\n    expect(await listSources()).toEqual([]);\n    expect(await countSourcesBySide()).toEqual({ crm: 0, warehouse: 0, synthetic: 0 });\n  });\n\n  it(\"buckets each kind onto the correct side\", async () => {\n    rows.push(\n      { id: crypto.randomUUID(), name: \"sf\", kind: \"salesforce\", config: { objects: [\"Account\"] }, createdAt: new Date() },\n      { id: crypto.randomUUID(), name: \"hs\", kind: \"hubspot\", config: { objects: [\"Contact\"] }, createdAt: new Date() },\n      { id: crypto.randomUUID(), name: \"db\", kind: \"databricks\", config: { objects: [\"t\"] }, createdAt: new Date() },\n      { id: crypto.randomUUID(), name: \"syn\", kind: \"synthetic\", config: { objects: [\"t\"] }, createdAt: new Date() },\n    );\n    expect(await countSourcesBySide()).toEqual({ crm: 2, warehouse: 1, synthetic: 1 });\n  });\n\n  it(\"throws when a row fails sourceSchema validation (e.g. empty objects array)\", async () => {\n    rows.push({ id: \"not-a-uuid\", name: \"bad\", kind: \"salesforce\", config: { objects: [] }, createdAt: new Date() });\n    await expect(listSources()).rejects.toThrow();\n  });\n});"
      },
