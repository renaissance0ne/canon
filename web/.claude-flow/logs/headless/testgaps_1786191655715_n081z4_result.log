        "language": "ts",
        "code": "// lib/validate-value.test.ts\nimport { describe, it, expect } from \"vitest\";\nimport { foldValue, checkObservedValue } from \"./validate-value\";\n\ndescribe(\"foldValue\", () => {\n  it(\"folds case, punctuation and whitespace\", () => {\n    expect(foldValue(\"ACME-INC\")).toBe(foldValue(\"ACME INC\"));\n  });\n\n  it(\"strips a single legal suffix\", () => {\n    expect(foldValue(\"Acme Corp\")).toBe(\"acme\");\n  });\n\n  it(\"strips multiple stacked suffixes, longest first\", () => {\n    expect(foldValue(\"Trellis Labs Pvt Ltd\")).toBe(\"trellis labs\");\n  });\n\n  it(\"does not strip a suffix that is the entire value\", () => {\n    expect(foldValue(\"Inc\")).toBe(\"inc\");\n  });\n\n  it(\"is total and deterministic for repeated calls\", () => {\n    expect(foldValue(\"Ünïcödé Co.\")).toBe(foldValue(\"Ünïcödé Co.\"));\n  });\n});\n\ndescribe(\"checkObservedValue\", () => {\n  it(\"rejects an empty candidate\", () => {\n    expect(checkObservedValue(\"  \", [\"Acme\"]).ok).toBe(false);\n  });\n\n  it(\"rejects when neither side has a value (orphan)\", () => {\n    expect(checkObservedValue(\"Acme\", [\"\", \"  \"]).ok).toBe(false);\n  });\n\n  it(\"accepts an exact match\", () => {\n    const r = checkObservedValue(\"Acme Inc\", [\"Acme Inc\", \"ACME INC\"]);\n    expect(r).toEqual({ ok: true, matches: \"Acme Inc\" });\n  });\n\n  it(\"accepts a folded-equivalent match and returns the observed form\", () => {\n    const r = checkObservedValue(\"acme inc.\", [\"Acme Inc\"]);\n    expect(r).toEqual({ ok: true, matches: \"Acme Inc\" });\n  });\n\n  it(\"rejects a value that is neither observed nor a legal normalization\", () => {\n    expect(checkObservedValue(\"ACC-9999\", [\"ACC-1\", \"ACC-2\"]).ok).toBe(false);\n  });\n});"
