        "code": "// components/conflicts/use-review.test.ts\nimport { describe, it, expect, vi } from \"vitest\";\nimport { renderHook, act } from \"@testing-library/react\";\n\nconst refresh = vi.fn();\nvi.mock(\"next/navigation\", () => ({ useRouter: () => ({ refresh }) }));\nconst patchJson = vi.fn();\nvi.mock(\"@/lib/api-client\", () => ({ patchJson: (...args: unknown[]) => patchJson(...args) }));\n\nimport { useReview } from \"@/components/conflicts/use-review\";\n\ndescribe(\"useReview\", () => {\n  it(\"sets pendingId during the request and clears it after\", async () => {\n    patchJson.mockResolvedValue({ ok: true, data: { conflictId: \"c1\", status: \"approved\", reviewedBy: \"j.rao\" } });\n    const { result } = renderHook(() => useReview());\n    await act(async () => { await result.current.submit(\"c1\", { action: \"approve\" }); });\n    expect(result.current.pendingId).toBeNull();\n  });\n\n  it(\"stores the server-confirmed status in `decided`, not an optimistic guess\", async () => {\n    patchJson.mockResolvedValue({ ok: true, data: { conflictId: \"c1\", status: \"overridden\", reviewedBy: \"j.rao\" } });\n    const { result } = renderHook(() => useReview());\n    await act(async () => { await result.current.submit(\"c1\", { action: \"override\", overrideValue: \"X\" }); });\n    expect(result.current.decided[\"c1\"]).toEqual({ status: \"overridden\", reviewedBy: \"j.rao\" });\n  });\n\n  it(\"does not touch `decided` on a failed request (no rollback needed, nothing was set)\", async () => {\n    patchJson.mockResolvedValue({ ok: false, message: \"No such conflict.\" });\n    const { result } = renderHook(() => useReview());\n    await act(async () => { await result.current.submit(\"c1\", { action: \"approve\" }); });\n    expect(result.current.decided[\"c1\"]).toBeUndefined();\n  });\n\n  it(\"triggers router.refresh() only on success\", async () => {\n    patchJson.mockResolvedValue({ ok: false, message: \"err\" });\n    const { result } = renderHook(() => useReview());\n    await act(async () => { await result.current.submit(\"c1\", { action: \"approve\" }); });\n    expect(refresh).not.toHaveBeenCalled();\n  });\n});"
