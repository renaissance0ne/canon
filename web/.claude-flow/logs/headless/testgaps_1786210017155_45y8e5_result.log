        "code": "// types/queue.test.ts\nimport { describe, it, expect } from \"vitest\";\nimport { conflictFieldLabel, severityReason } from \"@/types/queue\";\n\ndescribe(\"conflictFieldLabel\", () => {\n  it(\"returns 'entity absent' for orphan class regardless of field\", () => {\n    expect(conflictFieldLabel({ field: \"name\", conflictClass: \"orphan\", a: { values: [], present: false }, b: { values: [\"x\"], present: true } })).toBe(\"entity absent\");\n  });\n\n  it(\"shows N → M for a duplicate that collapses record count\", () => {\n    expect(conflictFieldLabel({ field: \"x\", conflictClass: \"duplicate\", a: { values: [\"1\", \"2\"], present: true }, b: { values: [\"1\"], present: true } })).toBe(\"2 → 1\");\n  });\n\n  it(\"falls back to 'duplicate record' when counts are equal or one side is empty\", () => {\n    expect(conflictFieldLabel({ field: \"x\", conflictClass: \"duplicate\", a: { values: [\"1\"], present: true }, b: { values: [], present: false } })).toBe(\"duplicate record\");\n  });\n\n  it(\"returns the raw field name for a plain field conflict\", () => {\n    expect(conflictFieldLabel({ field: \"parentExternalId\", conflictClass: \"field\", a: { values: [\"A\"], present: true }, b: { values: [\"B\"], present: true } })).toBe(\"parentExternalId\");\n  });\n});\n\ndescribe(\"severityReason\", () => {\n  it(\"explains structural conflicts\", () => {\n    expect(severityReason({ conflictClass: \"structural\", severity: 4, childCount: 0 })).toMatch(/rollups/);\n  });\n  it(\"distinguishes orphan-with-children from orphan-without\", () => {\n    expect(severityReason({ conflictClass: \"orphan\", severity: 4, childCount: 3 })).toContain(\"3 children\");\n    expect(severityReason({ conflictClass: \"orphan\", severity: 3, childCount: 1 })).toContain(\"1 child\"); // singular\n    expect(severityReason({ conflictClass: \"orphan\", severity: 3, childCount: 0 })).toContain(\"no children\");\n  });\n  it(\"distinguishes severity 3 from other non-structural severities on the default branch\", () => {\n    expect(severityReason({ conflictClass: \"field\", severity: 3, childCount: 0 })).toMatch(/owns or is credited/);\n    expect(severityReason({ conflictClass: \"field\", severity: 2, childCount: 0 })).toMatch(/non-rollup/);\n  });\n});"
