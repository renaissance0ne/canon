        "language": "ts",
        "code": "// lib/format.test.ts\nimport { describe, it, expect } from \"vitest\";\nimport {\n  shortRunId, formatElapsed, formatCount, formatStat,\n  formatClockTime, formatTimestamp, formatRelative, formatConfidence,\n} from \"@/lib/format\";\n\ndescribe(\"shortRunId\", () => {\n  it(\"strips hyphens and takes 4+2 chars joined by an interpunct\", () => {\n    expect(shortRunId(\"a41f1234-c9ab-...\")).toBe(\"a41f·1c\"); // TODO verify exact slice\n  });\n});\n\ndescribe(\"formatElapsed\", () => {\n  it(\"renders mm:ss under an hour\", () => expect(formatElapsed(65_000)).toBe(\"01:05\"));\n  it(\"renders h:mm:ss at exactly one hour\", () => expect(formatElapsed(3_600_000)).toBe(\"1:00:00\"));\n  it(\"clamps negative durations to zero\", () => expect(formatElapsed(-500)).toBe(\"00:00\"));\n  it(\"floors sub-second remainders\", () => expect(formatElapsed(999)).toBe(\"00:00\"));\n});\n\ndescribe(\"formatStat\", () => {\n  it(\"renders an em dash for null\", () => expect(formatStat(null)).toBe(\"—\"));\n  it(\"renders an em dash for undefined\", () => expect(formatStat(undefined)).toBe(\"—\"));\n  it(\"renders 0 distinctly from not-yet-computed\", () => expect(formatStat(0)).toBe(\"0\"));\n});\n\ndescribe(\"formatRelative\", () => {\n  const now = new Date(\"2026-08-08T12:00:00Z\");\n  it(\"says 'just now' under 60s\", () => expect(formatRelative(new Date(\"2026-08-08T11:59:30Z\"), now)).toBe(\"just now\"));\n  it(\"boundary at exactly 60s\", () => expect(formatRelative(new Date(\"2026-08-08T11:59:00Z\"), now)).toBe(\"1m ago\"));\n  it(\"boundary at exactly 60m\", () => expect(formatRelative(new Date(\"2026-08-08T11:00:00Z\"), now)).toBe(\"1h ago\"));\n  it(\"boundary at exactly 24h\", () => expect(formatRelative(new Date(\"2026-08-07T12:00:00Z\"), now)).toBe(\"1d ago\"));\n  it(\"handles a future date (negative delta) without throwing\", () => {\n    expect(() => formatRelative(new Date(\"2026-08-08T13:00:00Z\"), now)).not.toThrow();\n  });\n});\n\ndescribe(\"formatConfidence\", () => {\n  it(\"always renders two decimals\", () => expect(formatConfidence(0.9)).toBe(\"0.90\"));\n  it(\"clamps/handles out-of-range input gracefully\", () => {\n    // No clamping in source — document current (possibly surprising) behavior.\n    expect(formatConfidence(1.5)).toBe(\"1.50\");\n  });\n});"
