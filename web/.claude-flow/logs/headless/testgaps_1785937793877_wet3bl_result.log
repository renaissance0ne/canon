        "code": "// lib/server/auth.test.ts\nimport { describe, it, expect, vi, beforeEach } from \"vitest\";\n\nconst mockAuth = vi.fn();\nconst mockCurrentUser = vi.fn();\nvi.mock(\"@clerk/nextjs/server\", () => ({\n  auth: () => mockAuth(),\n  currentUser: () => mockCurrentUser(),\n}));\n\nimport { requireReviewer, getReviewer } from \"./auth\";\n\ndescribe(\"requireReviewer\", () => {\n  beforeEach(() => { mockAuth.mockReset(); mockCurrentUser.mockReset(); });\n\n  it(\"throws when there is no session\", async () => {\n    mockAuth.mockResolvedValue({ isAuthenticated: false, userId: null });\n    await expect(requireReviewer()).rejects.toThrow(/No authenticated reviewer/);\n  });\n\n  it(\"throws when isAuthenticated is true but userId is missing (inconsistent session)\", async () => {\n    mockAuth.mockResolvedValue({ isAuthenticated: true, userId: null });\n    await expect(requireReviewer()).rejects.toThrow();\n  });\n\n  it(\"returns userId + derived label when authenticated\", async () => {\n    mockAuth.mockResolvedValue({ isAuthenticated: true, userId: \"uid_1\" });\n    mockCurrentUser.mockResolvedValue({ username: \"j.rao\", primaryEmailAddress: { emailAddress: \"j@x.com\" } });\n    const reviewer = await requireReviewer();\n    expect(reviewer).toEqual({ userId: \"uid_1\", label: \"j.rao\" });\n  });\n});\n\ndescribe(\"getReviewer\", () => {\n  it(\"returns null when signed out instead of throwing\", async () => {\n    mockAuth.mockResolvedValue({ isAuthenticated: false, userId: null });\n    await expect(getReviewer()).resolves.toBeNull();\n  });\n\n  it(\"delegates to requireReviewer when signed in\", async () => {\n    mockAuth.mockResolvedValue({ isAuthenticated: true, userId: \"uid_1\" });\n    mockCurrentUser.mockResolvedValue({ username: null, primaryEmailAddress: null });\n    await expect(getReviewer()).resolves.toEqual({ userId: \"uid_1\", label: \"uid_1\" });\n  });\n});"
      },
