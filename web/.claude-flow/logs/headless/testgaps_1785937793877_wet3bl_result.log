        "code": "// proxy.test.ts (route-matcher logic, isolated from Clerk's auth() call)\nimport { describe, it, expect } from \"vitest\";\nimport { createRouteMatcher } from \"@clerk/nextjs/server\";\n\nconst isPublicRoute = createRouteMatcher([\"/\", \"/sign-in(.*)\", \"/sign-up(.*)\"]);\nconst req = (path: string) => new Request(`http://localhost${path}`);\n\ndescribe(\"proxy public route matcher\", () => {\n  it.each([\"/\", \"/sign-in\", \"/sign-in/factor-one\", \"/sign-up\"])(\"%s is public\", (path) => {\n    expect(isPublicRoute(req(path))).toBe(true);\n  });\n  it.each([\"/sources\", \"/get-started\", \"/api/sources\", \"/api/conflicts/123/resolution\"])(\n    \"%s requires auth\",\n    (path) => {\n      expect(isPublicRoute(req(path))).toBe(false);\n    },\n  );\n});"
