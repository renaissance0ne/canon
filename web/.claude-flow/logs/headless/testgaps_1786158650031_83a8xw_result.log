result.current.decided.c1).toEqual({ status: \"approved\", reviewedBy: \"j.rao\" });\n  });\n\n  it(\"calls router.refresh() only after a successful submit\", async () => {\n    vi.mocked(patchJson).mockResolvedValue({ ok: true, data: { conflictId: \"c1\", status: \"approved\", reviewedBy: \"j\" } });\n    const { result } = renderHook(() => useReview());\n    await act(async () => { await result.current.submit(\"c1\", { action: \"approve\" }); });\n    expect(refresh).toHaveBeenCalled();\n  });\n\n  it(\"leaves `decided` untouched and does NOT refresh on failure\", async () => {\n    vi.mocked(patchJson).mockResolvedValue({ ok: false, message: \"conflict already resolved\" });\n    const { result } = renderHook(() => useReview());\n    const outcome = await act(async () => result.current.submit(\"c1\", { action: \"approve\" }));\n    expect(outcome).toEqual({ ok: false, message: \"conflict already resolved\" });\n    expect(result.current.decided.c1).toBeUndefined();\n    expect(refresh).not.toHaveBeenCalled();\n  });\n\n  it(\"does not let a second submit for a different conflict clobber the first entry\", async () => { /* map-merge regression guard */ });\n});\n```\n\n---\n\n### 5. `lib/server/*.ts` — DB-backed, currently entirely untested\n\nEvery function in `audit.ts`, `auth.ts`, `conflicts.ts`, `engine.ts`, `entities.ts`, `export.ts`, `rulesets.ts`, `runs.ts`, `sources.ts` is untested. Two viable strategies, not mutually exclusive:\n\n- **Unit-mock `getDb()`** (`vi.mock(\"@/lib/db\")`) for functions whose logic is worth isolating from Postgres — e.g. `toQueueRow`'s presence/side-labeling logic in `conflicts.ts`, `appliedValue`/`applyDecisions` in `export.ts`, `csvCell`/`decisionsToCsv` in `export.ts`. These have real branching logic independent of the query.\n- **Integration tests against a real ephemeral Postgres** (Testcontainers, or a `docker compose` test DB + drizzle migrations) for anything that composes a Drizzle query chain — mocking `.select().from().innerJoin().where().orderBy().limit()` by hand is brittle and tests the mock, not the code.\n\nHighest-value untested logic, regardless of harness chosen:\n\n```ts\n// lib/server/conflicts.test.ts — pure-ish branch inside toQueueRow, extract if needed for unit testing\ndescribe(\"toQueueRow presence logic\", () => {\n  it(\"marks an orphan's absent side present:false when its values are empty\", () => { /* ... */ });\n  it(\"files an orphan under whichever side actually holds the record\", () => { /* ... */ });\n  it(\"labels sourceName 'unknown source' when the entity's sourceId matches neither run source (engine-bug guard)\", () => { /* ... */ });\n});\n\n// lib/server/conflicts.test.ts — recordReview, the highest-risk function in the app\ndescribe(\"recordReview\", () => {\n  it(\"returns 404 when the conflict does not exist\", async () => { /* ... */ });\n  it(\"returns 409 when the conflict has no resolution yet (run still resolving)\", async () => { /* ... */ });\n  it(\"returns 409 on 'approve' when proposedValue is empty (escalated, nothing to approve)\", async () => { /* ... */ });\n  it(\"rejects an override value not among the observed values (400)\", async () => { /* ... */ });\n  it(\"stores the folded/normalized match, not the typed override text\", async () => { /* ... */ });\n  it(\"clears overrideValue when moving off a previous override to approve/reject\", async () => { /* ... */ });\n  it(\"never writes reviewedBy from anything but the passed-in Reviewer\", async () => { /* ... */ });\n  it(\"appends exactly one audit_log row per call, with previousStatus set\", async () => { /* ... */ });\n});\n\n// lib/server/export.ts\ndescribe(\"decisionsToCsv\", () => {\n  it(\"quotes cells containing commas, quotes, or newlines\", () => { /* ... */ });\n  it(\"escapes an embedded double-quote by doubling it\", () => { /* ... */ });\n  it(\"renders null as an empty cell, not the string 'null'\", () => { /* ... */ });\n  it(\"ends the file with \\\\r\\\\n, including when there are zero rows\", () => { /* ... */ });\n});\ndescribe(\"appliedValue\", () => {\n  it.each([\"auto_applied\", \"approved\", \"overridden\"])(\"returns a value when status is %s\", (s) => { /* ... */ });\n  it.each([\"proposed\", \"escalated\", \"rejected\", null])(\"returns null for %s\", (s) => { /* ... */ });\n  it(\"returns overrideValue (not proposedValue) specifically for 'overridden'\", () => { /* ... */ });\n});\ndescribe(\"applyDecisions\", () => {\n  it(\"marks reparented:true only when the resolved parent differs from the original\", () => { /* ... */ });\n  it(\"ignores decisions for fields other than parentExternalId\", () => { /* ... */ });\n});\ndescribe(\"estimateExportBytes\", () => {\n  it(\"sums only the requested sections, ignoring sizing for unselected ones\", () => { /* ... */ });\n});\n\n// lib/server/rulesets.ts\ndescribe(\"createRulesetVersion\", () => {\n  it(\"assigns version = highest existing + 1 for the same name\", async () => { /* integration */ });\n  it(\"starts a brand-new policy name at version 1\", async () => { /* integration */ });\n  it(\"deactivates every other ruleset when activating the new one (exactly one active)\", async () => { /* integration */ });\n  it(\"two concurrent saves of the same name do not both get the same version (advisory lock)\", async () => {\n    // integration-only: fire two createRulesetVersion calls concurrently, assert distinct versions\n  });\n});\n\n// lib/server/auth.ts\ndescribe(\"requireReviewer\", () => {\n  it(\"throws when there is no authenticated session\", async () => { /* mock @clerk/nextjs/server */ });\n  it(\"prefers username, falling back through reviewerLabel\", async () => { /* ... */ });\n});\n\n// lib/server/engine.ts\ndescribe(\"startRun\", () => {\n  it(\"throws EngineUnreachableError when ENGINE_URL is unset\", async () => { /* ... */ });\n  it(\"throws EngineUnreachableError on a non-OK response, including status+body\", async () => { /* mock fetch */ });\n  it(\"throws EngineUnreachableError when the engine returns 200 with a body that fails schema validation\", async () => { /* ... */ });\n  it(\"throws EngineUnreachableError with 'no response within Ns' on an AbortSignal timeout\", async () => { /* ... */ });\n});\ndescribe(\"fetchEngineStatus\", () => {\n  it(\"returns null (not throw) when the engine is unreachable\", async () => { /* ... */ });\n  it(\"returns null when the engine's response fails schema validation\", async () => { /* ... */ });\n});\n```\n\n---\n\n### 6. `app/api/**/route.ts` — no integration tests at all\n\nNone of the 9 route handlers are tested. Each is a thin Zod-validate → server-call → shape-response layer, but several have branching worth locking down:\n\n```ts\n// app/api/runs/route.test.ts — POST /api/runs\ndescribe(\"POST /api/runs\", () => {\n  it(\"400s when sourceAId === sourceBId\", async () => { /* ... */ });\n  it(\"400s 'Source A no longer exists' when sourceAId isn't found, even if body is otherwise valid\", async () => { /* ... */ });\n  it(\"400s when the ruleset id no longer exists\", async () => { /* ... */ });\n  it(\"still returns 201 with the run id when the engine dispatch fails, and records run_failed audit\", async () => {\n    // mock startRun to throw EngineUnreachableError; assert failUndispatchedRun + appendAudit called, response is 201\n  });\n  it(\"rethrows a non-EngineUnreachableError from startRun rather than swallowing it\", async () => { /* ... */ });\n  it(\"400s with field-level issues when body fails createRunSchema\", async () => { /* ... */ });\n});\n\n// app/api/conflicts/[conflictId]/resolution/route.test.ts\ndescribe(\"PATCH /api/conflicts/:conflictId/resolution\", () => {\n  it(\"404s immediately for a non-UUID conflictId, without touching the DB\", async () => { /* ... */ });\n  it(\"maps recordReview's {ok:false, code} straight through to the response status\", async () => { /* ... */ });\n  it(\"never accepts a reviewedBy field from the request body (ignored even if present)\", async () => { /* ... */ });\n});\n\n// app/api/runs/[runId]/export/route.test.ts\ndescribe(\"GET /api/runs/:runId/export\", () => {\n  it(\"defaults to sections=hierarchy,decisions when ?sections is absent\", async () => { /* ... */ });\n  it(\"400s on an unknown section name\", async () => { /* ... */ });\n  it(\"de-duplicates and canonically orders sections regardless of query order\", async () => {\n    // ?sections=stats,hierarchy,hierarchy -> canonical order, deduped\n  });\n  it(\"400s on format other than json/csv\", async () => { /* ... */ });\n  it(\"CSV response omits hierarchy/orphans/stats even if requested\", async () => { /* ... */ });\n  it(\"sets content-disposition filename from shortRunId with the interpunct stripped\", async () => { /* ... */ });\n});\n\n// app/api/audit/export/route.test.ts\ndescribe(\"GET /api/audit/export\", () => {\n  it(\"404s when runId is a well-formed UUID but no such run exists\", async () => { /* ... */ });\n  it(\"400s on an invalid `action` query param\", async () => { /* ... */ });\n  it(\"omits the runId filter entirely when not provided (exports everything)\", async () => { /* ... */ });\n});\n\n// app/api/_lib/respond.test.ts\ndescribe(\"parseJson\", () => {\n  it(\"400s with 'Body must be JSON.' when the body isn't valid JSON\", async () => { /* ... */ });\n  it(\"maps each Zod issue to its dotted path in `issues`, using '_' for root-level issues\", async () => { /* ... */ });\n});\n```\n\n---\n\n### 7. `proxy.ts` — auth middleware, untested\n\n```ts\ndescribe(\"isPublicRoute matcher\", () => {\n  it(\"treats / and /sign-in* and /sign-up* as public\", () => { /* ... */ });\n  it(\"requires auth for every other page and every /api/* and /trpc/* route\", () => { /* ... */ });\n  it(\"excludes static assets per the config.matcher pattern (css/js/images/fonts/csv/office docs)\", () => { /* ... */ });\n});\n```\nThis is small but security-relevant — a regex/matcher regression here silently exposes an internal console. Worth a dedicated test even if the middleware body itself is one line, since `clerkMiddleware` mocking is the only way to catch a bad matcher before it ships.\n\n---\n\n### Missing error-handling coverage, called out specifically\n\n- `lib/server/engine.ts`: timeout vs. generic network failure produce different messages (`describe()`) — untested branch.\n- `lib/api-client.ts`: unparsable JSON error body (`.catch(() => null)`) — untested.\n- `app/api/runs/route.ts`: the only place that distinguishes \"engine dispatch failed\" (soft failure, 201 + failed run) from \"everything else\" (rethrow) — untested, and it's the one route with real error-recovery logic.\n- `lib/server/rulesets.ts`: the advisory-lock concurrency guard against two simultaneous \"save as vN\" — currently has no test proving it actually prevents a duplicate version number.\n- `lib/server/conflicts.ts` `recordReview`: three distinct rejection codes (400/404/409) with different triggering conditions — none tested.\n\n### Integration test gaps\n\n- End-to-end review flow: create a run → seed a conflict/resolution → PATCH override with an invalid value (expect 400, no audit row written) → PATCH override with a valid value (expect 200, resolutions row updated, exactly one audit_log row appended). Nothing currently proves the DB write and the audit append are consistent with each other.\n- Export round-trip: run with mixed escalated/auto-applied/overridden resolutions → JSON export → CSV export → assert both agree on `appliedValue` for the same conflict.\n- Auth boundary: an unauthenticated request to any `/api/*` route is rejected by `proxy.ts` before reaching the handler (currently only implied by code inspection, never exercised).\n- Ruleset versioning reproducibility: a run created under ruleset v3, then v4 is saved — assert the run's queue rows still resolve `appliedRuleStrategy` from v3, not v4 (`ruleStrategies()` in `conflicts.ts` reads from the run's own ruleset version, and there's no test proving old runs don't silently relabel).\n\n---\n\n**One aside, unrelated to coverage but worth flagging**: your working directory root has a couple of stray zero-byte files that look like broken shell-redirect artifacts — `String(n).padStart(2` and `r.conflictClass` — plus git status shows deleted `.env.example` and `rule.strategy` and an untracked `,` file. I didn't touch any of these since they're outside this task's scope, but you may want to clean them up separately.\n",
