        "code": "// types/run.test.ts\nimport { describe, it, expect } from \"vitest\";\nimport { isStatKnown, failedStage, runStageIndex, isTerminalRunStatus } from \"@/types/run\";\n\ndescribe(\"isStatKnown\", () => {\n  it(\"is unknown before its producing stage has finished\", () => {\n    expect(isStatKnown(\"matches\", \"extracting\")).toBe(false);\n  });\n\n  it(\"is known once the producing stage is behind current status\", () => {\n    expect(isStatKnown(\"matches\", \"detecting\")).toBe(true);\n  });\n\n  it(\"is known for every stat once complete\", () => {\n    expect(isStatKnown(\"tokensUsed\", \"complete\")).toBe(true);\n  });\n\n  it(\"is known for every stat when failed, regardless of where it died\", () => {\n    expect(isStatKnown(\"escalated\", \"failed\")).toBe(true);\n  });\n});\n\ndescribe(\"failedStage\", () => {\n  it(\"returns null when the error carries no stage= marker\", () => {\n    expect(failedStage(\"connection reset\")).toBeNull();\n  });\n\n  it(\"maps a known verb to its RunStage, case-insensitively\", () => {\n    expect(failedStage(\"source=Databricks GTM STAGE=Extract\")).toBe(\"extracting\");\n  });\n\n  it(\"returns null for an unrecognized verb\", () => {\n    expect(failedStage(\"stage=teleport\")).toBeNull();\n  });\n\n  it(\"returns null for a null error\", () => {\n    expect(failedStage(null)).toBeNull();\n  });\n});\n\ndescribe(\"runStageIndex / isTerminalRunStatus\", () => {\n  it(\"failed has no position in the pipeline\", () => {\n    expect(runStageIndex(\"failed\")).toBe(-1);\n  });\n\n  it(\"complete and failed are the only terminal states\", () => {\n    expect(isTerminalRunStatus(\"complete\")).toBe(true);\n    expect(isTerminalRunStatus(\"failed\")).toBe(true);\n    expect(isTerminalRunStatus(\"resolving\")).toBe(false);\n  });\n});"
