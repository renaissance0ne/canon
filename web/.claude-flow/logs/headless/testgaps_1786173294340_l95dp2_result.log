        "language": "ts",
        "code": "// lib/validate-value.test.ts\nimport { describe, it, expect } from \"vitest\";\nimport { foldValue, checkObservedValue, observedValues } from \"@/lib/validate-value\";\n\ndescribe(\"foldValue\", () => {\n  it(\"folds case, punctuation and whitespace\", () => {\n    expect(foldValue(\"ACME-INC\")).toBe(foldValue(\"ACME INC\"));\n  });\n\n  it(\"strips a single legal suffix\", () => {\n    expect(foldValue(\"Acme Corp\")).toBe(\"acme\");\n  });\n\n  it(\"strips multiple stacked suffixes, longest match first\", () => {\n    expect(foldValue(\"Trellis Labs Pvt Ltd\")).toBe(\"trellis labs\");\n  });\n\n  it(\"keeps a value that IS entirely a suffix\", () => {\n    expect(foldValue(\"Ltd\")).toBe(\"ltd\");\n  });\n\n  it(\"is idempotent and total for empty input\", () => {\n    expect(foldValue(\"\")).toBe(\"\");\n  });\n});\n\ndescribe(\"checkObservedValue\", () => {\n  const observed = [\"Acme Inc.\", \"ACME INC\"];\n\n  it(\"accepts an exact match\", () => {\n    const result = checkObservedValue(\"Acme Inc.\", observed);\n    expect(result).toEqual({ ok: true, matches: \"Acme Inc.\" });\n  });\n\n  it(\"accepts a legal normalization of an observed value\", () => {\n    const result = checkObservedValue(\"acme inc\", observed);\n    expect(result.ok).toBe(true);\n  });\n\n  it(\"rejects a value neither side holds\", () => {\n    const result = checkObservedValue(\"Globex\", observed);\n    expect(result).toEqual({ ok: false, reason: expect.stringContaining(\"Must be one of\") });\n  });\n\n  it(\"rejects an empty/whitespace-only candidate\", () => {\n    expect(checkObservedValue(\"   \", observed).ok).toBe(false);\n  });\n\n  it(\"rejects when neither side has a real value (orphan)\", () => {\n    const result = checkObservedValue(\"anything\", [\"\", \"  \"]);\n    expect(result).toEqual({ ok: false, reason: expect.stringContaining(\"Neither side\") });\n  });\n});\n\ndescribe(\"observedValues\", () => {\n  it(\"flattens and drops blank entries from both sides\", () => {\n    const row = { a: { values: [\"x\", \"\"] }, b: { values: [\"y\"] } };\n    expect(observedValues(row)).toEqual([\"x\", \"y\"]);\n  });\n});"
