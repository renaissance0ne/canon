        "language": "ts",
        "code": "// lib/server/engine.test.ts\nimport { describe, it, expect, vi, beforeEach, afterEach } from \"vitest\";\nimport { startRun, fetchEngineStatus, EngineUnreachableError } from \"@/lib/server/engine\";\n\ndescribe(\"startRun\", () => {\n  const originalEnv = process.env.ENGINE_URL;\n  beforeEach(() => { process.env.ENGINE_URL = \"http://engine.local\"; });\n  afterEach(() => { process.env.ENGINE_URL = originalEnv; vi.restoreAllMocks(); });\n\n  it(\"throws EngineUnreachableError when ENGINE_URL is unset\", async () => {\n    delete process.env.ENGINE_URL;\n    await expect(startRun(\"run-1\")).rejects.toThrow(EngineUnreachableError);\n  });\n\n  it(\"wraps a network failure\", async () => {\n    vi.stubGlobal(\"fetch\", vi.fn().mockRejectedValue(new Error(\"ECONNREFUSED\")));\n    await expect(startRun(\"run-1\")).rejects.toThrow(/Engine did not accept the run/);\n  });\n\n  it(\"throws with response status + truncated body on non-ok\", async () => {\n    vi.stubGlobal(\"fetch\", vi.fn().mockResolvedValue(\n      new Response(\"internal error details...\", { status: 500 }),\n    ));\n    await expect(startRun(\"run-1\")).rejects.toThrow(/rejected the run with 500/);\n  });\n\n  it(\"throws a contract-break error when the 200 body doesn't match the schema\", async () => {\n    vi.stubGlobal(\"fetch\", vi.fn().mockResolvedValue(\n      Response.json({ unexpected: true }, { status: 200 }),\n    ));\n    await expect(startRun(\"run-1\")).rejects.toThrow(/unexpected body/);\n  });\n\n  it(\"resolves on a well-formed 200\", async () => {\n    vi.stubGlobal(\"fetch\", vi.fn().mockResolvedValue(\n      Response.json({ runId: \"run-1\", accepted: true }, { status: 200 }),\n    ));\n    await expect(startRun(\"run-1\")).resolves.toBeUndefined();\n  });\n});\n\ndescribe(\"fetchEngineStatus\", () => {\n  it(\"returns null (not throw) when the engine responds non-ok\", async () => {\n    vi.stubGlobal(\"fetch\", vi.fn().mockResolvedValue(new Response(null, { status: 503 })));\n    await expect(fetchEngineStatus(\"run-1\")).resolves.toBeNull();\n  });\n\n  it(\"returns null when fetch itself throws (engine unreachable)\", async () => {\n    vi.stubGlobal(\"fetch\", vi.fn().mockRejectedValue(new Error(\"timeout\")));\n    await expect(fetchEngineStatus(\"run-1\")).resolves.toBeNull();\n  });\n\n  it(\"returns null when the body fails schema validation\", async () => {\n    vi.stubGlobal(\"fetch\", vi.fn().mockResolvedValue(Response.json({ bogus: true })));\n    await expect(fetchEngineStatus(\"run-1\")).resolves.toBeNull();\n  });\n});"
