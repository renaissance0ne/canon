\")).toBe(true);\n  });\n  it(\"rejects a non-uuid path param without throwing\", () => {\n    expect(isUuid(\"../../etc/passwd\")).toBe(false);\n    expect(isUuid(\"\")).toBe(false);\n    expect(isUuid(\"not-a-uuid\")).toBe(false);\n  });\n  it(\"is case-insensitive\", () => {\n    expect(isUuid(\"A41FBC21-C9AA-4444-8888-000000000000\")).toBe(true);\n  });\n});"
