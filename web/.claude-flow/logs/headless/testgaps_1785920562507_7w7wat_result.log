cated: false });\n    expect(await getReviewer()).toBeNull();\n  });\n  it(\"delegates to requireReviewer when signed in\", async () => {\n    (auth as any).mockResolvedValue({ isAuthenticated: true, userId: \"u1\" });\n    (currentUser as any).mockResolvedValue({ username: \"j.rao\" });\n    expect(await getReviewer()).toEqual({ userId: \"u1\", label: \"j.rao\" });\n  });\n});"
