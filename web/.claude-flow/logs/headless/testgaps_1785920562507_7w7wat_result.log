        "code": "// types/resolution.test.ts\nimport { describe, it, expect } from \"vitest\";\nimport { reviewActionSchema } from \"@/types/resolution\";\n\ndescribe(\"reviewActionSchema\", () => {\n  it(\"accepts approve/reject with no extra fields\", () => {\n    expect(reviewActionSchema.safeParse({ action: \"approve\" }).success).toBe(true);\n    expect(reviewActionSchema.safeParse({ action: \"reject\" }).success).toBe(true);\n  });\n  it(\"rejects override without overrideValue\", () => {\n    expect(reviewActionSchema.safeParse({ action: \"override\" }).success).toBe(false);\n  });\n  it(\"rejects override with empty overrideValue\", () => {\n    expect(reviewActionSchema.safeParse({ action: \"override\", overrideValue: \"\" }).success).toBe(false);\n  });\n  it(\"rejects a reviewedBy field even if the client sends one (must be server-derived)\", () => {\n    const r = reviewActionSchema.safeParse({ action: \"approve\", reviewedBy: \"spoofed\" });\n    // discriminatedUnion strips/ignores unknown keys by default — assert that,\n    // don't assume it silently trusts client-supplied identity.\n    expect(r.success && !(\"reviewedBy\" in r.data)).toBe(true);\n  });\n});"
