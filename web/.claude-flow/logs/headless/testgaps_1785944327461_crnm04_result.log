back to userId when user is null\", () => {\n    expect(reviewerLabel(null, \"uid_1\")).toBe(\"uid_1\");\n  });\n\n  it(\"falls back to userId when username and email are both absent\", () => {\n    expect(reviewerLabel({ username: null, primaryEmailAddress: null }, \"uid_1\")).toBe(\"uid_1\");\n  });\n\n  it(\"falls back to userId when primaryEmailAddress.emailAddress is null\", () => {\n    expect(reviewerLabel({ username: undefined, primaryEmailAddress: { emailAddress: null } }, \"uid_1\")).toBe(\"uid_1\");\n  });\n\n  // Documents current (possibly unintended) behavior: \"\" is not nullish, so ?? keeps it.\n  it(\"treats an empty-string username as present (not a fallback trigger)\", () => {\n    expect(reviewerLabel({ username: \"\", primaryEmailAddress: { emailAddress: \"j@x.com\" } }, \"uid_1\")).toBe(\"\");\n  });\n});\n```\n\n---\n\n### 2. `lib/cn.ts` — untested, pure, trivial but load-bearing (every styled component depends on it)\n\n```ts\n// lib/cn.test.ts\nimport { describe, it, expect } from \"vitest\";\nimport { cn } from \"@/lib/cn\";\n\ndescribe(\"cn\", () => {\n  it(\"merges plain class strings\", () => {\n    expect(cn(\"a\", \"b\")).toBe(\"a b\");\n  });\n\n  it(\"resolves conflicting tailwind classes to the last one\", () => {\n    expect(cn(\"px-2\", \"px-4\")).toBe(\"px-4\");\n  });\n\n  it(\"drops falsy values\", () => {\n    expect(cn(\"a\", false, undefined, null, \"b\")).toBe(\"a b\");\n  });\n\n  it(\"applies conditional object syntax\", () => {\n    expect(cn(\"a\", { b: true, c: false })).toBe(\"a b\");\n  });\n\n  it(\"returns empty string for no input\", () => {\n    expect(cn()).toBe(\"\");\n  });\n});\n```\n\n---\n\n### 3. `lib/server/sources.ts` — untested, no error-path coverage\n\n`listSources` parses every DB row through `sourceSchema.parse` — a malformed row currently throws uncaught, unhandled. `countSourcesBySide` has real branching logic (crm/warehouse/synthetic classification) that's never exercised.\n\n**Gaps:** empty source list; mixed-kind counting; a row that fails `sourceSchema.parse` (e.g., bad `config.objects`); `listSources` calling `connection()` before querying (currently unverifiable — no mock).\n\n```ts\n// lib/server/sources.test.ts\nimport { describe, it, expect, vi, beforeEach } from \"vitest\";\n\nvi.mock(\"next/server\", () => ({ connection: vi.fn().mockResolvedValue(undefined) }));\nconst mockSelect = vi.fn();\nvi.mock(\"@/lib/db\", () => ({ getDb: () => ({ select: mockSelect }) }));\n\nimport { listSources, countSourcesBySide } from \"@/lib/server/sources\";\n\nfunction rows(kinds: string[]) {\n  return kinds.map((kind, i) => ({\n    id: `00000000-0000-0000-0000-00000000000${i}`,\n    name: `source-${i}`,\n    kind,\n    config: { objects: [\"Account\"] },\n    createdAt: new Date(),\n  }));\n}\n\nfunction chain(result: unknown[]) {\n  return { from: () => ({ orderBy: () => Promise.resolve(result) }) };\n}\n\ndescribe(\"listSources\", () => {\n  beforeEach(() => mockSelect.mockReset());\n\n  it(\"returns an empty array when no sources are configured\", async () => {\n    mockSelect.mockReturnValue(chain([]));\n    expect(await listSources()).toEqual([]);\n  });\n\n  it(\"parses each row through sourceSchema\", async () => {\n    mockSelect.mockReturnValue(chain(rows([\"salesforce\"])));\n    const result = await listSources();\n    expect(result[0].kind).toBe(\"salesforce\");\n  });\n\n  it(\"throws when a row fails schema validation (e.g. malformed config)\", async () => {\n    mockSelect.mockReturnValue(\n      chain([{ id: \"not-a-uuid\", name: \"x\", kind: \"salesforce\", config: {}, createdAt: new Date() }]),\n    );\n    await expect(listSources()).rejects.toThrow();\n  });\n});\n\ndescribe(\"countSourcesBySide\", () => {\n  beforeEach(() => mockSelect.mockReset());\n\n  it(\"buckets salesforce and hubspot as crm\", async () => {\n    mockSelect.mockReturnValue(chain(rows([\"salesforce\", \"hubspot\"])));\n    expect(await countSourcesBySide()).toEqual({ crm: 2, warehouse: 0, synthetic: 0 });\n  });\n\n  it(\"buckets databricks and snowflake as warehouse\", async () => {\n    mockSelect.mockReturnValue(chain(rows([\"databricks\", \"snowflake\"])));\n    expect(await countSourcesBySide()).toEqual({ crm: 0, warehouse: 2, synthetic: 0 });\n  });\n\n  it(\"buckets synthetic separately from crm/warehouse\", async () => {\n    mockSelect.mockReturnValue(chain(rows([\"synthetic\", \"synthetic\"])));\n    expect(await countSourcesBySide()).toEqual({ crm: 0, warehouse: 0, synthetic: 2 });\n  });\n\n  it(\"counts a mixed set correctly\", async () => {\n    mockSelect.mockReturnValue(chain(rows([\"salesforce\", \"databricks\", \"synthetic\"])));\n    expect(await countSourcesBySide()).toEqual({ crm: 1, warehouse: 1, synthetic: 1 });\n  });\n});\n```\n\n---\n\n### 4. `lib/server/auth.ts` — untested, security-relevant\n\n`requireReviewer` is the single chokepoint that stops an anonymous string from becoming `audit_log.actor`. Its throw path (matcher/handler disagreement) is completely uncovered.\n\n**Gaps:** authenticated → returns `{userId, label}`; unauthenticated → throws with the specific message; `isAuthenticated` true but `userId` falsy (edge case the code explicitly guards); `getReviewer` returns `null` when signed out instead of throwing; `getReviewer` delegates to `requireReviewer` when signed in (label resolution reused, not duplicated).\n\n```ts\n// lib/server/auth.test.ts\nimport { describe, it, expect, vi, beforeEach } from \"vitest\";\n\nconst mockAuth = vi.fn();\nconst mockCurrentUser = vi.fn();\nvi.mock(\"@clerk/nextjs/server\", () => ({ auth: mockAuth, currentUser: mockCurrentUser }));\n\nimport { requireReviewer, getReviewer } from \"@/lib/server/auth\";\n\ndescribe(\"requireReviewer\", () => {\n  beforeEach(() => { mockAuth.mockReset(); mockCurrentUser.mockReset(); });\n\n  it(\"returns userId and resolved label when authenticated\", async () => {\n    mockAuth.mockResolvedValue({ isAuthenticated: true, userId: \"uid_1\" });\n    mockCurrentUser.mockResolvedValue({ username: \"j.rao\", primaryEmailAddress: null });\n    expect(await requireReviewer()).toEqual({ userId: \"uid_1\", label: \"j.rao\" });\n  });\n\n  it(\"throws when there is no session\", async () => {\n    mockAuth.mockResolvedValue({ isAuthenticated: false, userId: null });\n    await expect(requireReviewer()).rejects.toThrow(/no authenticated reviewer/i);\n  });\n\n  it(\"throws when isAuthenticated is true but userId is missing (defensive branch)\", async () => {\n    mockAuth.mockResolvedValue({ isAuthenticated: true, userId: null });\n    await expect(requireReviewer()).rejects.toThrow();\n  });\n});\n\ndescribe(\"getReviewer\", () => {\n  beforeEach(() => { mockAuth.mockReset(); mockCurrentUser.mockReset(); });\n\n  it(\"returns null when signed out, without throwing\", async () => {\n    mockAuth.mockResolvedValue({ isAuthenticated: false, userId: null });\n    expect(await getReviewer()).toBeNull();\n  });\n\n  it(\"returns the reviewer when signed in\", async () => {\n    mockAuth.mockResolvedValue({ isAuthenticated: true, userId: \"uid_2\" });\n    mockCurrentUser.mockResolvedValue({ username: null, primaryEmailAddress: { emailAddress: \"a@b.com\" } });\n    expect(await getReviewer()).toEqual({ userId: \"uid_2\", label: \"a@b.com\" });\n  });\n});\n```\n\n---\n\n### 5. `proxy.ts` — untested route-protection matcher (highest-risk gap)\n\nThis is the entire access-control boundary for an app that \"renders a company's full org chart\" — and `isPublicRoute` is a hand-maintained regex-adjacent list with no test locking its behavior. A future route addition could silently become public.\n\n**Gaps:** `/`, `/sign-in`, `/sign-in/factor-one`, `/sign-up` are public; `/sources`, `/api/anything`, `/get-started` require auth; static assets excluded by the `matcher` config (can't unit-test the matcher config directly, but the route-matcher logic is testable in isolation).\n\n```ts\n// proxy.test.ts\nimport { describe, it, expect } from \"vitest\";\nimport { createRouteMatcher } from \"@clerk/nextjs/server\";\n\n// Re-derive the same matcher proxy.ts builds, since it isn't exported.\nconst isPublicRoute = createRouteMatcher([\"/\", \"/sign-in(.*)\", \"/sign-up(.*)\"]);\n\nfunction req(path: string) {\n  return new Request(`https://example.com${path}`);\n}\n\ndescribe(\"public route matcher\", () => {\n  it.each([\"/\", \"/sign-in\", \"/sign-in/factor-one\", \"/sign-up\", \"/sign-up/verify\"])(\n    \"%s is public\",\n    (path) => expect(isPublicRoute(req(path))).toBe(true),\n  );\n\n  it.each([\"/sources\", \"/get-started\", \"/api/sources\", \"/sign-in-not-really\"])(\n    \"%s requires auth\",\n    (path) => expect(isPublicRoute(req(path))).toBe(false),\n  );\n});\n```\nNote: `/sign-in-not-really` matching `/sign-in(.*)` (no path-boundary anchor) is worth checking explicitly — if it currently passes as \"public,\" that's a real bug to flag, not just a test to add.\n\n**Integration gap:** no test drives an actual request through `clerkMiddleware` to confirm `auth.protect()` is invoked/skipped correctly, or that the `matcher` config's asset-extension exclusion list actually excludes what it claims (e.g., `.json` is deliberately excluded via the negative lookahead `js(?!on)` — that's exactly the kind of regex subtlety that silently breaks and deserves a locked-down test).\n\n---\n\n### 6. Zod schemas (`types/*.ts`) — untested, contract-critical\n\nThese mirror `engine/pipeline/schema.py` per the comments — a schema drift bug here is an integration failure between two codebases, and there's no test pinning behavior.\n\n**Gaps to cover** (`types/source.ts`, `types/conflict.ts`, `types/resolution.ts`):\n\n```ts\n// types/source.test.ts\nimport { describe, it, expect } from \"vitest\";\nimport { sourceConfigSchema, createSourceSchema, sourceKindSchema } from \"@/types/source\";\n\ndescribe(\"sourceConfigSchema\", () => {\n  it(\"rejects an empty objects array (min(1))\", () => {\n    expect(sourceConfigSchema.safeParse({ objects: [] }).success).toBe(false);\n  });\n\n  it(\"accepts config without a filter (optional)\", () => {\n    expect(sourceConfigSchema.safeParse({ objects: [\"Account\"] }).success).toBe(true);\n  });\n});\n\ndescribe(\"createSourceSchema\", () => {\n  it(\"rejects a name over 80 chars\", () => {\n    const r = createSourceSchema.safeParse({ name: \"x\".repeat(81), kind: \"salesforce\", config: { objects: [\"A\"] } });\n    expect(r.success).toBe(false);\n  });\n\n  it(\"rejects an unknown kind\", () => {\n    expect(sourceKindSchema.safeParse(\"mysql\").success).toBe(false);\n  });\n});\n```\n\n```ts\n// types/conflict.test.ts\nimport { describe, it, expect } from \"vitest\";\nimport { severitySchema } from \"@/types/conflict\";\n\ndescribe(\"severitySchema\", () => {\n  it.each([1, 2, 3, 4])(\"accepts %i\", (v) => expect(severitySchema.safeParse(v).success).toBe(true));\n  it.each([0, 5, 2.5, \"3\"])(\"rejects %p (boundary/type)\", (v) =>\n    expect(severitySchema.safeParse(v).success).toBe(false),\n  );\n});\n```\n\n```ts\n// types/resolution.test.ts\nimport { describe, it, expect } from \"vitest\";\nimport { reviewActionSchema } from \"@/types/resolution\";\n\ndescribe(\"reviewActionSchema\", () => {\n  it(\"accepts approve/reject with no extra fields\", () => {\n    expect(reviewActionSchema.safeParse({ action: \"approve\" }).success).toBe(true);\n    expect(reviewActionSchema.safeParse({ action: \"reject\" }).success).toBe(true);\n  });\n\n  it(\"requires overrideValue for override, and rejects an empty string\", () => {\n    expect(reviewActionSchema.safeParse({ action: \"override\" }).success).toBe(false);\n    expect(reviewActionSchema.safeParse({ action: \"override\", overrideValue: \"\" }).success).toBe(false);\n    expect(reviewActionSchema.safeParse({ action: \"override\", overrideValue: \"x\" }).success).toBe(true);\n  });\n\n  it(\"rejects a client-supplied reviewedBy (must never be settable from here)\", () => {\n    const r = reviewActionSchema.safeParse({ action: \"approve\", reviewedBy: \"attacker\" });\n    // discriminatedUnion strips/ignores unknown keys by default — assert that explicitly.\n    expect(r.success && !(\"reviewedBy\" in r.data)).toBe(true);\n  });\n});\n```\n\n---\n\n### 7. Components — zero rendering tests\n\n`SourceTable`, `SeverityMark`, `Button`, `SourcesEmptyState` all have real conditional logic and no snapshot of correct output.\n\n```tsx\n// components/severity-mark.test.tsx\nimport { describe, it, expect } from \"vitest\";\nimport { render, screen } from \"@testing-library/react\";\nimport { SeverityMark } from \"@/components/severity-mark\";\n\ndescribe(\"SeverityMark\", () => {\n  it.each([1, 2, 3, 4] as const)(\"always renders the label text alongside severity %i (never color-only)\", (s) => {\n    render(<SeverityMark severity={s} />);\n    expect(screen.getByText(/structural|attribute|cosmetic/i)).toBeInTheDocument();\n  });\n});\n```\n\n```tsx\n// components/sources/source-table.test.tsx\nimport { describe, it, expect } from \"vitest\";\nimport { render, screen } from \"@testing-library/react\";\nimport { SourceTable } from \"@/components/sources/source-table\";\n\nconst source = (overrides = {}) => ({\n  id: \"1\", name: \"SFDC Prod\", kind: \"salesforce\" as const,\n  config: { objects: [\"Account\", \"Contact\"] }, createdAt: new Date(), ...overrides,\n});\n\ndescribe(\"SourceTable\", () => {\n  it(\"renders zero rows for an empty list without erroring\", () => {\n    render(<SourceTable sources={[]} />);\n    expect(screen.queryAllByRole(\"row\")).toHaveLength(1); // header only\n  });\n\n  it(\"joins multiple config.objects with a comma\", () => {\n    render(<SourceTable sources={[source()]} />);\n    expect(screen.getByText(\"Account, Contact\")).toBeInTheDocument();\n  });\n\n  it(\"maps kind to its human label and CRM/warehouse side\", () => {\n    render(<SourceTable sources={[source({ kind: \"databricks\" })]} />);\n    expect(screen.getByText(\"Databricks\")).toBeInTheDocument();\n    expect(screen.getByText(\"warehouse\")).toBeInTheDocument();\n  });\n\n  it(\"renders a synthetic source (SIDE = 'either') without crashing\", () => {\n    render(<SourceTable sources={[source({ kind: \"synthetic\" })]} />);\n    expect(screen.getByText(\"either\")).toBeInTheDocument();\n  });\n});\n```\n\n```tsx\n// components/ui/button.test.tsx\nimport { describe, it, expect } from \"vitest\";\nimport { render, screen } from \"@testing-library/react\";\nimport { Button } from \"@/components/ui/button\";\n\ndescribe(\"Button\", () => {\n  it(\"defaults to primary/md variant classes\", () => {\n    render(<Button>Save</Button>);\n    expect(screen.getByRole(\"button\")).toHaveClass(\"bg-g-900\", \"h-9\");\n  });\n\n  it(\"renders disabled state with reduced opacity + no pointer events\", () => {\n    render(<Button disabled>Save</Button>);\n    expect(screen.getByRole(\"button\")).toBeDisabled();\n  });\n\n  it(\"with asChild, renders the child element (e.g. an anchor) instead of a <button>\", () => {\n    render(<Button asChild><a href=\"/x\">Go</a></Button>);\n    expect(screen.getByRole(\"link\", { name: \"Go\" })).toBeInTheDocument();\n    expect(screen.queryByRole(\"button\")).not.toBeInTheDocument();\n  });\n});\n```\n\n---\n\n### 8. Integration test gaps (none currently possible — infra doesn't exist)\n\n- **DB round-trip**: no test inserts a row via `getDb()` and confirms `listSources()` reads it back through `sourceSchema.parse` — the ORM↔schema boundary is only checked at runtime today. Needs a test Postgres (`pg-mem` or a docker-compose test DB) since `lib/db/index.ts` requires a live `DATABASE_URL`.\n- **`proxy.ts` end-to-end**: no test exercises actual `NextRequest` objects through `clerkMiddleware` with signed-in/signed-out session mocks to confirm redirects fire.\n- **Table-ownership boundaries** (`lib/db/schema.ts` comment: \"engine must never write\" to `sources`/`rulesets`): this is a documented invariant with zero enforcement in code and zero test — currently relies entirely on organizational discipline. Worth at minimum a comment-adjacent runtime assertion or a migration-level grant restriction, which could then be tested.\n- **API routes**: `types/resolution.ts` references a `PATCH /api/conflicts/:conflictId/resolution` endpoint in its comments, but no `app/api/**/route.ts` exists yet. When it's built, `reviewActionSchema` + `requireReviewer` need an integration test confirming `reviewedBy`/`actor` come only from the server session, never the request body (this is the exact vulnerability the code comments call out as unacceptable).\n\n---\n\n**Priority order if you can only do a few:** `proxy.ts` matcher (access-control correctness) → `lib/server/auth.ts` (audit-trail integrity) → `types/*.ts` schemas (cross-service contract) → `lib/server/sources.ts` → components.\n",
