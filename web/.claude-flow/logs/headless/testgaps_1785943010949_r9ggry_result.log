        "code": "// types/resolution.test.ts\nimport { describe, it, expect } from \"vitest\";\nimport { reviewActionSchema } from \"./resolution\";\n\ndescribe(\"reviewActionSchema\", () => {\n  it.each([\"approve\", \"reject\"])(\"accepts %s with no extra fields\", (action) => {\n    expect(reviewActionSchema.safeParse({ action }).success).toBe(true);\n  });\n  it(\"requires overrideValue for override action\", () => {\n    expect(reviewActionSchema.safeParse({ action: \"override\" }).success).toBe(false);\n  });\n  it(\"rejects empty-string overrideValue\", () => {\n    expect(reviewActionSchema.safeParse({ action: \"override\", overrideValue: \"\" }).success).toBe(false);\n  });\n  it(\"rejects unknown action literal\", () => {\n    expect(reviewActionSchema.safeParse({ action: \"delete\" }).success).toBe(false);\n  });\n  it(\"rejects a client-supplied reviewedBy field being relied upon (must be ignored/absent from type)\", () => {\n    // documents the intentional omission — reviewedBy must never be read from this schema\n    const parsed = reviewActionSchema.parse({ action: \"approve\", reviewedBy: \"attacker\" });\n    expect(parsed).not.toHaveProperty(\"reviewedBy\");\n  });\n});"
