        "code": "// lib/reviewer-label.test.ts\nimport { describe, it, expect } from \"vitest\";\nimport { reviewerLabel } from \"./reviewer-label\";\n\ndescribe(\"reviewerLabel\", () => {\n  it(\"prefers username over email\", () => {\n    expect(reviewerLabel({ username: \"j.rao\", primaryEmailAddress: { emailAddress: \"j@x.com\" } }, \"fallback\")).toBe(\"j.rao\");\n  });\n  it(\"falls back to email when username is null\", () => {\n    expect(reviewerLabel({ username: null, primaryEmailAddress: { emailAddress: \"j@x.com\" } }, \"fallback\")).toBe(\"j@x.com\");\n  });\n  it(\"falls back to email when username is empty string\", () => {\n    // edge case: \"\" is falsy but not null — current impl uses ?? so \"\" would win over email\n    expect(reviewerLabel({ username: \"\", primaryEmailAddress: { emailAddress: \"j@x.com\" } }, \"fallback\")).toBe(\"\");\n  });\n  it(\"uses fallback when user is null\", () => {\n    expect(reviewerLabel(null, \"user_123\")).toBe(\"user_123\");\n  });\n  it(\"uses fallback when both username and email are missing\", () => {\n    expect(reviewerLabel({ username: null, primaryEmailAddress: null }, \"user_123\")).toBe(\"user_123\");\n  });\n  it(\"uses fallback when emailAddress itself is null\", () => {\n    expect(reviewerLabel({ username: null, primaryEmailAddress: { emailAddress: null } }, \"user_123\")).toBe(\"user_123\");\n  });\n});"
      },
