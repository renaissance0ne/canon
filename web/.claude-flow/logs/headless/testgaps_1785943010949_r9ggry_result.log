Value({ isAuthenticated: true, userId: \"u1\" });\n    currentUserMock.mockResolvedValue({ username: null, primaryEmailAddress: null });\n    await expect(getReviewer()).resolves.toEqual({ userId: \"u1\", label: \"u1\" });\n  });\n});\n```\n\n**Gap — `getDb()` lazy-connect + missing-env-var failure path:**\n```ts\n// lib/db/index.test.ts\ndescribe(\"getDb\", () => {\n  it(\"throws an actionable error when DATABASE_URL is unset\", () => {\n    delete process.env.DATABASE_URL;\n    expect(() => getDb()).toThrow(/DATABASE_URL is not set/);\n  });\n  it(\"caches the connection on globalThis across calls (HMR safety)\", () => {\n    process.env.DATABASE_URL = \"postgres://x\";\n    const a = getDb();\n    const b = getDb();\n    expect(a).toBe(b);\n  });\n});\n```\n\n**Gap — `listSources` row→schema parse failure is silent-crash territory:**\n```ts\n// lib/server/sources.test.ts (add)\nit(\"throws if a row from the db fails sourceSchema.parse (schema drift)\", async () => {\n  // mock getDb().select().from().orderBy() to resolve a row missing a required field\n  // assert listSources() rejects rather than returning malformed data\n});\n```\n\n---\n\n### 4. Route matcher (`proxy.ts`) — untested authorization boundary\n\nThis is the single access-control gate for the whole app; a regex or matcher mistake here is a full auth bypass, and it's currently unverified.\n\n```ts\n// proxy.test.ts\nimport { describe, it, expect } from \"vitest\";\nimport { createRouteMatcher } from \"@clerk/nextjs/server\";\n\n// Test the matcher logic directly, not the exported middleware (which needs a Clerk request context)\nconst isPublicRoute = createRouteMatcher([\"/\", \"/sign-in(.*)\", \"/sign-up(.*)\"]);\n\ndescribe(\"isPublicRoute\", () => {\n  it.each([\"/\", \"/sign-in\", \"/sign-in/factor-one\", \"/sign-up\"])(\"treats %s as public\", (path) => {\n    expect(isPublicRoute(new Request(`http://x${path}`))).toBe(true);\n  });\n  it.each([\"/sources\", \"/api/sources\", \"/get-started\", \