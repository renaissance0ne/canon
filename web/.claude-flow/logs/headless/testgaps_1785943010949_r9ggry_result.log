        "code": "// types/rules.test.ts (add to same file)\ndescribe(\"survivorshipRuleSchema\", () => {\n  const valid = { id: \"1\", field: \"name\", entityType: \"account\", strategy: \"most_recent\", description: \"d\" };\n  it(\"accepts strategies other than prefer_source without preferredSourceId\", () => {\n    expect(survivorshipRuleSchema.safeParse(valid).success).toBe(true);\n  });\n  it(\"rejects prefer_source without preferredSourceId\", () => {\n    expect(survivorshipRuleSchema.safeParse({ ...valid, strategy: \"prefer_source\" }).success).toBe(false);\n  });\n  it(\"accepts prefer_source with preferredSourceId\", () => {\n    expect(survivorshipRuleSchema.safeParse({ ...valid, strategy: \"prefer_source\", preferredSourceId: \"src1\" }).success).toBe(true);\n  });\n});"
