 () => {\n    expect(reviewerLabel({ username: null, primaryEmailAddress: null }, \"user_123\")).toBe(\"user_123\");\n  });\n  it(\"uses fallback when emailAddress itself is null\", () => {\n    expect(reviewerLabel({ username: null, primaryEmailAddress: { emailAddress: null } }, \"user_123\")).toBe(\"user_123\");\n  });\n});\n```\nNote the `\"\"` edge case — worth confirming that's intentional (empty username beating a real email looks like a latent bug).\n\n**Gap — `ruleSpecificity` ordering not verified:**\n```ts\n// types/rules.test.ts\nimport { describe, it, expect } from \"vitest\";\nimport { ruleSpecificity } from \"./rules\";\n\ndescribe(\"ruleSpecificity\", () => {\n  const base = { id: \"1\", strategy: \"escalate\" as const, description: \"\" };\n  it(\"scores exact field + exact entityType highest (3)\", () => {\n    expect(ruleSpecificity({ ...base, field: \"name\", entityType: \"account\" })).toBe(3);\n  });\n  it(\"scores wildcard field + exact entityType as 1\", () => {\n    expect(ruleSpecificity({ ...base, field: \"*\", entityType: \"account\" })).toBe(1);\n  });\n  it(\"scores exact field + wildcard entityType as 2\", () => {\n    expect(ruleSpecificity({ ...base, field: \"name\", entityType: \"*\" })).toBe(2);\n  });\n  it(\"scores wildcard + wildcard as 0\", () => {\n    expect(ruleSpecificity({ ...base, field: \"*\", entityType: \"*\" })).toBe(0);\n  });\n});\n```\n\n**Gap — `countSourcesBySide` classification, needs `listSources` mocked:**\n```ts\n// lib/server/sources.test.ts\nimport { describe, it, expect, vi } from \"vitest\";\n\nvi.mock(\"next/server\", () => ({ connection: vi.fn() }));\nvi.mock(\"@/lib/db\", () => ({ getDb: vi.fn() }));\n\ndescribe(\"countSourcesBySide\", () => {\n  it(\"buckets salesforce/hubspot as crm, databricks/snowflake as warehouse, synthetic separately\", async () => {\n    // arrange: mock getDb().select().from().orderBy() to return a fixed row set\n    // covering one of each kind, then assert { crm: 2, warehouse: 2, synthetic: 1 }\n  });\n  it(\"returns zero counts for an empty source list\", async () => {});\n});\n```\n\n---\n\n### 2. Zod schema contracts — untested boundary validation\n\nThese are \"tool contracts\" per the code comments (mirroring `engine/pipeline/schema.py`), so a break here silently desyncs web/engine. None have parse tests.\n\n**Gap — `reviewActionSchema` discriminated union:**\n```ts\n// types/resolution.test.ts\nimport { describe, it, expect } from \"vitest\";\nimport { reviewActionSchema } from \"./resolution\";\n\ndescribe(\"reviewActionSchema\", () => {\n  it.each([\"approve\", \"reject\"])(\"accepts %s with no extra fields\", (action) => {\n    expect(reviewActionSchema.safeParse({ action }).success).toBe(true);\n  });\n  it(\"requires overrideValue for override action\", () => {\n    expect(reviewActionSchema.safeParse({ action: \"override\" }).success).toBe(false);\n  });\n  it(\"rejects empty-string overrideValue\", () => {\n    expect(reviewActionSchema.safeParse({ action: \"override\", overrideValue: \"\" }).success).toBe(false);\n  });\n  it(\"rejects unknown action literal\", () => {\n    expect(reviewActionSchema.safeParse({ action: \"delete\" }).success).toBe(false);\n  });\n  it(\"rejects a client-supplied reviewedBy field being relied upon (must be ignored/absent from type)\", () => {\n    // documents the intentional omission — reviewedBy must never be read from this schema\n    const parsed = reviewActionSchema.parse({ action: \"approve\", reviewedBy: \"attacker\" });\n    expect(parsed).not.toHaveProperty(\"reviewedBy\");\n  });\n});\n```\n\n**Gap — `survivorshipRuleSchema` refine() branch:**\n```ts\n// types/rules.test.ts (add to same file)\ndescribe(\"survivorshipRuleSchema\", () => {\n  const valid = { id: \"1\", field: \"name\", entityType: \"account\", strategy: \"most_recent\", description: \"d\" };\n  it(\"accepts strategies other than prefer_source without preferredSourceId\", () => {\n    expect(survivorshipRuleSchema.safeParse(valid).success).toBe(true);\n  });\n  it(\"rejects prefer_source without preferredSourceId\", () => {\n    expect(survivorshipRuleSchema.safeParse({ ...valid, strategy: \"prefer_source\" }).success).toBe(false);\n  });\n  it(\"accepts prefer_source with preferredSourceId\", () => {\n    expect(survivorshipRuleSchema.safeParse({ ...valid, strategy: \"prefer_source\", preferredSourceId: \"src1\" }).success).toBe(true);\n  });\n});\n```\n\n**Gap — `sourceConfigSchema` / `createSourceSchema` boundary values:**\n```ts\n// types/source.test.ts\ndescribe(\"sourceConfigSchema\", () => {\n  it(\"rejects empty objects array\", () => {\n    expect(sourceConfigSchema.safeParse({ objects: [] }).success).toBe(false);\n  });\n  it(\"filter is optional\", () => {\n    expect(sourceConfigSchema.safeParse({ objects: [\"Account\"] }).success).toBe(true);\n  });\n});\ndescribe(\"createSourceSchema\", () => {\n  it(\"rejects name over 80 chars\", () => {\n    expect(createSourceSchema.safeParse({ name: \"x\".repeat(81), kind: \"synthetic\", config: { objects: [\"a\"] } }).success).toBe(false);\n  });\n  it(\"rejects empty name\", () => {\n    expect(createSourceSchema.safeParse({ name: \"\", kind: \"synthetic\", config: { objects: [\"a\"] } }).success).toBe(false);\n  });\n  it(\"rejects unknown kind\", () => {\n    expect(createSourceSchema.safeParse({ name: \"n\", kind: \"oracle\", config: { objects: [\"a\"] } }).success).toBe(false);\n  });\n});\n```\n\n**Gap — `severitySchema` / `runStatsSchema` numeric bounds:**\n```ts\ndescribe(\"severitySchema\", () => {\n  it.each([0, 5, -1, 2.5])(\"rejects out-of-range value %p\", (v) => {\n    expect(severitySchema.safeParse(v).success).toBe(false);\n  });\n});\ndescribe(\"runStatsSchema\", () => {\n  it(\"rejects negative counts\", () => {\n    expect(runStatsSchema.safeParse({ entitiesA: -1, entitiesB: 0, candidatePairs: 0, matches: 0, conflicts: 0, autoResolved: 0, escalated: 0, tokensUsed: 0 }).success).toBe(false);\n  });\n  it(\"r