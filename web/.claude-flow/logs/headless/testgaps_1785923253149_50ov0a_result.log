  "output": "I have enough to write a comprehensive report. Here's the test coverage analysis.\n\n## Test Coverage Analysis: `canon/web`\n\n**Critical gap first:** there is no test infrastructure at all — zero test files, and no test runner (`vitest`/`jest`) in `package.json`'s devDependencies. Every gap below assumes Vitest + `@testing-library/react` gets added first, since this is a Next.js 16 / React 19 app (Vitest has the better RSC/ESM story here).\n\n```bash\nnpm i -D vitest @vitejs/plugin-react jsdom @testing-library/react @testing-library/jest-dom\n```\n\n### 1. `lib/reviewer-label.ts` — `reviewerLabel()`\nPure function, zero coverage. This is security/audit-sensitive: AGENTS.md ties it directly to `audit_log.actor`.\n\nUntested branches: username wins, email fallback, id fallback, `null` user, empty-string username (falsy but present — does it fall through correctly?).\n\n```ts\n// lib/reviewer-label.test.ts\nimport { describe, it, expect } from \"vitest\";\nimport { reviewerLabel } from \"./reviewer-label\";\n\ndescribe(\"reviewerLabel\", () => {\n  it(\"prefers username when present\", () => {\n    expect(reviewerLabel({ username: \"j.rao\", primaryEmailAddress: { emailAddress: \"j@x.com\" } }, \"uid_1\")).toBe(\"j.rao\");\n  });\n\n  it(\"falls back to email when username is missing\", () => {\n    expect(reviewerLabel({ username: null, primaryEmailAddress: { emailAddress: \"j@x.com\" } }, \"uid_1\")).toBe(\"j@x.com\");\n  });\n\n  it(\"falls back to the id when user is null\", () => {\n    expect(reviewerLabel(null, \"uid_1\")).toBe(\"uid_1\");\n  });\n\n  it(\"falls back to the id when username and email are both null\", () => {\n    expect(reviewerLabel({ username: null, primaryEmailAddress: null }, \"uid_1\")).toBe(\"uid_1\");\n  });\n\n  it(\"treats an empty-string username as absent (falsy, not nullish)\", () => {\n    // BUG RISK: ?? only catches null/undefined, not \"\". Verify intended behavior.\n    expect(reviewerLabel({ username: \"\", primaryEmailAddress: { emailAddress: \"j@x.com\" } }, \"uid_1\")).toBe(\"\");\n  });\n\n  it(\"falls back when primaryEmailAddress exists but emailAddress is null\", () => {\n    expect(reviewerLabel({ username: null, primaryEmailAddress: { emailAddress: null } }, \"uid_1\")).toBe(\"uid_1\");\n  });\n});\n```\n\nNote the empty-string case: `??` doesn't catch `\"\"`, so a user with an empty (not null) username string would render a blank label instead of falling through to email/id. Worth confirming this is intentional — Clerk usernames probably can't be empty strings, but the type allows it.\n\n### 2. `lib/cn.ts` — `cn()`\n```ts\n// lib/cn.test.ts\nimport { describe, it, expect } from \"vitest\";\nimport { cn } from \"./cn\";\n\ndescribe(\"cn\", () => {\n  it(\"merges class strings\", () => {\n    expect(cn(\"px-2\", \"py-4\")).toBe(\"px-2 py-4\");\n  });\n\n  it(\"resolves conflicting tailwind classes, last wins\", () => {\n    expect(cn(\"px-2\", \"px-4\")).toBe(\"px-4\");\n  });\n\n  it(\"drops falsy values\", () => {\n    expect(cn(\"a\", false, null, undefined, 0, \"b\")).toBe(\"a b\");\n  });\n\n  it(\"handles conditional object syntax\", () => {\n    expect(cn(\"base\", { active: true, disabled: false })).toBe(\"base active\");\n  });\n});\n```\n\n### 3. `types/rules.ts` — `ruleSpecificity()` and `survivorshipRuleSchema`\nThis drives resolution ordering (\"first match wins\") — a wrong specificity score silently misapplies survivorship policy. No coverage.\n\n```ts\n// types/rules.test.ts\nimport { describe, it, expect } from \"vitest\";\nimport { ruleSpecificity, survivorshipRuleSchema } from \"./rules\";\n\ndescribe(\"ruleSpecificity\", () => {\n  const base = { id: \"1\", strategy: \"escalate\" as const, description: \"d\" };\n\n  it(\"scores wildcard field + wildcard entityType as 0\", () => {\n    expect(ruleSpecificity({ ...base, field: \"*\", entityType: \"*\" })).toBe(0);\n  });\n  it(\"scores exact field + wildcard entityType as 2\", () => {\n    expect(ruleSpecificity({ ...base, field: \"email\", entityType: \"*\" })).toBe(2);\n  });\n  it(\"scores wildcard field + exact entityType as 1\", () => {\n    expect(ruleSpecificity({ ...base, field: \"*\", entityType: \"account\" })).toBe(1);\n  });\n  it(\"scores exact field + exact entityType as 3 (most specific)\", () => {\n    expect(ruleSpecificity({ ...base, field: \"email\", entityType: \"account\" })).toBe(3);\n  });\n});\n\ndescribe(\"survivorshipRuleSchema\", () => {\n  const valid = { id: \"1\", field: \"*\", entityType: \"*\", description: \"d\" };\n\n  it(\"accepts prefer_source with a preferredSourceId\", () => {\n    expect(survivorshipRuleSchema.safeParse({ ...valid, strategy: \"prefer_source\", preferredSourceId: \"src_1\" }).success).toBe(true);\n  });\n\n  it(\"rejects prefer_source without a preferredSourceId\", () => {\n    const result = survivorshipRuleSchema.safeParse({ ...valid, strategy: \"prefer_source\" });\n    expect(result.success).toBe(false);\n  });\n\n  it(\"accepts most_recent / most_complete / escalate without preferredSourceId\", () => {\n    for (const strategy of [\"most_recent\", \"most_complete\", \"escalate\"] as const) {\n      expect(survivorshipRuleSchema.safeParse({ ...valid, strategy }).success).toBe(true);\n    }\n  });\n});\n```\n\n### 4. `types/source.ts` — schema validation, untested entirely\n```ts\n// types/source.test.ts\nimport { describe, it, expect } from \"vitest\";\nimport { createSourceSchema, sourceConfigSchema } from \"./source\";\n\ndescribe(\"createSourceSchema\", () => {\n  it(\"rejects an empty name\", () => {\n    expect(createSourceSchema.safeParse({ name: \"\", kind: \"synthetic\", config: { objects: [\"a\"] } }).success).toBe(false);\n  });\n\n  it(\"rejects a name over 80 chars\", () => {\n    const name = \"a\".repeat(81);\n    expect(createSourceSchema.safeParse({ name, kind: \"synthetic\", config: { objects: [\"a\"] } }).success).toBe(false);\n  });\n\n  it(\"rejects an unknown kind\", () => {\n    expect(createSourceSchema.safeParse({ name: \"x\", kind: \"bigquery\", config: { objects: [\"a\"] } }).success).toBe(false);\n  });\n\n  it(\"rejects config.objects being empty\", () => {\n    expect(sourceConfigSchema.safeParse({ objects: [] }).success).toBe(false);\n  });\n\n  it(\"accepts config without filter (optional)\", () => {\n    expect(sourceConfigSchema.safeParse({ objects: [\"Account\"] }).success).toBe(true);\n  });\n});\n```\n\n### 5. `types/resolution.ts` — `reviewActionSchema` discriminated union\n```ts\n// types/resolution.test.ts\nimport { describe, it, expect } from \"vitest\";\nimport { reviewActionSchema } from \"./resolution\";\n\ndescribe(\"reviewActionSchema\", () => {\n  it(\"accepts approve with no extra fields\", () => {\n    expect(reviewActionSchema.safeParse({ action: \"approve\" }).success).toBe(true);\n  });\n  it(\"accepts reject\", () => {\n    expect(reviewActionSchema.safeParse({ action: \"reject\" }).success).toBe(true);\n  });\n  it(\"rejects override without overrideValue\", () => {\n    expect(reviewActionSchema.safeParse({ action: \"override\" }).success).toBe(false);\n  });\n  it(\"rejects override with an empty overrideValue\", () => {\n    expect(reviewActionSchema.safeParse({ action: \"override\", overrideValue: \"\" }).success).toBe(false);\n  });\n  it(\"accepts override with a non-empty overrideValue\", () => {\n    expect(reviewActionSchema.safeParse({ action: \"override\", overrideValue: \"Acme\" }).success).toBe(true);\n  });\n  it(\"rejects an unrecognized action\", () => {\n    expect(reviewActionSchema.safeParse({ action: \"delete\" }).success).toBe(false);\n  });\n  it(\"rejects an object without reviewedBy support (regression guard)\", () => {\n    // reviewedBy must never be accepted from the client — see auth.ts comment.\n    const parsed = reviewActionSchema.parse({ action: \"approve\", reviewedBy: \"attacker\" });\n    expect(parsed).not.toHaveProperty(\"reviewedBy\");\n  });\n});\n```\n\n### 6. `lib/server/sources.ts` — `countSourcesBySide()`\nCurrently untestable without a live DB because it composes `listSources()` internally. **Gap + refactor suggestion**: extract the classification into a pure function so it can be tested without mocking Drizzle/Postgres:\n\n```ts\n// suggested: lib/server/sources.ts\nexport function classifyBySide(all: Source[]) {\n  return {\n    crm: all.filter((s) => s.kind === \"salesforce\" || s.kind === \"hubspot\").length,\n    warehouse: all.filter((s) => s.kind === \"databricks\" || s.kind === \"snowflake\").length,\n    synthetic: all.filter((s) => s.kind === \"synthetic\").length,\n  };\n}\nexport async function countSourcesBySide() {\n  return classifyBySide(await listSources());\n}\n```\n\n```ts\n// lib/server/sources.test.ts\nimport { describe, it, expect } from \"vitest\";\nimport { classifyBySide } from \"./sources\";\n\nconst src = (kind: any, i: number) => ({\n  id: `${i}`, name: `s${i}`, kind, config: { objects: [\"a\"] }, createdAt: new Date(),\n});\n\ndescribe(\"classifyBySide\", () => {\n  it(\"counts crm sources (salesforce, hubspot)\", () => {\n    expect(classifyBySide([src(\"salesforce\", 1), src(\"hubspot\", 2)]).crm).toBe(2);\n  });\n  it(\"counts warehouse sources (databricks, snowflake)\", () => {\n    expect(classifyBySide([src(\"databricks\", 1), src(\"snowflake\", 2)]).warehouse).toBe(2);\n  });\n  it(\"counts synthetic separately from crm/warehouse\", () => {\n    const r = classifyBySide([src(\"synthetic\", 1)]);\n    expect(r).toEqual({ crm: 0, warehouse: 0, synthetic: 1 });\n  });\n  it(\"returns all zeros for an empty list\", () => {\n    expect(classifyBySide([])).toEqual({ crm: 0, warehouse: 0, synthetic: 0 });\n  });\n});\n```\n\n**Edge case worth flagging (not a bug, but untested drift risk):** `SOURCE_KIND_SIDE` in `types/source.ts` labels `synthetic` as `\"either\"`, but `classifyBySide`/`countSourcesBySide` puts it in a third bucket, not `crm` or `warehouse`. If any caller sums `crm + warehouse` expecting the total, synthetic sources will silently vanish from that total. A test asserting `crm + warehouse + synthetic === all.length` would catch that regression class.\n\n`listSources()` itself (the DB-touching half) needs an integration test — see gap #9.\n\n### 7. `lib/server/auth.ts` — `requireReviewer()` / `getReviewer()`\nZero coverage on the piece that produces `audit_log.actor`. Needs `@clerk/nextjs/server`'s `auth`/`currentUser` mocked.\n\n```ts\n// lib/server/auth.test.ts\nimport { describe, it, expect, vi, beforeEach } from \"vitest\";\n\nvi.mock(\"@clerk/nextjs/server\", () => ({\n  auth: vi.fn(),\n  currentUser: vi.fn(),\n}));\nimport { auth, currentUser } from \"@clerk/nextjs/server\";\nimport { requireReviewer, getReviewer } from \"./auth\";\n\ndescribe(\"requireReviewer\", () => {\n  beforeEach(() => vi.resetAllMocks());\n\n  it(\"throws when isAuthenticated is false\", async () => {\n    (auth as any).mockResolvedValue({ isAuthenticated: false, userId: null });\n    await expect(requireReviewer()).rejects.toThrow(/No authenticated reviewer/);\n  });\n\n  it(\"throws when isAuthenticated is true but userId is missing (matcher/handler disagreement)\", async () => {\n    (auth as any).mockResolvedValue({ isAuthenticated: true, userId: null });\n    await expect(requireReviewer()).rejects.toThrow();\n  });\n\n  it(\"returns userId + derived label on a valid session\", async () => {\n    (auth as any).mockResolvedValue({ isAuthenticated: true, userId: \"uid_1\" });\n    (currentUser as any).mockResolvedValue({ username: \"j.rao\", primaryEmailAddress: { emailAddress: \"j@x.com\" } });\n    await expect(requireReviewer()).resolves.toEqual({ userId: \"uid_1\", label: \"j.rao\" });\n  });\n});\n\ndescribe(\"getReviewer\", () => {\n  beforeEach(() => vi.resetAllMocks());\n\n  it(\"returns null when signed out, without calling currentUser\", async () => {\n    (auth as any).mockResolvedValue({ isAuthenticated: false, userId: null });\n    await expect(getReviewer()).resolves.toBeNull();\n    expect(currentUser).not.toHaveBeenCalled();\n  });\n\n  it(\"returns a Reviewer when signed in\", async () => {\n    (auth as any).mockResolvedValue({ isAuthenticated: true, userId: \"uid_1\" });\n    (currentUser as any).mockResolvedValue({ username: null, primaryEmailAddress: null });\n    await expect(getReviewer()).resolves.toEqual({ userId: \"uid_1\", label: \"uid_1\" });\n  });\n});\n```\n\n### 8. `proxy.ts` — route matcher / auth gate\nNo coverage on which routes are public vs. protected — this is the entire access-control boundary for an internal tool that exposes org data. At minimum, unit-test the matcher logic (extractable) or an integration test hitting the middleware:\n\n```ts\n// proxy.test.ts (sketch — createRouteMatcher is Clerk's, but the public-list is yours)\nimport { describe, it, expect } from \"vitest\";\nimport { createRouteMatcher } from \"@clerk/nextjs/server\";\n\nconst isPublicRoute = createRouteMatcher([\"/\", \"/sign-in(.*)\", \"/sign-up(.*)\"]);\n\ndescribe(\"public route matcher\", () => {\n  it.each([\n    [\"/\", true],\n    [\"/sign-in\", true],\n    [\"/sign-in/factor-one\", true],\n    [\"/sign-up\", true],\n    [\"/sources\", false],\n    [\"/api/conflicts/1/resolution\", false],\n    [\"/sign-in-not-really\", false], // regex-injection-adjacent edge case\n  ])(\"%s -> public=%s\", (path, expected) => {\n    const req = new Request(`https://x.test${path}`);\n    expect(isPublicRoute(req)).toBe(expected);\n  });\n});\n```\nNote `/sign-in-not-really` — worth confirming `createRouteMatcher`'s `(.*)` pattern doesn't loosely match paths that merely start with `/sign-in`.\n\n### 9. Missing: integration tests for `lib/db/*` and `lib/server/sources.ts` DB path\n`getDb()` and `listSources()` have zero coverage of:\n- Missing `DATABASE_URL` → the actionable error path\n- HMR/globalThis caching behavior (returns cached client on second call)\n- `listSources()` ordering by `createdAt`\n- `listSources()` throwing when a row fails `sourceSchema.parse` (malformed `config` JSON in the DB)\n\nThese need a real or dockerized Postgres (e.g. via `testcontainers` or a Supabase local stack) — currently no test DB setup exists in the repo at all.\n\n```ts\n// lib/db/index.test.ts (unit-testable slice, no DB needed)\nimport { describe, it, expect, vi } from \"vitest\";\n\ndescribe(\"getDb\", () => {\n  it(\"throws an actionable error when DATABASE_URL is unset\", async () => {\n    vi.stubEnv(\"DATABASE_URL\", \"\");\n    vi.resetModules();\n    const { getDb } = await import(\"./index\");\n    expect(() => getDb()).toThrow(/DATABASE_URL is not set/);\n  });\n});\n```\n\n### 10. Component tests — currently zero\n- `SourceTable`: renders correct `SOURCE_KIND_LABEL`/`SOURCE_KIND_SIDE` per row, joins `config.objects` with `\", \"`, renders nothing in `<tbody>` for an empty array (currently would render an empty table, not the empty state — that switch lives in the page, untested).\n- `SourcesPage`: switches between `SourcesEmptyState` and `SourceTable` based on `sources.length`; untested branch coverage on both paths and the boundary (`length === 1`).\n- `Button`: `asChild` renders a `Slot` wrapping the child instead of a `<button>`; variant/size class application; `disabled` applies `pointer-events-none opacity-40`.\n- `SeverityMark`: all four severities render their `MARK`/`TREATMENT`/`SEVERITY_LABEL` correctly — this is a compliance-relevant component (AGENTS.md: \"never rendered without the word\"), so a test asserting the label text is always present alongside the mark is worth having as a regression guard.\n\n```tsx\n// components/sources/source-table.test.tsx\nimport { describe, it, expect } from \"vitest\";\nimport { render, screen } from \"@testing-library/react\";\nimport { SourceTable } from \"./source-table\";\n\nconst source = {\n  id: \"1\", name: \"Prod SFDC\", kind: \"salesforce\" as const,\n  config: { objects: [\"Account\", \"Contact\"] }, createdAt: new Date(),\n};\n\ndescribe(\"SourceTable\", () => {\n  it(\"renders one row per source with joined objects\", () => {\n    render(<SourceTable sources={[source]} />);\n    expect(screen.getByText(\"Prod SFDC\")).toBeInTheDocument();\n    expect(screen.getByText(\"Salesforce\")).toBeInTheDocument();\n    expect(screen.getByText(\"crm\")).toBeInTheDocument();\n    expect(screen.getByText(\"Account, Contact\")).toBeInTheDocument();\n  });\n\n  it(\"renders an empty tbody for an empty sources array\", () => {\n    const { container } = render(<SourceTable sources={[]} />);\n    expect(container.querySelectorAll(\"tbody tr\")).toHaveLength(0);\n  });\n});\n```\n\n```tsx\n// components/severity-mark.test.tsx\nimport { describe, it, expect } from \"vitest\";\nimport { render, screen } from \"@testing-library/react\";\nimport { SeverityMark } from \"./severity-mark\";\n\ndescribe(\"SeverityMark\", () => {\n  it.each([1, 2, 3, 4] as const)(\"severity %i always renders its label text alongside the mark\", (severity) => {\n    render(<SeverityMark severity={severity} />);\n    expect(screen.getByText(/Structural|Attribute|Cosmetic/)).toBeInTheDocument();\n  });\n});\n```\n\n### Summary of gaps by priority\n\n| Priority | File | Why |\n|---|---|---|\n| P0 | Test infra itself | No runner installed, nothing can be tested yet |\n| P0 | `reviewerLabel`, `requireReviewer`/`getReviewer` | Feeds `audit_log.actor` — the audit trail's integrity depends on it |\n| P0 | `proxy.ts` matcher | Sole access-control gate for an internal-data console |\n| P1 | `reviewActionSchema`, `survivorshipRuleSchema`, `ruleSpecificity` | Drive resolution correctness and rule ordering |\n| P1 | `types/source.ts` schemas | Validate all source config input |\n| P2 | `classifyBySide`/`countSourcesBySide` | Business logic, has the crm+warehouse≠total edge case above |\n| P2 | `lib/db/index.ts`, `listSources()` | DB error paths, malformed-row parsing |\n| P3 | Component tests (`SourceTable`, `SourcesPage`, `Button`, `SeverityMark`) | UI branch coverage, lower risk than data/auth logic |\n\nNo API route handlers exist yet under `app/api` (checked — none found), so there's no integration-test gap there yet, but `reviewActionSchema`'s comment references a `PATCH /api/conflicts/:conflictId/resolution` handler that isn't implemented — worth noting since tests for it don't exist because the route itself doesn't either.\n",
