        "language": "ts",
        "code": "// lib/reviewer-label.test.ts\nimport { describe, it, expect } from \"vitest\";\nimport { reviewerLabel } from \"./reviewer-label\";\n\ndescribe(\"reviewerLabel\", () => {\n  it(\"prefers username when present\", () => {\n    expect(reviewerLabel({ username: \"j.rao\", primaryEmailAddress: { emailAddress: \"j@x.com\" } }, \"uid_1\")).toBe(\"j.rao\");\n  });\n\n  it(\"falls back to email when username is missing\", () => {\n    expect(reviewerLabel({ username: null, primaryEmailAddress: { emailAddress: \"j@x.com\" } }, \"uid_1\")).toBe(\"j@x.com\");\n  });\n\n  it(\"falls back to the id when user is null\", () => {\n    expect(reviewerLabel(null, \"uid_1\")).toBe(\"uid_1\");\n  });\n\n  it(\"falls back to the id when username and email are both null\", () => {\n    expect(reviewerLabel({ username: null, primaryEmailAddress: null }, \"uid_1\")).toBe(\"uid_1\");\n  });\n\n  it(\"treats an empty-string username as absent (falsy, not nullish)\", () => {\n    // BUG RISK: ?? only catches null/undefined, not \"\". Verify intended behavior.\n    expect(reviewerLabel({ username: \"\", primaryEmailAddress: { emailAddress: \"j@x.com\" } }, \"uid_1\")).toBe(\"\");\n  });\n\n  it(\"falls back when primaryEmailAddress exists but emailAddress is null\", () => {\n    expect(reviewerLabel({ username: null, primaryEmailAddress: { emailAddress: null } }, \"uid_1\")).toBe(\"uid_1\");\n  });\n});"
