        "code": "// types/rules.test.ts\nimport { describe, it, expect } from \"vitest\";\nimport { ruleSpecificity, survivorshipRuleSchema } from \"./rules\";\n\ndescribe(\"ruleSpecificity\", () => {\n  const base = { id: \"1\", strategy: \"escalate\" as const, description: \"d\" };\n\n  it(\"scores wildcard field + wildcard entityType as 0\", () => {\n    expect(ruleSpecificity({ ...base, field: \"*\", entityType: \"*\" })).toBe(0);\n  });\n  it(\"scores exact field + wildcard entityType as 2\", () => {\n    expect(ruleSpecificity({ ...base, field: \"email\", entityType: \"*\" })).toBe(2);\n  });\n  it(\"scores wildcard field + exact entityType as 1\", () => {\n    expect(ruleSpecificity({ ...base, field: \"*\", entityType: \"account\" })).toBe(1);\n  });\n  it(\"scores exact field + exact entityType as 3 (most specific)\", () => {\n    expect(ruleSpecificity({ ...base, field: \"email\", entityType: \"account\" })).toBe(3);\n  });\n});\n\ndescribe(\"survivorshipRuleSchema\", () => {\n  const valid = { id: \"1\", field: \"*\", entityType: \"*\", description: \"d\" };\n\n  it(\"accepts prefer_source with a preferredSourceId\", () => {\n    expect(survivorshipRuleSchema.safeParse({ ...valid, strategy: \"prefer_source\", preferredSourceId: \"src_1\" }).success).toBe(true);\n  });\n\n  it(\"rejects prefer_source without a preferredSourceId\", () => {\n    const result = survivorshipRuleSchema.safeParse({ ...valid, strategy: \"prefer_source\" });\n    expect(result.success).toBe(false);\n  });\n\n  it(\"accepts most_recent / most_complete / escalate without preferredSourceId\", () => {\n    for (const strategy of [\"most_recent\", \"most_complete\", \"escalate\"] as const) {\n      expect(survivorshipRuleSchema.safeParse({ ...valid, strategy }).success).toBe(true);\n    }\n  });\n});"
