        "title": "`types/run.ts` — `isTerminalRunStatus`, `runStageIndex`, `isStatKnown`, `failedStage`",
        "content": "\n```ts\ndescribe(\"isTerminalRunStatus\", () => {\n  it(\"true for complete and failed, false for every in-flight status\", () => {\n    expect(isTerminalRunStatus(\"complete\")).toBe(true);\n    expect(isTerminalRunStatus(\"failed\")).toBe(true);\n    for (const s of [\"queued\", \"extracting\", \"matching\", \"detecting\", \"resolving\"] as const) {\n      expect(isTerminalRunStatus(s)).toBe(false);\n    }\n  });\n});\n\ndescribe(\"isStatKnown\", () => {\n  it(\"all stats known once complete\", () => { /* ... */ });\n  it(\"all stats known once failed (partial-progress case)\", () => { /* ... */ });\n  it(\"a stat is unknown before its producing stage\", () => {\n    expect(isStatKnown(\"matches\", \"extracting\")).toBe(false);\n  });\n  it(\"a stat is known once its producing stage is behind\", () => {\n    expect(isStatKnown(\"entitiesA\", \"matching\")).toBe(true);\n  });\n});\n\ndescribe(\"failedStage\", () => {\n  it(\"parses stage= from the error convention\", () => {\n    expect(failedStage(\"EngineDispatch: timeout\\nstage=dispatch\")).toBe(\"queued\");\n  });\n  it(\"returns null when error has no stage= marker\", () => {\n    expect(failedStage(\"some other error\")).toBeNull();\n  });\n  it(\"returns null for a null error\", () => {\n    expect(failedStage(null)).toBeNull();\n  });\n  it(\"returns null for an unrecognized verb\", () => {\n    expect(failedStage(\"stage=nonsense\")).toBeNull();\n  });\n  it(\"is case-insensitive on the verb\", () => {\n    expect(failedStage(\"stage=EXTRACT\")).toBe(\"extracting\");\n  });\n});\n```\n\n",
