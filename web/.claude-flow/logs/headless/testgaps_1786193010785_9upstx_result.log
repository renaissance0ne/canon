        "code": "import { describe, it, expect } from \"vitest\";\nimport { diffSegments } from \"@/lib/diff-chars\";\n\ndescribe(\"diffSegments\", () => {\n  it(\"returns all-prefix when values are equal\", () => {\n    expect(diffSegments(\"ACME\", \"ACME\")).toEqual({ prefix: \"ACME\", middle: \"\", suffix: \"\" });\n  });\n\n  it(\"finds a differing middle with shared head and tail\", () => {\n    expect(diffSegments(\"ACC-4417\", \"ACC-2201\")).toEqual({\n      prefix: \"ACC-\", middle: \"4417\", suffix: \"\",\n    });\n  });\n\n  it(\"handles no shared prefix or suffix\", () => {\n    expect(diffSegments(\"abc\", \"xyz\")).toEqual({ prefix: \"\", middle: \"abc\", suffix: \"\" });\n  });\n\n  it(\"handles one empty string\", () => {\n    expect(diffSegments(\"\", \"abc\")).toEqual({ prefix: \"\", middle: \"\", suffix: \"\" });\n  });\n\n  it(\"does not double-count overlapping prefix/suffix on short strings\", () => {\n    // \"a\" vs \"aa\": max=1, prefix consumes the only char, suffix must not also claim it\n    expect(diffSegments(\"a\", \"aa\")).toEqual({ prefix: \"a\", middle: \"\", suffix: \"\" });\n  });\n\n  it(\"handles single-character differing values\", () => {\n    expect(diffSegments(\"A\", \"B\")).toEqual({ prefix: \"\", middle: \"A\", suffix: \"\" });\n  });\n});"
