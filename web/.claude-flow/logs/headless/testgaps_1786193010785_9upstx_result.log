        "title": "`lib/server/auth.ts` — `requireReviewer`, `requireReviewerForApi`, `getReviewer` (auth boundary — a bug here is a security bug)",
        "content": "\n```ts\nimport { vi, describe, it, expect } from \"vitest\";\n\nvi.mock(\"@clerk/nextjs/server\", () => ({\n  auth: vi.fn(),\n  currentUser: vi.fn(),\n}));\n\ndescribe(\"requireReviewerForApi\", () => {\n  it(\"returns 401 response when not authenticated\", async () => {\n    (auth as any).mockResolvedValue({ isAuthenticated: false, userId: null });\n    const gate = await requireReviewerForApi();\n    expect(gate.ok).toBe(false);\n    if (!gate.ok) expect(gate.response.status).toBe(401);\n  });\n\n  it(\"returns reviewer with username label when authenticated\", async () => { /* ... */ });\n\n  it(\"falls back to email, then userId, when username/email are null\", async () => { /* ... */ });\n});\n\ndescribe(\"requireReviewer\", () => {\n  it(\"throws if auth.protect() resolves but userId is somehow null (defensive check)\", async () => {\n    // covers the explicit \"Clerk changed shape underneath us\" guard — currently unexercised\n    (authMock.protect as any).mockResolvedValue(undefined);\n    (authMock as any).mockResolvedValue({ userId: null });\n    await expect(requireReviewer()).rejects.toThrow(/carried no userId/);\n  });\n});\n\ndescribe(\"getReviewer\", () => {\n  it(\"returns null when signed out, without redirecting\", async () => { /* ... */ });\n  it(\"delegates to requireReviewer when signed in\", async () => { /* ... */ });\n});\n```\n\n",
