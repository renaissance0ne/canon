# which is why lib/db passes `prepare: false`. Read by Server Components and
# route handlers only.
DATABASE_URL=postgresql://postgres.yenteczevefirhvgyvcu:ArlecchinoxZhongli@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Migrations — Supavisor SESSION mode (port 5432). Same host, same credential,
# different port. drizzle-kit runs DDL and introspection with prepared
# statements, which transaction mode does not support; Supabase's own guidance
# is to migrate over a session or direct connection.
MIGRATION_DATABASE_URL=postgresql://postgres.yenteczevefirhvgyvcu:ArlecchinoxZhongli@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Where the reconciliation engine listens. Not public: the browser never calls
