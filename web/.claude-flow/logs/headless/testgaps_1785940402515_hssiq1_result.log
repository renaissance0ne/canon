        "code": "// proxy.test.ts — test the exported matcher logic directly via createRouteMatcher\nimport { describe, it, expect } from \"vitest\";\nimport { createRouteMatcher } from \"@clerk/nextjs/server\";\n\nconst isPublicRoute = createRouteMatcher([\"/\", \"/sign-in(.*)\", \"/sign-up(.*)\"]);\n\nfunction req(path: string) {\n  return { nextUrl: { pathname: path } } as any;\n}\n\ndescribe(\"isPublicRoute\", () => {\n  it.each([\"/\", \"/sign-in\", \"/sign-in/factor-one\", \"/sign-up\"])(\"%s is public\", (p) => {\n    expect(isPublicRoute(req(p))).toBe(true);\n  });\n\n  it.each([\"/runs\", \"/sources\", \"/conflicts\", \"/api/runs\", \"/rules/edit\"])(\"%s requires auth\", (p) => {\n    expect(isPublicRoute(req(p))).toBe(false);\n  });\n\n  it(\"does not treat /sign-in-like as public via prefix confusion\", () => {\n    // guards against a future regex change loosening the matcher\n    expect(isPublicRoute(req(\"/sign-in-oops\"))).toBe(true); // documents current (.*) behavior — flag if unintended\n  });\n});"
