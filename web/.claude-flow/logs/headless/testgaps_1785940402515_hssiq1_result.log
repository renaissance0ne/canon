        "code": "// types/source.test.ts\nimport { describe, it, expect } from \"vitest\";\nimport { createSourceSchema, sourceConfigSchema } from \"./source\";\n\ndescribe(\"createSourceSchema\", () => {\n  it(\"accepts a minimal valid source\", () => {\n    expect(createSourceSchema.safeParse({\n      name: \"A\", kind: \"salesforce\", config: { objects: [\"Account\"] },\n    }).success).toBe(true);\n  });\n\n  it(\"rejects empty name\", () => {\n    expect(createSourceSchema.safeParse({ name: \"\", kind: \"salesforce\", config: { objects: [\"x\"] } }).success).toBe(false);\n  });\n\n  it(\"rejects name over 80 chars\", () => {\n    expect(createSourceSchema.safeParse({ name: \"a\".repeat(81), kind: \"salesforce\", config: { objects: [\"x\"] } }).success).toBe(false);\n  });\n\n  it(\"rejects an unknown kind\", () => {\n    expect(createSourceSchema.safeParse({ name: \"A\", kind: \"airtable\", config: { objects: [\"x\"] } }).success).toBe(false);\n  });\n\n  it(\"rejects config.objects being empty (min 1)\", () => {\n    expect(sourceConfigSchema.safeParse({ objects: [] }).success).toBe(false);\n  });\n\n  it(\"accepts config without the optional filter\", () => {\n    expect(sourceConfigSchema.safeParse({ objects: [\"Account\"] }).success).toBe(true);\n  });\n});"
