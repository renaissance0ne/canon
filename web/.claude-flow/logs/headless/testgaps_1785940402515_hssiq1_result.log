        "code": "// lib/reviewer-label.test.ts\nimport { describe, it, expect } from \"vitest\";\nimport { reviewerLabel } from \"./reviewer-label\";\n\ndescribe(\"reviewerLabel\", () => {\n  it(\"prefers username over email\", () => {\n    expect(reviewerLabel({ username: \"j.rao\", primaryEmailAddress: { emailAddress: \"j@x.com\" } }, \"fallback\")).toBe(\"j.rao\");\n  });\n\n  it(\"falls back to email when username is null\", () => {\n    expect(reviewerLabel({ username: null, primaryEmailAddress: { emailAddress: \"j@x.com\" } }, \"fallback\")).toBe(\"j@x.com\");\n  });\n\n  it(\"falls back to the provided fallback when user is null\", () => {\n    expect(reviewerLabel(null, \"signed in\")).toBe(\"signed in\");\n  });\n\n  it(\"falls back when primaryEmailAddress itself is null\", () => {\n    expect(reviewerLabel({ username: null, primaryEmailAddress: null }, \"fallback\")).toBe(\"fallback\");\n  });\n\n  it(\"falls back when emailAddress field is missing\", () => {\n    expect(reviewerLabel({ username: null, primaryEmailAddress: { emailAddress: null } }, \"fallback\")).toBe(\"fallback\");\n  });\n\n  it(\"does NOT treat an empty-string username as absent (documents ?? semantics)\", () => {\n    expect(reviewerLabel({ username: \"\", primaryEmailAddress: { emailAddress: \"j@x.com\" } }, \"fallback\")).toBe(\"\");\n  });\n});"
