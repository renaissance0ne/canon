ue({ isAuthenticated: true, userId: \"u_3\" });\n    (currentUser as any).mockResolvedValue({ username: \"a\", primaryEmailAddress: null });\n    await expect(getReviewer()).resolves.toEqual({ userId: \"u_3\", label: \"a\" });\n  });\n});"
