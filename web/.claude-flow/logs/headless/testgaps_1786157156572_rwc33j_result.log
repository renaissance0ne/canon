      {
        "title": "`lib/api-client.ts::sendJson` — untested error handling, and it's the only error path the whole review UI depends on",
        "content": "\n```ts\n// lib/api-client.test.ts\nimport { describe, expect, it, vi, afterEach } from \"vitest\";\nimport { postJson, patchJson } from \"@/lib/api-client\";\n\nafterEach(() => vi.unstubAllGlobals());\n\nit(\"returns ok:true with parsed data on 2xx\", async () => {\n  vi.stubGlobal(\"fetch\", vi.fn().mockResolvedValue(new Response(JSON.stringify({ a: 1 }), { status: 200 })));\n  expect(await postJson(\"/x\", {})).toEqual({ ok: true, data: { a: 1 } });\n});\n\nit(\"network failure (fetch throws) returns a fixed, non-empty message\", async () => {\n  vi.stubGlobal(\"fetch\", vi.fn().mockRejectedValue(new TypeError(\"failed to fetch\")));\n  const result = await patchJson(\"/x\", {});\n  expect(result).toEqual({ ok: false, message: expect.stringContaining(\"Could not reach\") });\n});\n\nit(\"non-ok response with a JSON error body surfaces error + issues\", async () => {\n  vi.stubGlobal(\"fetch\", vi.fn().mockResolvedValue(\n    new Response(JSON.stringify({ error: \"Bad field\", issues: { name: \"required\" } }), { status: 400 }),\n  ));\n  expect(await postJson(\"/x\", {})).toEqual({ ok: false, message: \"Bad field\", issues: { name: \"required\" } });\n});\n\nit(\"non-ok response with an unparseable body still returns a non-empty message\", async () => {\n  vi.stubGlobal(\"fetch\", vi.fn().mockResolvedValue(new Response(\"not json\", { status: 500 })));\n  const result = await postJson(\"/x\", {});\n  expect(result.ok).toBe(false);\n  expect(result.message).toContain(\"500\");\n});\n```\n\n---\n\n",
        "level": 3
      },
