t(\"is false for a stat whose producing stage hasn't finished yet\", () => {\n    expect(isStatKnown(\"matches\", \"extracting\")).toBe(false);\n  });\n  it(\"is true once the producing stage is behind current status\", () => {\n    expect(isStatKnown(\"entitiesA\", \"matching\")).toBe(true);\n  });\n});\n\ndescribe(\"runStageIndex\", () => {\n  it(\"returns -1 for 'failed', which is not a pipeline stage\", () => {\n    expect(runStageIndex(\"failed\")).toBe(-1);\n  });\n});\n```\n\n---\n\n## 3. `lib/server/*.ts` — business logic, currently 100% untested, mixed unit/integration\n\n### Pure sub-functions extractable today (unit-testable once `server-only` is stubbed)\n\n- `lib/server/entities.ts::childKey` — trivial, exported, untested.\n- `lib/server/export.ts::isExportSection`, `estimateExportBytes`, `decisionsToCsv` — exported and pure, untested.\n\n```ts\n// lib/server/export.test.ts\nimport { describe, expect, it } from \"vitest\";\nimport { isExportSection, estimateExportBytes, decisionsToCsv, type DecisionRow } from \"@/lib/server/export\";\n\nit(\"isExportSection rejects unknown names\", () => expect(isExportSection(\"bogus\")).toBe(false));\n\nit(\"estimateExportBytes sums only the requested sections\", () => {\n  const sizing = { hierarchy: 10, decisions: 5, orphans: 0, stats: 1 };\n  expect(estimateExportBytes(sizing, [\"hierarchy\"])).toBe(10 * 120);\n});\n\ndescribe(\"decisionsToCsv\", () => {\n  it(\"quotes cells containing commas, quotes or newlines\", () => {\n    const row = { ...emptyDecision(), rationale: 'has, a \"quote\"\\nand a newline' };\n    const csv = decisionsToCsv([row]);\n    expect(csv).toContain(`\"has, a \"\"quote\"\"`);\n  });\n  it(\"renders null fields as empty cells, not the string 'null'\", () => {\n    const csv = decisionsToCsv([emptyDecision()]);\n    expect(csv).not.toContain(\"null\");\n  });\n  it(\"ends every line with CRLF, including the final row\", () => {\n    expect(decisionsToCsv([emptyDecision()]).endsWith(\"\\r\\n\")).toBe(true);\n  });\n});\n```\n\n`appliedValue` and `applyDecisions` (the hierarchy-reparenting logic — arguably the most important function in `export.ts`) are **not exported**, so they're currently only reachable through a full `buildRunExport` DB round-trip. **Gap: export at least `applyDecisions` for direct unit testing**, or accept it's integration-only. Either way it needs a test — it's the function that decides whether an account's parent changed:\n\n```ts\nit(\"reparents an account only when a resolution changed its parentExternalId\", () => {});\nit(\"reparented is false when the resolved value equals the original parent (no-op override)\", () => {});\nit(\"ignores resolutions for fields other than parentExternalId\", () => {});\n```\n\n### `lib/server/engine.ts` — fully unit-testable today via `fetch` mocking, zero coverage on its error paths\n\nThis is the highest-value untested file: it has an explicit custom error class and three distinct failure modes, none exercised.\n\n```ts\n// lib/server/engine.test.ts\nimport { describe, expect, it, vi, beforeEach, afterEach } from \"vitest\";\nimport { startRun, fetchEngineStatus, EngineUnreachableError } from \"@/lib/server/engine\";\n\nbeforeEach(() => { process.env.ENGINE_URL = \"http://engine.test\"; });\nafterEach(() => { vi.unstubAllGlobals(); delete process.env.ENGINE_URL; });\n\ndescribe(\"startRun\", () => {\n  it(\"throws EngineUnreachableError when ENGINE_URL is unset\", async () => {\n    delete process.env.ENGINE_URL;\n    await expect(startRun(\"id\")).rejects.toBeInstanceOf(EngineUnreachableError);\n  });\n  it(\"throws when fetch rejects (network down)\", async () => {\n    vi.stubGlobal(\"fetch\", vi.fn().mockRejectedValue(new Error(\"ECONNREFUSED\")));\n    await expect(startRun(\"id\")).rejects.toThrow(EngineUnreachableError);\n  });\n  it(\"throws with a distinct message on AbortSignal timeout\", async () => {\n    vi.stubGlobal(\"fetch\", vi.fn().mockRejectedValue(Object.assign(new Error(), { name: \"TimeoutError\" })));\n    await expect(startRun(\"id\")).rejects.toThrow(/no response within 8s/);\n  });\n  it(\"throws when the engine responds non-2xx\", async () => {\n    vi.stubGlobal(\"fetch\", vi.fn().mockResolvedValue(new Response(\"bad request\", { status: 400 })));\n    await expect(startRun(\"id\")).rejects.toThrow(/rejected the run with 400/);\n  });\n  it(\"throws when the engine returns 200 with a body that fails the response schema\", async () => {\n    vi.stubGlobal(\"fetch\", vi.fn().mockResolvedValue(new Response(JSON.stringify({ ok: true }), { status: 200 })));\n    await expect(startRun(\"id\")).rejects.toThrow(/unexpected body/);\n  });\n  it(\"resolves on a valid 200 response\", async () => {\n    vi.stubGlobal(\"fetch\", vi.fn().mockResolvedValue(\n      new Response(JSON.stringify({ runId: \"id\", accepted: true }), { status: 200 }),\n    ));\n    await expect(startRun(\"id\")).resolves.toBeUndefined();\n  });\n  it(\"strips trailing slashes from ENGINE_URL\", async () => {\n    process.env.ENGINE_URL = \"http://engine.test///\";\n    const fetchMock = vi.fn().mockResolvedValue(new Response(JSON.stringify({ runId: \"id\", accepted: true })));\n    vi.stubGlobal(\"fetch\", fetchMock);\n    await startRun(\"id\");\n    expect(fetchMock).toHaveBeenCalledWith(\"http://engine.test/runs\", expect.anything());\n  });\n});\n\ndescribe(\"fetchEngineStatus\", () => {\n  it(\"returns null (never throws) when fetch rejects\", async () => {\n    vi.stubGlobal(\"fetch\", vi.fn().mockRejectedValue(new Error(\"down\")));\n    await expect(fetchEngineStatus(\"id\")).resolves.toBeNull();\n  });\n  it(\"returns null on a non-ok response\", async () => {\n    vi.stubGlobal(\"fetch\", vi.fn().mockResolvedValue(new Response(\"\", { status: 503 })));\n    await expect(fetchEngineStatus(\"id\")).resolves.toBeNull();\n  });\n  it(\"returns null when the body fails schema validation\", async () => {\n    vi.stubGlobal(\"fetch\", vi.fn().mockResolvedValue(new Response(JSON.stringify({}), { status: 200 })));\n    await expect(fetchEngineStatus(\"id\")).resolves.toBeNull();\n  });\n  it(\"returns the parsed status on success\", async () => {});\n});\n```\n\n### `lib/server/auth.ts` — untested, and it's the function the whole audit trail's integrity rests on\n\n```ts\n// lib/server/auth.test.ts\nimport { describe, expect, it, vi } from \"vitest\";\nvi.mock(\"@clerk/nextjs/server\", () => ({ auth: vi.fn(), currentUser: vi.fn() }));\nimport { auth, currentUser } from \"@clerk/nextjs/server\";\nimport { requireReviewer, getReviewer } from \"@/lib/server/auth\";\n\nit(\"requireReviewer throws when there is no session (matcher/handler disagreement)\", async () => {\n  vi.mocked(auth).mockResolvedValue({ isAuthenticated: false, userId: null } as any);\n  await expect(requireReviewer()).rejects.toThrow(/should be covered by proxy/);\n});\nit(\"requireReviewer resolves userId + label from the Clerk user\", async () => {\n  vi.mocked(auth).mockResolvedValue({ isAuthenticated: true, userId: \"u1\" } as any);\n  vi.mocked(currentUser).mockResolvedValue({ username: \"j.rao\" } as any);\n  await expect(requireReviewer()).resolves.toEqual({ userId: \"u1\", label: \"j.rao\" });\n});\nit(\"getReviewer returns null when signed out, without throwing\", async () => {\n  vi.mocked(auth).mockResolvedValue({ isAuthenticated: false } as any);\n  await expect(getReviewer()).resolves.toBeNull();\n});\n```\n\n### `proxy.ts` — the route matcher deciding what's public. Security-critical, zero tests.\n\n```ts\n// proxy.test.ts — verify the matcher, not clerkMiddleware internals\nimport { describe, expect, it } from \"vitest\";\nimport { createRouteMatcher } from \"@clerk/nextjs/server\";\n\nconst isPublicRoute = createRouteMatcher([\"/\", \"/sign-in(.*)\", \"/sign-up(.*)\"]);\n\nit.each([\"/\", \"/sign-in\", \"/sign-in/factor-one\", \"/sign-up\"])(\"%s is public\", (path) => {\n  expect(isPublicRoute(new Request(`http://x${path}`))).toBe(true);\n});\nit.each([\"/runs\", \"/api/runs\", \"/api/conflicts/abc/resolution\", \"/conflicts\"])(\"%s requires auth\", (path) => {\n  expect(isPublicRoute(new Request(`http://x${path}`))).toBe(false);\n});\n```\n\n### Integration-only: `recordReview`, `getQueuePage`, `createRulesetVersion`, `getAuditPage`\n\nThese touch Postgres directly and encode the most important business rules in the app (the observed-value guard, the \"approve with nothing proposed\" 409, version locking under concurrency). They need a seeded test database — no amount of mocking Drizzle honestly exercises `pg_advisory_xact_lock` or the join shape.\n\n```ts\n// lib/server/conflicts.integration.test.ts\n// Requires TEST_DATABASE_URL pointed at a disposable Postgres, migrated via drizzle-kit.\nimport { describe, expect, it, beforeEach } from \"vitest\";\nimport { recordReview, getReviewTarget } from \"@/lib/server/conflicts\";\n// seed helpers: insertSource, insertRun, insertMatch, insertConflict, insertResolution\n\nit(\"approve with no proposed value returns 409, does not write the resolution\", async () => {\n  const conflict = await seedConflict({ proposedValue: \"\" , status: \"escalated\"});\n  const result = await recordReview({ conflictId: conflict.id, action: { action: \"approve\" }, reviewer });\n  expect(result).toMatchObject({ ok: false, code: 409 });\n});\n\nit(\"override rejects a value that is not one of the two observed values\", async () => {\n  const conflict = await seedConflict({ valueA: \"ACC-1\", valueB: \"ACC-2\" });\n  const result = await recordReview({\n    conflictId: conflict.id, reviewer,\n    action: { action: \"override\", overrideValue: \"ACC-999\" },\n  });\n  expect(result).toMatchObject({ ok: false, code: 400 });\n});\n\nit(\"override normalizes the value to the exact observed spelling before storing\", async () => {\n  const conflict = await seedConflict({ valueA: \"ACME Inc.\", valueB: \"acme llc\" });\n  await recordReview({ conflictId: conflict.id, reviewer, action: { action: \"override\", overrideValue: \"acme inc\" } });\n  const target = await getReviewTarget(conflict.id);\n  // assert stored overrideValue === \"ACME Inc.\" (the folded-onto original), not the typed string\n});\n\nit(\"reviewing an already-resolved conflict overwrites status and clears overrideValue when moving off override\", async () => {});\nit(\"returns 404 for a conflictId that doesn't exist\", async () => {});\nit(\"returns 409 when the run hasn't reached resolve yet (resolution is null)\", async () => {});\nit(\"appends exactly one audit_log row per review, with the correct action mapping\", async () => {\n  // approve -> human_approved, reject -> human_rejected, override -> human_overridden\n});\n\n// concurrency-specific\nit(\"two concurrent createRulesetVersion calls for the same name never produce duplicate versions\", async () => {\n  const [a, b] = await Promise.all([createRulesetVersion(input), createRulesetVersion(input)]);\n  expect(new Set([a.version, b.version]).size).toBe(2);\n});\n```\n\n**Also currently unverified and worth a comment-in-code caveat becoming a real test:** `lib/server/conflicts.ts` comment at line ~64 explicitly says the `resolutions` LEFT JOIN assumes one resolution per conflict and is \"not yet enforced by a unique index.\" That's a documented, untested invariant — a regression test (or the migration itself) belongs here:\n```ts\nit(\"a conflict with two resolutions rows does not silently double-count in queue totals\", async () => {\n  // Documents current (buggy) behavior until a unique index exists — write this\n  // test to fail-loud once the constraint lands, or add the constraint now.\n});\n```\n\n---\n\n## 4. `app/api/**/route.ts` — 9 route handlers, 0 integration tests\n\nAll of them are one call away from testable: import the exported `GET`/`POST`/`PATCH` and invoke with a `Request`, mocking `lib/server/*` and `requireReviewer`.\n\n```ts\n// app/api/runs/route.test.ts\nimport { describe, expect, it, vi, beforeEach } from \"vitest\";\nvi.mock(\"@/lib/server/auth\", () => ({ requireReviewer: vi.fn() }));\nvi.mock(\"@/lib/server/sources\", () => ({ findSourceIds: vi.fn() }));\nvi.mock(\"@/lib/server/rulesets\", () => ({ getRuleset: vi.fn() }));\nvi.mock(\"@/lib/server/runs\", () => ({ createRun: vi.fn(), failUndispatchedRun: vi.fn(), listRuns: vi.fn() }));\nvi.mock(\"@/lib/server/engine\", async (orig) => ({ ...(await orig()), startRun: vi.fn() }));\nvi.mock(\"@/lib/server/audit\", () => ({ appendAudit: vi.fn() }));\nimport { POST } from \"@/app/api/runs/route\";\nimport { findSourceIds } from \"@/lib/server/sources\";\nimport { getRuleset } from \"@/lib/server/rulesets\";\nimport { createRun } from \"@/lib/server/runs\";\nimport { requireReviewer } from \"@/lib/server/auth\";\nimport { startRun, EngineUnreachableError } from \"@/lib/server/engine\";\nimport { failUndispatchedRun } from \"@/lib/server/runs\";\n\nfunction req(body: unknown) {\n  return new Request(\"http://x/api/runs\", { method: \"POST\", body: JSON.stringify(body) });\n}\n\nit(\"400s when sourceAId === sourceBId\", async () => {\n  const res = await POST(req({ sourceAId: SAME, sourceBId: SAME, rulesetId: R }));\n  expect(res.status).toBe(400);\n});\n\nit(\"400s when a source id no longer exists (not a raw FK 500)\", async () => {\n  vi.mocked(findSourceIds).mockResolvedValue(new Set([A])); // B missing\n  const res = await POST(req({ sourceAId: A, sourceBId: B, rulesetId: R }));\n  expect(res.status).toBe(400);\n  expect(await res.json()).toMatchObject({ error: expect.stringContaining(\"Source B\") });\n});\n\nit(\"400s when the body fails zod validation (missing field)\", async () => {\n  const res = await POST(req({ sourceAId: A }));\n  expect(res.status).toBe(400);\n});\n\nit(\"400s when the body is not valid JSON\", async () => {\n  const res = await POST(new Request(\"http://x\", { method: \"POST\", body: \"not json\" }));\n  expect(res.status).toBe(400);\n});\n\nit(\"201s and returns runId even when the engine rejects dispatch — and records the failure on the row\", async () => {\n  vi.mocked(findSourceIds).mockResolvedValue(new Set([A, B]));\n  vi.mocked(getRuleset).mockResolvedValue(rulesetFixture);\n  vi.mocked(requireReviewer).mockResolvedValue({ userId: \"u1\", label: \"j.rao\" });\n  vi.mocked(createRun).mockResolvedValue(runFixture);\n  vi.mocked(startRun).mockRejectedValue(new EngineUnreachableError(\"down\"));\n\n  const res = await POST(req(validBody));\n  expect(res.status).toBe(201);\n  expect(failUndispatchedRun).toHaveBeenCalledWith(runFixture.id, expect.stringContaining(\"stage=dispatch\"));\n});\n\nit(\"re-throws non-EngineUnreachableError errors from startRun instead of swallowing them\", async () => {\n  vi.mocked(startRun).mockRejectedValue(new Error(\"unexpected\"));\n  await expect(POST(req(validBody))).rejects.toThrow(\"unexpected\");\n});\n```\n\n```ts\n// app/api/conflicts/[conflictId]/resolution/route.test.ts\nimport { PATCH } from \"@/app/api/conflicts/[conflictId]/resolution/route\";\n\nit(\"returns 404 for a non-UUID conflictId without touching the DB\", async () => {\n  const res = await PATCH(req({ action: \"approve\" }), ctx(\"not-a-uuid\"));\n  expect(res.status).toBe(404);\n  expect(recordReview).not.toHaveBeenCalled();\n});\nit(\"rejects a body with an unknown action value (discriminated union)\", async () => {\n  const res = await PATCH(req({ action: \"delete\" }), ctx(validId));\n  expect(res.status).toBe(400);\n});\nit(\"rejects override with an empty overrideValue (min(1))\", async () => {});\nit(\"passes the server-resolved reviewer, never one from the body\", async () => {\n  await PATCH(req({ action: \"approve\", reviewedBy: \"attacker\" } as any), ctx(validId));\n  expect(recordReview).toHaveBeenCalledWith(expect.objectContaining({\n    reviewer: expect.not.objectContaining({ label: \"attacker\" }),\n  }));\n});\nit(\"surfaces recordReview's error code (400/404/409) verbatim\", async () => {});\n```\n\n```ts\n// app/api/runs/[runId]/export/route.test.ts\nit(\"rejects an unknown section name\", async () => {\n  const res = await GET(req(\"?sections=hierarchy,bogus\"), ctx(runId));\n  expect(res.status).toBe(400);\n});\nit(\"de-duplicates and canonically orders sections regardless of request order\", async () => {\n  // ?sections=stats,hierarchy,hierarchy -> only hierarchy+stats requested, in EXPORT_SECTIONS order\n});\nit(\"rejects an unsupported format\", async () => {\n  const res = await GET(req(\"?format=xml\"), ctx(runId));\n  expect(res.status).toBe(400);\n});\nit(\"csv format ignores non-decisions sections and returns only the decision log\", async () => {});\nit(\"sets content-disposition with a filename derived from shortRunId\", async () => {});\nit(\"404s for a run id that doesn't exist\", async () => {});\n```\n\n```ts\n// app/api/runs/[runId]/status/route.test.ts\nit(\"skips the engine call entirely for a terminal run\", async () => {\n  vi.mocked(getRun).mockResolvedValue({ ...runFixture, status: \"complete\" });\n  await GET(req(), ctx(runId));\n  expect(fetchEngineStatus).not.toHaveBeenCalled();\n});\nit(\"falls back to the DB row when the engine is unreachable mid-run\", async () => {\n  vi.mocked(getRun).mockResolvedValue({ ...runFixture, status: \"matching\" });\n  vi.mocked(fetchEngineStatus).mockResolvedValue(null);\n  const res = await GET(req(), ctx(runId));\n  expect(await res.json()).toMatchObject({ status: \"matching\" });\n});\nit(\"sets cache-control: no-store on every response\", async () => {});\nit(\"404s for an unknown runId\", async () => {});\n```\n\nSame pattern applies to `app/api/conflicts/route.ts` (query validation → `loadQueue` \"no-runs\" branch), `app/api/rulesets/route.ts`, `app/api/sources/route.ts`, and `app/api/audit/export/route.ts` (unknown `action` → 400, `runId` present but not found → 404, CSV quoting for detail containing commas/newlines) — all currently 0% covered.\n\n---\n\n## 5. Client components / hooks — logic embedded in `\"use client\"` files, untested\n\n### `components/conflicts/use-review.ts`\n\n```ts\n// components/conflicts/use-review.test.tsx\nimport { describe, expect, it, vi } from \"vitest\";\nimport { renderHook, act } from \"@testing-library/react\";\nvi.mock(\"next/navigation\", () => ({ useRouter: () => ({ refresh: vi.fn() }) }));\nvi.mock(\"@/lib/api-client\", () => ({ patchJson: vi.fn() }));\nimport { patchJson } from \"@/lib/api-client\";\nimport { useReview } from \"@/components/conflicts/use-review\";\n\nit(\"sets pendingId during the request and clears it after\", async () => {\n  vi.mocked(patchJson).mockImplementation(() => new Promise((r) => setTimeout(() => r({ ok: true, data: { conflictId: \"c1\", status: \"approved\", reviewedBy: \"j\" } }), 0)));\n  const { result } = renderHook(() => useReview());\n  let promise: Promise<any>;\n  act(() => { promise = result.current.submit(\"c1\", { action: \"approve\" }); });\n  expect(result.current.pendingId).toBe(\"c1\");\n  await act(async () => { await promise; });\n  expect(result.current.pendingId).toBeNull();\n});\n\nit(\"records the server-returned status in `decided`, not an optimistic guess\", async () => {\n  vi.mocked(patchJson).mockResolvedValue({ ok: true, data: { conflictId: \"c1\", status: \"overridden\", reviewedBy: \"j.rao\" } });\n  const { result } = renderHook(() => useReview());\n  await act(async () => { await result.current.submit(\"c1\", { action: \"approve\" }); });\n  expect(result.current.decided.c1).toEqual({ status: \"overridden\", reviewedBy: \"j.rao\" });\n});\n\nit(\"leaves `decided` untouched on failure (no optimistic rollback needed)\", async () => {\n  vi.mocked(patchJson).mockResolvedValue({ ok: false, message: \"boom\" });\n  const { result } = renderHook(() => useReview());\n  const outcome = await act(async () => result.current.submit(\"c1\", { action: \"reject\" }));\n  expect(outcome).toEqual({ ok: false, message: \"boom\" });\n  expect(result.current.decided.c1).toBeUndefined();\n});\n```\n\n### `components/rules/ruleset-editor.tsx`\n\nUntested logic worth pulling out or testing via render: `sameRules` (field-by-field dirty check, explicitly NOT `JSON.stringify` per the code comment — a regression here would let a byte-identical ruleset be saved as a spurious new version), the `prefer_source`-without-a-source save guard, and evaluation-order display vs. author-order mutation.\n\n```ts\n// components/rules/ruleset-editor.test.tsx\nit(\"Save is disabled when nothing changed from the active version\", () => {});\nit(\"dirty check ignores stored jsonb key-order differences (field-by-field, not JSON.stringify)\", () => {\n  // active.rules and rules are the \"same\" ruleset with keys serialized differently\n});\nit(\"blocks save with a message when a prefer_source rule has no preferredSourceId\", async () => {\n  render(<RulesetEditor active={null} sources={[]} />);\n  // set strategy to prefer_source, leave source unset, click Save\n  expect(await screen.findByRole(\"alert\")).toHaveTextContent(/names no system/);\n});\nit(\"clears preferredSourceId when a rule's strategy is switched away from prefer_source before saving\", () => {});\nit(\"Remove is not offered on the last remaining rule\", () => {});\nit(\"editing a rule mutates the correct row even though rows render in evaluation order, not author order\", () => {\n  // add a low-specificity rule first, then a high-specificity one; edit the row\n  // rendered SECOND (which is authored FIRST) and assert the right one changed\n});\n```\n\n---\n\n## 6. Priority summary\n\n| Priority | Module | Why |\n|---|---|---|\n| P0 | `lib/validate-value.ts`, `lib/server/conflicts.ts::recordReview` | Enforces \"no hallucinated value\" — the core product invariant |\n| P0 | `lib/server/engine.ts` | 3 untested failure modes on the only external network call; fully mockable today |\n| P0 | `app/api/**/route.ts` (all 9) | Zero integration coverage on every write path (`runs`, review actions, rulesets) |\n| P1 | `lib/format.ts`, `lib/diff-chars.ts`, `lib/audit-detail.ts`, `lib/rule-trace.ts` | Pure, zero-dependency, drive every screen's rendering — cheapest tests to write |\n| P1 | `types/run.ts` (`failedStage`, `isStatKnown`) | Regex/state-machine logic with silent-failure modes (`null`/`-1` fallbacks) |\n| P2 | `lib/server/auth.ts`, `proxy.ts` | Security-relevant, currently unverified route-matcher behavior |\n| P2 | `use-review.ts`, `ruleset-editor.tsx` | Client-side state machines with documented-but-unverified invariants |\n| P3 | Remaining `lib/server/*` DB integration tests | Needs a seeded test Postgres — bigger lift, schedule after unit layer exists |\n\n**Bottom line:** set up Vitest + the `server-only` alias first (blocks everything), then land the pure-function suites in section 1–2 (a day of work, no infra needed), then the `engine.ts`/route-handler mocked-integration tests (section 3–4), and treat the real-DB tests in `conflicts.ts`/`rulesets.ts` as a separate, slightly bigger follow-up once a disposable test database is wired up.\n",
