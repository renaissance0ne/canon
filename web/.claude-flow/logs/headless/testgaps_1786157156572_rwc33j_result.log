        "title": "`lib/format.ts` — 7 exported functions, 0 tests",
        "content": "\nEdge cases the code explicitly handles but nothing verifies:\n- `formatElapsed`: negative input clamps to 0 (`Math.max(0, ...)`), the 3600s hour boundary, sub-second rounding.\n- `formatStat`: `null`/`undefined` → `\"—\"`, but `0` must render as `\"0\"`, not the dash (easy regression: `n ?? \"—\"` vs the actual `n === null || n === undefined` check).\n- `formatRelative`: boundary values at exactly 60s/60m/24h, and a `now` before `date` (negative seconds — currently falls into `\"just now\"` unguarded).\n- `shortRunId`: id with more/less than 36 chars, id already without hyphens.\n\n```ts\n// lib/format.test.ts\nimport { describe, expect, it } from \"vitest\";\nimport {\n  shortRunId, formatElapsed, formatCount, formatStat,\n  formatTimestamp, formatRelative, formatConfidence,\n} from \"@/lib/format\";\n\ndescribe(\"shortRunId\", () => {\n  it(\"takes 4+2 hex chars around the interpunct\", () => {\n    expect(shortRunId(\"a41f1234-c9ab-...\")).toBe(\"a41f·1c\"); // adjust to real fixture\n  });\n  it(\"handles an id with no hyphens\", () => {\n    expect(shortRunId(\"abcdef123456\")).toBe(\"abcd·ef\");\n  });\n});\n\ndescribe(\"formatElapsed\", () => {\n  it(\"clamps negative durations to zero\", () => {\n    expect(formatElapsed(-500)).toBe(\"00:00\");\n  });\n  it(\"switches to h:mm:ss exactly at one hour\", () => {\n    expect(formatElapsed(3600_000)).toBe(\"1:00:00\");\n    expect(formatElapsed(3599_000)).toBe(\"59:59\");\n  });\n});\n\ndescribe(\"formatStat\", () => {\n  it(\"renders zero as 0, not an em dash\", () => {\n    expect(formatStat(0)).toBe(\"0\");\n  });\n  it.each([null, undefined])(\"renders %s as an em dash\", (v) => {\n    expect(formatStat(v)).toBe(\"—\");\n  });\n});\n\ndescribe(\"formatRelative\", () => {\n  it(\"is stable at the minute/hour/day boundaries\", () => {\n    const now = new Date(\"2026-08-08T12:00:00Z\");\n    expect(formatRelative(new Date(\"2026-08-08T11:59:00Z\"), now)).toBe(\"1m ago\");\n    expect(formatRelative(new Date(\"2026-08-08T11:00:00Z\"), now)).toBe(\"1h ago\");\n    expect(formatRelative(new Date(\"2026-08-07T12:00:00Z\"), now)).toBe(\"1d ago\");\n  });\n  it(\"does not crash on a future date\", () => {\n    expect(() => formatRelative(new Date(Date.now() + 10_000))).not.toThrow();\n  });\n});\n\ndescribe(\"formatConfidence\", () => {\n  it(\"always renders two decimals\", () => {\n    expect(formatConfidence(0.9)).toBe(\"0.90\");\n    expect(formatConfidence(1)).toBe(\"1.00\");\n  });\n});\n```\n\n",
        "level": 3
      },
      {
        "title": "`lib/diff-chars.ts::diffSegments` — the \"signature element\" of the whole UI, untested",
        "content": "\n```ts\n// lib/diff-chars.test.ts\nimport { describe, expect, it } from \"vitest\";\nimport { diffSegments } from \"@/lib/diff-chars\";\n\ndescribe(\"diffSegments\", () => {\n  it(\"puts the whole value in prefix when equal\", () => {\n    expect(diffSegments(\"ACME\", \"ACME\")).toEqual({ prefix: \"ACME\", middle: \"\", suffix: \"\" });\n  });\n  it(\"finds a head difference\", () => {\n    expect(diffSegments(\"APAC\", \"APAC-SOUTH\")).toEqual({ prefix: \"APAC\", middle: \"\", suffix: \"-SOUTH\" });\n    // NOTE: verify actual expected split — this exercises the \"same length\"\n    // asymmetry: value is a strict prefix of other.\n  });\n  it(\"finds a middle difference with shared prefix and suffix\", () => {\n    expect(diffSegments(\"ACC-4417\", \"ACC-2201\")).toEqual({ prefix: \"ACC-\", middle: \"4417\", suffix: \"\" });\n  });\n  it(\"handles two completely different strings (no shared chars)\", () => {\n    expect(diffSegments(\"abc\", \"xyz\")).toEqual({ prefix: \"\", middle: \"abc\", suffix: \"\" });\n  });\n  it(\"handles an empty string on one side\", () => {\n    expect(diffSegments(\"\", \"abc\")).toEqual({ prefix: \"\", middle: \"\", suffix: \"\" });\n  });\n  it(\"does not double-count overlapping prefix/suffix on short strings\", () => {\n    // \"aaa\" vs \"aa\": prefix scan alone would claim all of \"aa\", suffix must be\n    // bounded by max - prefix so it can't re-consume the same characters.\n    expect(diffSegments(\"aaa\", \"aa\")).toEqual({ prefix: \"aa\", middle: \"a\", suffix: \"\" });\n  });\n});\n```\n\n",
        "level": 3
      },
      {
        "title": "`lib/validate-value.ts` — enforces the \"no hallucinated value\" invariant; currently zero coverage on the exact rule the whole audit story depends on",
        "content": "\n```ts\n// lib/validate-value.test.ts\nimport { describe, expect, it } from \"vitest\";\nimport { foldValue, checkObservedValue, observedValues } from \"@/lib/validate-value\";\n\ndescribe(\"foldValue\", () => {\n  it(\"folds case, punctuation and whitespace\", () => {\n    expect(foldValue(\"ACME-INC\")).toBe(foldValue(\"ACME INC\"));\n  });\n  it(\"strips the longest matching suffix first (pvt ltd, not ltd)\", () => {\n    expect(foldValue(\"Trellis Labs Pvt Ltd\")).toBe(\"trellis labs\");\n  });\n  it(\"strips a suffix repeatedly when more than one is present\", () => {\n    expect(foldValue(\"Acme Pvt Ltd Ltd\")).toBe(\"acme\");\n  });\n  it(\"does not strip when the whole value IS the suffix\", () => {\n    expect(foldValue(\"Ltd\")).toBe(\"ltd\");\n  });\n  it(\"folds accented characters via NFKD\", () => {\n    expect(foldValue(\"Café Inc\")).toBe(\"cafe\");\n  });\n});\n\ndescribe(\"checkObservedValue\", () => {\n  it(\"rejects an empty candidate\", () => {\n    expect(checkObservedValue(\"   \", [\"A\", \"B\"])).toEqual({ ok: false, reason: expect.any(String) });\n  });\n  it(\"rejects when neither side holds a value (both blank)\", () => {\n    expect(checkObservedValue(\"X\", [\"\", \"  \"])).toMatchObject({ ok: false });\n  });\n  it(\"accepts an exact match\", () => {\n    expect(checkObservedValue(\"ACC-4417\", [\"ACC-4417\", \"ACC-2201\"])).toEqual({ ok: true, matches: \"ACC-4417\" });\n  });\n  it(\"accepts a folded/normalized equivalent and returns the ORIGINAL observed value\", () => {\n    expect(checkObservedValue(\"acme inc\", [\"ACME Inc.\"])).toEqual({ ok: true, matches: \"ACME Inc.\" });\n  });\n  it(\"rejects a value that is neither observed value nor a legal normalization\", () => {\n    expect(checkObservedValue(\"ACC-9999\", [\"ACC-4417\", \"ACC-2201\"])).toMatchObject({ ok: false });\n  });\n});\n\ndescribe(\"observedValues\", () => {\n  it(\"flattens both sides and drops blanks\", () => {\n    expect(observedValues({ a: { values: [\"X\", \"\"] }, b: { values: [\"  \", \"Y\"] } })).toEqual([\"X\", \"Y\"]);\n  });\n});\n```\n\n",
        "level": 3
      },
      {
        "title": "`lib/reviewer-label.ts` — one-liner, but has a real edge-case bug surface",
        "content": "\n`user?.username ?? ...` only falls through on `null`/`undefined` — an **empty-string username** (a real possibility from Clerk) will render as `\"\"` instead of falling back to email. Untested today, so this would ship silently.\n\n```ts\n// lib/reviewer-label.test.ts\nimport { describe, expect, it } from \"vitest\";\nimport { reviewerLabel } from \"@/lib/reviewer-label\";\n\ndescribe(\"reviewerLabel\", () => {\n  it(\"prefers username\", () => {\n    expect(reviewerLabel({ username: \"j.rao\", primaryEmailAddress: { emailAddress: \"j@x.com\" } }, \"fallback\")).toBe(\"j.rao\");\n  });\n  it(\"falls back to email when no username\", () => {\n    expect(reviewerLabel({ username: null, primaryEmailAddress: { emailAddress: \"j@x.com\" } }, \"fallback\")).toBe(\"j@x.com\");\n  });\n  it(\"falls back to the id when user is null\", () => {\n    expect(reviewerLabel(null, \"user_123\")).toBe(\"user_123\");\n  });\n  it(\"EDGE CASE: empty-string username is not treated as absent\", () => {\n    // Documents current behavior — flag if this is not actually desired.\n    expect(reviewerLabel({ username: \"\", primaryEmailAddress: { emailAddress: \"j@x.com\" } }, \"fallback\")).toBe(\"\");\n  });\n});\n```\n\n",
        "level": 3
      },
      {
        "title": "`lib/rule-trace.ts::deriveRuleTrace` — 4-node state machine, untested",
        "content": "\nMissing case: a rule matched but decided `escalate` (no value produced) — `apply` and `propose` both report `ran: false`, which is easy to regress silently.\n\n```ts\n// lib/rule-trace.test.ts\nimport { describe, expect, it } from \"vitest\";\nimport { deriveRuleTrace } from \"@/lib/rule-trace\";\n// build a minimal QueueRow fixture per test\n\nit(\"shows nothing resolved yet when there is no resolution\", () => { /* resolution: null */ });\nit(\"apply ran when a rule matched and produced a value\", () => { /* appliedRuleId set, proposedValue non-empty */ });\nit(\"neither apply nor propose ran when a rule matched but escalated (no value)\", () => {\n  // appliedRuleId set, proposedValue === \"\" — this is the easy-to-miss branch\n});\nit(\"propose ran (not apply) when no rule matched but the agent proposed a value\", () => {\n  // appliedRuleId: null, proposedValue non-empty\n});\nit(\"validate.ran mirrors hasValue exactly\", () => {});\n```\n\n",
        "level": 3
